  .banner-perimeter {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
    overflow: visible; /* lets the stroke sit on the edge, not inside it */
  }

  .banner-perimeter-rect {
    stroke: var(--color-accent, #ff3333);
    stroke-width: 2px;
    /* pathLength="100" on the element normalizes the perimeter to 100 units,
