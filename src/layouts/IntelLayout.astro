---
/**
 * IntelLayout — the whole shape of an article-section page, in one place.
 *
 * ─── WHY THIS EXISTS ──────────────────────────────────────────────────────
 * /intel and /intel/topic/<category> render the same page: filter bar,
 * magazine spread, video strip, archive grid, pagination. They differ only in
 * their title, which articles they show, and which filter is highlighted.
 * Written as two route files they were ~90% identical — the exact fork that
 * made the four /feed routes so painful before EPIC-000.
 *
 * So the page lives here, and each route becomes about 30 lines that just say
 * *which* articles to show.
 *
 * ─── THE PAGE, TOP TO BOTTOM ──────────────────────────────────────────────
 *   1. FeedLayout        page chrome — nav, big title, footer
 *   2. IntelFilters      ALL / FILM / TV / GAMES / EVENTS
 *   3. IntelMagazine     3-column spread (page 1 only)
 *   4. video strip       "Latest From The Channel" (page 1 of /intel only)
 *   5. CardGrid          the paginated archive
 *   6. Pagination        numbered pages
 *
 * ─── WHY THE MAGAZINE ONLY APPEARS ON PAGE 1 ──────────────────────────────
 * The spread is an opening statement. Repeating it on page 2, 3, 4 would push
 * the actual archive further down every time and show the same newest
 * articles again on each page. So pages 2+ are a plain, fast archive grid.
 *
 * ─── HOW PAGINATION IS SPLIT ──────────────────────────────────────────────
 * The magazine uses the newest MAGAZINE_SIZE articles (see
 * src/data/sections.js). The paginated archive therefore starts AFTER those,
 * so page 1 never shows the same article twice — once in the spread and again
 * in the grid below. The routes do that slicing in getStaticPaths.
 */
import FeedLayout from './FeedLayout.astro';
import IntelFilters from '../components/IntelFilters.astro';
import IntelMagazine from '../components/IntelMagazine.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CardGrid from '../components/CardGrid.astro';
import ContentCard from '../components/ContentCard.astro';
import Pagination from '../components/Pagination.astro';
import EmptyState from '../components/EmptyState.astro';
import GooglePreferredSourceDeeplink from '@puralex/astro-google-preferred-source/components/GooglePreferredSourceDeeplink.astro';
import { ARTICLE_SECTION } from '../data/sections.js';
import { LABELS } from '../data/content.js';
import { getCardImageSources } from '../lib/card-images.js';
import { Image } from 'astro:assets';
import logoImage from '../assets/logo-mark.webp';
import { getReferralItems, referralRel } from '../data/referrals.js';
import { BRAND_ICONS } from '../data/icons.js';

const adItems = getReferralItems();

const getAdMeta = (item: any) => {
  if (item.offer) return 'REFERRAL';
  if (item.affiliate === false) return 'TOOLS';
  return 'AFFILIATE';
};

interface Props {
  /** Browser tab / SEO title. */
  title: string;
  /** Meta description. */
  description: string;
  /** sr-only heading naming the page's content, for screen readers. */
  headingLabel: string;
  /** Astro's pagination object for the archive grid. */
  page: any;
  /** Which filter button is highlighted. null = "ALL". */
  activeCategory: string | null;
  /** Articles for the magazine spread. Empty on pages 2+. */
  magazineArticles: any[];
  /** Videos for the break strip. Empty to hide the strip entirely. */
  videos?: any[];
  /** Heading above the archive grid, e.g. "More From The Intel". */
  archiveHeading: string;
  /** Shown when there is genuinely nothing on the page. */
  emptyMessage: string;
  /** Image to preload in the <head> for LCP optimization */
  preloadImage?: string | null;
}

const {
  title,
  description,
  headingLabel,
  page,
  activeCategory,
  magazineArticles = [],
  videos = [],
  archiveHeading,
  emptyMessage,
  preloadImage = null,
} = Astro.props;

const hasMagazine = magazineArticles.length > 0;
const hasArchive = page.data.length > 0;
const hasVideos = videos.length > 0;
const firstMagSources = hasMagazine && magazineArticles[0]?.image ? getCardImageSources(magazineArticles[0].image) : null;
const defaultPreloadImage = preloadImage || (firstMagSources ? firstMagSources.src : null);
const defaultPreloadSrcset = firstMagSources ? firstMagSources.srcset : null;
const defaultPreloadSizes = firstMagSources?.srcset ? "(max-width: 900px) 92vw, 720px" : null;


// Nothing at all to show — not even one article in the spread.
/*
  An article section with nothing in it.

  The page still renders, and it must: IntelFilters shows every canonical
  category whether or not it has articles, so removing the page would make a
  visible button 404. An honest "no items found" screen is the better answer
  for a reader.

  It is NOT the better answer for Google. /intel/topic/events had zero
  articles, no robots directive, and a place in our own sitemap — so we were
  actively inviting Google to crawl an empty page, and Search Console returned
  "Soft 404: URL is not available to Google" on 2026-08-28. That is not a
  penalty, but it is us advertising a destination with nothing at it, which is
  the same rule scripts/seo-routing.test.mjs already enforces for redirects.

  So: exists for humans, noindex for crawlers, and dropped from the sitemap in
  astro.config.mjs. All three conditions lift by themselves the moment the
  category has its first article.
*/
const isEmpty = !hasMagazine && !hasArchive;
---

<FeedLayout
  noindex={isEmpty}
  hideHero={true}
  title={title}
  description={description}
  headingLabel={headingLabel}
  page={page}
  preloadImage={defaultPreloadImage} preloadImageSrcset={defaultPreloadSrcset} preloadImageSizes={defaultPreloadSizes}
  kicker={ARTICLE_SECTION.kicker}
  titlePrimary={ARTICLE_SECTION.titlePrimary}
  titleSecondary={ARTICLE_SECTION.titleSecondary}
  mainClass="pb-16 md:pb-24"
>
  {/* Render the category filters at the top of the page */}
  <IntelFilters slot="filters" active={activeCategory} />

  {hasMagazine && <IntelMagazine articles={magazineArticles} />}

  {/* BANNER PLACEMENT (YOUTUBE CTA / ADVERTISEMENT ROTATOR) */}
  <div class="yt-banner-wrapper">
    <div class="banner-rotator-grid" id="banner-rotator">
      {/* 1. YOUTUBE SUBSCRIBE BANNER (Always First) */}
      <a href="https://youtube.com/@BeUnconventionalHQ?sub_confirmation=1" target="_blank" rel="noopener noreferrer" class="yt-subscribe-banner banner-slide" data-state="active" data-meta="YOUTUBE">
        <Image src={logoImage} alt="Be Unconventional" class="yt-banner-logo" />
        <span class="yt-banner-text">Subscribe on YouTube</span>
        <svg viewBox="0 0 24 24" class="yt-banner-icon"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>

      {/* 2..N. ADVERTISEMENT PLACEMENTS (Dynamic from Support HQ) */}
      {adItems.map((item) => (
        <a href={item.href} target="_blank" rel={referralRel(item)} class="yt-subscribe-banner banner-slide" data-state="hidden-prev" data-meta={getAdMeta(item)}>
          {item.image ? (
            <Image src={item.image} alt={item.label} class="yt-banner-logo yt-banner-logo--square" />
          ) : (
            <div class="yt-banner-logo yt-banner-logo--fallback" set:html={item.icon ? (BRAND_ICONS[item.icon as keyof typeof BRAND_ICONS] ?? BRAND_ICONS.storefront) : BRAND_ICONS.storefront} />
          )}
          <span class="yt-banner-text yt-banner-text--ad">{item.blurb}</span>
          <span class="yt-banner-icon yt-banner-icon--ad" aria-hidden="true">&rarr;</span>
        </a>
      ))}

      {/* BOTTOM EDGE PROGRESS INDICATOR */}
      <div class="banner-progress-bar" id="banner-progress"></div>
    </div>

    {/* METADATA DISCLOSURE ROW */}
    <div class="banner-metadata-row">
      <span class="banner-meta-text" id="banner-meta">YOUTUBE</span>
    </div>
  </div>

  <script>
    /* 
      Advanced N-Item Continuous 3D Flip Engine.
      Automatically loops through items seamlessly with synchronized progress indication.
    */
    document.addEventListener('astro:page-load', () => {
      const rotator = document.getElementById('banner-rotator');
      const metaLabel = document.getElementById('banner-meta');
      if (!rotator || !metaLabel) return;

      const slides = Array.from(rotator.querySelectorAll('.banner-slide')) as HTMLElement[];
      if (slides.length <= 1) return;

      if ((window as any).__bannerRotatorInterval) {
        clearInterval((window as any).__bannerRotatorInterval);
      }

      const transitionDuration = 800; // Match CSS
      const holdDuration = 8000; // 8 Seconds for reading ads comfortably
      let currentIndex = 0;
      let isAnimating = false;

      // Reset states
      slides.forEach((slide, idx) => {
        slide.setAttribute('data-state', idx === 0 ? 'active' : 'hidden-prev');
      });

      const restartProgress = () => {
        const oldBar = document.getElementById('banner-progress');
        if (!oldBar) return;
        const newBar = oldBar.cloneNode(true);
        if (oldBar.parentNode) {
          oldBar.parentNode.replaceChild(newBar, oldBar);
        }
      };

      const goToNextSlide = () => {
        if (isAnimating) return;
        isAnimating = true;

        const nextIndex = (currentIndex + 1) % slides.length;
        const currentSlide = slides[currentIndex];
        const nextSlide = slides[nextIndex];

        // current -> floor, next (from ceiling) -> active
        nextSlide.style.transition = 'none';
        nextSlide.setAttribute('data-state', 'hidden-prev'); // snap to ceiling
        void nextSlide.offsetWidth;
        nextSlide.style.transition = '';

        currentSlide.setAttribute('data-state', 'hidden-next'); // flop to floor
        nextSlide.setAttribute('data-state', 'active');         // flop from ceiling to view

        currentIndex = nextIndex;
        
        // Update the metadata row underneath the banner
        const newMetaText = nextSlide.getAttribute('data-meta') || 'YOUTUBE';
        metaLabel.textContent = newMetaText;
        
        restartProgress();

        setTimeout(() => {
          isAnimating = false;
        }, transitionDuration);
      };

      restartProgress();
      
      const startRotation = () => {
        if (!(window as any).__bannerRotatorInterval) {
          (window as any).__bannerRotatorInterval = setInterval(goToNextSlide, holdDuration);
        }
      };

      const stopRotation = () => {
        if ((window as any).__bannerRotatorInterval) {
          clearInterval((window as any).__bannerRotatorInterval);
          (window as any).__bannerRotatorInterval = null;
        }
      };

      startRotation();

      const bannerWrapper = document.querySelector('.yt-banner-wrapper');
      if (bannerWrapper) {
        bannerWrapper.addEventListener('mouseenter', stopRotation);
        bannerWrapper.addEventListener('mouseleave', startRotation);
        bannerWrapper.addEventListener('focusin', stopRotation);
        bannerWrapper.addEventListener('focusout', startRotation);
      }
    });
  </script>

  {
    hasVideos && (
      /* aria-labelledby points at the heading's id so screen readers announce
         this region by name rather than as an anonymous "section". */
      <section class="intel-break pt-16" aria-labelledby="intel-video-head">
        <SectionHeading
          title="Latest From The Channel"
          id="intel-video-head"
          linkLabel={LABELS.viewAllVideos}
          linkHref="/feed/videos"
        />
        <CardGrid columns="video">
          {videos.map((video: any, index: number) => (
            <ContentCard item={video} index={index} />
          ))}
        </CardGrid>
      </section>
    )
  }

  {
    hasArchive && (
      <section class="intel-archive pt-16 mt-16" aria-labelledby="intel-archive-head">
        <SectionHeading title={archiveHeading} id="intel-archive-head" />
        <CardGrid>
          {page.data.map((item: any, index: number) => (
            <ContentCard item={item} index={index} />
          ))}
        </CardGrid>
      </section>
    )
  }

  {
    isEmpty && (
      /* Same wording and same way out as the Feed: "Clear Filters" returns
         to the unfiltered section. */
      <EmptyState
        message={emptyMessage}
        actionLabel={activeCategory ? LABELS.clearFilters : undefined}
        actionHref={activeCategory ? ARTICLE_SECTION.path : undefined}
      />
    )
  }

  {
    hasArchive && (
      /* mt-auto pushes pagination to the bottom when the page is short, so it
         never floats mid-screen above a large gap. */
      <div class="intel-pagination mt-auto w-full flex flex-col items-center gap-6">
        <GooglePreferredSourceDeeplink url="beunconventionalhq.com" variant="glow" theme="dark" label="Follow on Google Search" />
        <Pagination page={page} />
      </div>
    )
  }
</FeedLayout>

<style>
  /* Neutralize the global Magazine margin so the YouTube CTA can be perfectly mathematically centered */
  .feed-page :global(.intel-magazine) {
    margin-bottom: 0 !important;
  }
</style>

<style>
  /* 
    ========================================================================
    YOUTUBE BANNER (SLIM & PERFECTLY CENTERED)
    ========================================================================
  */
  
  .yt-banner-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 4rem 0; /* Fully flushed with the container edges */
  }

  .yt-subscribe-banner {
    display: grid;
    grid-template-columns: 105px 1fr 44px; /* Strict 3-column lock: Logo, Text, Icon */
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0; /* Squared edges as requested */
    padding: 2.5rem 3rem; /* Taller without expanding wrapper */
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .yt-banner-logo {
    height: 48px; /* Greatly increased legibility */
    width: auto;
    max-width: 105px; /* Matches the new wide column */
    justify-self: start;
    object-fit: contain;
    object-position: left center;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .yt-banner-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap; /* GUARANTEES NO WRAPPING */
    text-align: left; /* Locks text position perfectly */
    transition: all 0.3s ease;
    position: relative;
    justify-self: start;
  }

  /* Red underline hover effect matching standard interactive states */
  .yt-banner-text::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.3s ease;
  }

  .yt-banner-icon {
    width: 44px; /* Scaled up YouTube logo */
    height: 44px;
    color: var(--color-accent-text); /* Passes WCAG AA contrast */
    fill: currentColor;
    transition: transform 0.3s ease;
    justify-self: end;
  }

  /* HOVER STATES: Red border, box shadow glow, red text */
  .yt-subscribe-banner:hover {
    border-color: var(--color-accent);
    background: #0a0a0a;
    box-shadow: 0 0 24px rgba(204, 0, 0, 0.25);
  }

  .yt-subscribe-banner:hover .yt-banner-logo {
    opacity: 1;
  }

  .yt-subscribe-banner:hover .yt-banner-text {
    color: var(--color-accent-text, #ff3333);
    text-shadow: 0 0 12px rgba(204, 0, 0, 0.4);
  }
  
  .yt-subscribe-banner:hover .yt-banner-text::after {
    width: 100%;
  }

  .yt-subscribe-banner:hover .yt-banner-icon {
    transform: scale(1.1);
  }

  /* MOBILE OPTIMIZATION (PORTRAIT & LANDSCAPE FIX) */
  /* MOBILE OPTIMIZATION (PORTRAIT FIX - FORCED INLINE) */
  /* MOBILE OPTIMIZATION (PORTRAIT FIX - FORCED INLINE) */
  @media (max-width: 768px) {
    .yt-banner-wrapper {
      padding: 4rem 0;
      margin: 0 -0.5rem; /* Extends the width of the box slightly on mobile */
      width: calc(100% + 1rem);
    }
    
    .yt-subscribe-banner {
      grid-template-columns: 78px 1fr 24px; /* Strict mobile column lock */
      padding: 1.75rem 1.5rem; /* Better side padding since we aren't centering */
      gap: 1rem;
    }
    
    .yt-banner-logo {
      height: 36px;
      max-width: 78px;
    }
    
    .yt-banner-text {
      font-size: 0.85rem; /* Perfectly tuned to fit one line */
      letter-spacing: 0.05em;
    }
    
    .yt-banner-icon {
      width: 24px;
      height: 24px;
    }
  }

  /* Ultra-small screens (e.g. iPhone SE / old devices) */
  @media (max-width: 380px) {
    .yt-subscribe-banner {
      grid-template-columns: 61px 1fr 20px;
      padding: 1.5rem 1rem;
      gap: 0.5rem;
    }
    .yt-banner-text {
      font-size: 0.75rem;
    }
    .yt-banner-icon {
      width: 20px;
      height: 20px;
    }
    .yt-banner-logo {
      height: 28px;
      max-width: 61px;
    }
  }

  /* BANNER ROTATOR GRID (Continuous One-Directional 3D Flip) */
  .banner-rotator-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    width: 100%;
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .banner-slide {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.8s ease;
    backface-visibility: hidden;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  /* Active: Visible and forward-facing */
  .banner-slide[data-state="active"] {
    transform: rotateX(0deg);
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  /* Hidden Next: Flips DOWN and AWAY (into the floor) */
  .banner-slide[data-state="hidden-next"] {
    transform: rotateX(-90deg);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Hidden Prev: Waits at the TOP (in the ceiling), ready to flip down */
  .banner-slide[data-state="hidden-prev"] {
    transform: rotateX(90deg);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* BOTTOM EDGE PROGRESS INDICATOR */
  .banner-progress-bar {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    align-self: end;
    width: 100%;
    height: 2px;
    background: var(--color-accent, #ff3333);
    pointer-events: none;
    z-index: 10;
    transform-origin: left;
    transform: scaleX(0);
    opacity: 0;
    animation: progressFill 8s linear forwards;
  }

  .yt-banner-wrapper:hover .banner-progress-bar,
  .yt-banner-wrapper:focus-within .banner-progress-bar {
    animation-play-state: paused;
  }

  @keyframes progressFill {
    0% { transform: scaleX(0); opacity: 0; }
    5% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
  }

  /* METADATA DISCLOSURE ROW */
  .banner-metadata-row {
    display: flex;
    justify-content: flex-start; /* Align left */
    padding-left: 3rem; /* Match the banner's internal padding */
    margin-top: 1rem;
    pointer-events: none; /* purely decorative/disclosure */
  }
  .banner-meta-text {
    font-family: var(--font-display);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--color-white-muted);
    text-transform: uppercase;
    opacity: 0.35;
    transition: opacity 0.3s ease;
  }
  .yt-banner-wrapper:hover .banner-meta-text {
    opacity: 0.55;
  }

  /* AD MODIFIERS (Adapting the YouTube banner perfectly for dynamic items) */
  .yt-banner-logo--square {
    object-fit: contain;
    border-radius: 4px;
    background: transparent;
    padding: 0;
  }
  .yt-banner-logo--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border-radius: 4px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-white);
    width: 48px;
    height: 48px;
  }
  .yt-banner-logo--fallback svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .yt-banner-cta--ad {
    min-width: 0; /* Allows children to truncate if they get too long */
    max-width: calc(100vw - 8rem); /* Force truncation before hitting screen edge on mobile */
    /* Remove flex: 1 to preserve exact justify-content: center behavior */
  }
  .yt-banner-text--ad {
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    max-width: 100%;
  }
  .yt-banner-icon--ad {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    font-size: 1.5rem;
    width: 24px;
    height: auto;
    flex-shrink: 0;
    color: var(--color-white);
    transition: color 0.3s ease, transform 0.3s ease;
  }
  
  .yt-subscribe-banner:hover .yt-banner-icon--ad {
    color: var(--color-accent-text);
  }

  @media (max-width: 768px) {
    .banner-metadata-row {
      justify-content: center;
      padding-left: 0;
    }
    .yt-banner-logo--fallback {
      width: 36px;
      height: 36px;
    }
    .yt-banner-cta--ad {
      gap: 0.5rem;
    }
    .yt-banner-icon--ad {
      font-size: 1.1rem;
    }
  }

  /* Ultra-small screens */
  @media (max-width: 380px) {
    .yt-banner-logo--fallback {
      width: 28px;
      height: 28px;
    }
    .yt-banner-icon--ad {
      font-size: 0.95rem;
    }
  }
</style>
