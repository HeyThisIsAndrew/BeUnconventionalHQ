---
/**
 * Shared shell for every feed surface (`/feed`, `/feed/videos`,
 * `/feed/articles`, `/feed/[category]`).
 *
 * These four routes were near-identical copies of one another — same page
 * chrome, same heading, same filter bar, same `.feed-page` / `.container`
 * style block — differing only in their title, description and which loader
 * fed the grid. Adding a fifth article surface would have forked it again, so
 * the chrome lives here once and the routes supply only what actually varies.
 *
 * The grid itself stays in the caller via <slot />, because `/feed/[category]`
 * renders a plain grid while the others render the client-filtered <FeedGrid />.
 */
import Layout from './Layout.astro';
import PageTitle from '../components/PageTitle.astro';
import QuadrantFilter from '../components/QuadrantFilter.astro';

interface Props {
  title: string;
  description: string;
  /** sr-only <h2> so card <h3>s don't skip a level (axe: heading-order). */
  headingLabel: string;
  page: { url: { prev?: string; next?: string } };
  /** QuadrantFilter's nav mode — on for the top-level feeds, off for category pages. */
  isNavMode?: boolean;
  /** Extra utility classes for <main>, e.g. the category page's bottom padding. */
  mainClass?: string;
}

const {
  title,
  description,
  headingLabel,
  page,
  isNavMode = false,
  mainClass = '',
} = Astro.props;
---

<Layout title={title} description={description} prevUrl={page.url.prev} nextUrl={page.url.next}>
  <main class:list={['feed-page', 'flex-1', 'flex', 'flex-col', 'w-full', mainClass]}>
    <div class="container-page flex-1 flex flex-col">
      <header class="section-header animate-on-scroll" data-nav-anchor>
        <PageTitle as="h1" kicker="Explore The HQ" primary="The" secondary="Feed" />
      </header>

      <QuadrantFilter showTypes={true} isNavMode={isNavMode} />

      <h2 class="sr-only">{headingLabel}</h2>

      <slot />
    </div>
  </main>
</Layout>

<style>
  .feed-page {
    padding: 120px 0 2rem;
  }

  @media (max-width: 768px) {
    .feed-page {
      padding: 80px 0 2rem;
    }
  }
</style>
