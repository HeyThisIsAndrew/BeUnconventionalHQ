---
// Self-hosted fonts (was Google Fonts). Same-origin, no render-blocking
// external request, no third-party exposure of visitor IPs.
// @ts-ignore
import '@fontsource-variable/syne';
// @ts-ignore
import '@fontsource-variable/inter';
import '../styles/global-base.css';
import '../styles/global.css';
import '../styles/theme-red.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import BrandGlow from '../components/BrandGlow.astro';
import ContactModal from '../components/ContactModal.astro';
import { site } from '../data/site.js';
import { ClientRouter } from 'astro:transitions';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import logoImage from '../assets/logo.webp';

const {
  title = site.name,
  description = site.description,
  image = site.image,
  type = 'website',
  // Opt-in gate for work-in-progress or draft routes. When true, we emit a
  // robots meta directive that tells search engines not to index the page or
  // follow its links. Keep the default false so existing production pages are
  // unaffected.
  noindex = false,
  prevUrl,
  nextUrl,
  preloadImage,
} = Astro.props;

// Self-referential canonical URL: absolute, no trailing slash (except root)
// to match Cloudflare's asset html_handling: "drop-trailing-slash"
// (wrangler.jsonc) — every internal link already points to the no-slash
// form, and drop-trailing-slash serves that directly while redirecting
// the slashed form away, so the canonical tag has to agree or it points
// at a URL that immediately redirects elsewhere. og:url reuses the same
// value so search engines never see a page advertise two different
// addresses for itself.
const canonicalPath =
  Astro.url.pathname === '/' || !Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname
    : Astro.url.pathname.slice(0, -1);
const url = Astro.props.url ?? new URL(canonicalPath, site.url).toString();

// Sitewide structured data: tells search engines who this brand is and
// which social accounts are officially ours. Per-page Article/VideoObject
// schema is layered on separately. SearchAction is intentionally omitted
// until on-site search exists.
const orgId = `${site.url}#organization`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.name,
      url: site.url,
      logo: new URL(logoImage.src, site.url).toString(),
      description: site.description,
      sameAs: [
        site.socials.youtube,
        site.socials.instagram,
        site.socials.tiktok,
        site.socials.threads,
        site.socials.facebook,
        site.socials.twitter,
        site.socials.letterboxd,
        site.socials.substack,
      ].filter(Boolean),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}#website`,
      name: site.name,
      url: site.url,
      description: site.description,
      publisher: { '@id': orgId },
    },
  ],
};

const disableAnalytics = import.meta.env.PUBLIC_DISABLE_ANALYTICS === 'true';
const gtmId = disableAnalytics ? undefined : import.meta.env.PUBLIC_GTM_ID;
---

<html lang="en">
  <head>
    {/* Must be the FIRST thing in <head>. The spec requires the encoding
        declaration inside the first 1024 bytes, and Lighthouse fails the page
        otherwise. It used to sit below the GTM and view-transition blocks,
        which put it at byte 1536: ClientRouter alone emits two meta tags plus
        a module script before anything else got a chance to render. */}
    <meta charset="utf-8" />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <!-- Google Tag Manager (Worker) -->
    {gtmId && (
      <>
        <script is:inline type="text/partytown" is:inline>
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            'gtm.start': new Date().getTime(),
            event: 'gtm.js',
          });
        </script>
        <script is:inline type="text/partytown" src={`https://www.googletagmanager.com/gtm.js?id=${gtmId}`} />
      </>
    )}

    <!-- Google Tag Manager (Main Thread Navigation) -->
    {gtmId && (
      <script is:inline>
        if (typeof window !== 'undefined') {
          if (!window['setup']) {
            window['setup'] = true;
            // ClientRouter swaps pages without full reloads, so this script only
            // runs once per session. astro:page-load fires on the initial load
            // AND after every client-side navigation — the GA4 tag in the GTM
            // dashboard triggers on this event (not "All Pages") to avoid
            // double-counting the first view.
            document.addEventListener('astro:page-load', function () {
              const pushGA = () => {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                  event: 'page_view',
                  page_location: window.location.href,
                  page_path: window.location.pathname,
                  page_title: document.title,
                });
              };
              if ('requestIdleCallback' in window) {
                requestIdleCallback(pushGA);
              } else {
                setTimeout(pushGA, 200);
              }
            });
          }
        }
      </script>
    )}

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="canonical" href={url} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {/* Per-page <head> additions, e.g. an article's Article JSON-LD. Renders
        nothing when unused, so existing pages are unaffected. */}
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`/favicon.ico`} />
    {/*
      Home-screen / web app tile art (issue #66).

      Cut from src/assets/logo-mark.webp — the PRE-CROPPED mark — not logo.webp.
      logo.webp is a 2000x2000 square whose artwork fills only ~42% of the
      height, so scaling it into a 180px tile spent most of those pixels on
      transparent padding and rendered the wordmark tiny and soft. Same
      reasoning as ArticleThumb.astro.

      Flattened onto black rather than left transparent: iOS composites an
      unknown background behind a transparent icon, which on a light wallpaper
      put a black wordmark on near-white. 180x180 is the size iOS requests;
      it downsamples cleanly for the smaller slots.
    */}
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="msapplication-TileImage" content={`/apple-touch-icon.png`} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    {/* Site-wide brand signature. Decorative, fixed, behind all content —
        see src/components/BrandGlow.astro for the performance reasoning. */}
    <BrandGlow />

    <a href="#page-content" class="skip-link">Skip to main content</a>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <div class="safe-area-blackout"></div>
    <!-- Navbar and Footer are siblings of #page-content, so inert-ing only
         #page-content would still let Tab reach them. Wrap all three in
         #app-wrapper and inert THAT while a modal is open — the modals live
         outside the wrapper, so they stay reachable. -->
    <div id="app-wrapper" class="min-h-[100svh] flex flex-col">
      <Navbar />
      <div id="page-content" class="flex-1 flex flex-col">
        <slot />
      </div>
      <Footer />
    </div>
    {/*
      ─── TURNSTILE LOADS ONCE, HERE ────────────────────────────────────────
      It used to be requested by each form that needed it — ContactModal and
      SubscribeBox as plain `api.js`, NewsletterForm as `api.js?render=explicit`
      — so any page carrying both (/, /events, /featured) fetched the API twice
      from two different URLs.

      That is not just a duplicate request. `render=explicit` is a GLOBAL
      switch: when the API is loaded that way it stops scanning the DOM for
      implicit `.cf-turnstile` widgets. ContactModal and SubscribeBox both rely
      on that scan, so whichever tag happened to win the race decided whether
      the contact form got a widget at all — and with no widget its submit
      button stays disabled and the form cannot be sent.

      One plain (implicit) load removes the race. `window.turnstile.render()`
      is still exposed in implicit mode, so NewsletterForm's explicit render
      keeps working, and its holder is `#newsletter-turnstile` rather than
      `.cf-turnstile`, so the implicit scan will not double-render it.

      KNOWN, NOT FIXED HERE: the implicit scan only runs once, when the script
      loads. With ClientRouter, a client-side navigation replaces those forms
      with fresh unrendered elements, so ContactModal's and SubscribeBox's
      widgets do not come back until a full reload. NewsletterForm already
      solves this by rendering explicitly on `astro:page-load`; the other two
      want the same treatment, which is a change to live bot-check flow that
      should be verified against real Turnstile rather than assumed.
    */}
    {PUBLIC_TURNSTILE_SITE_KEY && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    <ContactModal />
    <slot name="modals" />

    <!-- Unified Video Modal -->
    <div
      id="video-modal"
      class="modal-overlay"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Video Player"
    >
      <div class="modal-content">
        <button class="modal-close" aria-label="Close modal">&times;</button>
        <div class="video-container">
          <iframe
            id="modal-iframe"
            src=""
            
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="YouTube video player"></iframe>
        </div>
      </div>
    </div>

    {/*
      NOT `is:inline` any more.

      This block needs `import`, and an inline script is copied verbatim into
      the HTML without going through the bundler, so imports are unavailable
      there. As a bundled module it can pull in the shared scroll-lock utility
      instead of carrying its own (broken) copy — see src/lib/scroll-lock.ts.

      Nothing here depends on running before paint: every listener below is
      delegated from `document`, so a deferred module attaches them long
      before any click can happen.
    */}
    <script>
      import { lockScroll, unlockScroll } from '../lib/scroll-lock';

      /* The listeners below are attached to `document` once and must never be
         attached twice, so the "already bound" flags live on `window` rather
         than in module scope — module scope would reset if this script were
         ever re-evaluated, window will not. Declared here because a bundled
         script is type-checked, unlike the inline one this replaced. */
      declare global {
        interface Window {
          videoModalSetup?: boolean;
          videoModalEscSetup?: boolean;
          videoModalNavSetup?: boolean;
        }
      }

      (function () {
        // Remembers what had focus before the modal opened, to restore it on
        // close instead of dropping keyboard users at the top of the page.
        let lastFocused: HTMLElement | null = null;

        function openModal(videoId: string) {
          const modal = document.getElementById('video-modal');
          const modalIframe = document.getElementById(
            'modal-iframe'
          ) as HTMLIFrameElement | null;

          if (videoId && modal && modalIframe) {
            // Save focus + trap it: inert the whole app wrapper (navbar,
            // content, footer), not just #page-content.
            lastFocused = document.activeElement as HTMLElement | null;

            /*
              Hold the page still. This replaces a hand-rolled lock that set
              `body.style.top` but left the scrollbar gutter uncompensated, so
              opening the modal shifted every desktop page sideways by the
              width of the scrollbar. The utility measures and pads that gap.
            */
            lockScroll();

            // ACTION 2.1 & 2.2: No autoplay, use rel=0 and modestbranding=1
            modalIframe.src = `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1&enablejsapi=1`;
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
            document.getElementById('app-wrapper')?.setAttribute('inert', '');

            const closeBtn = modal.querySelector<HTMLElement>('.modal-close');
            if (closeBtn) setTimeout(() => closeBtn.focus(), 100);
          }
        }

        function closeModal() {
          const modal = document.getElementById('video-modal');
          const modalIframe = document.getElementById(
            'modal-iframe'
          ) as HTMLIFrameElement | null;

          if (modal && modalIframe) {
            /*
              Guard on THIS modal's own state, not on the global `modal-open`
              class. That class is set by whichever overlay is open — keying
              off it meant closing the video modal could release a lock the
              mobile menu or contact modal had taken.
            */
            if (!modal.classList.contains('active')) return;

            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            document.getElementById('app-wrapper')?.removeAttribute('inert');
            // 'about:blank', NOT '' — an empty src resolves to the current
            // page URL, silently reloading the whole site inside the hidden
            // iframe on every close.
            modalIframe.src = 'about:blank';

            /*
              ─── THIS IS THE LAYOUT-SHIFT FIX ───────────────────────────────
              What was here before unpinned the body, then restored the scroll
              position inside a DOUBLE requestAnimationFrame. Those are two
              different frames: for ~32ms the body was already unpinned and
              back at offset 0, and the browser painted it there. That painted
              intermediate state IS the jump — the page visibly snapped to a
              different position and then slid back.

              unlockScroll() does both halves synchronously, in one frame, so
              there is never a paint at the wrong offset.
            */
            unlockScroll();

            /*
              `preventScroll: true` matters as much as the line above. Calling
              focus() on the card that opened the modal makes the browser
              scroll that element into view — which fought the restore and is
              why the landing position depended on WHICH video you had tapped,
              i.e. why the jump looked inconsistent rather than constant.
            */
            if (lastFocused && typeof lastFocused.focus === 'function') {
              lastFocused.focus({ preventScroll: true });
            }
            lastFocused = null;
          }
        }

        console.log("LAYOUT SCRIPT EXECUTED!");
        // Global Event Delegation for Video Triggers
        if (!window.videoModalSetup) {
          console.log("Attaching global click listener for video modal");
          document.addEventListener('click', (e) => {
          if (!(e.target instanceof Element)) return;
          const trigger = e.target.closest('[data-action="open-video"]');
          
          if (trigger) {
            e.preventDefault();
              const videoId = trigger.getAttribute('data-video-id');
              console.log('TRIGGER CLICKED! Video ID:', videoId);
              if (videoId) openModal(videoId);
            }

            const currentModal = document.getElementById('video-modal');
            if (e.target === currentModal || e.target.closest('.modal-close')) {
              closeModal();
            }
          });
          window.videoModalSetup = true;
        }

        if (!window.videoModalEscSetup) {
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();

            if (e.key === 'Enter' || e.key === ' ') {
              if (!(e.target instanceof Element)) return;
              const trigger = e.target.closest('[data-action="open-video"]');
              if (trigger) {
                e.preventDefault();
                const videoId = trigger.getAttribute('data-video-id');
                if (videoId) openModal(videoId);
              }
            }
          });
          window.videoModalEscSetup = true;
        }

        if (!window.videoModalNavSetup) {
          document.addEventListener('astro:before-preparation', closeModal);
          window.videoModalNavSetup = true;
        }
      })();
    </script>
    <script>
      let isInitialLoad = true;

      function initReveal() {
        const els = document.querySelectorAll('.reveal, .animate-on-scroll');
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((elem) => {
            const el = elem as HTMLElement;
            el.setAttribute('data-state', 'in');
            el.setAttribute('data-state', 'active');
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const delay = el.dataset.delay || '0';
              el.style.transitionDelay = `${delay}ms`;
              el.setAttribute('data-state', 'in');
              el.setAttribute('data-state', 'active');
              el.style.opacity = '1';
              el.style.transform = 'none';
              obs.unobserve(el);
              
              // Clear the delay after the animation completes so hover effects aren't permanently delayed
              setTimeout(() => {
                if (el) el.style.transitionDelay = '';
              }, parseInt(delay) + 600);
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      // Reveal everything with no transition. `.animate-on-scroll` starts at
      // `opacity: 0; filter: blur(4px)` the instant new markup exists, so on a
      // client-side navigation this MUST run before the browser paints the
      // swapped-in page — otherwise the page paints once with the content
      // invisible and then snaps it visible, which reads as a pop-in (most
      // obvious on a large above-the-fold element like the About logo).
      function revealImmediately() {
        document.querySelectorAll('.reveal, .animate-on-scroll').forEach((elem) => {
          const el = elem as HTMLElement;
          const originalTransition = el.style.transition;
          el.style.transition = 'none';
          el.setAttribute('data-state', 'in');
          el.setAttribute('data-state', 'active');
          el.style.opacity = '1';
          el.style.transform = 'none';

          // Restore transition for hover effects after rendering
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              el.style.transition = originalTransition;
            });
          });
        });
      }

      // astro:after-swap fires after the new document replaces the old one but
      // BEFORE it is painted — the only hook that can suppress the flash.
      // astro:page-load is too late by one paint, which is what caused the
      // pop-in. Keep the page-load call as an idempotent safety net for any
      // path that reaches it without an after-swap.
      document.addEventListener('astro:after-swap', revealImmediately);

      function handlePageLoad() {
        if (isInitialLoad) {
          // A cold load has no swap: the markup is parsed with opacity 0
          // already applied, so the IntersectionObserver fade-in is the
          // intended entrance rather than a flash.
          initReveal();
          isInitialLoad = false;
        } else {
          revealImmediately();
        }
      }

      document.addEventListener('astro:page-load', handlePageLoad);
    </script>
    <script>
      /*
        BROKEN-IMAGE FAIL-SAFE

        Marks the container of any image that fails to load, so CSS can put a
        branded panel there instead of leaving an empty box in the grid (see
        `[data-img-failed]` in styles/modules/home-cards.css).

        Registered ONCE on `document` in the CAPTURE phase, which is the only
        way to catch this: `error` events from <img> do not bubble, so a normal
        delegated listener on document never sees them. Capture also means it
        covers images added later by the Feed's client-side filtering, without
        re-binding on every render.
      */
      function markFailed(img: HTMLImageElement) {
        /* An image with no src is not a load failure — components render a
           branded fallback instead of an <img> when they have no cover, so
           there is nothing to rescue here. */
        if (!img.currentSrc && !img.getAttribute('src')) return;
        /*
          The MEDIA CONTAINER is the target, not literally the parent node. An
          <img> inside a <picture> (art-directed sources, e.g. EventCard's
          logo-on-mobile swap) has the <picture> as its parent, and marking
          that leaves the styled container — `.content-card-media` and friends
          — unmarked, so the branded panel never paints and the broken image
          stays visible. <picture> is a grouping element with no box of its
          own; step through it to the element that actually has one.
        */
        const parent = img.parentElement;
        const container = parent?.tagName === 'PICTURE' ? parent.parentElement : parent;
        container?.setAttribute('data-img-failed', 'true');
      }

      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) markFailed(target);
        },
        true
      );

      /*
        Catch-up sweep.

        This is a bundled module and therefore DEFERRED, so images that were
        already requested during parsing can finish — and fail — before the
        listener above exists. Those errors are gone by the time we register,
        which is why a sweep is needed and not just the listener.

        `complete && naturalWidth === 0` is the standard test for "finished,
        with nothing decoded", i.e. broken. Re-run on `astro:page-load` so it
        also covers pages arriving via client-side navigation.
      */
      function sweepBrokenImages() {
        document.querySelectorAll('img').forEach((img) => {
          if (img.complete && img.naturalWidth === 0) markFailed(img);
        });
      }

      sweepBrokenImages();
      document.addEventListener('astro:page-load', sweepBrokenImages);
    </script>
    <script>
      import { releaseScrollLock } from '../lib/scroll-lock';

      // Step 1: Strip mobile scroll locks BEFORE Astro takes its snapshot
      document.addEventListener('astro:before-preparation', () => {
        /*
          One call replaces the hand-rolled teardown that used to live here
          (clear four inline styles, re-parse `body.style.top` to recover the
          offset, scrollTo). It also resets the lock COUNTER — without that, a
          navigation performed while an overlay was open left the count above
          zero, and the next page could never be unlocked because every
          unlockScroll() decremented to a still-positive number.

          It deliberately does NOT restore the scroll position: the page is
          being replaced, so the old offset is meaningless, and Step 2 below
          scrolls to top for the incoming page.
        */
        releaseScrollLock();

        const body = document.body;
        if (body.style.overflow === 'hidden') {
          body.style.overflow = '';
        }
        // Never cache an OPEN modal: with the scroll lock already cleared above,
        // a cached-open modal causes a big scroll jump when closed after Back.
        // Release the focus trap and close/reset both modals.
        document.getElementById('app-wrapper')?.removeAttribute('inert');
        const videoModal = document.getElementById('video-modal');
        if (videoModal) {
          videoModal.classList.remove('active');
          videoModal.setAttribute('aria-hidden', 'true');
          const iframe = videoModal.querySelector('#modal-iframe') as HTMLIFrameElement | null;
          if (iframe) iframe.src = 'about:blank';
        }
        const successContainer = document.getElementById('success-message');
        if (successContainer && !successContainer.classList.contains('hidden')) {
          successContainer.classList.add('hidden');
          const iframe = document.getElementById('hidden_iframe') as HTMLIFrameElement | null;
          if (iframe) iframe.src = 'about:blank';
        }
        const contactModal = document.getElementById('contact-modal');
        if (contactModal) {
          const formContainer = document.getElementById('form-container');
          if (formContainer && !formContainer.classList.contains('hidden')) {
            formContainer.classList.add('hidden');
            const form = document.getElementById('contact-modal-form') as HTMLFormElement | null;
            form?.reset();
          }
          document
            .getElementById('modal-form-status')
            ?.classList.remove('is-visible');
        }
        const calendarModal = document.getElementById('spanning-calendar-modal');
        if (calendarModal) {
          calendarModal.classList.remove('is-active');
          calendarModal.setAttribute('aria-hidden', 'true');
        }
        const modal = document.querySelector('#category-modal') as HTMLDialogElement | null;
        modal?.close();
      });

      // Step 2: Force scroll to top instantly BEFORE the DOM swaps
      document.addEventListener('astro:before-swap', () => {
        window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
      });

      /*
        GTM SPA pageview tracking does NOT live here — deliberately.

        This exact `dataLayer.push({ event: 'page_view', ... })` used to be
        duplicated here AND in the <head> script above (search this file for
        "GA4 tag in the GTM dashboard triggers on this event"). Two separate
        `astro:page-load` listeners means every page view pushed 'page_view'
        TWICE, so every tag keyed off it — GA4, Clarity, Meta, TikTok — fired
        twice per view. That is the exact "multiple events on page load" bug
        reported via Meta Pixel Helper on /feed; it was not page-specific, it
        was firing twice on every page, just not necessarily noticed elsewhere.

        There must be exactly ONE source of this event, so this copy was
        deleted. See the <head> script for the one that remains — it is also
        deliberately deferred with requestIdleCallback so it does not compete
        with initial render, which this duplicate was not doing either.
      */
    </script>
  </body>
</html>
