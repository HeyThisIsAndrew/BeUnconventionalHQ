---
import { SECTIONS } from '../data/content.js';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Categories from '../components/Categories.astro';
import LatestArticles from '../components/LatestArticles.astro';
import PromoBanner from '../components/PromoBanner.astro';
import TakeoverBillboard from '../components/TakeoverBillboard.astro';
import { getVideosUnified } from '../lib/videos-source';
import PageTitle from '../components/PageTitle.astro';
import ContentCard from '../components/ContentCard.astro';
import SubscribeCTA from '../components/SubscribeCTA.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import SectionHeader from '../components/SectionHeader.astro';

// Get the current path, stripping trailing slashes for safety
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = currentPath === '/';
---

<Layout title="Be Unconventional HQ" preloadImage="/banner.webp">
  <main>
  <Hero />

  {/* Route-based conditional rendering guardrail */}
  {isHomePage && <TakeoverBillboard />}

  {
    false && (
      <PromoBanner
        title="Final Space: The Ending"
        subtitle="Olan Rogers finally gets to finish the story that captured our hearts. See why this is the most important release of the year."
        videoId="CBUmFGi_NNI"
        image="https://i.ytimg.com/vi/CBUmFGi_NNI/maxresdefault.jpg"
      />
    )
  }

  <Section pt="4rem" pb="6rem" maxWidth="1536px">
    <SectionHeader>
      {/* Copy lives in src/data/content.js -> SECTIONS.recentVideos */}
      <PageTitle {...SECTIONS.recentVideos} />
    </SectionHeader>
    <Grid minColWidth="min(100%, 400px)" gap="2.5rem">
      {
        (await getVideosUnified())
          .slice(0, 3)
          .map((video, index) => (
            <ContentCard item={video} index={index} />
          ))
      }
    </Grid>
  </Section>

  <Section pb="8rem" maxWidth="1536px">
    <SectionHeader>
      <PageTitle {...SECTIONS.whatWeCover} />
    </SectionHeader>
    <Categories />
  </Section>

  <LatestArticles />

  <SubscribeCTA />
  </main>
</Layout>
