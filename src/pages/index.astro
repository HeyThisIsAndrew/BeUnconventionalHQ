---
import Layout from '../layouts/Layout.astro';
import TakeoverBillboard from '../components/TakeoverBillboard.astro';
import CommercialRotator from '../components/CommercialRotator.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import SubscribeCTA from '../components/SubscribeCTA.astro';
import ChalkFilter from '../components/home/ChalkFilter.astro';
import HeroAccordion from '../components/home/HeroAccordion.astro';
import IntelSpread from '../components/home/IntelSpread.astro';
import FeaturedWorld from '../components/home/FeaturedWorld.astro';
import WatchingRail from '../components/home/WatchingRail.astro';
import HomeSectionHeader from '../components/home/HomeSectionHeader.astro';
import { getHomepageFeed } from '../data/homepage-feed';
import { HERO_SIZES } from '../lib/homepage-feed';
import { getArticleFeedItems } from '../lib/articles';
import { getVideoItems } from '../lib/feed-items';
import { site } from '../data/site.js';
import '../styles/modules/home.css';

/*
  ─── THE HOMEPAGE (feat/homepage-v4) ──────────────────────────────────────

  Every headline, deck, date and image below comes from ONE module,
  src/data/homepage-feed.ts, which reads the real stores (articles.json,
  videos.json). Nothing on this page types copy of its own except section
  names.

  Order, and why:
    1. Hero accordion     Film, TV, Games, Events, Latest
       Live billboard     hidden unless /api/live-status.json says we are live
    2. Intel              the written side, as a magazine spread
    3. Featured           one curated story world
       Ad rotator         the channel CTA + partners, a deliberate break
                          between the editorial half and the video half
    4. The HQ Is Watching the channel's long-form videos
       Instagram          social proof, just before the ask
       Subscribe          the page's one conversion point

  ─── WHAT IS NOT HERE ANY MORE, AND WHY NOTHING WAS DELETED ───────────────
  The splash curtain is gone because its arming lives inside Hero.astro, and
  this page no longer mounts Hero. Hero.astro, HeroTrailer.astro (hard rule
  2), HomeSpotlightBar, FeaturedHighlights, Categories, LatestArticles and
  splash.css all stay on disk: other components and test suites still read
  them, and deleting them is what white-screened the previous attempt.
*/
const feed = await getHomepageFeed();
const heroImage = feed.hero[0]?.story;

/*
  The mini Intel magazine takes the newest articles the hero and Featured are
  NOT already showing, so no story appears twice on one screen. Four: one
  rail tile each side of the feature plus the feature's own tile, which is
  what keeps a MINIATURE of the spread from running 900px tall.
*/
const INTEL_MINI_SIZE = 4;
const onPage = new Set(
  [...feed.hero.map((p) => p.story), ...(feed.featured ? [feed.featured.lead, ...feed.featured.items] : [])].map((s) => s.url),
);
const intelArticles = getArticleFeedItems().filter((a) => !onPage.has(a.link)).slice(0, INTEL_MINI_SIZE);

/* The rail renders the FEED's own card (ContentCard), which takes the feed's
   video records rather than HomeStory, so the rail's picks are looked up by
   YouTube id, in the order the feed module chose them. */
const videoById = new Map((await getVideoItems()).map((v: any) => [v.youtubeId, v]));
const railVideos = feed.rail.map((s) => videoById.get(s.videoId)).filter(Boolean);

/* Featured hands its world's stories to FeaturedHighlights, the production
   featured box, which takes feed records too. Videos lead, so the box opens
   on something that plays, as production's does. */
const articleByLink = new Map(getArticleFeedItems().map((a) => [a.link, a]));
const worldStories = feed.featured ? [feed.featured.lead, ...feed.featured.items] : [];
const worldRecords = [
  ...worldStories.filter((s) => s.type === 'video').map((s) => videoById.get(s.videoId)),
  ...worldStories.filter((s) => s.type === 'article').map((s) => articleByLink.get(s.url)),
].filter(Boolean);
const preconnect = heroImage && /wsrv\.nl/.test(heroImage.imageSrcset || heroImage.image) ? ['https://wsrv.nl'] : [];
---

<Layout
  title={site.name}
  preloadImage={heroImage?.image || undefined}
  preloadImageSrcset={heroImage?.imageSrcset || undefined}
  preloadImageSizes={heroImage?.imageSrcset ? HERO_SIZES : undefined}
  preconnect={preconnect}
>
  <main class="home-v4">
    <h1 class="sr-only">{site.name}: {site.tagline}</h1>
    <ChalkFilter />

    <HeroAccordion panels={feed.hero} />

    <TakeoverBillboard />

    <IntelSpread articles={intelArticles} />

    <FeaturedWorld world={feed.featured} records={worldRecords} />

    <div class="home-slot home-container">
      <CommercialRotator />
    </div>

    <WatchingRail items={railVideos} />

    <div class="home-slot">
      <InstagramFeed>
        <HomeSectionHeader
          slot="header"
          icon="instagram"
          id="instagram-feed-heading"
          title="On Instagram"
          descriptor="Latest from the feed"
        />
      </InstagramFeed>
    </div>

    <div class="home-slot">
      <SubscribeCTA />
    </div>
  </main>
</Layout>
