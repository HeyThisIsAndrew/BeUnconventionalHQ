---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
import SocialsSection from '../components/SocialsSection.astro';
import { SOCIAL_ICONS } from '../data/icons.js';
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.webp';
import andrewHeadshot from '../assets/andrew-headshot.jpg';

const title = `About | ${site.name}`;
const description =
  'Be Unconventional HQ is an editorial publication where nerd culture gets cinematic. Covering Film, TV, Gaming, and Events with a focus on the craft behind the stories.';

const pillars = [
  {
    label: 'Production Quality',
    value: '4K',
    desc: 'Cinematic film-standard visuals',
  },
  {
    label: 'Filmmaker Perspective',
    value: 'Pro',
    desc: 'Expertise-driven industry analysis',
  },
  {
    label: 'Passionate Community',
    value: 'HQ',
    desc: 'Connecting nerd culture enthusiasts',
  },
  {
    label: 'Unfiltered Truth',
    value: '100%',
    desc: 'Honest reviews and deep dives',
  },
];

const founderSocials = [
  { name: 'Instagram', url: 'https://www.instagram.com/hey_thisisandrew/', icon: SOCIAL_ICONS.Instagram },
  { name: 'YouTube', url: 'https://www.youtube.com/@HeyThisIsAndrew', icon: SOCIAL_ICONS.YouTube },
  { name: 'TikTok', url: 'https://www.tiktok.com/@hey_thisisandrew', icon: SOCIAL_ICONS.TikTok },
  { name: 'Threads', url: 'https://www.threads.net/@hey_thisisandrew', icon: SOCIAL_ICONS.Threads },
  { name: 'Facebook', url: 'https://www.facebook.com/thisisandrew', icon: SOCIAL_ICONS.Facebook },
  { name: 'Amazon', url: 'https://www.amazon.com/shop/influencer-0931c541?ref=ac_inf_tb_vh', icon: SOCIAL_ICONS.Amazon },
];
---

<Layout title={title} description={description}>
  <main class="about-page">
    <section class="about-hero">
      <div class="about-image-container animate-on-scroll">
        <Image
          src={logoImage}
          alt="Be Unconventional HQ"
          class="about-profile-img"
          width={800}
          height={800}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="about-story animate-on-scroll" data-delay="200">
        <p class="section-kicker about-kicker">The Publication</p>
        <h1 class="about-title-main">WHERE NERD CULTURE GETS CINEMATIC</h1>
        <p class="about-title-sub">🎬 FILM • 📺 TV • 🎮 GAMING • 🎟️ EVENTS</p>
        <div class="about-text">
          <p>
            <strong>Be Unconventional HQ</strong> is an editorial publication for people who love the craft behind the stories. If we talk cinema, content should look like cinema.
          </p>
          <p>
            From breaking down the cinematography of a new film or show to exploring game design, covering live events, and diving into the filmmaking process, our goal is to slow down, appreciate the details, and have genuine conversations. No clickbait, no artificial outrage—just unfiltered truth and expertise-driven industry analysis.
          </p>
          <p>
            If you’re passionate about movies, TV, games, events, and storytelling, you’re in the right place. Be yourself. Be passionate. Be unconventional.
          </p>
        </div>
      </div>
    </section>

    <section class="masthead-section animate-on-scroll">
      <div class="masthead-container">
        <div class="masthead-image">
          <Image
            src={andrewHeadshot}
            alt="Andrew Baxter"
            class="founder-img"
            width={400}
            height={400}
          />
        </div>
        <div class="masthead-bio">
          <p class="section-kicker">Masthead</p>
          <h2 class="founder-name">Andrew Baxter</h2>
          <h3 class="founder-title">Founder & Editor</h3>
          <div class="founder-socials">
            {founderSocials.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="founder-social-link">
                <span set:html={social.icon} />
              </a>
            ))}
          </div>
          <div class="founder-text">
            <p>
              I am documenting the messy reality of building a brand. I’m pushing past perfectionism, learning new technical workflows (Sony Alpha, DaVinci Resolve, AI tools), and building my creative ecosystem in public. There is no hyper-polished fake expertise here. Just raw behind-the-scenes progress as I figure it out as I go.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-section">
      <div class="stats-grid">
        {
          pillars.map((pillar, index) => (
            <div
              class="stat-card animate-on-scroll"
              data-delay={100 + index * 100}
            >
              <span class="stat-value">{pillar.value}</span>
              <span class="stat-label">{pillar.label}</span>
              <p class="pillar-desc">{pillar.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="pb-8">
      <SocialsSection />
    </div>
  </main>
</Layout>

<style>
  .about-kicker {
    color: var(--color-accent-text);
    font-size: clamp(0.75rem, calc(0.375rem + 0.9vw), 1.1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .about-title-main {
    text-align: center;
    font-size: clamp(1.2rem, calc(0.75rem + 1.2vw), 2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-white);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    line-height: 1.2;
  }

  .about-title-sub {
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.35rem, calc(0.15rem + 0.65vw), 0.75rem);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    white-space: nowrap;
  }

  .pillar-desc {
    font-size: 0.8rem;
    color: var(--color-white-muted);
    margin-top: 0.5rem;
    line-height: 1.4;
  }

  .masthead-section {
    padding: 4rem 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .masthead-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    background: rgba(25, 25, 25, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem;
    border-radius: 12px;
  }

  @media (min-width: 768px) {
    .masthead-container {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .masthead-image {
    flex-shrink: 0;
  }

  .founder-img {
    width: 200px;
    height: 200px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 2px solid var(--color-accent);
  }

  .masthead-bio {
    flex-grow: 1;
  }

  .founder-name {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }

  .founder-title {
    font-size: 1rem;
    color: var(--color-accent-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .founder-socials {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .founder-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--color-white-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .founder-social-link:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }
  
  .founder-social-link :global(svg) {
    width: 100%;
    height: 100%;
  }

  .founder-text p {
    color: var(--color-white-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .about-title-main {
      font-size: clamp(1rem, calc(0.5rem + 2vw), 1.35rem);
      text-align: center;
    }
    .masthead-container {
      padding: 2rem 1rem;
      text-align: center;
    }
    .founder-socials {
      justify-content: center;
    }
  }
</style>
