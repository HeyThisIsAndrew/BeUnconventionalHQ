---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
import SocialsSection from '../components/SocialsSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageTitle from '../components/PageTitle.astro';
import { SOCIAL_ICONS } from '../data/icons.js';
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
/*
  The PRE-CROPPED mark (src/assets/logo-mark.webp), not logo.webp.

  logo.webp is a 2000x2000 square canvas whose artwork is only 1909x839, so
  the other 58% of its height is transparent padding. Because the <Image>
  width/height attributes set the reserved aspect ratio, `.about-image-container`
  was sizing a SQUARE box for artwork that fills 42% of it, and on a two-column
  hero that empty box is what set the section's height. logo-mark.webp is the
  same artwork on its real content box, so the box size IS the mark size.
  Same reasoning as the fallback mark in ArticleThumb.astro.
*/
import logoImage from '../assets/logo-mark.webp';
import andrewHeadshot from '../assets/andrew-headshot.webp';

const title = `About | ${site.name}`;
const description =
  'Be Unconventional HQ is an editorial publication where nerd culture gets cinematic. Covering Film, TV, Gaming, and Events with a focus on the craft behind the stories.';

const pillars = [
  {
    value: 'FILM \u00b7 TV \u00b7 GAMING',
    label: 'Coverage',
    desc: 'Reviews, analysis, and event reporting',
    backText: 'Film, television, and gaming, plus reporting from the events where that work gets shown.',
    longValue: true,
  },
  {
    value: '2026',
    label: 'Founded',
    desc: 'Independent, no publisher',
    backText: 'Founded in 2026 and run independently. No publisher, no network, and no editorial mandate from anyone else.',
  },
  {
    value: 'Weekly',
    label: 'Publishing Cadence',
    desc: 'New coverage every week',
    backText: 'New coverage every week, so what we publish keeps pace with what is actually releasing.',
  },
  {
    value: '4K',
    label: 'Production Standard',
    desc: 'Sony Alpha, DaVinci Resolve, Shure',
    backText: 'Shot on Sony Alpha bodies, recorded with Shure microphones, and graded in DaVinci Resolve. Finished in 4K.',
  },
];

const founderSocials = [
  { name: 'Instagram', url: 'https://www.instagram.com/hey_thisisandrew/', icon: SOCIAL_ICONS.Instagram },
  { name: 'YouTube', url: 'https://www.youtube.com/@HeyThisIsAndrew', icon: SOCIAL_ICONS.YouTube },
  { name: 'TikTok', url: 'https://www.tiktok.com/@hey_thisisandrew', icon: SOCIAL_ICONS.TikTok },
  { name: 'Threads', url: 'https://www.threads.net/@hey_thisisandrew', icon: SOCIAL_ICONS.Threads },
  { name: 'Facebook', url: 'https://www.facebook.com/thisisandrew', icon: SOCIAL_ICONS.Facebook },
  { name: 'Twitter', url: 'https://twitter.com/_ThisIsAndrew', icon: SOCIAL_ICONS.Twitter },
  { name: 'Bluesky', url: 'https://bsky.app/profile/thisisandrew.bsky.social', icon: SOCIAL_ICONS.Bluesky },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/andrewlwyrbaxter/', icon: SOCIAL_ICONS.LinkedIn },
  { name: 'Substack', url: 'https://thisiscoffeetalk.substack.com/', icon: SOCIAL_ICONS.Substack },
];

/* The mobile social row splits into two lines. Derived from the list rather
   than hardcoded so removing a platform cannot leave a dangling separator. */
const mobileSocialRows = [
  founderSocials.slice(0, Math.ceil(founderSocials.length / 2)),
  founderSocials.slice(Math.ceil(founderSocials.length / 2)),
];
---

<Layout title={title} description={description}>
  <main class="about-page">
    <section class="about-hero">
      <div class="about-image-container animate-on-scroll">
        <Image
          src={logoImage}
          alt="Be Unconventional HQ"
          class="about-profile-img"
          width={1000}
          height={460}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="about-story animate-on-scroll" data-delay="200">
        <p class="section-kicker about-kicker">The Publication</p>
        <h1 class="about-title-main">WHERE NERD CULTURE GETS CINEMATIC</h1>
        <p class="about-title-sub">FILM | TV | GAMING | EVENTS</p>
        <div class="about-text">
          <p>
            <strong>BE Unconventional HQ</strong> is an editorial publication for people who love the craft behind the stories. Our principle is simple: if we're talking cinema, then our content should look like cinema.
          </p>
          <p>
            From breaking down the cinematography of a new film or show to exploring game design, covering live events, and diving into the filmmaking process, our goal is to slow down, appreciate the details, and have genuine conversations.
          </p>
          <p>
            No clickbait, no artificial outrage, just unfiltered honesty and expertise-driven industry analysis.
          </p>
          <p>
            If you're passionate about Movies, TV, Gaming, and Events you're in the right place.
          </p>
          <p class="about-motto">
            BE YOURSELF. <br />
            BE PASSIONATE. <br />
            BE UNCONVENTIONAL.
          </p>
        </div>
      </div>
    </section>

    <section class="masthead-section animate-on-scroll">
      <SectionHeader class="about-section-header">
        <PageTitle
          kicker="MASTHEAD"
          primary="INSIDE THE"
          secondary="HQ"
          scale="secondary"
        />
      </SectionHeader>
      <div class="masthead-container">
        <div class="masthead-image">
          <div class="masthead-image-wrapper">
            <Image
              src={andrewHeadshot}
              alt="Andrew Baxter"
              class="founder-img"
              width={400}
              height={400}
            />
          </div>
        </div>
        <div class="masthead-bio">
          <h2 class="founder-name">Andrew Baxter</h2>
          <h3 class="founder-title">Founder & Editor</h3>
          <div class="founder-socials desktop-socials">
            {founderSocials.map((social, index) => (
              <>
                <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="founder-social-link">
                  <span class="social-icon-wrapper" set:html={social.icon} />
                </a>
                {index < founderSocials.length - 1 && <span class="social-separator">|</span>}
              </>
            ))}
          </div>

          <div class="mobile-socials">
            {mobileSocialRows.map((row) => (
              <div class="social-row">
                {row.map((social, index) => (
                  <>
                    <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="founder-social-link">
                      <span class="social-icon-wrapper" set:html={social.icon} />
                    </a>
                    {index < row.length - 1 && <span class="social-separator">|</span>}
                  </>
                ))}
              </div>
            ))}
          </div>
          <div class="founder-text">
            <p>
              He spent more than a decade in games and technology, including time at Sony Interactive Entertainment as a software engineer and in quality assurance. That background informs the coverage: not access, but a working knowledge of how these products are built, tested, and shipped, and what that means for the people who play and watch them. He founded BE Unconventional HQ in 2026 and edits its film, television, and gaming coverage.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-section">
      <div class="stats-grid">
        {
          pillars.map((pillar, index) => (
            <button
              class="stat-card flip-card animate-on-scroll"
              data-delay={100 + index * 100}
              aria-label={`More info about ${pillar.label}`}
            >
              <div class="flip-card-inner">
                <div class="flip-card-front">
                  <span class:list={['stat-value', pillar.longValue && 'stat-value-long']}>
                    {pillar.value}
                  </span>
                  <span class="stat-label">{pillar.label}</span>
                  <p class="pillar-desc">{pillar.desc}</p>
                </div>
                <div class="flip-card-back">
                  <p>{pillar.backText}</p>
                </div>
              </div>
            </button>
          ))
        }
      </div>
    </section>

    <SocialsSection />

    <section class="press-kit-section press-inquiries-section animate-on-scroll">
      {/* Deliberately NOT the stacked <PageTitle /> used by the masthead: that
          treatment overlaps its second line onto the first by design (it is
          drawn for a one-word tail like "HQ"), and "Editorial Inquiries" is
          unreadable in it. This uses the same kicker + `.press-kit-title` pair
          as the subscribe and event-booking panels. */}
      <p class="section-kicker">Media</p>
      <h2 class="press-kit-title">Press and Editorial Inquiries</h2>
      <p class="press-kit-desc press-inquiries-desc">
        Screeners, review copies, event credentials, and partnership requests all start in one place.
      </p>
      <Button href="/collaborations">Visit Collaborations</Button>
    </section>
  </main>

</Layout>

<style>
  .about-section-header {
    /* Was 5rem, stacking on top of `.about-hero`'s own 5rem bottom margin for
       ~10rem of dead run between the publication copy and the founder card.
       3rem here plus the hero's 5rem reads as one section break, not two. */
    margin-bottom: 3rem;
  }

  /* Match the kicker treatment "The Publication" uses in the hero: accent
     colour and the wider tracking, on top of the cinematic PageTitle stack. */
  .about-section-header :global(.page-title-kicker) {
    color: var(--color-accent-text);
    letter-spacing: 0.3em;
  }

  .about-kicker {
    color: var(--color-accent-text);
    font-size: clamp(0.75rem, calc(0.375rem + 0.9vw), 1.1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .about-story h1.about-title-main {
    text-align: center;
    text-wrap: balance;
    font-size: clamp(1.2rem, calc(0.75rem + 1.2vw), 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    line-height: 1.2;
    white-space: nowrap;
    margin-bottom: 1rem;
  }

  .about-title-sub {
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.6rem, calc(0.4rem + 1vw), 1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    white-space: nowrap;
  }

  .about-motto {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.6rem, calc(0.4rem + 1vw), 1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    margin-top: 2.5rem;
    /* Do not force nowrap so it can wrap on mobile gracefully */
  }

  @media (min-width: 769px) {
    .about-motto br {
      display: none;
    }
  }

  /* "FILM · TV · GAMING" cannot ride the numeric `.stat-value` scale without
     overflowing the card, so long values get their own step down. */
  .stat-value-long {
    font-size: clamp(1rem, calc(0.7rem + 0.9vw), 1.25rem);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .pillar-desc {
    font-size: 0.8rem;
    color: var(--color-white-muted);
    margin-top: 0.5rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .masthead-section {
    padding: 0 2rem;
    max-width: 1536px;
    margin: 0 auto 5rem auto;
  }

  .masthead-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    background: rgba(25, 25, 25, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem;
    border-radius: 0;
  }

  @media (min-width: 768px) {
    .masthead-container {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .masthead-image {
    flex-shrink: 0;
  }

  .masthead-image-wrapper {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    overflow: hidden;
  }

  .founder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .masthead-bio {
    flex-grow: 1;
  }

  .founder-name {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }

  .founder-title {
    font-size: 1rem;
    color: var(--color-accent-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .desktop-socials {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(0.15rem, 1vw, 1rem);
    margin-bottom: 1.5rem;
  }

  .mobile-socials {
    display: none;
  }

  .founder-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .founder-social-link:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }
  
  .social-icon-wrapper {
    display: inline-block;
    width: 24px;
    height: 24px;
  }

  .social-icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  .social-separator {
    color: var(--color-white-muted);
    opacity: 0.3;
    font-size: 0.9rem;
  }

  .founder-text p {
    color: var(--color-white-muted);
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  /* FLIP CARD STYLES */
  .flip-card {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    perspective: 1000px;
    width: 100%;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .flip-card:hover .flip-card-inner,
  .flip-card:focus .flip-card-inner,
  .flip-card:focus-within .flip-card-inner {
    transform: rotateY(180deg);
  }

  /* Reset global stat-card hover translateY since inner flips */
  .stat-card.flip-card:hover {
    transform: none;
    border-color: transparent;
    box-shadow: none;
  }

  .flip-card-front, .flip-card-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 0;
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .flip-card:hover .flip-card-front,
  .flip-card:hover .flip-card-back {
    border-color: var(--color-accent);
    box-shadow: 0 8px 30px rgba(204, 0, 0, 0.1);
  }

  /* The front needs position relative to dictate the total height of the container */
  .flip-card-front {
    position: relative; 
  }

  .flip-card-back {
    transform: rotateY(180deg);
    background: rgba(25, 25, 25, 0.95);
    text-align: center;
  }

  .flip-card-back p {
    color: var(--color-white);
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
    width: 100%;
    text-wrap: balance;
  }

  /* Rides the shared `.press-kit-section` panel (styles/modules/about.css) so
     this reads as the same class of section as the subscribe and event CTAs,
     rather than as a link stranded above the footer. Only the spacing differs:
     the shared rule's 6rem top margin is tuned for a panel that follows a card
     grid, and this one follows the socials grid. */
  .press-inquiries-section {
    margin: 0 auto 5rem;
  }

  .press-inquiries-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    text-wrap: balance;
    max-width: 46ch;
    margin: 0 auto 2.5rem;
  }

  @media (max-width: 768px) {
    .press-inquiries-section {
      padding: 3rem 1.5rem;
      margin-bottom: 4rem;
    }

    .press-inquiries-desc {
      font-size: 0.95rem;
    }

    .about-story h1.about-title-main {
      font-size: clamp(1.2rem, calc(0.5rem + 3vw), 1.6rem);
      text-align: center;
      white-space: normal;
    }
    .masthead-section {
      margin-bottom: 4rem;
    }
    .masthead-container {
      padding: 2rem;
      text-align: center;
    }
    .founder-text {
      text-align: left;
      text-wrap: pretty;
      max-width: 260px;
      margin: 0 auto;
    }
    .founder-text p {
      font-size: 0.95rem;
    }
    .flip-card-back p {
      font-size: 0.9rem;
    }
    .desktop-socials {
      display: none;
    }
    .mobile-socials {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      width: 100%;
      margin: 0 auto 2rem auto;
    }
    .social-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }
  }
</style>
