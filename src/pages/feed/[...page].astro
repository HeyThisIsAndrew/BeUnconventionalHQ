---
import FeedLayout from '../../layouts/FeedLayout.astro';
import { META, pageTitle } from '../../data/content.js';
import { getAllFeedItems } from '../../lib/feed-items';
import FeedGrid from '../../components/FeedGrid.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(await getAllFeedItems(), { pageSize: 12 });
}

const { page } = Astro.props;
const allItems = await getAllFeedItems();

const title = pageTitle(META.feed.title, page.currentPage);
const description = META.feed.description;
---

<FeedLayout
  title={title}
  description={description}
  headingLabel="All content"
  page={page}
  isNavMode={true}
>
  <FeedGrid page={page} allItems={allItems} />
</FeedLayout>
