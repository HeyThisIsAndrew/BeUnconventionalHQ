---
import FeedLayout from '../../../layouts/FeedLayout.astro';
import { site } from '../../../data/site.js';
import { getArticleItems } from '../../../lib/feed-items';
import FeedGrid from '../../../components/FeedGrid.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(getArticleItems(), { pageSize: 12 });
}

const { page } = Astro.props;
const allItems = getArticleItems();

const pageNum = page.currentPage > 1 ? ` - Page ${page.currentPage}` : '';
const title = `Articles${pageNum} | ${site.name}`;
const description = 'Discover the latest articles from Be Unconventional HQ.';
---

<FeedLayout
  title={title}
  description={description}
  headingLabel="All articles"
  page={page}
  isNavMode={true}
>
  <FeedGrid page={page} allItems={allItems} />
</FeedLayout>
