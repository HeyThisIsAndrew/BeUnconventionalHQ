---
import FeedLayout from '../../../layouts/FeedLayout.astro';
import { META, pageTitle } from '../../../data/content.js';
import { getVideoItems } from '../../../lib/feed-items';
import FeedGrid from '../../../components/FeedGrid.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(await getVideoItems(), { pageSize: 12 });
}

const { page } = Astro.props;
const allItems = await getVideoItems();

const title = pageTitle(META.feedVideos.title, page.currentPage);
const description = META.feedVideos.description;
---

<FeedLayout
  title={title}
  description={description}
  headingLabel="All videos"
  page={page}
  isNavMode={true}
>
  <FeedGrid page={page} allItems={allItems} />
</FeedLayout>
