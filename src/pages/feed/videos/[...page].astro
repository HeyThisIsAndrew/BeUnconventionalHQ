---
import FeedLayout from '../../../layouts/FeedLayout.astro';
import { site } from '../../../data/site.js';
import { getVideoItems } from '../../../lib/feed-items';
import FeedGrid from '../../../components/FeedGrid.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(await getVideoItems(), { pageSize: 12 });
}

const { page } = Astro.props;
const allItems = await getVideoItems();

const pageNum = page.currentPage > 1 ? ` - Page ${page.currentPage}` : '';
const title = `Videos${pageNum} | ${site.name}`;
const description = 'Discover the latest videos from Be Unconventional HQ.';
---

<FeedLayout
  title={title}
  description={description}
  headingLabel="All videos"
  page={page}
  isNavMode={true}
>
  <FeedGrid page={page} allItems={allItems} />
</FeedLayout>
