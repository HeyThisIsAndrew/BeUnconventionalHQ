---
/*
  The ethics policy. Same layout and styling as /privacy, on purpose (the
  owner's call, 2026-10-31): a plain policy page, not a section of the press
  kit, which is where /ethics used to forward.

  Every statement here restates something the site already says elsewhere:
  the five EDITORIAL STANDARDS lines in the press kit
  (src/pages/collaborations/press-kit.astro), the independence line on
  /about, and the affiliate disclosure (src/data/referrals.js). The one
  addition is the sponsored-content line, which US FTC guidance requires of
  any paid partnership. Change a standard there and here together.
*/
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
import { pageTitle } from '../data/content.js';

const title = pageTitle('Ethics Policy');
const description =
  'The editorial standards behind BE Unconventional HQ: independence, disclosure of provided materials, embargoes, corrections, and how to reach the editorial team.';
---

<Layout title={title} description={description}>
  <main class="policy-page container-page pt-24 pb-24">
    <div class="policy-header animate-on-scroll">
      <h1 class="policy-title">ETHICS POLICY</h1>
      <p class="policy-subtitle">Last updated: October 2026</p>
    </div>

    <div class="policy-content animate-on-scroll" data-delay="100">
      <p>
        {site.name} was founded in 2026 and is run independently, with no publisher, no network, and no editorial mandate from anyone else. These are the standards our coverage is held to.
      </p>

      <h2>Editorial Independence</h2>
      <p>
        Our coverage, including reviews and scores, reflects our own judgment. Studios, publishers, platforms, and partners do not approve or change what we publish.
      </p>

      <h2>Provided Materials</h2>
      <p>
        When a studio, publisher, or event gives us access to something, such as a screener, a review copy, or event credentials, we disclose it in the coverage.
      </p>

      <h2>Affiliate Links & Sponsorships</h2>
      <p>
        {site.name} is self-funded. Some links on the site are affiliate links, which may earn us a commission at no extra cost to you, and they are disclosed where they appear. Sponsored or paid partnership content is clearly identified as such. Neither affects our editorial coverage.
      </p>

      <h2>Advertising</h2>
      <p>
        Any advertising on the site is clearly separated from our editorial content. Advertisers have no say in what we cover or how we cover it. How advertising uses cookies is explained in our <a href="/privacy">Privacy Policy</a>.
      </p>

      <h2>Embargoes</h2>
      <p>
        We honor embargo terms agreed in writing and publish embargoed coverage only once the embargo lifts.
      </p>

      <h2>Corrections</h2>
      <p>
        When we get something wrong, we correct it on the record. Story tips, review material, and corrections all reach the same inbox, so if you spot an error, tell us at <a href="mailto:press@beunconventionalhq.com">press@beunconventionalhq.com</a>.
      </p>

      <h2>Contact</h2>
      <p>
        Press, publicists, and readers can reach the editorial team directly at <a href="mailto:press@beunconventionalhq.com">press@beunconventionalhq.com</a>.
      </p>
    </div>
  </main>
</Layout>

<style>
  /* The /privacy page's styles, unchanged, so the two policies read as one set. */
  .policy-page {
    min-height: 80vh;
  }

  .policy-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .policy-title {
    font-size: clamp(2rem, calc(1rem + 2.5vw), 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-white);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    line-height: 1;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .policy-subtitle {
    color: var(--color-accent-text);
    font-size: clamp(0.75rem, calc(0.375rem + 0.9vw), 1.1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .policy-content {
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-white-muted);
    font-size: 1.1rem;
    line-height: 1.7;
    background: rgba(10, 10, 12, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1rem;
    padding: clamp(2rem, 5vw, 4rem);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .policy-content h2 {
    color: var(--color-white);
    font-size: 1.5rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .policy-content h2:first-child {
    margin-top: 0;
  }

  .policy-content p {
    margin-bottom: 1.5rem;
  }

  .policy-content p:last-child {
    margin-bottom: 0;
  }

  .policy-content strong {
    color: var(--color-white);
    font-weight: 600;
  }
</style>
