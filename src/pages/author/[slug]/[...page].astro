---
import FeedLayout from '../../../layouts/FeedLayout.astro';
import { getPublishedArticles } from '../../../lib/articles.js';
import { DEFAULT_BYLINE } from '../../../data/sections.js';
import CardGrid from '../../../components/CardGrid.astro';
import Pagination from '../../../components/Pagination.astro';
import type { GetStaticPathsOptions } from 'astro';
import { Image } from 'astro:assets';
import andrewHeadshot from '../../../assets/andrew-headshot.webp';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const author = {
    slug: 'andrew-baxter',
    ...DEFAULT_BYLINE
  };
  const articles = getPublishedArticles();
  
  return paginate(articles, { 
    pageSize: 12, 
    params: { slug: author.slug },
    props: { author }
  });
}

const { page, author } = Astro.props;
---

<FeedLayout
  title={`${author.name} | BE UNCONVENTIONAL HQ`}
  description={author.bio}
  headingLabel={`Articles by ${author.name}`}
  page={page}
  isNavMode={false}
>
  <div class="author-profile">
    <div class="author-profile-header">
      <Image src={andrewHeadshot} alt={author.name} width={150} height={150} class="author-avatar" />
      <div class="author-info">
        <h1>{author.name}</h1>
        <p class="author-role">{author.role}</p>
        <p class="author-bio">{author.bio}</p>
      </div>
    </div>
  </div>

  <section class="author-articles">
    <h2>Articles</h2>
    <CardGrid items={page.data} />
    <Pagination page={page} />
  </section>
</FeedLayout>

<style>
  .author-profile {
    max-width: 800px;
    margin: 4rem auto 3rem auto;
    padding: 2.5rem;
    background: #111;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
  }
  .author-profile-header {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .author-avatar {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-accent);
  }
  .author-info h1 {
    margin: 0 0 0.5rem 0;
    font-size: 2.5rem;
    font-family: var(--font-heading);
    text-transform: uppercase;
  }
  .author-role {
    color: var(--color-accent);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1rem 0;
  }
  .author-bio {
    color: var(--color-text-dim, #ccc);
    line-height: 1.6;
    margin: 0;
  }
  .author-articles h2 {
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 1rem;
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem;
  }
  @media (max-width: 600px) {
    .author-profile-header {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
