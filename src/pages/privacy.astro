---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';

const title = `Privacy Policy | ${site.name}`;
const description = 'How we collect, use, and protect your data.';
---

<Layout title={title} description={description}>
  <main class="privacy-page container-page pt-24 pb-24">
    <div class="privacy-header animate-on-scroll">
      <h1 class="privacy-title">PRIVACY POLICY</h1>
      <p class="privacy-subtitle">Last updated: July 2026</p>
    </div>

    <div class="privacy-content animate-on-scroll" data-delay="100">
      <p>
        At Be Unconventional HQ, we respect your privacy. This policy explains what information we collect when you visit our site, how it is used, and how we protect it.
      </p>

      <h2>Security & Bot Protection</h2>
      <p>
        To protect our website from spam and abuse, we use <strong>Cloudflare Turnstile</strong> in invisible mode. Turnstile may analyze browser and device characteristics to verify that you are a human, not a bot. This data is processed strictly for security and verification purposes and is governed by Cloudflare's standard retention and privacy practices.
      </p>

      <h2>Marketing & Analytics</h2>
      <p>
        We use analytics and marketing tools including <strong>Google Analytics 4 (GA4)</strong>, <strong>Meta Pixel</strong>, and <strong>TikTok Pixel</strong> to understand our audience and measure the effectiveness of our content. 
      </p>
      <ul>
        <li>These tools use cookies and similar technologies to track page views, events, and broad demographic trends.</li>
        <li>We retain analytics data using standard default periods (e.g., 2 months for GA4 user and event data).</li>
        <li>We do not share identifiable user data with these platforms beyond what is gathered anonymously for standard analytics and aggregate campaign tracking.</li>
      </ul>

      <h2>Behavioural Tracking</h2>
      <p>
        We use <strong>Microsoft Clarity</strong> to capture anonymous heatmaps and session replays. This helps us understand how visitors navigate the site so we can improve the user experience. By default, Microsoft Clarity masks user input fields, meaning any text you type is not recorded or visible in session replays. Microsoft retains this data for up to 30 days.
      </p>

      <h2>Data Collection & Forms</h2>
      <p>
        Currently, we do not have an active email service provider or newsletter list. If you choose to contact us or provide information in the future via a contact form, we will collect only the information you explicitly provide (such as your name and email address) for the sole purpose of responding to your inquiry. We will never sell or rent your personal information to third parties.
      </p>

      <h2>Your Rights & Choices</h2>
      <p>
        You can opt out of analytics tracking by disabling cookies in your browser settings or by using browser extensions designed to block tracking pixels and scripts.
      </p>
    </div>
  </main>
</Layout>

<style>
  .privacy-page {
    min-height: 80vh;
  }
  
  .privacy-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .privacy-title {
    font-size: clamp(2rem, calc(1rem + 2.5vw), 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-white);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    line-height: 1;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .privacy-subtitle {
    color: var(--color-accent-text);
    font-size: clamp(0.75rem, calc(0.375rem + 0.9vw), 1.1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .privacy-content {
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-white-muted);
    font-size: 1.1rem;
    line-height: 1.7;
    background: rgba(10, 10, 12, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1rem;
    padding: clamp(2rem, 5vw, 4rem);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .privacy-content h2 {
    color: var(--color-white);
    font-size: 1.5rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .privacy-content h2:first-child {
    margin-top: 0;
  }

  .privacy-content p {
    margin-bottom: 1.5rem;
  }

  .privacy-content p:last-child {
    margin-bottom: 0;
  }

  .privacy-content ul {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .privacy-content li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .privacy-content li::before {
    content: "•";
    color: var(--color-accent-text);
    position: absolute;
    left: 0;
    font-weight: bold;
  }

  .privacy-content strong {
    color: var(--color-white);
    font-weight: 600;
  }
</style>
