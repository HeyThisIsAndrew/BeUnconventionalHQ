---
/**
 * /newsletter: THE HQ DISPATCH preference page. Choose topics, or unsubscribe.
 *
 * ─── ONE CENTRED PAGE, HONEST ABOUT THE EMAIL LINK (owner's reviews, 2026-11-01)
 * Why the emailed link: there is no login, and the link is what proves the
 * reader owns the address before its topics change or it is unsubscribed.
 * The page says that in one sentence, then, in order:
 *   1. what THE HQ DISPATCH is, and a way in for someone not subscribed
 *      yet (the homepage subscribe box, /#subscribe);
 *   2. the link form, one sentence of why, and one line each on what the
 *      email is (sender and subject read from newsletter-prefs.ts, never
 *      retyped), what happens for an address that never subscribed, what to
 *      do after the 48 hours, and the unsubscribe link in every issue;
 *   3. the four topics as a plain PREVIEW list, labelled "Preview only",
 *      with no frame, check or fill, so nothing looks tappable. After the
 *      link they become the dialog's real tiles, with Save and Unsubscribe;
 *   4. the signup box's own footer line.

 * Two states, decided by the URL:
 *   no ?t=   the preview, the steps and the link form (actions.newsletterLink).
 *            The answer never says whether the address is subscribed.
 *   ?t=...   the signed link: live tiles, Save, Unsubscribe
 *            (actions.newsletterPrefs). An expired link drops back to the
 *            first state with a note.
 * Every issue links here ("Choose your topics", with ?email= prefilled by
 * Kit). Kit's own one-click unsubscribe stays in every issue as well.
 *
 * Sizes are rem, so the page scales with the site's root steps at 2560px and
 * 4K (global-base.css) instead of shrinking to a strip in the middle.
 *
 * Gated like the other utility routes: noindex here, and in the sitemap
 * filter in astro.config.mjs. Not robots-blocked, so crawlers can read the
 * noindex. Logic: src/lib/newsletter-prefs.ts. Runbook: scripts/hq-dispatch.md.
 */
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
import { SECTIONS, MESSAGES } from '../data/content.js';
import PageTitle from '../components/PageTitle.astro';
import NewsletterTopics from '../components/NewsletterTopics.astro';
import { LINK_TTL_HOURS, prefsEmail, LINK_FROM } from '../lib/newsletter-prefs.ts';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

const title = `Newsletter Preferences | ${site.name}`;
const description = 'Choose what THE HQ DISPATCH sends you: Film, TV, Games and Events, or unsubscribe.';
/* Read from the code that sends the email, so the page can never describe a
   different sender or subject from the one that arrives. */
const LINK_SENDER = LINK_FROM;
const LINK_SUBJECT = prefsEmail('').subject;
---

<Layout title={title} description={description} noindex>
  <main class="container-page prefs-main">
    <div class="prefs-page" id="prefs" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY ?? ''} data-trigger-text={MESSAGES.newsletterTopicsTrigger}>
      <header class="prefs-header">
        <div class="section-header prefs-lockup">
          <PageTitle {...SECTIONS.subscribe} scale="secondary" as="h1" />
        </div>
        <p class="prefs-lede">{MESSAGES.subscribeSubtitle} You control what lands in your inbox.</p>
        <p class="prefs-lede prefs-new" id="prefs-new">Not subscribed yet? <a class="prefs-inline" href="/#subscribe">Subscribe on the homepage</a>.</p>
        <p class="prefs-lede prefs-signed-in" id="prefs-address" hidden></p>
      </header>

      <section class="prefs-section" id="prefs-request-section" aria-labelledby="prefs-link-title">
        <h2 class="nl-hq-header prefs-section-title" id="prefs-link-title">Change your topics or unsubscribe</h2>
        <p class="prefs-note">There is no login, so we email you a link that proves the address is yours before anything changes.</p>
        <form class="newsletter-form prefs-request" id="prefs-request" novalidate>
          <div class="newsletter-row">
            <label class="sr-only" for="prefs-email">Email address</label>
            <input class="newsletter-input" id="prefs-email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder="you@example.com" />
            <button class="cta-button-primary newsletter-submit" type="submit">Email me a link</button>
          </div>
          <div class="prefs-turnstile" id="prefs-turnstile"></div>
        </form>
        <ul class="prefs-facts">
          <li>Look for an email from {LINK_SENDER} titled &ldquo;{LINK_SUBJECT}&rdquo;.</li>
          <li>If that address never subscribed, no email is sent.</li>
          <li>The link works for {LINK_TTL_HOURS} hours; after that, ask for a new one here.</li>
          <li>No link? The Unsubscribe link at the bottom of any issue also works.</li>
        </ul>
      </section>

      <section class="prefs-section" aria-labelledby="prefs-topics-title">
        <h2 class="nl-hq-header prefs-section-title" id="prefs-topics-title">The four topics</h2>
        <p class="prefs-note" id="prefs-topics-note">Preview only: topics cannot be changed on this page.</p>
        <form id="prefs-choose" novalidate>
          <NewsletterTopics preview id="prefs-topics" />
          <div class="prefs-actions" id="prefs-actions" hidden>
            <button class="cta-button-primary" type="submit">Save my topics</button>
            <button class="prefs-link-button" type="button" id="prefs-unsub">Unsubscribe from THE HQ DISPATCH</button>
          </div>
          <div class="prefs-confirm" id="prefs-confirm" hidden>
            <p>Stop all THE HQ DISPATCH emails to this address?</p>
            <button class="cta-button-primary" type="button" id="prefs-unsub-yes">Yes, unsubscribe me</button>
            <button class="prefs-link-button" type="button" id="prefs-unsub-no">Keep my subscription</button>
          </div>
        </form>
      </section>

      <p class="prefs-status" id="prefs-status" role="status" aria-live="polite"></p>
      <p class="newsletter-fineprint prefs-fineprint">{MESSAGES.newsletterFineprint}</p>
    </div>
  </main>
</Layout>

<style>
  /* Centred column, rem throughout so it scales with the root steps; text
     sizes are max(rem, px) so the 80% laptop root never makes them tiny.
     Clear of the fixed navbar by its MEASURED height (--nav-h, published by
     Navbar.astro), not a guessed px value: `pt-24` on a `.container-page`
     did nothing and the kicker sat under the navbar (owner's screenshot). */
  /* On a screen taller than the page (2560px, 4K), the layout keeps the
     footer at the bottom; this page's own <main> takes that height and
     centres the column in it, so it never reads as a short form over empty
     space. On shorter screens it changes nothing. */
  .prefs-main {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .prefs-page {
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
    padding: calc(var(--nav-h, 84px) + 3rem) 0 2.5rem;
    text-align: center;
  }
  .prefs-lockup { margin-bottom: 1.25rem; }
  .prefs-lede {
    max-width: 36rem;
    margin: 0 auto;
    font-size: max(1rem, 15px);
    line-height: 1.6;
    color: var(--color-white-muted);
  }
  .prefs-signed-in { margin-top: 0.75rem; color: var(--color-white); }

  .prefs-section {
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .prefs-section-title { margin: 0 0 0.75rem; }
  .prefs-note {
    max-width: 36rem;
    margin: 0 auto 1.25rem;
    font-size: max(0.9rem, 13px);
    line-height: 1.6;
    color: var(--color-white-muted);
  }
  .prefs-new { margin-top: 0.6rem; color: var(--color-white); }
  .prefs-inline {
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }
  .prefs-inline:hover, .prefs-inline:focus-visible { color: var(--color-accent-text); }

  /* One short fact per line, under the form. */
  .prefs-facts {
    max-width: 36rem;
    margin: 1.1rem auto 0;
    padding: 0;
    list-style: none;
    font-size: max(0.85rem, 12.5px);
    line-height: 1.55;
    color: var(--color-white-muted);
  }
  .prefs-facts li + li { margin-top: 0.3rem; }

  /* The box's form sizing, inside this column rather than its own 56rem. */
  .prefs-request { max-width: none; margin: 0; }
  .prefs-turnstile:not(:empty) { margin-top: 1rem; }

  .prefs-actions, .prefs-confirm {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .prefs-confirm p { width: 100%; margin: 0; }
  .prefs-link-button {
    min-height: 44px;
    padding: 0.75rem 0;
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
  }
  .prefs-link-button:hover, .prefs-link-button:focus-visible { color: var(--color-accent-text); }
  .prefs-status { margin: 2rem 0 0; min-height: 1.5rem; color: var(--color-white); }
  .prefs-status.is-error { color: var(--color-accent-text); }
  .prefs-fineprint { margin-top: 1rem; }
</style>

<script>
  import { actions } from 'astro:actions';
  import { requestTurnstile } from '../lib/turnstile-lazy';

  type Topic = 'film' | 'tv' | 'games' | 'events';

  function setup() {
    const root = document.getElementById('prefs');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const status = document.getElementById('prefs-status')!;
    const request = document.getElementById('prefs-request') as HTMLFormElement;
    const requestSection = document.getElementById('prefs-request-section')!;
    const choose = document.getElementById('prefs-choose') as HTMLFormElement;
    const tiles = document.getElementById('prefs-topics')!;
    const say = (message: string, error = false) => {
      status.textContent = message;
      status.classList.toggle('is-error', error);
    };
    const params = new URLSearchParams(location.search);
    const token = params.get('t');
    const emailInput = document.getElementById('prefs-email') as HTMLInputElement;
    if (params.get('email')) emailInput.value = params.get('email') ?? '';

    const boxes = () => [...tiles.querySelectorAll<HTMLInputElement>('input[name="topics"]')];
    const announce = () => tiles.dispatchEvent(new Event('change', { bubbles: true }));
    const errorText = (error: any) =>
      error?.type === 'AstroActionInputError' ? 'Please check the address and try again.' : error?.message || 'Something went wrong. Please try again.';

    /* State 2: a verified link turns the preview into the real thing. */
    if (token) {
      say('Loading your topics...');
      (async () => {
        const { data, error } = await actions.newsletterPrefs({ token, op: 'get' });
        if (error || !data) return say(errorText(error), true);
        requestSection.hidden = true;
        document.getElementById('prefs-new')!.hidden = true;
        const address = document.getElementById('prefs-address')!;
        address.textContent = `Signed in as ${data.email}.`;
        address.hidden = false;
        document.getElementById('prefs-topics-title')!.textContent = document.querySelector('[data-trigger-text]')?.getAttribute('data-trigger-text') ?? 'Choose what lands in your inbox';
        tiles.classList.remove('is-preview');
        for (const box of boxes()) { box.disabled = false; box.checked = data.topics.includes(box.value as Topic); }
        announce();
        document.getElementById('prefs-topics-note')!.textContent = 'Tap a topic to turn it on or off, then save.';
        document.getElementById('prefs-actions')!.hidden = false;
        say(data.unsubscribed ? 'This address is unsubscribed. Save your topics to come back.' : '');
      })();

      choose.addEventListener('submit', async (event) => {
        event.preventDefault();
        say('Saving...');
        const topics = boxes().filter((b) => b.checked).map((b) => b.value as Topic);
        const { data, error } = await actions.newsletterPrefs({ token, op: 'save', topics });
        if (error || !data) return say(errorText(error), true);
        for (const box of boxes()) box.checked = data.topics.includes(box.value as Topic);
        announce();
        say('Saved. Your next issue follows these topics.');
      });
      const confirm = document.getElementById('prefs-confirm')!;
      document.getElementById('prefs-unsub')!.addEventListener('click', () => { confirm.hidden = false; });
      document.getElementById('prefs-unsub-no')!.addEventListener('click', () => { confirm.hidden = true; });
      document.getElementById('prefs-unsub-yes')!.addEventListener('click', async () => {
        say('Unsubscribing...');
        const { error } = await actions.newsletterPrefs({ token, op: 'unsubscribe' });
        if (error) return say(errorText(error), true);
        confirm.hidden = true;
        say('Done. You will not get THE HQ DISPATCH any more. Changed your mind? Save your topics above.');
      });
      return;
    }

    /* State 1: the preview stays a preview; ask for a link. Turnstile runs only when a site key exists. */
    choose.addEventListener('submit', (event) => event.preventDefault());
    const sitekey = root.dataset.sitekey;
    const humanToken = async (): Promise<string | undefined> => {
      if (!sitekey) return undefined;
      const turnstile = await requestTurnstile();
      return new Promise((resolve, reject) => {
        const holder = document.getElementById('prefs-turnstile')!;
        holder.innerHTML = '';
        const id = turnstile.render(holder, {
          sitekey, execution: 'execute', appearance: 'interaction-only', theme: 'dark',
          callback: (t: string) => resolve(t),
          'error-callback': () => reject(new Error('turnstile')),
          'timeout-callback': () => reject(new Error('turnstile')),
        });
        turnstile.execute(id);
      });
    };
    request.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = emailInput.value.trim();
      if (!email || !emailInput.checkValidity()) return say('Please enter a valid email address.', true);
      say('Sending...');
      let human: string | undefined;
      try {
        human = await humanToken();
      } catch {
        return say("Our anti-spam check couldn't finish. An ad blocker can cause this. Please try again.", true);
      }
      const { data, error } = await actions.newsletterLink({ email, 'cf-turnstile-response': human });
      if (error || !data) return say(errorText(error), true);
      say(data.message);
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
