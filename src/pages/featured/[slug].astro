---
import Layout from '../../layouts/Layout.astro';
import { getArticleItems } from '../../lib/feed-items';
import { getVideosUnified } from '../../lib/videos-source';
import { getFeaturedBrandsLocal, getHubBackdrop, urlFor, HUB_CATEGORY_LABELS } from '../../lib/local-content';
import SubscribeCTA from '../../components/SubscribeCTA.astro';
import HeroTrailer from '../../components/HeroTrailer.astro';
import ContentCard from '../../components/ContentCard.astro';
import InstagramFeed from '../../components/InstagramFeed.astro';
import { getHubTopicKeywords } from '../../lib/instagram-topic';
import { parseVideoId } from '../../lib/platforms/youtube';

export async function getStaticPaths() {
  // `defined(slug.current)` filtering happens in getFeaturedBrandsLocal, so a
  // half-filled brand can never reach the map below and crash the build (the
  // original #19 crash). Second guard here is belt-and-suspenders.
  const brands = getFeaturedBrandsLocal();
  return brands
    .filter((brand: any) => brand?.slug?.current)
    .map((brand: any) => ({
      params: { slug: brand.slug.current },
      props: { event: brand }, // body references `event.*`; keep that binding
    }));
}

const { event } = Astro.props;

// 1. Fetch Global Data
const allVideos = await getVideosUnified();
const allArticles = getArticleItems();

// 1b. Phase C1 (epic #25): deterministic, editor-controlled coverage — videos
// whose hubs[] reference THIS brand doc (by slug - see sync-youtube.mjs's
// taxonomy dictionary, which keys hub matches off event/featuredBrand
// slugs). Empty until editors/sync hub-tag published docs; the tag-match
// fallback below keeps behavior unchanged until then.
const hubCoverage = allVideos
  .filter((v: any) => !v.isShort && !v.isLive && (v.hubs || []).includes(event.slug?.current))
  .sort((a: any, b: any) => new Date(b.publishedAt ?? 0).getTime() - new Date(a.publishedAt ?? 0).getTime());

// 2. Fallback: filter global data against hub tags (legacy heuristic; removed
// in Phase C2 once hub-tagging covers the catalog)
const eventTags = (event.youtubeSyncKeywords || []).filter((t: any) => typeof t === 'string');

const filteredVideos = hubCoverage.length > 0 ? hubCoverage : allVideos.filter((v: any) => {


  // STRICT FILTERING: Query against the actual YouTube Tags synced directly from 
  // YouTube Studio metadata into Sanity (`v.youtubeTags`). 
  // We use EXACT matching on normalized tags, avoiding all regex and substring data leaks.
  return eventTags.some((tag: string) => {
    const normalize = (s: string) => s.toLowerCase().replace(/[^\w\s]/g, ' ').replace(/\s+/g, ' ').trim();
    const t = normalize(tag);
    if (!t) return false;
    
    // Exact match on normalized strings (e.g. "marvel studios" === "marvel studios")
    const hasYouTubeTag = v.youtubeTags?.some((yt: string) => normalize(yt) === t);
    
    // Also include videos where the editor manually assigned the topic in Sanity
    const hasTopic = v.tags?.some((vt: string) => normalize(vt) === t);
    const hasCategory = v.category ? normalize(v.category) === t : false;
    
    return hasYouTubeTag || hasTopic || hasCategory;
  });
});

const filteredArticles = allArticles.filter((a: any) => {
  return eventTags.some((tag: string) => {
    const normalize = (s: string) => s.toLowerCase().replace(/[^\w\s]/g, ' ').replace(/\s+/g, ' ').trim();
    const t = normalize(tag);
    if (!t) return false;
    
    // Exact match on normalized strings
    const hasTopic = a.tags?.some((at: string) => normalize(at) === t);
    const hasCategory = a.category ? normalize(a.category) === t : false;
    return hasTopic || hasCategory;
  });
});

// Merge and sort all content
const unifiedContent = [
  ...filteredArticles.map((a: any) => ({ ...a, contentType: 'article' })),
  ...filteredVideos.map((v: any) => ({ ...v, contentType: 'video' }))
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// YouTube IDs are extracted via the shared parseVideoId (src/lib/platforms/youtube).

/*
  `brandColor` on a featuredBrand doc is an OBJECT — {hex: '#E23636'} — not a
  string. Interpolated straight into a style attribute it stringified to
  "[object Object]", which meant two things silently did nothing: the
  --brand-color custom property was invalid (nothing read it, so nobody
  noticed), and the fallbackGradient below it was an invalid gradient. That
  fallback is the entire background for a hub with no hero image, which is
  thirteen of the fifteen — they rendered as a flat empty box.

  The RGB triple is derived here rather than stored, same as on /featured:
  one editable value in the CMS, no second field to keep in step with it.
*/
const brandHex: string =
  (typeof event.brandColor === 'string' ? event.brandColor : event.brandColor?.hex) || '#CC0000';

function hexToRgbTriple(hex: string): string {
  const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
  if (!m) return '204, 0, 0';
  const int = parseInt(m[1], 16);
  return `${(int >> 16) & 255}, ${(int >> 8) & 255}, ${int & 255}`;
}

const brandColor = brandHex;
const brandRgb = hexToRgbTriple(brandHex);
/*
  THE HUB PAGE OPENS ON THE SAME SCENE THE DECK CLOSED ON.

  Landing here used to be a hard cut: /featured had a moving backdrop with the
  mark set into the artwork, and this page answered with a flat image and a
  paragraph of grey body copy. Same backdrop source as the deck now
  (getHubBackdrop), so a hub looks like itself in both places.

  Requested at 900px because it is blurred past any detail — a bigger source
  would be weight with nothing to show for it.
*/
const heroBackdrop = getHubBackdrop(event.slug?.current ?? '');
const categoryLabel = HUB_CATEGORY_LABELS[event.hubCategory ?? ''] ?? '';

/*
  Held back to a tint rather than the brand colour at full strength: this is the
  ground a logo and a line of type sit on, and four hubs are set to pure white.
*/
const fallbackGradient = `linear-gradient(135deg, rgba(${brandRgb}, 0.28) 0%, #0a0a0a 62%, #111 100%)`;

// The trailer (poster, players, sound) is fully encapsulated in <HeroTrailer/>.
const trailerUrl = event.trailerUrl;
const trailerId = parseVideoId(trailerUrl);
---

<Layout title={`${event.title}`} description={`Complete coverage of ${event.title}`}>
  <main class="event-dashboard" style={`--brand-color: ${brandColor}; --brand-rgb: ${brandRgb};`}>
    
    {/* TODO: Refactor this hero section into a reusable component to share with
        the event detail page. Follow up with: "Can you walk me through creating
        a reusable component for the hero section?" */}
    {/* Cinematic Hero */}
    <section class="event-hero">
      {/* Two layers (issue #22): the wrapper owns clipping/coverage and stays
          static; the inner layer owns the background image and the slow Ken
          Burns transform. Animating a single element caused edge slivers. */}
      <div class="event-hero-bg-wrapper">
        {heroBackdrop ? (
          /*
            The hub's own art, blurred, with the slow push this hero has always
            had. It used to be a cross-fade of up to six stills gathered from
            the thumbnails of videos tagged to the hub — which meant a hub could
            end up backed by a photograph of the site owner. See
            getHubBackdrop().
          */
          <div
            class="event-hero-bg-animated hero-backdrop-plate"
            style={`background-image: url('${
              urlFor(heroBackdrop.ref).width(900).auto('format').quality(70).url()
            }');`}
          ></div>
        ) : (
          <div class="event-hero-bg-animated" style={`background-image: ${fallbackGradient};`}></div>
        )}
      </div>
      <div class="event-hero-overlay flex flex-col justify-center">
        <div
          class:list={[
            'container',
            'hero-grid-container',
            'lg:!px-20',
            'xl:!px-24',
            '2xl:!max-w-[1920px]',
            '2xl:!grid-cols-[1fr_1.2fr]',
            '3xl:!max-w-[2400px]',
            '3xl:!grid-cols-[1fr_1.4fr]',
            { 'has-trailer': !!trailerId, 'has-cta': !!event.signUpLink },
          ]}
        >
          <div class="event-hero-content hero-copy animate-on-scroll">
            {/* See the matching note in events/[slug].astro: when a logo
                exists the visible title is an image, so without this the page
                ships with no <h1> at all. sr-only keeps the visual design
                identical while restoring the outline and SEO. */}
            {/*
              Names the row on /featured that this hub sits in. It is the one
              piece of continuity a logo alone cannot give you — you clicked
              "The Multiverse", so the page you land on says so, in the same
              plate the row header uses.
            */}
            {categoryLabel && <span class="hero-eyebrow">{categoryLabel}</span>}

            {event.logo && <h1 class="sr-only">{event.title}</h1>}
            {event.logo ? (
              <img
                src={urlFor(event.logo).height(240).url()}
                alt={`${event.title} logo`}
                class="hero-logo"
                height="240"
                width={event.logo?.dimensions?.aspectRatio
                  ? Math.round(240 * event.logo.dimensions.aspectRatio)
                  : undefined}
              />
            ) : (
              <h1 class="hero-title">{event.title}</h1>
            )}

            {event.description && (
              <div class="hero-description-wrapper">
                <p class="hero-description-text" id="event-about-text">{event.description}</p>
                <button class="hero-read-more" id="event-about-toggle" aria-expanded="false" hidden>
                  Read more
                </button>
              </div>
            )}
          </div>
          
          {trailerId && (
            <div class="hero-trailer animate-on-scroll aspect-video w-full h-auto 2xl:!max-w-4xl 3xl:!max-w-6xl 2xl:scale-110 2xl:origin-right" style="animation-delay: 0.2s;">
              <HeroTrailer trailerId={trailerId} title={event.title} />
            </div>
          )}

          {/* Placed after the trailer in the DOM so mobile stacks copy →
              trailer → button; grid-areas restore the desktop layout. */}
          {event.signUpLink && (
            <div class="hero-info-cta">
              <a href={event.signUpLink} target="_blank" rel="noopener noreferrer" class="hero-rsvp-btn">
                Event Details
              </a>
            </div>
          )}
        </div>
      </div>
    </section>

    <div class="container-page content-container">
      {unifiedContent.length > 0 ? (
        <section class="content-section">
          <h2 class="sr-only">Event coverage</h2>

          <div class="filter-controls animate-on-scroll">
            <button class="filter-btn type-btn" data-filter="article" aria-pressed="false">ARTICLES</button>
            <button class="filter-btn type-btn" data-filter="video" aria-pressed="false">VIDEOS</button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full" aria-live="polite">
            {unifiedContent.map((item, index) => (
              <ContentCard item={item} index={index} />
            ))}
          </div>
        </section>
      ) : (
        <div class="empty-state animate-on-scroll">
          <p>{event.title} content is coming soon.</p>
        </div>
      )}
    </div>
    {/* Topic-qualified: this brand's own keywords, not its display title.
        Renders nothing unless enough qualifying tiles exist to fill the
        widest row — HUB_CAROUSEL_MIN_TILES in lib/instagram-topic.ts. */}
    <InstagramFeed topicKeywords={getHubTopicKeywords(event)} />
    <SubscribeCTA />

  </main>
</Layout>

<style>

  .event-dashboard {
    /* min-height removed to respect canonical footer spacing */
  }
  /* Page width wrapper now shared: `.container-page` in modules/layout.css */
  
  /* Hero */
  /* ══════════════════════════════════════════════════════════════════════
     THE HERO IS PINNED. THE COVERAGE SCROLLS UP OVER IT.

     Landing here used to be a hard cut: a half-height hero that ended at an
     edge, with a grey content grid starting underneath it — and you could see
     both at once, which is what killed the cinematic read the moment the page
     loaded.

     Sticky fixes the seam by removing it. The hero does not end, it gets
     COVERED: it holds the viewport while the coverage panel rises over it like
     a curtain, and only leaves once the panel has fully passed. There is no
     boundary left to blend because there is no boundary.

     Pure CSS. No scroll listener, no rAF, no per-frame work — the compositor
     owns it, so this cannot regress the smoothness the deck page was tuned for.

     THREE THINGS ARE LOAD-BEARING:

     1. `100lvh`, never `100vh`. On iOS `100vh` is the LARGEST viewport, which
        the page also uses before the URL bar retracts, so a `vh` hero leaves a
        gap under itself. scripts/viewport-units.test.mjs pins this unit for
        exactly this reason.
     2. `top` must clear the fixed header, or the hero pins underneath it.
     3. Sticky fails SILENTLY if any ancestor has `overflow: hidden` — the same
        family of trap as hard rule 3, and it produces no error, just a hero
        that scrolls away. Nothing between here and <body> clips; the only
        `overflow: hidden` in this file is on .event-hero-bg-wrapper, which is
        a CHILD.

     NO `overflow: hidden` HERE either — on iOS Safari an overflow:hidden
     ancestor makes a descendant cross-origin (YouTube) iframe render as a black
     box, and the trailer lives in this subtree. The background layer is inset:0
     and clips to its own box, so the clip was never needed.
     ══════════════════════════════════════════════════════════════════════ */
  .event-hero {
    position: sticky;
    top: var(--header-height, 80px);
    height: calc(100lvh - var(--header-height, 80px));
    min-height: 560px;
    display: flex;
    align-items: center;
    /* Below the coverage panel, which paints over it. */
    z-index: 0;
    background-color: #111;
  }

  @media (prefers-reduced-motion: reduce) {
    /*
      Sticky is not an animation, but the effect it produces is motion the
      viewer did not ask for. Falling back to a normal hero costs nothing.
    */
    .event-hero {
      position: relative;
    }
  }

  /*
    THE PANEL THAT RIDES OVER IT.

    Opaque, or the pinned hero shows through and the whole effect reads as a
    rendering fault rather than a layer. The shadow above it is what sells the
    depth: it is the only cue that one plane is passing in front of another.
  */
  .content-container {
    position: relative;
    z-index: 1;
    background: var(--color-black, #050505);
    box-shadow: 0 -60px 90px rgba(0, 0, 0, 0.9);
  }

  /*
    A hairline of the brand's colour along the panel's leading edge. Without it
    the panel arrives as a flat black rectangle; with it, the hub's own colour
    is the last thing you see of the hero and the first thing you see of the
    coverage.
  */
  .content-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right,
      transparent 0%,
      rgba(var(--brand-rgb, 204, 0, 0), 0.55) 22%,
      rgba(var(--brand-rgb, 204, 0, 0), 0.55) 78%,
      transparent 100%);
    pointer-events: none;
  }
  /* Clipping/coverage layer: static, fills the hero, hides the sliver the
     animated child exposes at its edges while scaled. overflow:hidden is safe
     HERE (and only here) — it contains no iframe, so the iOS black-box bug
     cannot trigger. */
  .event-hero-bg-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .event-hero-bg-animated {
    position: absolute;
    inset: 0;
    /* Cover the whole hero (behind the copy AND the trailer). It re-crops when
       the description expands — an accepted trade for full coverage. */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    /* translateZ(0) promotes this layer to its own compositor layer. Without
       it, the overlay's backdrop-filter blur stops the animated transform from
       repainting (issue #22 root cause) — keep it in the base AND in every
       keyframe so the promotion never lapses mid-animation. */
    transform: translateZ(0);
    /* Tuned after visual QA: the original 1.05/50s (~0.1%/s) sat below the
       perception floor and read as static. 1.08/30s is ambient but alive —
       don't retune blind; verify any change with the 2s/1.5x debug values
       (see d1db593). */
    animation: cinematic-hero-zoom 30s ease-in-out infinite alternate;
  }
  /* Scale never drops below 1, so the image always covers the wrapper — no
     exposed edges at any point in the cycle. */
  @keyframes cinematic-hero-zoom {
    from {
      transform: scale(1.08) translateZ(0);
    }
    to {
      transform: scale(1) translateZ(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-hero-bg-animated {
      animation: none;
    }
  }

  /*
    THE HERO PLATE.

    Blurred, and OVERSCANNED past its clipping wrapper. A CSS blur goes weak at
    its own element's edges — it mixes in the transparent pixels outside — so
    the outermost band of a blurred element is the least blurred part of it.
    Left flush with the box, that band is what shows behind the logo and the
    copy. `.event-hero-bg-wrapper` already clips, so pushing the plate past it
    puts the weak edge outside the clip where it is never seen.

    Blurred less than the deck's, and brightened rather than dimmed: on
    /featured this sits behind a poster and must not compete with it, whereas
    here it IS the scene with only a logo and a line of type in front. Trailer
    stills are dark to begin with, and blurring a dark image and then dimming it
    is how this hero was once a black rectangle.
  */
  .hero-backdrop-plate {
    inset: -12%;
    top: -12%;
    left: -12%;
    right: -12%;
    bottom: -12%;
    filter: blur(9px) saturate(1.15) brightness(1.16);
    -webkit-filter: blur(9px) saturate(1.15) brightness(1.16);
  }

  /*
    Shapes the plate the copy sits on. A single flat image behind white text is
    what made this hero read as a stock header — the copy had no ground of its
    own, so it floated. Darkest at the bottom left, where the mark and the line
    are, and clearing toward the trailer on the right.
  */
  .event-hero-bg-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /*
      TWO SCRIMS MULTIPLY. THESE ONES MULTIPLIED TO BLACK.

      A design review called this hero "mostly empty dark space next to the
      logo", and the backdrop gallery WAS behind it the whole time — it was
      just unreadable. Stacked alpha compounds: at the bottom-left corner these
      two came to 1 - (1-0.92)(1-0.88) = 0.99, and at the logo's own position
      about 0.85. A gallery under a 99% black wash is an expensive way to draw
      a black rectangle.

      The vertical one now only does what it has to — seat the bottom edge
      against the section below — and the horizontal one carries legibility for
      the copy, ending sooner and softer. At the logo the pair now comes to
      about 0.55, which is a lit scene with type on it rather than a void.
    */
    background:
      linear-gradient(to top, rgba(5,5,5,0.82) 0%, rgba(5,5,5,0.42) 18%, rgba(5,5,5,0.12) 38%, transparent 62%),
      linear-gradient(to right, rgba(5,5,5,0.62) 0%, rgba(5,5,5,0.34) 24%, rgba(5,5,5,0.10) 46%, transparent 68%);
  }
  /* In normal flow (not absolute) so the banner GROWS with its content instead
     of overflowing upward under the fixed navbar. padding-top clears the navbar
     so the logo is never clipped. */
  .event-hero-overlay {
    position: relative;
    z-index: 1;
    min-height: 70vh;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.97) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.35) 100%
    );
    /* Subtle blur of the background image behind the overlay (content is a child,
       so it stays sharp) — softens the busy hero art for title legibility. */
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    padding-top: clamp(6rem, 4.5rem + 6vw, 8.5rem);
    padding-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  /* Mobile: single column. Source order is copy → trailer → button, so the
     trailer sits above the Event Details button. */
  .hero-grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  /*
    NAMED .hero-info-cta, NOT .hero-cta — deliberately. See the matching note
    in events/[slug].astro: .hero-cta is already the homepage splash/reveal
    button's class (hero.css + splash.css), and this page's wrapper reusing
    that name let splash.css's pulsing-glow/flex rules bleed onto the
    unrelated "Event Details" CTA here — reported as a stray red outline
    around the button on every viewport.
  */
  .hero-info-cta {
    text-align: center;
  }

  /* Desktop: two columns. grid-areas keep copy + button stacked on the left
     with the trailer spanning both rows on the right. */
  @media (min-width: 900px) {
    /* .has-trailer / .has-cta are applied at build time — no reliance on :has()
       (which older Firefox lacks). Single-row areas when there's no CTA so the
       copy isn't squeezed by an empty grid row. */
    .hero-grid-container.has-trailer {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'copy trailer';
      align-items: center;
    }
    .hero-grid-container.has-trailer.has-cta {
      grid-template-areas:
        'copy trailer'
        'cta trailer';
    }
    .hero-grid-container.has-trailer .hero-copy {
      grid-area: copy;
    }
    .hero-grid-container.has-trailer .hero-trailer {
      grid-area: trailer;
    }
    .hero-grid-container.has-trailer .hero-info-cta {
      grid-area: cta;
      align-self: start;
    }
    .hero-info-cta {
      text-align: left;
    }
  }

  .event-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 900px;
  }
  
  /* Placement only — the trailer's internals live in <HeroTrailer/>. */
  .hero-trailer {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }
  
  /*
    The row plate, restated. Same size, same tracking and same quiet grey the
    accordion headers use, because it is the same object — the label of the row
    you came in through.
  */
  .hero-eyebrow {
    display: inline-block;
    margin-bottom: 1.4rem;
    padding: 0.45rem 0.9rem;
    border-left: 2px solid rgba(var(--brand-rgb, 204, 0, 0), 0.9);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero-logo {
    /* Responsive + width-capped so wide logos (e.g. Comic-Con) never overflow
       the column or force the banner taller than the viewport on mobile. */
    max-height: clamp(84px, 46px + 12vw, 180px);
    max-width: min(100%, 420px);
    width: auto;
    height: auto;
    object-fit: contain;
    margin-bottom: 1.5rem;
    /* Removed filter: drop-shadow due to known iOS Safari rendering bugs 
       causing the image to completely fail to load/display as broken on mobile */
  }
  .hero-title {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: clamp(1.9rem, calc(1.1rem + 3vw), 3.75rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    margin: 0 0 1rem 0;
  }
  .hero-meta {
    font-size: clamp(0.9rem, 0.8rem + 0.6vw, 1.25rem);
    color: #ccc;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .event-dates, .event-location {
    display: inline-block;
  }

  /*
    THE BILLING BLOCK, NOT A PARAGRAPH.

    "Presenting Marvel, the MCU, and Marvel Games." was set as sentence-case
    body copy at 1rem — the largest text in the column after the logo, and the
    single thing that most made this page read as a marketing page rather than
    a title card. It is the same sentence /featured sets small, tracked out and
    dim under the mark, and it does the same job here.

    Font size stays identical in every state so toggling never resizes the
    text. The collapsed height is still exactly two lines — 3.4em now rather
    than 3em, because the line-height came up with the tracking; the read-more
    script measures the full height itself and animates between the two, so
    this number only has to agree with line-height.
  */
  .hero-description-text {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.58);
    line-height: 1.7;
    max-width: 46ch;
    margin-top: 1.6rem;
    overflow: hidden;
    max-height: 3.4em;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.9);
  }
  .hero-read-more {
    background: none;
    border: none;
    color: white; /* Set to static white to resolve state bugs. See commented-out rules below. */
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0;
    margin-top: 0.5rem;
    cursor: pointer;
    text-decoration: underline;
  }

  /* TODO: Revisit stateful color logic. Caused color to reset on scroll.
  .hero-read-more:hover, .hero-read-more:focus-visible {
    color: var(--color-accent-text);
  } */

  .hero-rsvp-btn {
    display: inline-block;
    background: transparent;
    color: white;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.75rem 2rem;
    border: 1px solid var(--color-accent, #cc0000);
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .hero-rsvp-btn:hover {
    background: var(--color-accent, #cc0000);
    color: white;
  }

  /* Mobile: single column with no trailer — centre the lockup for balance.
     align-items centres the logo (a flex item); text-align centres the copy. */
  @media (max-width: 899px) {
    .event-hero-content {
      align-items: flex-start;
      text-align: left;
    }
    /* Font size stays 1rem (matching the base) so expand/collapse never resizes
       the text; only the top margin tightens on mobile. */
    .hero-description-text {
      margin-top: 1rem;
    }
  }

  /* Content */
  .content-container {
    padding: 4rem 2rem;
    /* Enough that the panel can actually cover the pinned hero on a short
       page. A hub with one card would otherwise stop scrolling before the
       hero was covered, leaving the effect half-finished. */
    min-height: calc(100lvh - var(--header-height, 80px));
  }
  .content-section {
    margin-bottom: 5rem;
  }
  
  /* Filter Controls */
  .filter-controls {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 600px;
    margin: 0 auto 3rem auto;
  }
  /*
    Two heavy filled slabs at 1.1rem bold were the loudest thing between the
    hero and the coverage, and they are a filter — furniture, not a headline.
    Quieted to match the row plates: hairline, tracked out, small.
  */
  .filter-btn {
    padding: 0.85rem 1rem;
    background: rgba(10, 10, 10, 0.45);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    font-family: var(--font-display, 'Inter', sans-serif);
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  @media (hover: hover) and (pointer: fine) {
    .filter-btn:hover,
    .filter-btn:focus-visible {
      background: rgba(239, 68, 68, 0.1);
      border: 2px solid var(--color-accent, #ef4444);
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
      transform: translateY(-2px);
    }
  }

  .filter-btn.active {
    background: rgba(239, 68, 68, 0.1);
    border: 2px solid var(--color-accent, #ef4444);
    color: white;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.6);
  }

  @media (max-width: 767px) {
    .filter-controls {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }
    .filter-btn {
      flex: 1;
      padding: 0.75rem 0.5rem;
      font-size: 0.9rem;
    }
  }
  
  .empty-state {
    text-align: center;
    padding: 4rem;
    color: #a0a0a0;
    font-size: 1.2rem;
  }

  /* Visually hidden but exposed to assistive tech (used for the section <h2>
     that restores the heading hierarchy between the hero <h1> and card <h3>s). */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // astro:page-load fires on the initial load AND after every View Transition
  // navigation, so the filters keep working after client-side nav.
  function initEventInteractions() {
    const filterBtns = Array.from(document.querySelectorAll('.filter-btn'));
    const contentCards = Array.from(document.querySelectorAll('.content-card'));

    filterBtns.forEach((btn) => {
      if ((btn as HTMLElement).dataset.bound === 'true') return;
      (btn as HTMLElement).dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const wasActive = btn.classList.contains('active');
        filterBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });

        let activeFilter = 'all';
        if (!wasActive) {
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          activeFilter = (btn as HTMLElement).getAttribute('data-filter') || '';
        }

        contentCards.forEach((card) => {
          const show = activeFilter === 'all' || card.getAttribute('data-type') === activeFilter;
          (card as HTMLElement).style.display = show ? 'flex' : 'none';
        });
      });
    });

    // Keyboard activation for video cards exposed as role="button".
    document.querySelectorAll('[data-action="open-video"]').forEach((card) => {
      if ((card as HTMLElement).dataset.keybound === 'true') return;
      (card as HTMLElement).dataset.keybound = 'true';
      card.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          (card as HTMLElement).click();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initEventInteractions);
</script>

<script>
  // Expandable event blurb. max-height animates between the CSS collapsed value
  // (3em) and the measured full height, so the motion is smooth in both
  // directions with no arbitrary max-height and no snap at the end. Rapid
  // toggling is safe: each click retargets the same animated property and the
  // completion cleanup uses a single transitionend handler (no stray timeout).
  const COLLAPSED_MAX = '3em';

  function initEventAbout() {
    const text = document.getElementById('event-about-text');
    const toggle = document.getElementById('event-about-toggle');
    if (!text || !toggle) return;

    let expanded = false;


    // Toggle visibility depends on whether the (collapsed) text overflows.
    const evaluate = () => {
      if (expanded) return;
      toggle.hidden = text.scrollHeight <= text.clientHeight + 2;
    };

    if (toggle.dataset.bound !== 'true') {
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        if (!expanded) {
          expanded = true;
          text.style.maxHeight = 'none';
          toggle.textContent = 'Read less';
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          expanded = false;
          text.style.maxHeight = COLLAPSED_MAX;
          toggle.textContent = 'Read more';
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Evaluate after web fonts settle (wrong scrollHeight otherwise) and on any
    // resize/reflow of the text box.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(evaluate);
    }
    evaluate();
    if ((text as any).__ro) (text as any).__ro.disconnect();
    const ro = new ResizeObserver(() => evaluate());
    ro.observe(text);
    (text as any).__ro = ro;
  }

  document.addEventListener('astro:page-load', initEventAbout);
</script>
