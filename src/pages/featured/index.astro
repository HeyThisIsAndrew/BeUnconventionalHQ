---
import Layout from '../../layouts/Layout.astro';
import SubscribeCTA from '../../components/SubscribeCTA.astro';
import { getFeaturedBrandsLocal, urlFor } from '../../lib/local-content';


const brands = await getFeaturedBrandsLocal();

// Temporary category map to bridge Sanity's "Brand" taxonomy into the UI.
const categoryMap: Record<string, string> = {
  'marvel-comics': 'universes',
  'dc-comics': 'universes',
  'sony-pictures': 'universes',
  
  'netflix': 'streaming',
  'prime-video': 'streaming',
  'max': 'streaming',
  'apple-tv-plus': 'streaming',
  'disney-plus': 'streaming',
  'hulu': 'streaming',
  
  'warner-bros': 'studios',
  'universal': 'studios',
  'a24': 'studios',
  
  'playstation': 'gaming',
  'nintendo': 'gaming',
  'xbox': 'gaming'
};

const categoryLabels: Record<string, string> = {
  'universes': 'The Multiverse',
  'streaming': 'Streamers',
  'studios': 'Studios',
  'gaming': 'Gaming'
};

// Group the brands
const groupedBrands = brands.reduce((acc, brand) => {
  const category = categoryMap[brand.slug?.current || ''] || 'other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(brand);
  return acc;
}, {} as Record<string, typeof brands>);

// Sort categories explicitly based on user instruction
const desiredOrder = ['universes', 'streaming', 'studios', 'gaming'];
const sortedCategories = Object.keys(groupedBrands).sort((a, b) => {
  const indexA = desiredOrder.indexOf(a);
  const indexB = desiredOrder.indexOf(b);
  if (indexA === -1 && indexB === -1) return 0;
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});
---

<Layout title="Featured Hubs">
  <main class="featured-directory-page">
    {sortedCategories.length > 0 ? (
      <div class="accordion-container animate-on-scroll">
        {sortedCategories.map((category, index) => {
          let categoryBrands = groupedBrands[category];
          // Force order for gaming
          if (category === 'gaming') {
            const gamingOrder = ['playstation', 'nintendo', 'xbox'];
            categoryBrands = categoryBrands.sort((a, b) => {
              const aIdx = gamingOrder.indexOf(a.slug?.current || '');
              const bIdx = gamingOrder.indexOf(b.slug?.current || '');
              if (aIdx === -1 && bIdx === -1) return 0;
              if (aIdx === -1) return 1;
              if (bIdx === -1) return -1;
              return aIdx - bIdx;
            });
          }

          // First one is expanded by default
          const isExpanded = index === 0;

          return (
            <div class={`accordion-section ${isExpanded ? 'expanded' : 'collapsed'}`} data-category={category}>
              
              {/* THE COLLAPSED / HEADER STATE */}
              <div class="accordion-header">
                <div class="accordion-header-bg"></div>
                <h2 class="accordion-title">{categoryLabels[category] || category}</h2>
              </div>

              {/* THE EXPANDED CAROUSEL STATE */}
              <div class="accordion-body">
                <div class="carousel-track">
                  {categoryBrands.map(brand => {
                    const heroUrl = brand.heroImage 
                      ? urlFor(brand.heroImage).width(800).height(450).url() 
                      : null;
                    const logoWidth = 160;
                    const logoHeight = 96;

                    return (
                      <a href={`/featured/${brand.slug?.current}`} class="carousel-item event-card">
                        <div class="event-image-wrapper">
                          {heroUrl ? (
                            <img
                              src={heroUrl}
                              alt={brand.title}
                              loading="lazy"
                              decoding="async"
                              class="event-image"
                            />
                          ) : (
                            <div class="article-thumb-fallback" style="position: absolute; inset: 0; width: 100%; height: 100%;" aria-hidden="true"></div>
                          )}
                          <div class="event-overlay">
                            {brand.logo ? (
                              <>
                                <span class="event-card-logo-wrap">
                                  <img
                                    src={urlFor(brand.logo).height(96).url()}
                                    alt={`${brand.title} logo`}
                                    class="event-card-logo"
                                    height={logoHeight}
                                    width={logoWidth}
                                    loading="lazy"
                                  />
                                </span>
                                <h4 class="event-card-sr-title">{brand.title}</h4>
                              </>
                            ) : (
                              <h4 class="event-title line-clamp-2">{brand.title}</h4>
                            )}
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="container-page">
        <p class="featured-empty">Dedicated coverage hubs are coming soon.</p>
      </div>
    )}
  </main>
</Layout>

<script>
  function initAccordion() {
    const sections = document.querySelectorAll('.accordion-section');
    
    sections.forEach(section => {
      const header = section.querySelector('.accordion-header');
      if (!header) return;
      
      header.addEventListener('click', () => {
        // If it's already expanded, do nothing (keep one open at a time)
        if (section.classList.contains('expanded')) return;
        
        // Collapse all
        sections.forEach(s => {
          s.classList.remove('expanded');
          s.classList.add('collapsed');
        });
        
        // Expand the clicked one
        section.classList.remove('collapsed');
        section.classList.add('expanded');
      });
    });
  }

  initAccordion();
  document.addEventListener('astro:page-load', initAccordion);
</script>

<style>
  /* 
    ACCORDION LAYOUT
    Full screen cinematic takeover.
  */
  .featured-directory-page {
    width: 100%;
    /* Fill screen minus the header approx height (80px) */
    height: calc(100vh - 80px); 
    min-height: 600px;
    background: #000;
    overflow: hidden; /* Prevent page scroll, accordion does the work */
  }

  .accordion-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
  }

  .accordion-section {
    flex: 1;
    position: relative;
    overflow: hidden;
    transition: flex 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
    border-bottom: 2px solid #000;
    background: #0a0a0a;
  }

  .accordion-section.expanded {
    flex: 6; /* expanded takes 6x the space of a collapsed row */
  }

  /* THEMES: Alternate dark red and black cinematic gradients for the backgrounds */
  .accordion-section:nth-child(1) .accordion-header-bg { background: linear-gradient(135deg, rgba(138, 0, 0, 0.4) 0%, #000 100%); }
  .accordion-section:nth-child(2) .accordion-header-bg { background: linear-gradient(135deg, rgba(20, 20, 20, 0.8) 0%, #000 100%); }
  .accordion-section:nth-child(3) .accordion-header-bg { background: linear-gradient(135deg, rgba(80, 0, 0, 0.3) 0%, #000 100%); }
  .accordion-section:nth-child(4) .accordion-header-bg { background: linear-gradient(135deg, rgba(40, 40, 40, 0.5) 0%, #000 100%); }

  /* HEADER (Collapsed state) */
  .accordion-header {
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: absolute;
    inset: 0;
    z-index: 10;
  }
  
  .accordion-section.expanded .accordion-header {
    height: auto;
    position: relative;
    padding: 2rem 2rem 0 2rem;
    background: transparent;
    justify-content: flex-start;
    cursor: default; /* Not clickable to expand if already expanded */
  }

  .accordion-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6rem);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #fff;
    margin: 0;
    z-index: 2;
    transition: font-size 0.6s ease, padding 0.6s ease, text-shadow 0.3s ease;
    text-align: center;
  }
  
  /* Hover effect on collapsed rows */
  .accordion-section.collapsed:hover .accordion-title {
    color: var(--color-accent);
    text-shadow: 0 0 20px rgba(204, 0, 0, 0.4);
    transform: scale(1.02);
  }

  .accordion-section.expanded .accordion-title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    text-align: left;
    color: #fff;
    text-shadow: none;
    transform: scale(1);
  }

  .accordion-header-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }
  .accordion-section.collapsed:hover .accordion-header-bg {
    opacity: 0.9;
  }
  .accordion-section.expanded .accordion-header-bg {
    opacity: 0;
    pointer-events: none;
  }

  /* BODY (Expanded Carousel) */
  .accordion-body {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
    flex-grow: 1;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .accordion-section.expanded .accordion-body {
    opacity: 1;
    visibility: visible;
    transition-delay: 0.3s; /* fade in after expansion starts */
  }

  /* CAROUSEL TRACK */
  .carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 1rem 2rem;
    width: 100%;
    scrollbar-width: none; /* Firefox */
    align-items: center;
  }
  .carousel-track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* CAROUSEL CARDS */
  .carousel-item {
    flex-shrink: 0;
    width: clamp(280px, 30vw, 450px);
    aspect-ratio: 16 / 9;
    scroll-snap-align: center;
    border-radius: 4px; /* subtle cinematic curve */
    overflow: hidden;
    position: relative;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease;
    background: #111;
  }
  
  .carousel-item:hover {
    transform: scale(1.05);
    z-index: 10;
    box-shadow: 0 10px 40px rgba(0,0,0,0.8), 0 0 20px rgba(204,0,0,0.3);
  }

  .event-image-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .event-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .carousel-item:hover .event-image {
    transform: scale(1.02);
  }

  .event-overlay {
    position: absolute;
    inset: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
  }

  .event-card-logo-wrap {
    display: inline-block;
    max-width: 70%;
    filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.9));
  }
  
  .event-card-logo {
    max-height: 60px;
    width: auto;
    object-fit: contain;
    transition: transform 0.4s ease;
  }
  
  .carousel-item:hover .event-card-logo {
    transform: scale(1.05) translateY(-5px);
  }

  .event-card-sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .event-title {
    color: #fff;
    font-family: var(--font-display);
    margin: 0;
    font-size: 1.2rem;
  }
</style>
