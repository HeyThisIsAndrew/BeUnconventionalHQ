    z-index: 5;
    pointer-events: none;
  }
  .deck-card.active .peeking-spine {
    opacity: 0; 
  }
  .spine-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
    font-weight: 800;
    color: #fff;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .deck-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  /* Cards BEHIND the front one still lift slightly on hover — that is the
     affordance saying "click me to bring this forward". */
  .deck-card:hover .deck-card-image {
    transform: scale(1.05);
  }

  /* The front card does not. It is the subject of the composition, and a
     1.02 nudge on a 720px image is a visible drift for no information. */
  .deck-card.active:hover .deck-card-image {
    transform: none;
  }

  .deck-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; 
  }
  .deck-card.active .deck-card-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
    opacity: 0;
    pointer-events: auto; 
  }
  .deck-card.active:hover .deck-card-overlay {
    opacity: 1;
  }

  .click-to-enter-pill {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 1rem 2.5rem;
    font-weight: 900;
    border-radius: 0;
    letter-spacing: 0.1em;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s ease;
    text-transform: uppercase;
    text-decoration: none;
  }
  .click-to-enter-pill:hover {
    background: #fff;
    color: #000;
  }
  .deck-card.active:hover .click-to-enter-pill {
    transform: translateY(0);
    opacity: 1;
  }

  /* QUICK NAV TRACK */
  .deck-nav-track {
    width: 100%;
    box-sizing: border-box;
    height: 90px;
    margin-top: 1rem;
    display: flex;
    gap: 12px;
    align-items: center;
    overflow-x: auto;
    padding: 10px 5%; 
    z-index: 2; /* above glow */

    /* The scrollbar is browser chrome sitting across the bottom of a piece of
       set dressing. The rail says what it is by the way it fades. */
    scrollbar-width: none;
    -ms-overflow-style: none;

    /*
      FEATHERED EDGES, BUT ONLY WHERE THERE IS SOMETHING TO FEATHER.

      This was a fixed `transparent 0%, black 10%, black 90%, transparent`.
      The ramp is a share of the RAIL, not of what has scrolled out of it, so
      it dimmed the first and last thumbnail permanently — including when the
      rail was not scrolled at all and there was nothing beyond either edge to
      suggest. Five hubs in a row and two of them looked disabled.

      The ramps are variables at zero by default, and the script raises the
      one on whichever side actually has content off-screen. Scrolled to the
      start, the left edge is crisp and the right one fades; in the middle,
      both; with everything visible, neither.
    */
    --nav-fade-start: 0%;
    --nav-fade-end: 0%;
    -webkit-mask-image: linear-gradient(to right,
      transparent 0%, black var(--nav-fade-start),
      black calc(100% - var(--nav-fade-end)), transparent 100%);
    mask-image: linear-gradient(to right,
      transparent 0%, black var(--nav-fade-start),
      black calc(100% - var(--nav-fade-end)), transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .deck-nav-track::-webkit-scrollbar {
    display: none;
  }

  .deck-nav-track[data-overflow-start='1'] {
    --nav-fade-start: 9%;
  }

  .deck-nav-track[data-overflow-end='1'] {
    --nav-fade-end: 9%;
  }
  
  .deck-nav-track::-webkit-scrollbar {
    height: 4px;
  }
  .deck-nav-track::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
  }
  .deck-nav-track::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.2);
  }

  .deck-nav-thumb {
    width: 120px;
    height: 60px;
    flex-shrink: 0;
    background: #111;
    border: 1px solid rgba(255,255,255,0.1);
    opacity: 0.4;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
    overflow: visible; /* so tooltip can escape */
  }
  
  .deck-nav-thumb:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }
  
  .deck-nav-thumb.active {
    opacity: 1;
    border-color: var(--color-accent);
    transform: scale(1.05);
    box-shadow: 0 5px 15px rgba(204,0,0,0.4);
  }

  .nav-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav-thumb-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: #fff;
    text-transform: uppercase;
    font-weight: bold;
    padding: 0.5rem;
    text-align: center;
  }

  /* TOOLTIP */
  .custom-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(0,0,0,0.9);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 0.4rem 0.8rem;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
    z-index: 100;
    box-shadow: 0 10px 20px rgba(0,0,0,0.8);
  }
  .deck-nav-thumb:hover .custom-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* RIGHT COLUMN */
  .info-column {
    flex: 0 0 50%;
    max-width: 50%;
    position: relative;
    height: 100%;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
  }

  .info-panels-wrapper {
    position: relative;
    width: 100%;
    height: 100%; 
  }

  .brand-info-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(40px);
    transition: all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .brand-info-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  .large-trailer-card {
    position: relative;
    width: 100%;
    height: 100%;
    background: transparent;
    /* Removed overflow: hidden so left edge feathering can bleed cleanly if needed */
    border: none;
  }

  .trailer-bg-wrapper {
    position: absolute;
    top: 0;
    left: 50%;
    width: 150%;
    height: 100%;
    /* Held in a custom property because the push-in keyframes below have to
       restate the whole transform, and the compact layout needs to zero the
       shift without having to redeclare the animation too. */
    --trailer-shift: -50%;
    transform: translateX(var(--trailer-shift));
    pointer-events: none;
    z-index: 1;
    /*
      The video's edges — "no hard edges, even from the video".

      HORIZONTAL: this wrapper is 150% wide and centred, so it already spans
      -25%..125% of the info column: the video bleeds a quarter of a column
      LEFT, under the deck. The old two-stop ramp hit full opacity at 15% of
      the wrapper (x = -2.5% of the column), so the whole crossfade happened
      in a narrow band right at the seam and read as an edge. Full opacity at
      29% puts it at x = +18% of the column (-25 + 150 * 0.29), so the video
      dissolves in across a band ~43% of the column wide, straddling the seam
      instead of stopping at it.

      VERTICAL: nothing. The wrapper used to be 150% TALL as well, and relied
      on a SECOND mask layer intersected with this one to claw the overhang
      back. That is what put the video 111px below the row on desktop and
      74px below it on a landscape phone — straight over the footer — because
      `mask-composite: intersect` is the one part of this construct WebKit
      does not honour reliably. With the composite gone the two layers union
      instead, and a union of "opaque from 29% rightward" with anything is
      opaque: no vertical containment at all.

      So containment is geometric now. The wrapper is exactly as tall as its
      panel, and `mask-repeat: no-repeat` on a single layer already clears
      everything outside the wrapper's own box — including the 6% the
      push-in animation scales past it. One mask layer, no compositing, and
      the containment holds even where masks are ignored entirely.

      The soft top and bottom edges that the second layer used to provide are
      painted instead, by .trailer-gradient-top / -bottom below. A scrim over
      the video is the same result as a mask under it on a black page, and it
      cannot silently stop working.
    */
    -webkit-mask-image:
      linear-gradient(to right,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0.03) 6%, rgba(0,0,0,0.10) 11%,
        rgba(0,0,0,0.24) 15%, rgba(0,0,0,0.45) 19%, rgba(0,0,0,0.68) 22%,
        rgba(0,0,0,0.86) 25%, rgba(0,0,0,0.96) 27%, rgba(0,0,0,1) 29%,
        rgba(0,0,0,1) 100%);
    mask-image:
      linear-gradient(to right,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0.03) 6%, rgba(0,0,0,0.10) 11%,
        rgba(0,0,0,0.24) 15%, rgba(0,0,0,0.45) 19%, rgba(0,0,0,0.68) 22%,
        rgba(0,0,0,0.86) 25%, rgba(0,0,0,0.96) 27%, rgba(0,0,0,1) 29%,
        rgba(0,0,0,1) 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE BACKDROP GALLERY

     Stills, cross-fading, sharing the trailer's box so they get the same seam
     mask and the same slow push-in. This is the backdrop everywhere; the video
     is a layer over it on screens big enough to be worth the 900kB.
     ══════════════════════════════════════════════════════════════════════ */
  .backdrop-gallery {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .backdrop-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /*
      Long, and asymmetric on purpose. A quick cross-fade reads as a slideshow
      changing slides; a slow one where the outgoing frame lingers reads as a
      dissolve, which is the cut a title sequence would use.
    */
    transition: opacity 2.2s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .backdrop-layer.active {
    opacity: 1;
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE VIDEO, CROPPED PAST ITS OWN CHROME

     YouTube's branding cannot be turned off from an embed. `modestbranding`
     no longer removes the wordmark and `rel=0` no longer removes related
     videos, so the logo, the title overlay and the end-of-video state will
     surface however the player is configured — which on a dark cinematic
     backdrop looks exactly like what it is, an embedded YouTube player.

     What CAN be done is put that chrome outside the frame. Every piece of it
     is anchored to the PLAYER's own edges and corners, so an iframe sized
     132% of its box with the overflow masked away shows only the middle ~76%
     of the player: no corners, no control strip, no title bar.

     132 rather than more, because the crop is toward the centre and that is
     where a trailer's own burnt-in titling tends to sit. This is enough to
     clear the chrome and no more.

     The offset is margin, not transform: this is a cross-origin iframe and
     the push-in is deliberately carried on the wrapper for the same reason
     (see the trailerPush note) — WebKit renders transformed cross-origin
     frames badly.
  */
  .trailer-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 132%;
    height: 132%;
    margin-top: -16%;
    margin-left: -16%;
    border: none;
    z-index: 2;
    /*
      Arrives over the stills rather than replacing them, so the moment the
      player becomes ready is a dissolve rather than a cut — and a blocked or
      slow embed simply never arrives, leaving the gallery in place.
    */
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  /* `src` is only ever set by loadTrailer(), so this is true exactly when a
     real player has been asked for. */
  .trailer-iframe[src] {
    opacity: 1;
  }

  .trailer-fallback-img {
    width: 100%;
    height: 100%;
    border: none;
    object-fit: cover;
    animation: slowPan 20s linear infinite alternate;
  }
  @keyframes slowPan {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
  }

  .trailer-dark-overlay {
    position: absolute;
    /*
      Spans -25%..125% of the panel, i.e. the SAME box as .trailer-bg-wrapper.

      Pinned to the panel (inset: 0) its full-opacity end landed exactly on
      the column boundary, so however soft the gradient was to the right of
      that line, the line itself was a step: pixel-scanning a horizontal
      slice across the seam showed a jump of 21-27 at x=756 on a 1440 render.
      A gradient cannot hide its own start — the fix is to move the start off
      the seam entirely.

      Sharing the video's box means the wash is already ~0.6 alpha and still
      falling by the time it crosses the boundary, and it keeps going into
      the deck column, where .deck-column's higher z-index paints it UNDER
      the cards — so it deepens the background the deck fades into rather
      than dimming the deck itself.
    */
    top: 0;
    bottom: 0;
    left: -25%;
    width: 150%;
    background: linear-gradient(to right,
      rgba(5,5,5,1) 0%, rgba(5,5,5,0.98) 5%, rgba(5,5,5,0.93) 9%,
      rgba(5,5,5,0.84) 13%, rgba(5,5,5,0.70) 17%, rgba(5,5,5,0.53) 21%,
      rgba(5,5,5,0.36) 25%, rgba(5,5,5,0.22) 29%, rgba(5,5,5,0.11) 33%,
      rgba(5,5,5,0.04) 37%, rgba(5,5,5,0) 42%);
    z-index: 2;
    pointer-events: none;
  }

  /*
    Softens the wrapper's top cut. The mask contains the video to its own box
    now (see .trailer-bg-wrapper), which is a clean edge rather than a fade,
    and a clean edge at the top of the row reads as a letterbox bar. This
    puts the fade back as paint.
  */
  .trailer-gradient-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 22%;
    background: linear-gradient(to bottom, rgba(5,5,5,0.95) 0%, rgba(5,5,5,0.55) 45%, transparent 100%);
    z-index: 3;
    pointer-events: none;
  }

  .trailer-gradient-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 40%, transparent 100%);
    z-index: 3;
    /*
      This scrim is a VERTICAL gradient across the panel's full width, so its
      left edge was a flat vertical cut sitting on the seam — the second
      contributor to the step at x=756, and the one that showed up lower in
      the panel where the scrim is densest. Feathering its left edge lets it
      arrive with the video instead of announcing the panel.
    */
    -webkit-mask-image: linear-gradient(to right,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.10) 6%, rgba(0,0,0,0.32) 11%,
      rgba(0,0,0,0.60) 16%, rgba(0,0,0,0.84) 21%, rgba(0,0,0,0.96) 25%,
      rgba(0,0,0,1) 29%);
    mask-image: linear-gradient(to right,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.10) 6%, rgba(0,0,0,0.32) 11%,
      rgba(0,0,0,0.60) 16%, rgba(0,0,0,0.84) 21%, rgba(0,0,0,0.96) 25%,
      rgba(0,0,0,1) 29%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }


  /* ══════════════════════════════════════════════════════════════════════
     THE BRAND PLATE — logo, line, and way in, all ON THE ARTWORK.

     This replaces a block of trailer-corner styles (`.trailer-bottom-content`,
     `.trailer-logo-wrap`, `.trailer-text-title`, `.brand-desc`,
     `.dynamic-brand-btn`) that positioned the same three things over the
     video in the other column.

     Two reasons they moved. The first is structural: at phone widths the
     trailer panel is about 200px tall and that stack is about 165px, so it
     filled the video and collided with YouTube's own title overlay and
     control bar — the "crammed" portrait layout, and it was a collision, not
     a spacing problem. The second is compositional: a hub had its identity on
     one surface and its artwork on another, and neither could win.

     The site already solves this for video cards — `.video-watermark` in
     ContentCard.astro sits the mark bottom-left over the frame — so hubs use
     the same idea at poster scale.
     ══════════════════════════════════════════════════════════════════════ */

  .deck-card-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    /*
      Multi-stop rather than a two-stop ramp, for the same reason the seam
      feather is: a linear alpha ramp shows its own endpoints as faint bands
      across the artwork.
    */
    background: linear-gradient(to top,
      rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.86) 12%, rgba(0,0,0,0.72) 24%,
      rgba(0,0,0,0.52) 36%, rgba(0,0,0,0.31) 48%, rgba(0,0,0,0.15) 60%,
      rgba(0,0,0,0.05) 72%, transparent 84%);
  }

  .deck-card.active .deck-card-scrim {
    opacity: 1;
  }

  .deck-card-plate {
    position: absolute;
    left: 2rem;
    bottom: 1.9rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    /* Leaves room for the Enter chip on the opposite corner. */
    max-width: calc(100% - 2rem - 11rem);
    pointer-events: none;
  }

  /* HARD RULE 6: drop-shadow lives on the WRAPPER, never the <img>. */
  .deck-card-logo-wrap {
    display: block;
    filter: drop-shadow(0 6px 16px rgba(0,0,0,0.95));
  }

  .deck-card-logo {
    display: block;
    height: 40px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* Stand-in for a hub with no logo asset. Same weight on the page as a
     wordmark would be, so the layout does not shift when artwork arrives. */
  .deck-card-wordmark {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-shadow: 0 6px 18px rgba(0,0,0,0.95);
  }

  /*
    The billing block. Small, tracked out and dim on purpose — on a poster
    this is the line nobody reads first, and that is exactly its job here.
  */
  .deck-card-desc {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.6;
    text-shadow: 0 2px 8px rgba(0,0,0,0.95);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /*
    THE CHIP IS A SIGNPOST, NOT A CONTROL.

    The whole card is the link now, so this must not look like a second,
    separate target sitting on it. It is unfilled, hairline and quiet at
    rest, and it answers the card's own hover and focus rather than its own —
    which is what tells you the artwork is the thing you are pressing.

    The brand colour arrives only on that hover. Held as a TRANSLUCENT tint
    over the dark card rather than a solid fill, so the label stays legible
    whatever hex a hub is given in the CMS, white included (Apple TV+, A24,
    Universal and Sony Pictures are all set to white, and a solid fill made
    the label vanish on every one of them).
  */
  .deck-card-enter {
    position: absolute;
    right: 2rem;
    bottom: 1.9rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    pointer-events: none;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    transition:
      border-color 0.35s cubic-bezier(0.25, 0.8, 0.2, 1),
      background-color 0.35s cubic-bezier(0.25, 0.8, 0.2, 1),
      box-shadow 0.35s cubic-bezier(0.25, 0.8, 0.2, 1),
      color 0.35s cubic-bezier(0.25, 0.8, 0.2, 1);
  }

  .deck-card-enter svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.2, 1);
  }

  .deck-card.active:hover .deck-card-enter,
  .deck-card.active:focus-visible .deck-card-enter {
    border-color: rgba(var(--brand-rgb, 204, 0, 0), 0.85);
    background-color: rgba(var(--brand-rgb, 204, 0, 0), 0.18);
    box-shadow:
      0 0 34px rgba(var(--brand-rgb, 204, 0, 0), 0.32),
      inset 0 0 22px rgba(var(--brand-rgb, 204, 0, 0), 0.12);
    color: #fff;
  }

  .deck-card.active:hover .deck-card-enter svg,
  .deck-card.active:focus-visible .deck-card-enter svg {
    transform: translateX(4px);
  }

  /* Only the front card is branded. The ones behind it are silhouettes. */
  .deck-card:not(.active) .deck-card-plate,
  .deck-card:not(.active) .deck-card-enter {
    opacity: 0;
  }

  /* The card is an <a>; it must not inherit link chrome. */
  .deck-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .deck-card.active:focus-visible {
    outline: 2px solid rgba(var(--brand-rgb, 204, 0, 0), 0.9);
    outline-offset: 3px;
  }


  /*
    The front card is a link in behaviour, so it should say so on hover.
    The cards behind it still mean "bring me forward".
  */
  .deck-card.active {
    cursor: pointer;
  }


  /* ══════════════════════════════════════════════════════════════════════
     MOBILE  (issue #138, handoff item 1)

     The desktop layout is two hard 50% flex columns side by side. Below
     768px that is unusable — each column gets ~190px, the deck cards become
     illegible slivers and the trailer's bottom content has nowhere to go.

     Per the ticket this is re-fitted with real media queries, NOT reverted to
     a grid: the columns stay flex and simply stack, video on top (40%) and
     deck below (60%). DOM order is deck-then-info, so `order` does the
     reordering — CSS, not JS and not duplicated markup (hard rule 7).

     The 3D deck keeps its stacked metaphor and just compresses its spread,
     rather than flattening to a carousel, so the interaction a phone user
     gets is the same one the desktop design established.
     ══════════════════════════════════════════════════════════════════════ */
  /* ══════════════════════════════════════════════════════════════════════
     STAGING — how an open row arrives, and how it keeps moving.

     Everything below is about TIMING and MOTION rather than decoration.
     Opening a row used to reveal every part of it at the same instant, which
     is what made the page feel like a screenshot appearing rather than a
     scene starting. Now the pieces land on a beat: artwork, then the
     thumbnail strip, then the brand mark, then the words. It reads as
     something being presented to you.

     Each piece starts slightly low and faded and settles into place. The
     delays are the whole point — they are what a title sequence does.
     ══════════════════════════════════════════════════════════════════════ */

  .deck-stack,
  .deck-nav-track,
  .deck-card-plate,
  .deck-card-enter {
    opacity: 0;
    transition:
      opacity 0.7s ease,
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The artwork leads, and only fades — its transform belongs to the drift
     below, and two rules fighting over one transform is how motion bugs
     start. */
  .accordion-section.expanded .deck-stack {
    opacity: 1;
    transition-delay: 0.34s;
  }

  .deck-nav-track,
  .deck-card-plate,
  .deck-card-enter {
    transform: translateY(16px);
  }

  .accordion-section.expanded .deck-nav-track {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.52s;
  }

  /* The mark and its line ride the artwork in, a beat behind it. Scoped to
     the ACTIVE card so the silhouettes behind stay unbranded — this rule and
     the `:not(.active)` one above are the same statement from both sides. */
  .accordion-section.expanded .deck-card.active .deck-card-plate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.62s;
  }

  .accordion-section.expanded .deck-card.active .deck-card-enter {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.74s;
  }

  /*
     THE TRAILER BREATHES.

     A still frame with gradients over it reads as a hero image, not a scene.
     A very slow, very small push-in is the difference — it is the same trick
     a documentary uses on a photograph. 32 seconds and 6% is deliberately
     below the threshold where you notice it happening; you only notice that
     the panel feels alive.

     The move is carried on the wrapper, not the video element itself,
     because transforming a cross-origin video frame directly is exactly the
     kind of thing WebKit renders badly.
  */
  @keyframes trailerPush {
    from {
      transform: translateX(var(--trailer-shift, -50%)) scale(1);
    }
    to {
      transform: translateX(var(--trailer-shift, -50%)) scale(1.06);
    }
  }

  .accordion-section.expanded .brand-info-panel.active .trailer-bg-wrapper {
    animation: trailerPush 32s ease-in-out infinite alternate;
  }

  /*
     THE DECK DRIFTS AGAINST IT.

     As the pointer moves across an open row, the artwork slides a few pixels
     one way and the backlight a little further. Because the trailer is
     pushing in on its own clock and the deck answers the pointer, the two
     halves are never moving together — which is what sells depth. The
     numbers are small on purpose: this should feel like the scene has weight,
     not like the page is wobbling.
  */
  /*
    THE ARTWORK DOES NOT DRIFT.

    The deck stack used to translate with the pointer, which meant the big
    image wandered a few pixels whenever the mouse moved anywhere in the row
    — reported as "it randomly moves without doing anything". Depth now comes
    entirely from the backlight behind it (below) and the trailer's slow push
    on the other side, both of which move while the subject stays put. That is
    the more filmic arrangement anyway: the camera moves, the subject holds.
  */
  .deck-stack {
    transition: opacity 0.7s ease;
  }

  .ambient-glow-container {
    transform: translate3d(
      calc(var(--drift-x, 0) * -22px),
      calc(var(--drift-y, 0) * -14px),
      0
    );
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ─── TEMPORARY typography demo + picker ───────────────────────────────
     Each face is declared once and reached two ways: by `data-demo-font` on
