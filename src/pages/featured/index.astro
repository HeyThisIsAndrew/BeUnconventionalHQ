  /* ══════════════════════════════════════════════════════════════════════
     COMPACT  — phones in portrait, and anything too SHORT for two columns.

     The desktop layout is two 50% columns side by side. That needs both
     width and height: a landscape phone clears the width test at 926px and
     fails the height one at 428px, which is why it was getting the desktop
     rules and overflowing them. The query asks about both.

     Stacking the columns was the old answer and it is what made portrait
     feel crammed: video 40% / deck 60% left roughly 200px for each, and the
     trailer's overlaid text (~165px of it) filled its share completely and
     spilled onto the video and onto YouTube's own title and control bars.

     So the columns do not stack any more — the trailer leaves the layout
     entirely and becomes the plate BEHIND the row, with the artwork on top
     of it. Same square footage, one thing in it instead of two, and the
     branding is on the artwork where it now lives at every size.
     ══════════════════════════════════════════════════════════════════════ */
  @media (max-width: 768px), (max-height: 560px) {
    .deck-view-container {
      flex-direction: column;
      padding: 0;
      position: relative;
    }

    /* Out of the flow, behind everything. */
    .info-column {
      position: absolute;
      inset: 0;
      flex: none;
      max-width: none;
      width: 100%;
      height: 100%;
      z-index: 0;
      display: block;
    }

    .deck-column {
      position: relative;
      z-index: 2;
      flex: 1 1 auto;
      max-width: 100%;
      width: 100%;
      height: 100%;
      min-height: 0;
      /*
        Poster and rail read as ONE object, centred in the row.

        With the stack taking all the leftover height the card was centred in
        a 389px box while the rail stayed pinned 120px below it, so the two
        halves of the same control floated apart with the row's slack sitting
        between them. Centring the pair puts the slack around the group
        instead, where it is the space the backing plate shows through.
      */
      justify-content: center;
    }

    /* ── Deck ────────────────────────────────────────────────────────────
       The card can no longer be sized from width alone. On a 926px landscape
       phone the row is only ~355px tall, so a card at 94% of the width would
       be 490px tall and simply not fit — the same "sized by one axis on a
       screen constrained by the other" mistake that put the video over the
       footer.

       So the stack becomes a size container and the card takes whichever of
       the two limits binds first: 94% of the stack's width, or the width
       that makes it 94% of the stack's HEIGHT (94 x 16/9 = 167). One
       declaration, correct in both orientations, no second breakpoint.

       Grid replaces the absolute + negative-margin centring it used to need:
       every card occupies the same cell and `place-items: center` holds them
       there, which leaves `transform` free for the deck offsets instead of
       having it fight a `margin-top` that had to be recomputed by hand
       whenever the width changed. */
    .deck-stack {
      /*
        NO `aspect-ratio` HERE, however tempting.

        Giving the stack an intrinsic 16/9 height closes the gap between the
        poster and the rail, and it also gives every COLLAPSED row a ~220px
        min-content height — their bodies are hidden but still laid out. The
        four rows then stop fitting the viewport and the page grows to 1290px
        with the last row's content running past the footer. The accordion
        only fits the screen because nothing inside it has an intrinsic
        height, and that has to stay true.

        So the stack still takes the leftover space, and the slack around the
        poster is filled by the backing plate showing through rather than by
        making the box smaller.
      */
      container-type: size;
      display: grid;
      grid-template: 1fr / 1fr;
      place-items: center;
      /* The right-edge feather aimed at a column that is no longer there. */
      -webkit-mask-image: none;
      mask-image: none;
    }

    .deck-card {
      position: relative;
      grid-area: 1 / 1;
      top: auto;
      left: auto;
      margin-top: 0;
      width: min(94cqw, 167cqh);
    }

    /* Compressed spread: the desktop 25% / 45% offsets push the second and
       third cards off a 390px screen entirely. */
    .deck-card.next-1 {
      transform: translateX(14%) scale(0.92);
    }

    .deck-card.next-2 {
      transform: translateX(25%) scale(0.85);
    }

    .deck-card.hidden {
      transform: translateX(36%) scale(0.78);
    }

    .peeking-spine {
      width: 34px;
    }

    .spine-text {
      font-size: 1rem;
      letter-spacing: 0.05em;
    }

    .deck-nav-track {
      height: 66px;
      margin-top: 0.5rem;
      padding: 6px 4%;
      gap: 8px;
      flex: 0 0 auto;
    }

    .deck-nav-thumb {
      width: 84px;
      height: 46px;
    }

    /* Hover tooltips are meaningless on touch and stick after a tap. */
    .custom-tooltip {
      display: none;
    }

    /* ── Trailer, now the backing plate ──────────────────────────────────
       Full width, no seam to feather, and pushed a long way down: it is
       behind the artwork, so anything it does with contrast is competing
       with the thing you are meant to be looking at. */
    .trailer-bg-wrapper {
      --trailer-shift: 0%;
      left: 0;
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }

    /* Belt and braces with the script's compact guard: even if a trailer were
       somehow given a src here, it would not paint over the stills. */
    .trailer-iframe {
      display: none;
    }

    .trailer-dark-overlay {
      left: 0;
      width: 100%;
      /* Dark enough that the poster stays the brightest thing in the row,
         light enough that the space around it reads as a scene rather than
         as an empty box. */
      background:
        linear-gradient(to bottom, rgba(5,5,5,0.78) 0%, rgba(5,5,5,0.46) 45%, rgba(5,5,5,0.86) 100%);
    }

    .trailer-gradient-top {
      height: 30%;
    }

    .trailer-gradient-bottom {
      height: 40%;
    }

    /* ── Brand plate on the card ─────────────────────────────────────────
       Corners pull in and the type comes down a step, but the arrangement is
       the desktop one. */
    .deck-card-plate {
      left: 1rem;
      bottom: 1rem;
      gap: 0.45rem;
      max-width: calc(100% - 1rem - 7.5rem);
    }

    .deck-card-logo {
      height: 26px;
    }

    .deck-card-wordmark {
      font-size: 1.15rem;
    }

    .deck-card-enter {
      right: 1rem;
      bottom: 1rem;
      padding: 0.5rem 0.9rem;
      font-size: 0.62rem;
      letter-spacing: 0.2em;
    }

    .deck-card-enter svg {
      width: 12px;
      height: 12px;
    }

    /* The blur radius is a fixed 120px, which on a 390px-wide column washes
       the whole deck out instead of backlighting the active card. */
    .ambient-glow-layer {
      -webkit-filter: blur(60px) saturate(1.5);
      filter: blur(60px) saturate(1.5);
    }
  }

  /* ── Phone-width only ──────────────────────────────────────────────────
     Sizes that depend on a NARROW screen rather than a short one. A landscape
