      transition: none;
    }

    .trailer-fallback-img,
    .accordion-section.expanded .brand-info-panel.active .trailer-bg-wrapper {
      animation: none;
    }

    /* The backlight is the only thing still tracking the pointer. */
    .ambient-glow-container {
      transform: none;
    }

    /* The staged entrance is a nice-to-have; being able to read the row is
       not. With the transitions off, everything must simply BE there. */
    .accordion-section.expanded .deck-stack,
    .accordion-section.expanded .deck-nav-track,
    .accordion-section.expanded .deck-card.active .deck-card-plate,
    .accordion-section.expanded .deck-card.active .deck-card-enter {
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
  }
