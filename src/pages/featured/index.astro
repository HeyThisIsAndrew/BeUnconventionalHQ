---
import Layout from '../../layouts/Layout.astro';
import SubscribeCTA from '../../components/SubscribeCTA.astro';
import { getFeaturedBrandsLocal, urlFor } from '../../lib/local-content';

const brands = await getFeaturedBrandsLocal();

const categoryMap: Record<string, string> = {
  'marvel-comics': 'universes',
  'dc-comics': 'universes',
  'netflix': 'streaming',
  'prime-video': 'streaming',
  'max': 'streaming',
  'apple-tv-plus': 'streaming',
  'disney-plus': 'streaming',
  'hulu': 'streaming',
  'warner-bros': 'studios',
  'universal': 'studios',
  'sony-pictures': 'studios',
  'a24': 'studios',
  'playstation': 'gaming',
  'nintendo': 'gaming',
  'xbox': 'gaming'
};

const categoryLabels: Record<string, string> = {
  'universes': 'The Multiverse',
  'streaming': 'Streamers',
  'studios': 'Studios',
  'gaming': 'Gaming'
};

const groupedBrands = brands.reduce((acc, brand) => {
  const category = categoryMap[brand.slug?.current || ''] || 'other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(brand);
  return acc;
}, {} as Record<string, typeof brands>);

const desiredOrder = ['universes', 'streaming', 'studios', 'gaming'];
const sortedCategories = Object.keys(groupedBrands).sort((a, b) => {
  const indexA = desiredOrder.indexOf(a);
  const indexB = desiredOrder.indexOf(b);
  if (indexA === -1 && indexB === -1) return 0;
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});



const brandMeta = {
  'marvel-comics': { color: '#E23636', rgb: '226, 54, 54', desc: 'Presenting Marvel, the MCU, and Marvel Games.' },
  'dc-comics': { color: '#0476F2', rgb: '4, 118, 242', desc: 'Presenting DC, the DCU, and DC Games.' },
  'netflix': { color: '#E50914', rgb: '229, 9, 20', desc: 'The definitive source for Netflix Originals, series, and films.' },
  'prime-video': { color: '#00A8E1', rgb: '0, 168, 225', desc: 'The definitive source for Amazon Originals and Prime Video exclusives.' },
  'max': { color: '#002BE7', rgb: '0, 43, 231', desc: 'Presenting HBO, Max Originals, and Warner Bros. Discovery streams.' },
  'apple-tv-plus': { color: '#FFFFFF', rgb: '255, 255, 255', desc: 'The definitive source for Apple Original films and series.' },
  'disney-plus': { color: '#113CCF', rgb: '17, 60, 207', desc: 'Presenting Disney, Pixar, Marvel, and Star Wars streams.' },
  'hulu': { color: '#1CE783', rgb: '28, 231, 131', desc: 'The definitive source for Hulu Originals and FX exclusives.' },
  'warner-bros': { color: '#002BE7', rgb: '0, 43, 231', desc: 'Presenting Warner Bros. Pictures and the WB catalog.' },
  'universal': { color: '#FFFFFF', rgb: '255, 255, 255', desc: 'Presenting Universal Pictures, Illumination, and DreamWorks.' },
  'sony-pictures': { color: '#FFFFFF', rgb: '255, 255, 255', desc: 'Presenting Sony Pictures, Columbia, and Sony Animation.' },
  'a24': { color: '#FFFFFF', rgb: '255, 255, 255', desc: 'The definitive source for A24 films and independent cinema.' },
  'playstation': { color: '#00439C', rgb: '0, 67, 156', desc: 'Presenting PlayStation Studios, PS5, and exclusive titles.' },
  'nintendo': { color: '#E60012', rgb: '230, 0, 18', desc: 'Presenting Nintendo, the Switch, and iconic franchises.' },
  'xbox': { color: '#107C10', rgb: '16, 124, 16', desc: 'Presenting Xbox Game Studios, Game Pass, and Series X|S.' }
};

function extractYoutubeId(url: string) {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:.*v=|.*\/))([^"&?\s]{11})/);
  return match ? match[1] : null;
}
---

<Layout title="Featured Hubs">
  <main class="featured-directory-page">
    {sortedCategories.length > 0 ? (
      <div class="accordion-container animate-on-scroll">
        {sortedCategories.map((category, index) => {
          let categoryBrands = groupedBrands[category];
          if (category === 'gaming') {
            const gamingOrder = ['playstation', 'nintendo', 'xbox'];
            categoryBrands = categoryBrands.sort((a, b) => {
              const aIdx = gamingOrder.indexOf(a.slug?.current || '');
              const bIdx = gamingOrder.indexOf(b.slug?.current || '');
              if (aIdx === -1 && bIdx === -1) return 0;
              if (aIdx === -1) return 1;
              if (bIdx === -1) return -1;
              return aIdx - bIdx;
            });
          }

          const isExpanded = index === 0;

          return (
            <div class={`accordion-section ${isExpanded ? 'expanded' : 'collapsed'}`} data-category={category}>
              
              <div class="accordion-header">
                <div class="accordion-header-bg"></div>
                <h2 class="accordion-title">{categoryLabels[category] || category}</h2>
              </div>

              <div class="accordion-body">
                <div class="deck-view-container">
                  
                  <div class="deck-column">
                    
                    {/* AMBIENT GLOW BACKLIGHT */}
                    <div class="ambient-glow-container">
                       {categoryBrands.map((brand, bIndex) => {
                         const glowUrl = brand.heroImage ? urlFor(brand.heroImage).width(100).url() : null;
                         return (
                            <div class={`ambient-glow-layer ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex} style={glowUrl ? `background-image: url(${glowUrl})` : ''}></div>
                         );
                       })}
                    </div>

                    <div class="deck-stack">
                      {categoryBrands.map((brand, bIndex) => {
                        const heroUrl = brand.heroImage ? urlFor(brand.heroImage).width(1200).height(1600).url() : null;
                        const metaCard = brandMeta[brand.slug?.current] || { rgb: "204, 0, 0" };
                        return (
                          <div class={`deck-card ${bIndex === 0 ? "active" : bIndex === 1 ? "next-1" : bIndex === 2 ? "next-2" : "hidden"}`} data-index={bIndex} data-brand-rgb={metaCard.rgb}>

                            <div class="peeking-spine">
                               <span class="spine-text">{brand.title}</span>
                            </div>

                            {heroUrl ? (
                              <img src={heroUrl} alt={brand.title} loading="lazy" class="deck-card-image" />
                            ) : (
                              <div class="article-thumb-fallback"></div>
                            )}
                            
                            <div class="deck-card-overlay">
                               <a href={`/featured/${brand.slug?.current}`} class="click-to-enter-pill">
                                 ENTER HUB
                               </a>
                            </div>
                          </div>
                        );
                      })}
                    </div>

                    <div class="deck-nav-track">
                      {categoryBrands.map((brand, bIndex) => {
                         const heroUrl = brand.heroImage ? urlFor(brand.heroImage).width(400).height(200).url() : null;
                         return (
                           <div class={`deck-nav-thumb ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex}>
                             
                             {/* TOOLTIP */}
                             <div class="custom-tooltip">{brand.title}</div>

                             {heroUrl ? (
                                <img src={heroUrl} alt={brand.title} loading="lazy" class="nav-thumb-img" />
                             ) : (
                                <div class="nav-thumb-fallback">{brand.title}</div>
                             )}
                           </div>
                         );
                      })}
                    </div>
                  </div>

                  <div class="info-column">
                    <div class="info-panels-wrapper">
                      {categoryBrands.map((brand, bIndex) => {
                        const ytId = extractYoutubeId(brand.trailerUrl || '');
                        const ytSrc = ytId ? `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&mute=1&loop=1&playlist=${ytId}&controls=0&modestbranding=1&showinfo=0&rel=0` : null;
                        const heroUrl = brand.heroImage ? urlFor(brand.heroImage).width(1200).height(800).url() : null;
                        const meta = brandMeta[brand.slug?.current] || { color: 'var(--color-accent)', desc: `The definitive source for ${brand.title} intel, trailers, and updates.` };

                        return (
                          <div class={`brand-info-panel ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex} style={`--brand-color: ${meta.color};`}>
                            <div class="large-trailer-card">
                              
                              <div class="trailer-bg-wrapper">
                                {ytSrc ? (
                                  <iframe class="trailer-iframe" data-src={ytSrc} allow="autoplay; encrypted-media" tabindex="-1"></iframe>
                                ) : heroUrl ? (
                                  <img src={heroUrl} class="trailer-fallback-img" alt={brand.title} />
                                ) : (
                                  <div class="article-thumb-fallback"></div>
                                )}
                              </div>

                              <div class="trailer-dark-overlay"></div>
                              <div class="trailer-gradient-bottom"></div>

                              <div class="trailer-bottom-content">
                                {brand.logo ? (
                                  <img src={urlFor(brand.logo).height(120).url()} alt={`${brand.title} logo`} class="trailer-logo" />
                                ) : (
                                  <h3 class="trailer-text-title">{brand.title}</h3>
                                )}
                                <div class="trailer-text-btn-row">
                                  <a href={`/featured/${brand.slug?.current}`} class="cta-button-primary dynamic-brand-btn">ENTER {brand.title}</a>
                                  <p class="brand-desc">{meta.desc}</p>
                                </div>
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="container-page">
        <p class="featured-empty">Dedicated coverage hubs are coming soon.</p>
      </div>
    )}
  </main>
</Layout>

<script>
  let audioCtx = null;
  function playCinematicThud() {
    try {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.type = 'sine';
      // Deep frequency drop
      osc.frequency.setValueAtTime(100, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(20, audioCtx.currentTime + 0.3);
      
      // Volume envelope
      gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
      
      osc.start();
      osc.stop(audioCtx.currentTime + 0.3);
    } catch(e) {
      // Ignore if AudioContext is not supported or locked
    }
  }

  function initAccordionAndDecks() {
    const sections = document.querySelectorAll('.accordion-section');
    sections.forEach(section => {
      const header = section.querySelector('.accordion-header');
      if (!header) return;
      
      if (!header.dataset.hasClickListener) {
        header.dataset.hasClickListener = 'true';
        header.addEventListener('click', () => {
          if (section.classList.contains('expanded')) return;
          playCinematicThud();
          
          sections.forEach(s => {
            s.classList.remove('expanded');
            s.classList.add('collapsed');
            const iframes = s.querySelectorAll('.trailer-iframe');
            iframes.forEach(iframe => { iframe.src = ''; });
          });
          
          section.classList.remove('collapsed');
          section.classList.add('expanded');

          const activeCard = section.querySelector('.deck-card.active');
          if (activeCard) {
             const activeIdx = activeCard.getAttribute('data-index');
             const activePanel = section.querySelector(`.brand-info-panel[data-index="${activeIdx}"]`);
             if (activePanel) {
               const iframe = activePanel.querySelector('.trailer-iframe');
               if (iframe && !iframe.src && iframe.dataset.src) {
                 iframe.src = iframe.dataset.src;
               }
             }
          }
        });
      }

      const cards = Array.from(section.querySelectorAll('.deck-card'));
      const navThumbs = Array.from(section.querySelectorAll('.deck-nav-thumb'));
      const infoPanels = Array.from(section.querySelectorAll('.brand-info-panel'));
      const glowLayers = Array.from(section.querySelectorAll('.ambient-glow-layer'));
      
      let activeIndex = 0;
      cards.forEach((c, idx) => {
        if (c.classList.contains('active')) activeIndex = idx;
      });

      if (section.classList.contains('expanded')) {
        const firstIframe = infoPanels[activeIndex]?.querySelector('.trailer-iframe');
        if (firstIframe && firstIframe.dataset.src && !firstIframe.src) {
          firstIframe.src = firstIframe.dataset.src;
        }
      }

      function renderDeck() {
        cards.forEach((card, i) => {
          // Clear any inline styles from parallax before applying classes
          card.style.transform = ''; 
          
          card.className = 'deck-card'; 
          infoPanels[i].className = 'brand-info-panel';
          
          if (navThumbs[i]) navThumbs[i].className = 'deck-nav-thumb';
          if (glowLayers[i]) glowLayers[i].className = 'ambient-glow-layer';

          const iframe = infoPanels[i].querySelector('.trailer-iframe');


          if (i === activeIndex) {
            card.classList.add('active');
            infoPanels[i].classList.add('active');
            if (navThumbs[i]) navThumbs[i].classList.add('active');
            if (glowLayers[i]) glowLayers[i].classList.add('active');
            
            // Set dynamic left row color
            const brandRgb = card.getAttribute('data-brand-rgb');
            if (brandRgb) {
              section.style.setProperty('--category-accent-rgb', brandRgb);
            }


            if (iframe && !iframe.src && iframe.dataset.src) {
              iframe.src = iframe.dataset.src;
            }
          } else if (i === (activeIndex + 1) % cards.length) {
            card.classList.add('next-1');
            if (iframe && iframe.src) iframe.src = ''; 
          } else if (i === (activeIndex + 2) % cards.length) {
            card.classList.add('next-2');
            if (iframe && iframe.src) iframe.src = '';
          } else {
            card.classList.add('hidden');
            if (iframe && iframe.src) iframe.src = '';
          }
        });
      }

      // Deck Stack Clicks & Parallax
      cards.forEach((card, i) => {
        if (!card.dataset.hasClickListener) {
          card.dataset.hasClickListener = 'true';
          card.addEventListener('click', (e) => {
            if (i !== activeIndex) {
              e.preventDefault();
              e.stopPropagation();
              activeIndex = i;
              playCinematicThud();
              renderDeck();
            }
          });

          // Parallax hover depth on active card
          card.addEventListener('mousemove', (e) => {
            if (i !== activeIndex) return;
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            // Max rotation of 3 degrees
            const rotateX = ((y - centerY) / centerY) * -3; 
            const rotateY = ((x - centerX) / centerX) * 3;
            card.style.transform = `perspective(1000px) scale(1) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          });
          card.addEventListener('mouseleave', () => {
            if (i === activeIndex) {
              // Smoothly reset
              card.style.transform = `translateX(0) scale(1)`;
            }
          });
        }
      });

      // Quick Nav Thumb Clicks
      navThumbs.forEach((thumb, i) => {
        if (!thumb.dataset.hasClickListener) {
          thumb.dataset.hasClickListener = 'true';
          thumb.addEventListener('click', (e) => {
            if (i !== activeIndex) {
              e.preventDefault();
              e.stopPropagation();
              activeIndex = i;
              playCinematicThud();
              renderDeck();
            }
          });
        }
      });
    });
  }

  initAccordionAndDecks();
  document.addEventListener('astro:page-load', initAccordionAndDecks);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@700&family=Oswald:wght@700&family=Syncopate:wght@700&display=swap');

  .featured-directory-page {
    width: 100%;
    padding-top: var(--header-height, 80px);
    height: 100vh;
    min-height: 750px;
    background: #000;
    overflow: hidden;
  }

  .accordion-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .accordion-section {
    flex: 1;
    position: relative;
    overflow: hidden;
    transition: flex 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
    background: #050505;
  }

  .accordion-section.expanded {
    flex: 8; 
  }

  .accordion-header-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.6;
    background: linear-gradient(to right, rgba(var(--category-accent-rgb, 100, 0, 0), 0.75) 0%, rgba(0, 0, 0, 0.95) 60%);
    transition: opacity 0.4s ease, background 0.4s ease;
  }
  
  .accordion-section.collapsed:hover .accordion-header-bg {
    opacity: 1;
    background: linear-gradient(to right, rgba(var(--category-accent-rgb, 153, 0, 0), 0.95) 0%, rgba(0, 0, 0, 0.95) 60%);
  }
  
  .accordion-section.expanded .accordion-header-bg {
    opacity: 0;
    pointer-events: none;
  }

  .accordion-header {
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-left: 5vw;
    cursor: pointer;
    position: absolute;
    inset: 0;
    z-index: 10;
  }
  
  .accordion-section.expanded .accordion-header {
    height: auto;
    position: relative;
    padding: 1.5rem 5vw 1rem 5vw;
    background: transparent;
    cursor: default;
  }

  .accordion-title {
    font-family: 'Helvetica Neue', Helvetica, -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
    font-weight: 900; 
    letter-spacing: -0.04em; 
    color: rgba(255, 255, 255, 0.7); 
    margin: 0;
    z-index: 2;
    transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .accordion-section.collapsed:hover .accordion-title {
    color: #fff;
    transform: scale(1.02) translateX(10px);
  }

  .accordion-section.expanded .accordion-title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    color: #fff;
    letter-spacing: -0.02em;
    transform: none;
  }

  .accordion-body {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease;
    flex-grow: 1;
    height: 100%;
    width: 100%;
    position: relative;
  }
  .accordion-section.expanded .accordion-body {
    opacity: 1;
    visibility: visible;
    transition-delay: 0.3s;
  }

  .deck-view-container {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0 0 0 5vw; /* Full bleed on right and bottom */
  }

  .deck-column {
    flex: 0 0 50%;
    max-width: 50%;
    position: relative;
    height: 100%;
    z-index: 20;
    display: flex;
    flex-direction: column;
  }

  /* AMBIENT GLOW */
  .ambient-glow-container {
    position: absolute;
    inset: -20%; /* bleed outwards */
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ambient-glow-layer {
    position: absolute;
    inset: -10%;
    background-size: cover;
    background-position: center;
    -webkit-filter: blur(120px) saturate(1.5);
    filter: blur(120px) saturate(1.5);
    -webkit-mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 65%);
    mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 65%);
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .ambient-glow-layer.active {
    opacity: 0.4; 
  }

  .deck-stack {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 0; 
    z-index: 2;
    /* Feather out the cards on the right side into the right column */
    -webkit-mask-image: linear-gradient(to left, transparent 0%, rgba(0,0,0,0.2) 20%, black 60%);
    mask-image: linear-gradient(to left, transparent 0%, rgba(0,0,0,0.2) 20%, black 60%);
  }

  .deck-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 80%;
    height: 95%;
    border-radius: 0; 
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.9);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), 
                opacity 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
                z-index 0s;
    background: #111;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .deck-card.active {
    z-index: 10;
    transform: translateX(0) scale(1);
    opacity: 1;
  }
  
  .deck-card.next-1 {
    z-index: 9;
    transform: translateX(25%) scale(0.9);
    opacity: 0.8;
  }
  
  .deck-card.next-2 {
    z-index: 8;
    transform: translateX(45%) scale(0.8);
    opacity: 0.5;
  }
  
  .deck-card.hidden {
    z-index: 1;
    transform: translateX(65%) scale(0.7);
    opacity: 0;
    pointer-events: none;
  }

  .peeking-spine {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 60px;
    background: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.9) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.5s ease;
    z-index: 5;
    pointer-events: none;
  }
  .deck-card.active .peeking-spine {
    opacity: 0; 
  }
  .spine-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
    font-weight: 800;
    color: #fff;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .deck-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .deck-card:hover .deck-card-image {
    transform: scale(1.05);
  }
  .deck-card.active:hover .deck-card-image {
    transform: scale(1.02); 
  }

  .deck-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; 
  }
  .deck-card.active .deck-card-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
    opacity: 0;
    pointer-events: auto; 
  }
  .deck-card.active:hover .deck-card-overlay {
    opacity: 1;
  }

  .click-to-enter-pill {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 1rem 2.5rem;
    font-weight: 900;
    border-radius: 0;
    letter-spacing: 0.1em;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s ease;
    text-transform: uppercase;
    text-decoration: none;
  }
  .click-to-enter-pill:hover {
    background: #fff;
    color: #000;
  }
  .deck-card.active:hover .click-to-enter-pill {
    transform: translateY(0);
    opacity: 1;
  }

  /* QUICK NAV TRACK */
  .deck-nav-track {
    width: 100%;
    box-sizing: border-box;
    height: 90px;
