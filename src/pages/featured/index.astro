    .deck-card-desc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-section,
    .deck-card,
    .brand-info-panel,
    .accordion-title,
    .ambient-glow-layer,
    .ambient-glow-container,
    .deck-stack,
    .deck-nav-track,
    .deck-card-plate,
    .deck-card-enter,
    .deck-card-scrim,
