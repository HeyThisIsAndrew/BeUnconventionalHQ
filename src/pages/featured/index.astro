      rgba(5,5,5,1) 0%, rgba(5,5,5,0.98) 5%, rgba(5,5,5,0.93) 9%,
      rgba(5,5,5,0.84) 13%, rgba(5,5,5,0.70) 17%, rgba(5,5,5,0.53) 21%,
