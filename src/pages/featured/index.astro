    opacity: 1;
    visibility: visible;
    transition-delay: 0.3s;
  }

  .deck-view-container {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0 0 0 5vw; /* Full bleed on right and bottom */
  }

  .deck-column {
    flex: 0 0 50%;
    max-width: 50%;
    position: relative;
    height: 100%;
    z-index: 20;
    display: flex;
    flex-direction: column;
    /*
      NO `overflow: hidden` HERE.

      The clip that came off .accordion-section (hard rule 3) was parked on
      this column, and it landed exactly on the 50% seam — a dead straight
      vertical cut through the deck, which is the hard edge between the two
      halves. Containment is done with a mask on `.deck-stack` instead: it
      fades the cards to zero alpha BEFORE the column boundary, so nothing
      escapes into the right half and nothing is sliced to do it.
    */
  }

  /* AMBIENT GLOW */
  .ambient-glow-container {
    position: absolute;
    /*
      Bleed sideways and up, but NOT down.

      This was `inset: -20%` on all four sides. `.accordion-section` used to
      clip that overhang away, but that clip had to go (hard rule 3), and the
      bottom 20% — measured at 83px — then painted a blurred wash straight
      over the footer whenever the LAST row was the expanded one.

      Sideways and upward bleed stay: both land inside the section, which is
      where the ambient backlight is supposed to spread. Only the bottom is
      pinned to the column, because below it is somebody else's content.
    */
    inset: -20% -20% 0 -20%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ambient-glow-layer {
    position: absolute;
    inset: -10%;
    background-size: cover;
    background-position: center;
    -webkit-filter: blur(120px) saturate(1.5);
    filter: blur(120px) saturate(1.5);
    -webkit-mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 65%);
    mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 65%);
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .ambient-glow-layer.active {
    opacity: 0.4; 
  }

  .deck-stack {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 0; 
    z-index: 2;
    /*
      Feather the deck out into the right column.

      Multi-stop, not the two-stop linear ramp this used to be. A linear alpha
      ramp is what the eye reads as a visible band (Mach banding): the
      derivative is constant, so the ramp's two ENDS are discontinuities and
      both show up as faint lines. These stops approximate a smoothstep, so
      the fade has no detectable start or finish.

      `mask-repeat: no-repeat` is load-bearing. mask-repeat defaults to
      `repeat`, which TILES the gradient outside the element's box — a card
      translated past the stack edge would pass under a fresh copy of the
      ramp and pop back into view. With no-repeat, everything past the box is
      masked out, and because the ramp has already reached zero alpha there,
      that cutoff is invisible.
    */
    -webkit-mask-image: linear-gradient(to left,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.04) 8%, rgba(0,0,0,0.12) 15%,
      rgba(0,0,0,0.28) 22%, rgba(0,0,0,0.50) 30%, rgba(0,0,0,0.72) 38%,
      rgba(0,0,0,0.88) 46%, rgba(0,0,0,0.97) 54%, rgba(0,0,0,1) 62%);
    mask-image: linear-gradient(to left,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.04) 8%, rgba(0,0,0,0.12) 15%,
      rgba(0,0,0,0.28) 22%, rgba(0,0,0,0.50) 30%, rgba(0,0,0,0.72) 38%,
      rgba(0,0,0,0.88) 46%, rgba(0,0,0,0.97) 54%, rgba(0,0,0,1) 62%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .deck-card {
    position: absolute;
    top: 50%;
    left: 0;
