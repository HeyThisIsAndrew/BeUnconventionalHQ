---
import Layout from '../../layouts/Layout.astro';
import { getFeaturedBrandsLocal, getHubBackdrops, urlFor } from '../../lib/local-content';

/*
  `featuredBrand` docs are read out of src/data/videos.json, which is a frozen
  Sanity export with no generated types — every consumer of it in this repo
  (see /featured/[slug].astro) annotates the doc as `any` for exactly that
  reason. Naming the shape once here is what lets the map/sort callbacks below
  be typed instead of each one tripping ts(7006) "implicitly has an any type".
*/
type Brand = any;

/*
  A backdrop is a full-bleed image behind everything else, so the temptation is
  to ship one big file and let `object-fit` deal with it. That is how removing
  900kB of YouTube player from the phone layout would have bought nothing: six
  1280x720 stills is about the same weight, just in a different column of the
  waterfall.

  YouTube's still endpoints include two 16:9 sizes — `mqdefault` at 320x180 and
  `maxresdefault` at 1280x720. (`hqdefault` and `sddefault` are 4:3 and arrive
  pillarboxed with baked-in black bars, which is why they are not offered here.)
  Sanity resizes on request, so it just gets asked for the same two widths.

  `sizes` mirrors the layout: the backdrop spans the viewport on the compact
  layout and about three quarters of it beside the deck, because the wrapper
  is 150% of a half-width column.
*/
const BACKDROP_SIZES =
  '(max-width: 768px) 100vw, (max-height: 560px) 100vw, 75vw';

function backdropSrcSet(url: string): string | undefined {
  const yt = /^(https?:\/\/i\.ytimg\.com\/vi\/[^/]+\/)maxresdefault\.jpg/.exec(url);
  if (yt) return `${yt[1]}mqdefault.jpg 320w, ${url} 1280w`;
  return undefined;
}

// getFeaturedBrandsLocal() is synchronous — it filters an imported JSON array.
const brands: Brand[] = getFeaturedBrandsLocal();

/*
  Which category a hub sits in is now a FIELD ON THE HUB (`hubCategory`),
  edited in the Local CMS, not a lookup table in this file. The table that
  used to live here meant a newly created hub landed in a nameless "other"
  row until someone edited page code, which is not something an editor can
  do. The label and ordering below stay here on purpose: adding a hub is a
  data change, adding a CATEGORY is a design decision.
*/
const categoryLabels: Record<string, string> = {
  'universes': 'The Multiverse',
  'streaming': 'Streamers',
  'studios': 'Studios',
  'gaming': 'Gaming'
};

const groupedBrands = brands.reduce((acc: Record<string, Brand[]>, brand: Brand) => {
  const category = brand.hubCategory || 'other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(brand);
  return acc;
}, {} as Record<string, Brand[]>);

const desiredOrder = ['universes', 'streaming', 'studios', 'gaming'];
const sortedCategories = Object.keys(groupedBrands).sort((a, b) => {
  const indexA = desiredOrder.indexOf(a);
  const indexB = desiredOrder.indexOf(b);
  if (indexA === -1 && indexB === -1) return 0;
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});



interface BrandMeta {
  color: string;
  rgb: string;
  desc: string;
}

/*
  Brand colour and the one-line description are fields on the hub too
  (`brandColor.hex` and `description`). They were a hardcoded table here,
  which meant the two things an editor most wants to change about a hub —
  what it says and what colour it glows — were the two things they could not
  reach from the CMS.

  The RGB triple the dynamic lighting needs is DERIVED from the hex rather
  than stored beside it. Storing both invites them to drift apart, and there
  is only ever one right answer for a given colour.
*/
function hexToRgbTriple(hex?: string): string {
  const m = /^#?([0-9a-f]{6})$/i.exec((hex ?? '').trim());
  if (!m) return '204, 0, 0'; // site accent, matching the CSS fallback
  const int = parseInt(m[1], 16);
  return `${(int >> 16) & 255}, ${(int >> 8) & 255}, ${int & 255}`;
}

interface BrandMeta {
  color: string;
  rgb: string;
  desc: string;
}

function metaFor(brand: Brand): BrandMeta {
  const hex = brand?.brandColor?.hex;
  return {
    color: hex || 'var(--color-accent)',
    rgb: hexToRgbTriple(hex),
    desc:
      brand?.description ||
      `The definitive source for ${brand?.title ?? 'this hub'} intel, trailers, and updates.`,
  };
}

/* ─────────────────────────────────────────────────────────────────────────
   CINEMATIC TYPOGRAPHY — candidates, and the one that ships.

   Two modes, and which one you get depends on the build:

     • `npm run dev` — the picker renders and every candidate is loaded, so
       faces can be compared live. Default is "Demo all", which puts a
       DIFFERENT candidate on each category with its name beside it.
     • production build — the picker is not emitted at all, only PROD_FONT is
       downloaded, and every title renders in it. No review chrome, and no
       paying for seven unused webfonts on a page that is in the Lighthouse
       gate.

   `family` is the Google Fonts css2 query fragment; `stack` is the CSS
   font-family. To change what ships, change PROD_FONT — nothing else.
   ───────────────────────────────────────────────────────────────────────── */
interface DemoFont {
  id: string;
  short: string;
  label: string;
  family: string;
  stack: string;
  weight: number;
  /** Extra tracking for faces that set too tight at banner sizes. */
  tracking: string;
}

const DEMO_FONTS: DemoFont[] = [
  // ── The four original candidates (issue #138) ──
  { id: 'syncopate', short: 'Syncopate', label: 'SYNCOPATE (Epic Ultra-Wide)',
    family: 'Syncopate:wght@700', stack: "'Syncopate', sans-serif", weight: 700, tracking: '-0.01em' },
  { id: 'bebas', short: 'Bebas Neue', label: 'BEBAS NEUE (Tall/Condensed)',
    family: 'Bebas+Neue', stack: "'Bebas Neue', sans-serif", weight: 400, tracking: '0.01em' },
  { id: 'cinzel', short: 'Cinzel', label: 'CINZEL (Prestige Serif)',
    family: 'Cinzel:wght@700..900', stack: "'Cinzel', serif", weight: 800, tracking: '0.01em' },
  { id: 'oswald', short: 'Oswald', label: 'OSWALD (Modern Tech/Heavy)',
    family: 'Oswald:wght@700', stack: "'Oswald', sans-serif", weight: 700, tracking: '-0.01em' },

  // ── Added candidates, all chosen for behaviour at banner size ──
  // Anton: the blockbuster one-sheet face. Very heavy, tightly condensed, so
  // "THE MULTIVERSE" holds one line where a wide face wraps.
  { id: 'anton', short: 'Anton', label: 'ANTON (Blockbuster Poster)',
    family: 'Anton', stack: "'Anton', sans-serif", weight: 400, tracking: '-0.01em' },
  // Big Shoulders: editorial-cinematic, tall and narrow — title-card energy
  // without Anton's bluntness.
  { id: 'bigshoulders', short: 'Big Shoulders', label: 'BIG SHOULDERS (Tall Editorial)',
    family: 'Big+Shoulders+Display:wght@800', stack: "'Big Shoulders Display', sans-serif", weight: 800, tracking: '0.01em' },
  // Archivo Black: neutral heavy grotesque, closest to the site's own Syne.
  { id: 'archivo', short: 'Archivo Black', label: 'ARCHIVO BLACK (Heavy Neutral)',
    family: 'Archivo+Black', stack: "'Archivo Black', sans-serif", weight: 400, tracking: '-0.02em' },
  // Unbounded: contemporary streaming-brand display, wide and geometric.
  { id: 'unbounded', short: 'Unbounded', label: 'UNBOUNDED (Modern Streamer)',
    family: 'Unbounded:wght@800', stack: "'Unbounded', sans-serif", weight: 800, tracking: '-0.02em' },

  /*
    GOTHAM STAND-INS.

    Gotham is a licensed Hoefler & Co typeface — it is not on Google Fonts
    and cannot be self-hosted without buying a webfont licence, so it cannot
    simply be dropped in. Montserrat is the long-standing open substitute:
    the same geometric-sans skeleton and near-identical proportions.

    Both weights are here because "Medium" behaves very differently at these
    two jobs. At 90px across a full-bleed bar, Medium is genuinely light —
    elegant and modern, but it does not hold against a bright still. The
    ExtraBold cut is what film marketing actually uses at poster size.
  */
  { id: 'gotham', short: 'Montserrat Md', label: 'MONTSERRAT MEDIUM (Gotham-like)',
    family: 'Montserrat:wght@500', stack: "'Montserrat', sans-serif", weight: 500, tracking: '0.02em' },
  { id: 'gotham-heavy', short: 'Montserrat XB', label: 'MONTSERRAT EXTRABOLD (Gotham Black-like)',
    family: 'Montserrat:wght@800', stack: "'Montserrat', sans-serif", weight: 800, tracking: '-0.01em' },
];

/*
  THE FACE THAT SHIPS.

  Montserrat Medium, as the Gotham-like direction asked for. Toggle in dev to
  compare — `gotham-heavy` is the same face at ExtraBold and is the one to
  reach for if the Medium cut reads too light over bright hero art, which is
  the usual outcome at banner size.
*/
const PROD_FONT = 'gotham';

const IS_DEV = import.meta.env.DEV;
const activeFonts = IS_DEV ? DEMO_FONTS : DEMO_FONTS.filter((f) => f.id === PROD_FONT);
const fontImportUrl =
  `https://fonts.googleapis.com/css2?${activeFonts.map((f) => `family=${f.family}`).join('&')}&display=swap`;

/*
  Emitted as one inline <style> rather than written out in the scoped block,
  so the face list stays a single source of truth: adding a candidate to
  DEMO_FONTS is all it takes, and production automatically ships exactly one
  @import instead of eight.
*/
const fontCss = `@import url('${fontImportUrl}');
${activeFonts
  .map(
    (f) => `[data-title-font='${f.id}'] .accordion-title,
.accordion-title[data-demo-font='${f.id}'] {
  font-family: ${f.stack};
  font-weight: ${f.weight};
  letter-spacing: ${f.tracking};
  text-transform: uppercase;
}`,
  )
  .join('\n')}`;

function extractYoutubeId(url: string) {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:.*v=|.*\/))([^"&?\s]{11})/);
  return match ? match[1] : null;
}
---

<Layout
  title="Featured Hubs"
  preconnect={["https://cdn.sanity.io", "https://www.youtube-nocookie.com"]}
>
  <style is:inline set:html={fontCss}></style>
  <main class="featured-directory-page" data-title-font={IS_DEV ? 'demo' : PROD_FONT}>
    {sortedCategories.length > 0 ? (
      <div class="accordion-container animate-on-scroll">
        {sortedCategories.map((category, index) => {
          let categoryBrands = groupedBrands[category];
          if (category === 'gaming') {
            const gamingOrder = ['playstation', 'nintendo', 'xbox'];
            categoryBrands = categoryBrands.sort((a: Brand, b: Brand) => {
              const aIdx = gamingOrder.indexOf(a.slug?.current || '');
              const bIdx = gamingOrder.indexOf(b.slug?.current || '');
              if (aIdx === -1 && bIdx === -1) return 0;
              if (aIdx === -1) return 1;
              if (bIdx === -1) return -1;
              return aIdx - bIdx;
            });
          }

          const isExpanded = index === 0;

          return (
            <div class={`accordion-section ${isExpanded ? 'expanded' : 'collapsed'}`} data-category={category}>
              
              <div class="accordion-header">
                <div class="accordion-header-bg"></div>
                
                <h2 class="accordion-title" data-demo-font={DEMO_FONTS[index % DEMO_FONTS.length].id}>
                  {categoryLabels[category] || category}
                  {IS_DEV && (
                    <span class="accordion-title-demo-label">
                      — {DEMO_FONTS[index % DEMO_FONTS.length].label}
                    </span>
                  )}
                </h2>

              </div>

              <div class="accordion-body">
                <div class="deck-view-container">
                  
                  <div class="deck-column">
                    
                    {/* AMBIENT GLOW BACKLIGHT */}
                    <div class="ambient-glow-container">
                       {categoryBrands.map((brand: Brand, bIndex: number) => {
                         const glowUrl = brand.heroImage ? urlFor(brand.heroImage).width(100).auto('format').quality(60).url() : null;
                         return (
                            <div class={`ambient-glow-layer ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex} style={glowUrl ? `background-image: url(${glowUrl})` : ''}></div>
                         );
                       })}
                    </div>

                    <div class="deck-stack">
                      {categoryBrands.map((brand: Brand, bIndex: number) => {
                        const heroUrl = brand.heroImage ? urlFor(brand.heroImage).width(1200).auto('format').quality(78).url() : null;
                        const metaCard = metaFor(brand);
                        return (
                          <a
                            class={`deck-card ${bIndex === 0 ? "active" : bIndex === 1 ? "next-1" : bIndex === 2 ? "next-2" : "hidden"}`}
                            href={`/featured/${brand.slug?.current}`}
                            aria-label={`Enter the ${brand.title} hub`}
                            data-index={bIndex}
                            data-brand-rgb={metaCard.rgb}
                            style={`--brand-rgb: ${metaCard.rgb};`}
                          >

                            <div class="peeking-spine">
                               <span class="spine-text">{brand.title}</span>
                            </div>

                            {/*
                              The FRONT card is the largest thing above the
                              fold, so it is the LCP element — and it was
                              marked lazy, which tells the browser to
                              deprioritise exactly the image the score is
                              measured on. Eager and high priority for that
                              one; everything behind it stays lazy.
                            */}
                            {heroUrl ? (
                              <img
                                src={heroUrl}
                                alt={brand.title}
                                loading={bIndex === 0 ? 'eager' : 'lazy'}
                                fetchpriority={bIndex === 0 ? 'high' : 'auto'}
                                decoding={bIndex === 0 ? 'sync' : 'async'}
                                class="deck-card-image"
                              />
                            ) : (
                              <div class="article-thumb-fallback"></div>
                            )}

                            {/*
                              THE KEY ART CARRIES THE BRANDING AND THE WAY IN.

                              The mark used to sit in the corner of the trailer
                              on the other side of the row, which meant a hub's
                              identity and a hub's artwork were two separate
                              objects competing to be looked at — and on a phone
                              they landed on top of each other and of the video's
                              own title overlay.

                              One surface instead: the poster IS the button, and
                              the logo sits on it bottom-left the way it does on
                              the video cards elsewhere on this site
                              (`.video-watermark` in ContentCard.astro). The
                              trailer becomes what it should always have been —
                              the plate behind the scene, with nothing to read on
                              it.
                            */}
                            <span class="deck-card-scrim" aria-hidden="true"></span>

                            <span class="deck-card-plate" aria-hidden="true">
                              {brand.logo ? (
                                /* HARD RULE 6: the shadow is on the WRAPPER,
                                   never on the <img>. */
                                <span class="deck-card-logo-wrap">
                                  <img
                                    src={urlFor(brand.logo).height(120).auto('format').url()}
                                    alt=""
                                    class="deck-card-logo"
                                    loading={bIndex === 0 ? 'eager' : 'lazy'}
                                  />
                                </span>
                              ) : (
                                <span class="deck-card-wordmark">{brand.title}</span>
                              )}
                              <span class="deck-card-desc">{metaCard.desc}</span>
                            </span>

                            <span class="deck-card-enter" aria-hidden="true">
                              <span>Enter</span>
                              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M5 12h13M13 6l6 6-6 6" />
                              </svg>
                            </span>
                          </a>
                        );
                      })}
                    </div>

                    <div class="deck-nav-track">
                      {categoryBrands.map((brand: Brand, bIndex: number) => {
                         const heroUrl = brand.heroImage ? urlFor(brand.heroImage).width(400).height(200).auto('format').quality(70).url() : null;
                         return (
                           <div class={`deck-nav-thumb ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex}>
                             
                             {/* TOOLTIP */}
                             <div class="custom-tooltip">{brand.title}</div>

                             {heroUrl ? (
                                <img src={heroUrl} alt={brand.title} loading="lazy" class="nav-thumb-img" />
                             ) : (
                                <div class="nav-thumb-fallback">{brand.title}</div>
                             )}
                           </div>
                         );
                      })}
                    </div>
                  </div>

                  <div class="info-column">
                    <div class="info-panels-wrapper">
                      {categoryBrands.map((brand: Brand, bIndex: number) => {
                        const ytId = extractYoutubeId(brand.trailerUrl || '');
                        const ytSrc = ytId ? `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&mute=1&loop=1&playlist=${ytId}&controls=0&modestbranding=1&showinfo=0&rel=0` : null;
                        const meta = metaFor(brand);
                        const backdrops = getHubBackdrops(brand.slug?.current ?? '');

                        return (
                          <div class={`brand-info-panel ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex} style={`--brand-color: ${meta.color}; --brand-rgb: ${meta.rgb};`}>
                            <div class="large-trailer-card">
                              
                              <div class="trailer-bg-wrapper">
                                {/*
                                  THE BACKDROP IS STILLS. THE VIDEO IS AN EXTRA.

                                  Both live in this one box so they share its
                                  mask, its size and its slow push-in — the
                                  video fades in ON TOP of the gallery rather
                                  than replacing it, and on a phone it simply
                                  never loads (see the compact guard in the
                                  script) and the gallery is the whole backdrop.

                                  Only the first frame carries a real `src`;
                                  the rest are hydrated when their panel becomes
                                  the active one. Fifteen hubs at six stills
                                  each is ninety images, and `loading="lazy"` is
                                  not a reliable guard when the container is
                                  hidden with `visibility` rather than moved
                                  off-screen.
                                */}
                                {backdrops.length > 0 && (
                                  <div class="backdrop-gallery" aria-hidden="true">
                                    {backdrops.map((b, i) => {
                                      const sanity = b.kind === 'sanity';
                                      const url = sanity
                                        ? urlFor(b.ref).width(1280).auto('format').quality(72).url()
                                        : b.url;
                                      const srcset = sanity
                                        ? `${urlFor(b.ref).width(320).auto('format').quality(72).url()} 320w, ${url} 1280w`
                                        : backdropSrcSet(url);
                                      const first = i === 0;
                                      /*
                                        Only the hub that is actually showing
                                        gets a frame in the HTML. Marking every
                                        panel's first frame eager-in-markup
                                        loads one still per hub on open — two
                                        today, fifteen once the rest have
                                        artwork, for fourteen panels nobody is
                                        looking at. The others are hydrated by
                                        startBackdrop() when they are selected.
                                      */
                                      const painted = first && bIndex === 0;
                                      return (
                                        <img
                                          class={`backdrop-layer ${first ? 'active' : ''}`}
                                          src={painted ? url : undefined}
                                          srcset={painted ? srcset : undefined}
                                          data-src={painted ? undefined : url}
                                          data-srcset={painted ? undefined : srcset}
                                          sizes={BACKDROP_SIZES}
                                          alt=""
                                          decoding="async"
                                          loading={bIndex === 0 && first ? 'eager' : 'lazy'}
                                        />
                                      );
                                    })}
                                  </div>
                                )}

                                {ytSrc && (
                                  <iframe class="trailer-iframe" data-src={ytSrc} allow="autoplay; encrypted-media" tabindex="-1"></iframe>
                                )}

                                {backdrops.length === 0 && !ytSrc && (
                                  <div class="article-thumb-fallback"></div>
                                )}
                              </div>

                              <div class="trailer-dark-overlay"></div>
                              <div class="trailer-gradient-top"></div>
                              <div class="trailer-gradient-bottom"></div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="container-page">
        <p class="featured-empty">Dedicated coverage hubs are coming soon.</p>
      </div>
    )}
  
    {/*
      Typeface picker — DEV ONLY. `import.meta.env.DEV` is false for
      `astro build`, so this markup, and the seven non-shipping webfonts it
      exists to compare, never reach a deployed page.
    */}
    {IS_DEV && (
      <div class="font-picker" role="group" aria-label="Preview heading typeface">
        <span class="font-picker-label">Typeface</span>
        <button type="button" class="font-picker-btn" data-font="demo" aria-pressed="true">Demo per row</button>
        {DEMO_FONTS.map((f) => (
          <button type="button" class="font-picker-btn" data-font={f.id} aria-pressed="false">{f.short}</button>
        ))}
      </div>
    )}
  </main>
</Layout>

<script>
  let audioCtx: AudioContext | null = null;
  function playCinematicThud() {
    try {
      // Safari still only exposes the prefixed constructor.
      const Ctor =
        window.AudioContext ||
        (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!Ctor) return;
      if (!audioCtx) audioCtx = new Ctor();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.type = 'sine';
      // Deep frequency drop
      osc.frequency.setValueAtTime(100, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(20, audioCtx.currentTime + 0.3);
      
      // Volume envelope
      gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
      
      osc.start();
      osc.stop(audioCtx.currentTime + 0.3);
    } catch(e) {
      // Ignore if AudioContext is not supported or locked
    }
  }

  /*
    THE TRAILER IS A DESKTOP ENHANCEMENT.

    The YouTube embed is ~900kB of player JavaScript, and on the compact
    layout it sits BEHIND the artwork where almost none of it is legible
    anyway — it was most of why the page felt slow on a phone. Same markup
    either way (hard rule 7): the iframe is simply never given its src, so it
    never makes a request, and the still gallery underneath is the backdrop.

    Matched against the same query the stylesheet uses for the compact layout.
    Keep the two in step.
  */
  const compactQuery = () =>
    window.matchMedia('(max-width: 768px), (max-height: 560px)');

  function loadTrailer(iframe: HTMLIFrameElement | null | undefined) {
    if (!iframe) return;
    if (compactQuery().matches) return;
    const lazySrc = iframe.dataset.src;
    // Guarded on the data attribute, never falling back to '': a hub with no
    // trailerUrl renders no data-src, and assigning '' would load this page
    // into the iframe (hard rule 4).
    if (lazySrc && !iframe.src) iframe.src = lazySrc;
  }

  /*
    THE BACKDROP CYCLES ONLY WHERE IT IS BEING LOOKED AT.

    One timer per section rather than one per panel: fifteen hubs across four
    rows is fifteen intervals and ninety images if every gallery runs itself,
    and at most one of them is ever on screen. The section owns the timer, the
    active panel owns the frames.
  */
  const reduceMotionQuery = () => window.matchMedia('(prefers-reduced-motion: reduce)');
  const BACKDROP_HOLD_MS = 7000;

  function stopBackdrop(section: HTMLElement) {
    const id = Number(section.dataset.backdropTimer || 0);
    if (id) window.clearInterval(id);
    delete section.dataset.backdropTimer;
  }

  function startBackdrop(section: HTMLElement) {
    stopBackdrop(section);
    if (!section.classList.contains('expanded')) return;

    const panel = section.querySelector<HTMLElement>('.brand-info-panel.active');
    if (!panel) return;

    const frames = Array.from(panel.querySelectorAll<HTMLImageElement>('.backdrop-layer'));
    if (frames.length === 0) return;

    /*
      ONE FRAME AHEAD, NOT ALL OF THEM.

      Hydrating the whole set when the panel opens costs six images for a
      visitor who looks at the row for seven seconds and moves on. Fetching the
      next one during the current one's hold means the cross-fade always has
      its image ready and nobody pays for stills they never see.
    */
    const hydrate = (i: number) => {
      const frame = frames[i % frames.length];
      if (!frame) return;
      const lazySrc = frame.dataset.src;
      if (!lazySrc || frame.src) return;
      const lazySet = frame.dataset.srcset;
      if (lazySet) frame.srcset = lazySet;
      frame.src = lazySrc;
      delete frame.dataset.src;
      delete frame.dataset.srcset;
    };

    // A cross-fade IS the motion someone asked not to see. One frame, held —
    // but it still has to be fetched, since it may not be in the HTML.
    if (frames.length < 2 || reduceMotionQuery().matches) {
      const only = frames.findIndex((f) => f.classList.contains('active'));
      hydrate(only < 0 ? 0 : only);
      return;
    }

    let index = frames.findIndex((f) => f.classList.contains('active'));
    if (index < 0) index = 0;
    // The current frame first — on any panel but the one the page opened on,
    // this is the frame that was left out of the HTML.
    hydrate(index);
    hydrate(index + 1);

    const timer = window.setInterval(() => {
      frames[index].classList.remove('active');
      index = (index + 1) % frames.length;
      frames[index].classList.add('active');
      hydrate(index + 1);
    }, BACKDROP_HOLD_MS);

    section.dataset.backdropTimer = String(timer);
  }

  function initAccordionAndDecks() {
    const sections = document.querySelectorAll<HTMLElement>('.accordion-section');
    sections.forEach(section => {
      const header = section.querySelector<HTMLElement>('.accordion-header');
      if (!header) return;
      
      if (!header.dataset.hasClickListener) {
        header.dataset.hasClickListener = 'true';
        header.addEventListener('click', () => {
          if (section.classList.contains('expanded')) return;
          playCinematicThud();
          
          sections.forEach(s => {
            s.classList.remove('expanded');
            s.classList.add('collapsed');
            const iframes = s.querySelectorAll<HTMLIFrameElement>('.trailer-iframe');
            // NEVER `iframe.src = ''` (hard rule 4): the empty string resolves
            // against the document URL, so it reloads this whole page inside
            // the iframe. removeAttribute is the real unload.
            iframes.forEach((iframe) => { iframe.removeAttribute('src'); });
            stopBackdrop(s);
          });
          
          section.classList.remove('collapsed');
          section.classList.add('expanded');
          startBackdrop(section);

          const activeCard = section.querySelector<HTMLElement>('.deck-card.active');
          if (activeCard) {
             const activeIdx = activeCard.getAttribute('data-index');
             const activePanel = section.querySelector<HTMLElement>(`.brand-info-panel[data-index="${activeIdx}"]`);
             if (activePanel) {
               loadTrailer(activePanel.querySelector<HTMLIFrameElement>('.trailer-iframe'));
             }
          }
        });
      }

      const cards = Array.from(section.querySelectorAll<HTMLElement>('.deck-card'));
      const navThumbs = Array.from(section.querySelectorAll<HTMLElement>('.deck-nav-thumb'));
      const infoPanels = Array.from(section.querySelectorAll<HTMLElement>('.brand-info-panel'));
      const glowLayers = Array.from(section.querySelectorAll<HTMLElement>('.ambient-glow-layer'));
      
      let activeIndex = 0;
      cards.forEach((c, idx) => {
        if (c.classList.contains('active')) activeIndex = idx;
      });

      if (section.classList.contains('expanded')) {
        /*
          THE OPENING TRAILER WAITS FOR THE PAGE TO FINISH PAINTING.

          This used to assign the iframe's src during init, which pulled about
          900kB of YouTube player JS onto the critical path and left the
          largest image above the fold fighting it for bandwidth. The
          Lighthouse gate caught it: /featured scored 75% with a 13.6s LCP,
          against a 90% threshold and 95% before this page was rebuilt.

          Deferring to idle (with a load-event fallback, since
          requestIdleCallback may never fire on a busy page and is missing on
          older Safari) takes the player off that path entirely. The trailer
          still autoplays on its own — it just starts a beat after the artwork
          is on screen, which is the right order anyway.
        */
        const startTrailer = () => {
          loadTrailer(infoPanels[activeIndex]?.querySelector<HTMLIFrameElement>('.trailer-iframe'));
        };

        startBackdrop(section);

        const deferTrailer = () => {
          if ('requestIdleCallback' in window) {
            (window as any).requestIdleCallback(startTrailer, { timeout: 2500 });
          } else {
            setTimeout(startTrailer, 1200);
          }
        };

        if (document.readyState === 'complete') deferTrailer();
        else window.addEventListener('load', deferTrailer, { once: true });
      }

      function renderDeck() {
        cards.forEach((card, i) => {
          card.className = 'deck-card';
          /* Class transforms only. An inline one would win over them and
             strand the card off-position — see the note on the click
             handlers below. */
          card.style.transform = '';
          infoPanels[i].className = 'brand-info-panel';
          
          if (navThumbs[i]) navThumbs[i].className = 'deck-nav-thumb';
          if (glowLayers[i]) glowLayers[i].className = 'ambient-glow-layer';

          const iframe = infoPanels[i].querySelector<HTMLIFrameElement>('.trailer-iframe');

          if (i === activeIndex) {
            card.classList.add('active');
            infoPanels[i].classList.add('active');
            if (navThumbs[i]) navThumbs[i].classList.add('active');
            if (glowLayers[i]) glowLayers[i].classList.add('active');
            
            loadTrailer(iframe);
            
            // Set dynamic left row color
            const brandRgb = card.getAttribute('data-brand-rgb');
            if (brandRgb) {
              section.style.setProperty('--category-accent-rgb', brandRgb);
            }
          } else {
            if (i === (activeIndex + 1) % cards.length) {
              card.classList.add('next-1');
            } else if (i === (activeIndex + 2) % cards.length) {
              card.classList.add('next-2');
            } else {
              card.classList.add('hidden');
            }
            
            // Unload inactive iframes to save memory and CPU
            if (iframe && iframe.src) {
              iframe.removeAttribute('src');
            }
          }
        });

        // The gallery follows the selection: a new hub means a new backdrop
        // set, so the cycle restarts on its first frame rather than resuming
        // mid-way through the previous hub's.
        startBackdrop(section);
      }

      // Deck Stack Clicks & Parallax
      cards.forEach((card, i) => {
        if (!card.dataset.hasClickListener) {
          card.dataset.hasClickListener = 'true';
          card.addEventListener('click', (e) => {
            if (i !== activeIndex) {
              // A card behind the front one means "bring me forward".
              e.preventDefault();
              e.stopPropagation();
              activeIndex = i;
              playCinematicThud();
              renderDeck();
              return;
            }
            /*
              The FRONT card means "go in" — and it is now a real <a>, so
              that needs no code at all. Falling through to the browser's own
              navigation is what makes the tile work for keyboards, screen
              readers, middle-click and open-in-new-tab, none of which a
              `window.location` assignment supports.

              The separate "Enter" button in the trailer corner is gone with
              it: there is one target per hub now, and it is the artwork.
            */
          });

          /*
            NO PARALLAX TILT ON THE FRONT CARD.

            This used to write an INLINE transform on every mousemove, which
            caused three separate complaints about the big artwork not sitting
            still — and one of them was a genuine bug rather than a taste
            issue. `renderDeck()` re-assigns `card.className` but cannot clear
            an inline style, and inline beats any stylesheet rule. So a tilt
            left behind by the pointer survived the next selection and
            overrode the deck's own positioning: the card that should have
            settled at translateX(0) stayed wherever the last mousemove had
            put it. That is why selecting a brand appeared to move the image
            at random.

            The front card is the largest thing on the page and the thing the
            eye fixes on. It holds still.
          */
        }
      });

      /*
        POINTER DRIFT.

        Reports where the pointer sits inside the open row as two numbers
        from -1 to 1, and lets CSS decide what moves and how far. Keeping the
        distances in the stylesheet means the feel can be tuned without
        touching this handler.

        Gated on the EVENT's pointer type rather than a `(hover: hover)`
        media query. The media query is the usual way to do this and it is
        the wrong one here: plenty of real desktop environments report
        `hover: none` (this project's own headless test browser does), which
        silently costs those visitors the effect. The event knows what it
        actually was. It also handles a touchscreen laptop properly — drift
        with the mouse, none from a finger — which one global media query
        cannot express.
      */
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reducedMotion && !section.dataset.hasDriftListener) {
        section.dataset.hasDriftListener = 'true';

        const resetDrift = () => {
          section.style.setProperty('--drift-x', '0');
          section.style.setProperty('--drift-y', '0');
        };

        section.addEventListener('pointermove', (e: PointerEvent) => {
          // A tap fires one synthetic move; acting on it would shove the
          // artwork sideways and leave it parked there.
          if (e.pointerType === 'touch') return;
          if (!section.classList.contains('expanded')) return;
          const rect = section.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          section.style.setProperty('--drift-x', String(x * 2));
          section.style.setProperty('--drift-y', String(y * 2));
        });

        section.addEventListener('pointerleave', resetDrift);
      }

      /*
        THE RAIL ONLY FADES WHERE IT CONTINUES.

        Reports which sides actually have thumbnails scrolled out of view;
        the stylesheet turns that into the edge feather. Without it the fade
        is unconditional and the first and last hub in every row look dimmed
        even when the whole rail fits.

        `scrollWidth - clientWidth` can be a fraction of a pixel off on a
        fractional-DPI display, so the ends are tested with a small tolerance
        rather than an exact comparison — otherwise the rail never quite
        admits it has reached its end and keeps a feather on a crisp edge.
      */
      const navTrack = section.querySelector<HTMLElement>('.deck-nav-track');
      if (navTrack && !navTrack.dataset.hasOverflowListener) {
        navTrack.dataset.hasOverflowListener = 'true';

        const syncNavFade = () => {
          const max = navTrack.scrollWidth - navTrack.clientWidth;
          const atStart = navTrack.scrollLeft <= 1;
          const atEnd = navTrack.scrollLeft >= max - 1;
          navTrack.dataset.overflowStart = max > 1 && !atStart ? '1' : '0';
          navTrack.dataset.overflowEnd = max > 1 && !atEnd ? '1' : '0';
        };

        syncNavFade();
        navTrack.addEventListener('scroll', syncNavFade, { passive: true });

        // The rail's width changes when the row opens or closes, which is a
        // layout change with no scroll and no resize behind it.
        const RO = (window as { ResizeObserver?: typeof ResizeObserver }).ResizeObserver;
        if (RO) new RO(syncNavFade).observe(navTrack);
        else window.addEventListener('resize', syncNavFade);
      }

      // Quick Nav Thumb Clicks
      navThumbs.forEach((thumb, i) => {
        if (!thumb.dataset.hasClickListener) {
          thumb.dataset.hasClickListener = 'true';
          thumb.addEventListener('click', (e) => {
            if (i !== activeIndex) {
              e.preventDefault();
              e.stopPropagation();
              activeIndex = i;
              playCinematicThud();
              renderDeck();
            }
          });
        }
      });
    });
  }

  /* TEMPORARY typography picker — remove with DEMO_FONTS. */
  function initFontPicker() {
    const root = document.querySelector<HTMLElement>('.featured-directory-page');
    if (!root || root.dataset.fontPickerInit === '1') return;
    root.dataset.fontPickerInit = '1';

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.font-picker-btn'));
    for (const button of buttons) {
      button.addEventListener('click', () => {
        root.dataset.titleFont = button.dataset.font ?? 'demo';
        for (const other of buttons) {
          other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
        }
      });
    }
  }

  initAccordionAndDecks();
  initFontPicker();
  document.addEventListener('astro:page-load', () => {
    initAccordionAndDecks();
    initFontPicker();
  });
</script>

