---
import { SECTIONS } from '../../data/content.js';
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/PageTitle.astro';
import CategoryOverlay from '../../components/CategoryOverlay.astro';
import SubscribeCTA from '../../components/SubscribeCTA.astro';
import { site } from '../../data/site.js';
import { getFeaturedBrandsLocal, urlFor } from '../../lib/local-content';

const title = `Featured | ${site.name}`;
const description =
  'Deep dives and dedicated coverage hubs for our favorite brands and topics.';

// Published, sluggable brands only — same defensive filter as the detail page,
// so drafts/incomplete docs never break the listing or produce dead links.
const brands = getFeaturedBrandsLocal();

// TEMPORARY: Hardcoded map until Sanity schema is updated and synced
// Contains the 15+ hubs we discussed to ensure they group correctly as they are added
const categoryMap: Record<string, string> = {
  // The Universes
  'marvel-comics': 'universes',
  'dc-comics': 'universes',
  
  // Streaming
  'netflix': 'streaming',
  'prime-video': 'streaming',
  'disney-plus': 'streaming',
  'max': 'streaming',
  'hulu': 'streaming',
  'apple-tv-plus': 'streaming',
  
  // The Studios
  'a24': 'studios',
  'warner-bros': 'studios',
  'universal': 'studios',
  'sony-pictures': 'studios',
  
  // Gaming
  'playstation': 'gaming',
  'xbox': 'gaming',
  'nintendo': 'gaming',
};

// Group brands by category
const groupedBrands = brands.reduce((acc, brand) => {
  const slug = brand.slug.current;
  const cat = brand.category || categoryMap[slug] || 'universes'; // Default fallback
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(brand);
  return acc;
}, {} as Record<string, any[]>);

// Category display labels
const categoryLabels: Record<string, string> = {
  'universes': 'The Multiverse',
  'streaming': 'Streamers',
  'studios': 'Studios',
  'gaming': 'Gaming',
};

// Sort order for categories so they appear consistently
const categoryOrder = ['universes', 'streaming', 'studios', 'gaming'];
const sortedCategories = Object.keys(groupedBrands).sort((a, b) => {
  return categoryOrder.indexOf(a) - categoryOrder.indexOf(b);
});

const overlayItems = sortedCategories.map(cat => ({
  label: categoryLabels[cat].toUpperCase(),
  href: '#', // Handled by JS
  slug: cat,
  active: false
}));
---

<Layout title={title} description={description} preconnect={["https://cdn.sanity.io"]}>
  <main class="events-page" style="display: flex; flex-direction: column; flex: 1 1 0%; width: 100%; min-height: 50vh; padding-top: 120px;">
    <div class="container-page" style="width: 100%;">
      <header class="section-header animate-on-scroll" data-nav-anchor style="text-align: center; margin-bottom: 2rem;">
        <PageTitle as="h1" {...SECTIONS.featured} />
      </header>

      {/* FILTER BUTTONS (Using QuadrantFilter styling) */}
      <CategoryOverlay items={overlayItems} />

      <div class="filter-row category-row desktop-category-row animate-on-scroll" style="margin-bottom: 3rem; display: flex; justify-content: center; width: 100%;">
        <div class="filter-grid" style="width: 100%;">
          <button class="quadrant-btn cat-btn featured-cat-btn" data-filter="universes">THE UNIVERSES</button>
          <button class="quadrant-btn cat-btn featured-cat-btn" data-filter="streaming">STREAMING</button>
          <button class="quadrant-btn cat-btn featured-cat-btn" data-filter="studios">THE STUDIOS</button>
          <button class="quadrant-btn cat-btn featured-cat-btn" data-filter="gaming">GAMING</button>
        </div>
      </div>

      {/*
        Structural sr-only <h2> so the card <h3>s do not skip a level.
      */}
      {brands.length > 0 ? (
        <>
        <h2 class="sr-only">Featured collections</h2>
        <div class="featured-sections-container">
          {sortedCategories.map((category) => {
            let categoryBrands = groupedBrands[category];
            if (category === 'gaming') {
              const gamingOrder = ['playstation', 'nintendo', 'xbox'];
              categoryBrands.sort((a: any, b: any) => {
                const aIdx = gamingOrder.indexOf(a.slug.current);
                const bIdx = gamingOrder.indexOf(b.slug.current);
                if (aIdx === -1 && bIdx === -1) return 0;
                if (aIdx === -1) return 1;
                if (bIdx === -1) return -1;
                return aIdx - bIdx;
              });
            }
            return (
              <section class="featured-category-section animate-on-scroll" data-category={category}>
                
                {/* Premium Cinematic Category Header */}
                <h3 class="category-heading">{categoryLabels[category] || category}</h3>
                
                {/* Existing Grid Math Preserved */}
                <div class={`featured-hub-grid ${categoryBrands.length === 4 ? 'grid-2x2' : ''}`}>
                  {categoryBrands.map((brand: any, index: number) => {
                    const heroUrl = brand.heroImage
                      ? urlFor(brand.heroImage).width(800).height(450).auto('format').url()
                      : null;
                    const logoHeight = 96;
                    const logoWidth = brand.logo?.dimensions?.aspectRatio
                      ? Math.round(logoHeight * brand.logo.dimensions.aspectRatio)
                      : undefined;

                    return (
                      <a
                        href={`/featured/${brand.slug.current}`}
                        class="event-card"
                        style={`--index: ${index}; width: 100%;`}
                      >
                        <div class="event-image-wrapper w-full aspect-video">
                          {heroUrl ? (
                            <img
                              src={heroUrl}
                              alt={brand.title}
                              loading="lazy"
                              decoding="async"
                              class="event-image"
                            />
                          ) : (
                            <div class="article-thumb-fallback" style="position: absolute; inset: 0; width: 100%; height: 100%;" aria-hidden="true"></div>
                          )}
                          <div class="event-overlay">
                            {brand.logo ? (
                              <>
                                <span class="event-card-logo-wrap">
                                  <img
                                    src={urlFor(brand.logo).height(96).url()}
                                    alt={`${brand.title} logo`}
                                    class="event-card-logo"
                                    height={logoHeight}
                                    width={logoWidth}
                                    loading="lazy"
                                  />
                                </span>
                                <h4 class="event-card-sr-title">{brand.title}</h4>
                              </>
                            ) : (
                              <h4 class="event-title line-clamp-2">{brand.title}</h4>
                            )}
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </section>
            );
          })}
        </div>
        </>
      ) : (
        <p class="featured-empty">Dedicated coverage hubs are coming soon.</p>
      )}
    </div>
  </main>

  <SubscribeCTA />

</Layout>

<script>
  function initFeaturedFilters() {
    
    const pills = document.querySelectorAll('.featured-cat-btn, #category-fullscreen-overlay .cat-btn');
    const openBtn = document.getElementById('open-categories-btn');

    const sections = document.querySelectorAll('.featured-category-section');

    if (!pills.length || !sections.length) return;

    pills.forEach(pill => {
      // Remove old listeners to prevent duplicates on astro:page-load
      const newPill = pill.cloneNode(true) as HTMLElement;
      if (pill.parentNode) {
        pill.parentNode.replaceChild(newPill, pill);
      }
      
      newPill.addEventListener('click', (e) => {
        e.preventDefault();
        const targetCategory = newPill.getAttribute('data-filter') || newPill.getAttribute('data-category');
        const isAlreadyActive = newPill.classList.contains('active');
        
        // Remove active from all
        document.querySelectorAll('.featured-cat-btn, #category-fullscreen-overlay .cat-btn').forEach(p => p.classList.remove('active'));
        
        if (!isAlreadyActive) {
          document.querySelectorAll('.featured-cat-btn, #category-fullscreen-overlay .cat-btn').forEach(p => {
             const cat = p.getAttribute('data-filter') || p.getAttribute('data-category');
             if (cat === targetCategory) p.classList.add('active');
          });
        }

        // Update mobile open button text
        if (openBtn) {
          if (!isAlreadyActive) {
             openBtn.textContent = `Categories | ${newPill.textContent?.trim()}`;
             openBtn.classList.add('active');
          } else {
             openBtn.textContent = 'Categories';
             openBtn.classList.remove('active');
          }
        }

        sections.forEach(section => {
          const sectionEl = section as HTMLElement;
          const sectionCategory = sectionEl.getAttribute('data-category');
          if (isAlreadyActive || targetCategory === sectionCategory) {
            sectionEl.style.display = 'block';
          } else {
            sectionEl.style.display = 'none';
          }
        });
      });
    });
  }

  initFeaturedFilters();
  document.addEventListener('astro:page-load', initFeaturedFilters);
</script>

<style>
  /* Page width wrapper now shared: `.container-page` in modules/layout.css */
  /* Shared `.event-card` and `.event-overlay` styles moved to `events.css` */
  /* Filter grid button styles are globally available from `modules/filters.css` via `.quadrant-btn` and `.cat-btn` */

  .featured-sections-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .featured-category-section {
    display: block;
    width: 100%;
  }

  .category-heading {
    font-family: var(--font-display);
    text-align: center;
    font-size: 2.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
    color: #fff;
    border-bottom: none;
    padding-bottom: 0;
  }

  /*
    Hub grid.
    Filling the wrapper puts it back in line with the rest of the site.
  */
  .featured-hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 2rem;
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .featured-hub-grid.grid-2x2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .featured-empty {
    text-align: center;
    color: #888;
    font-size: 1.1rem;
    padding: 4rem 0;
  }
  
  .event-card-logo-wrap {
    display: inline-block;
    max-width: 80%;
    margin-right: auto;
    filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.7));
  }
  
  .event-card-logo {
    max-height: 80px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .event-card-sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .event-image-wrapper {
    overflow: hidden;
    position: relative;
  }

  .event-image {
    transform: scale(1.05);
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .event-card:hover .event-image {
    transform: scale(1);
  }

  .event-card:hover .event-card-logo {
    transform: scale(1.1);
  }

  @media (max-width: 768px) {
    .desktop-category-row {
      display: none !important;
    }
  }

</style>
