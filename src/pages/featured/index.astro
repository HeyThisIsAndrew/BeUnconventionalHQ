---
import Layout from '../../layouts/Layout.astro';
import { getFeaturedBrandsLocal, urlFor } from '../../lib/local-content';

type Brand = any;

const brands: Brand[] = getFeaturedBrandsLocal();

const categoryMap: Record<string, string> = {
  'marvel-comics': 'universes',
  'dc-comics': 'universes',
  'prime-video': 'streaming',
  'hbo-max': 'streaming',
  'netflix': 'streaming',
  'apple-tv-plus': 'streaming',
  'disney-plus': 'streaming',
  'peacock': 'streaming',
  'warner-bros': 'studios',
  'disney': 'studios',
  'sony-pictures': 'studios',
  'universal': 'studios',
  'playstation': 'gaming',
  'nintendo': 'gaming',
  'xbox': 'gaming'
};

const categoryLabels: Record<string, string> = {
  'universes': 'The Universes',
  'streaming': 'Streaming',
  'studios': 'The Studios',
  'gaming': 'Gaming'
};

const groupedBrands = brands.reduce((acc: Record<string, Brand[]>, brand: Brand) => {
  const category = brand.hubCategory || categoryMap[brand.slug?.current] || 'other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(brand);
  return acc;
}, {} as Record<string, Brand[]>);

const desiredOrder = ['universes', 'streaming', 'studios', 'gaming'];
const sortedCategories = Object.keys(groupedBrands).sort((a, b) => {
  const indexA = desiredOrder.indexOf(a);
  const indexB = desiredOrder.indexOf(b);
  if (indexA === -1 && indexB === -1) return 0;
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});

function metaFor(brand: Brand) {
  const hex = (typeof brand.brandColor === 'string' ? brand.brandColor : brand.brandColor?.hex) || '#CC0000';
  const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
  let rgb = '204, 0, 0';
  if (m) {
    const int = parseInt(m[1], 16);
    rgb = `${(int >> 16) & 255}, ${(int >> 8) & 255}, ${int & 255}`;
  }
  return { color: hex, rgb };
}
---

<Layout
  title="Featured Hubs | BE Unconventional HQ"
  description="Explore dedicated coverage hubs for your favorite entertainment brands."
>
  <main class="featured-directory-page pt-48 pb-16">
    <div class="container-page">
      <h1 class="page-title text-4xl font-display font-black uppercase tracking-tight text-white mb-12 mt-12">Featured Hubs</h1>
      
      {sortedCategories.length > 0 && (
        <div class="filters-container mb-12">
          <div class="filter-controls">
            {sortedCategories.map(cat => (
              <button 
                class="filter-pill" 
                data-category={cat}
                aria-pressed="false"
              >
                {categoryLabels[cat] || cat}
              </button>
            ))}
          </div>
        </div>
      )}

      {sortedCategories.length > 0 ? (
        <div class="sections-container flex flex-col gap-16">
          {sortedCategories.map((cat) => {
            const categoryBrands = groupedBrands[cat];
            return (
              <section class="featured-category-section" data-category={cat}>
                <h2 class="category-heading">{categoryLabels[cat] || cat}</h2>
                <div class="brand-grid">
                  {categoryBrands.map((brand: Brand) => {
                    const heroUrl = brand.heroImage ? urlFor(brand.heroImage).width(800).auto('format').quality(78).url() : null;
                    const logoUrl = brand.logo ? urlFor(brand.logo).height(200).auto('format').url() : null;
                    const meta = metaFor(brand);
                    
                    return (
                      <a 
                        href={`/featured/${brand.slug?.current}`} 
                        class="brand-card"
                        style={`--brand-rgb: ${meta.rgb};`}
                        aria-label={`Enter the ${brand.title} hub`}
                      >
                        <div class="brand-card-bg">
                          {heroUrl ? (
                            <img src={heroUrl} alt="" loading="lazy" class="brand-card-image" />
                          ) : (
                            <div class="brand-card-fallback"></div>
                          )}
                          <div class="brand-card-overlay"></div>
                        </div>
                        <div class="brand-card-content">
                          {logoUrl ? (
                            <img src={logoUrl} alt={brand.title} class="brand-card-logo" loading="lazy" />
                          ) : (
                            <span class="brand-card-title">{brand.title}</span>
                          )}
                        </div>
                        <div class="brand-card-hover-border"></div>
                      </a>
                    );
                  })}
                </div>
              </section>
            );
          })}
        </div>
      ) : (
        <p class="text-gray-400 text-lg">No featured hubs available at the moment.</p>
      )}
    </div>
  </main>

  <script>
    function initFeaturedFilters() {
      const pills = document.querySelectorAll('.filter-pill');
      const sections = document.querySelectorAll('.featured-category-section');

      if (!pills.length || !sections.length) return;

      pills.forEach(pill => {
        // Mark as bound so we don't attach multiple listeners if called again
        if (pill.hasAttribute('data-bound')) return;
        pill.setAttribute('data-bound', 'true');

        pill.addEventListener('click', () => {
          // Toggle active state
          const isActive = pill.getAttribute('aria-pressed') === 'true';
          
          if (isActive) {
            pill.setAttribute('aria-pressed', 'false');
            pill.classList.remove('active');
          } else {
            // Deselect all others
            pills.forEach(p => {
              p.setAttribute('aria-pressed', 'false');
              p.classList.remove('active');
            });
            // Select this one
            pill.setAttribute('aria-pressed', 'true');
            pill.classList.add('active');
          }

          // Determine selected category
          const activePill = Array.from(pills).find(p => p.getAttribute('aria-pressed') === 'true');
          const selectedCategory = activePill ? activePill.getAttribute('data-category') : null;

          // Toggle sections
          sections.forEach(section => {
            if (!selectedCategory || section.getAttribute('data-category') === selectedCategory) {
              (section as HTMLElement).style.display = 'block';
            } else {
              (section as HTMLElement).style.display = 'none';
            }
          });
        });
      });
    }

    // Run on initial load
    initFeaturedFilters();
    // Re-run on Astro view transition page load
    document.addEventListener('astro:page-load', initFeaturedFilters);
  </script>
</Layout>

<style>
  .featured-directory-page {
    padding-top: 14rem;
    padding-bottom: 4rem;

    background-color: #050505;
    min-height: 100vh;
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .filter-pill {
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover,
  .filter-pill:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .filter-pill.active,
  .filter-pill[aria-pressed="true"] {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  .category-heading {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1rem;
  }

  /* 
    Preserve Grid Math: Bulletproof mobile grid CSS constraint 
    to prevent horizontal text or card blowouts on small viewports.
  */
  .brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .brand-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 0.5rem;
    overflow: hidden;
    text-decoration: none;
    background-color: #111;
    transform: translateZ(0);
  }

  .brand-card-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .brand-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .brand-card-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(var(--brand-rgb), 0.4) 0%, #111 100%);
  }

  .brand-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.6) 100%);
    transition: opacity 0.4s ease;
  }

  .brand-card-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 2rem;
  }

  .brand-card-logo {
    max-width: 80%;
    max-height: 60%;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.8));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .brand-card-title {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: 1.5rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #fff;
    text-align: center;
  }

  .brand-card-hover-border {
    position: absolute;
    inset: 0;
    z-index: 3;
    border: 2px solid transparent;
    border-radius: 0.5rem;
    transition: border-color 0.3s ease;
    pointer-events: none;
  }

  /* Hover States */
  .brand-card:hover .brand-card-image {
    transform: scale(1.05);
  }

  .brand-card:hover .brand-card-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.4) 100%);
  }

  .brand-card:hover .brand-card-logo {
    transform: scale(1.08);
  }

  .brand-card:hover .brand-card-hover-border,
  .brand-card:focus-visible .brand-card-hover-border {
    border-color: rgba(var(--brand-rgb), 0.8);
  }

  .brand-card:focus-visible {
    outline: none;
  }
</style>
