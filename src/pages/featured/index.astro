      y=0 to 16.7% and y=100% to 83.3%, so the ramps run 17%->27% and
      73%->83%: zero alpha everywhere outside the panel, fully opaque across
      the middle 70%, and a soft feather at top and bottom rather than a cut.

      The two gradients are INTERSECTED — a mask layer list composites with
      `add` by default, which would union them and mask nothing.
    */
    -webkit-mask-image:
      linear-gradient(to right,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0.03) 6%, rgba(0,0,0,0.10) 11%,
        rgba(0,0,0,0.24) 15%, rgba(0,0,0,0.45) 19%, rgba(0,0,0,0.68) 22%,
        rgba(0,0,0,0.86) 25%, rgba(0,0,0,0.96) 27%, rgba(0,0,0,1) 29%,
        rgba(0,0,0,1) 100%),
      linear-gradient(to bottom,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0) 17%, rgba(0,0,0,0.18) 20%,
        rgba(0,0,0,0.55) 23%, rgba(0,0,0,0.86) 25%, rgba(0,0,0,1) 27%,
        rgba(0,0,0,1) 73%, rgba(0,0,0,0.86) 75%, rgba(0,0,0,0.55) 77%,
        rgba(0,0,0,0.18) 80%, rgba(0,0,0,0) 83%, rgba(0,0,0,0) 100%);
    mask-image:
      linear-gradient(to right,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0.03) 6%, rgba(0,0,0,0.10) 11%,
        rgba(0,0,0,0.24) 15%, rgba(0,0,0,0.45) 19%, rgba(0,0,0,0.68) 22%,
        rgba(0,0,0,0.86) 25%, rgba(0,0,0,0.96) 27%, rgba(0,0,0,1) 29%,
        rgba(0,0,0,1) 100%),
      linear-gradient(to bottom,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0) 17%, rgba(0,0,0,0.18) 20%,
        rgba(0,0,0,0.55) 23%, rgba(0,0,0,0.86) 25%, rgba(0,0,0,1) 27%,
        rgba(0,0,0,1) 73%, rgba(0,0,0,0.86) 75%, rgba(0,0,0,0.55) 77%,
        rgba(0,0,0,0.18) 80%, rgba(0,0,0,0) 83%, rgba(0,0,0,0) 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }
  
  .trailer-iframe, .trailer-fallback-img {
    width: 100%;
