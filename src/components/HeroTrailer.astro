---
// Fully self-contained hero trailer. Zero global CSS, no generic IDs, no
// dependency on the site-wide video modal. Two physical structures toggled by
// CSS media queries so there is never a JS breakpoint "dead UI" trap:
//
//   • Mobile (≤899px): a NATIVE YouTube iframe (controls, playsinline, no
//     autoplay, no custom overlay). The user taps the native thumbnail/play
//     button directly — the only thing iOS Safari reliably honours, and it
//     shows the creator's custom YouTube thumbnail for free.
//   • Desktop (≥900px): custom poster + muted autoplay + a scoped sound toggle,
//     driven by the YouTube postMessage API (desktop has no async gesture rules).
//
// Only the visible side is ever given a src, so a single embed loads at a time
// and a hidden side can never bleed audio.
export interface Props {
  trailerId: string;
  title: string;
  /** Optional desktop poster; defaults to the video's YouTube thumbnail. */
  posterUrl?: string;
}
const { trailerId, title, posterUrl } = Astro.props;

const uid = Math.random().toString(36).slice(2, 11);
const poster = posterUrl || `https://i.ytimg.com/vi/${trailerId}/maxresdefault.jpg`;
const posterFallback = `https://i.ytimg.com/vi/${trailerId}/hqdefault.jpg`;

const base = `https://www.youtube-nocookie.com/embed/${trailerId}`;
const mobileSrc = `${base}?playsinline=1&rel=0&modestbranding=1&loop=1&playlist=${trailerId}&enablejsapi=1`;
const desktopSrc = `${base}?autoplay=1&mute=1&loop=1&playlist=${trailerId}&controls=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1`;
---

<hero-trailer class="ht-root" data-uid={uid} data-title={title}>
  {/* MOBILE — native player only. src is attached by JS when this side is shown. */}
  <div class="ht-mobile">
    <iframe
      class="ht-frame"
      data-src={mobileSrc}
      title={title}
      
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </div>

  {/* DESKTOP — custom poster + muted autoplay + sound toggle. */}
  <div class="ht-desktop">
    <div class="ht-mount" data-src={desktopSrc}></div>

    <button type="button" class="ht-poster" aria-label={`Play ${title} trailer`} data-play-hover="true">
      <img
        class="ht-poster-img"
        src={poster}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        data-fallback={posterFallback}
      />
      <div class="ht-play-wrapper" aria-hidden="true">
        <div class="cinematic-play-button">
          <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
    </button>

    <button type="button" class="ht-sound is-muted" aria-label="Unmute trailer" aria-pressed="false">
      <svg class="ht-ico-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 5 6 9H2v6h4l5 4z" />
        <line x1="22" y1="9" x2="16" y2="15" />
        <line x1="16" y1="9" x2="22" y2="15" />
      </svg>
      <svg class="ht-ico-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 5 6 9H2v6h4l5 4z" />
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
      </svg>
    </button>
  </div>
</hero-trailer>

<style>
  /* Everything is scoped to .hero-trailer; Astro also hashes these selectors, so
     there is zero chance of touching the global video modal or any other player. */
  .ht-root {
    display: block;
    position: relative;
    width: 100%;
    max-width: min(100%, calc(80vh * 16 / 9));
    max-height: 80vh;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    background: #000;
    /* No border-radius / overflow:hidden — both trigger the iOS Safari black-box
       bug on cross-origin video iframes. */
  }

  .ht-mobile,
  .ht-desktop {
    position: absolute;
    inset: 0;
  }

  /* The injected/native iframes fill their side. */
  .ht-root :global(iframe.ht-frame),
  .ht-mount :global(iframe) {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    transform: translateZ(0) !important;
    border: 0 !important;
  }

  /* --- Desktop poster --- */
  .ht-poster {
    position: absolute;
    inset: 0;
    z-index: 4;
    padding: 0;
    border: none;
    background: #000;
    cursor: pointer;
    transition: opacity 0.4s ease;
  }
  .ht-poster.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  .ht-poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ht-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    transition: background 0.3s ease;
  }
  .ht-poster:hover::after,
  .ht-poster:focus-visible::after {
    background: rgba(0, 0, 0, 0.2);
  }
  .ht-play-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  /* --- Desktop sound toggle --- */
  .ht-sound {
    position: absolute;
    bottom: 0.85rem;
    right: 0.85rem;
    z-index: 5;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.85); /* Removed backdrop-filter to prevent iOS Safari iframe compositing bug */
    color: #fff;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }
  .ht-sound:hover,
  .ht-sound:focus-visible {
    background: var(--color-accent, #cc0000);
    border-color: var(--color-accent, #cc0000);
    transform: scale(1.06);
    outline: none;
  }
  .ht-sound svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .ht-sound .ht-ico-unmuted {
    display: none;
  }
  .ht-sound.is-unmuted .ht-ico-muted {
    display: none;
  }
  .ht-sound.is-unmuted .ht-ico-unmuted {
    display: block;
  }

  /* --- Physical structure toggle. Both nodes exist; CSS decides which shows. --- */
  .ht-desktop {
    display: none;
  }
  @media (min-width: 900px) {
    .ht-mobile {
      display: none;
    }
    .ht-desktop {
      display: block;
    }
  }
</style>

<script>
  class HeroTrailer extends HTMLElement {
    private desktopFrame: HTMLIFrameElement | null = null;
    private ready = false;
    private muted = true;
    private posterHidden = false;
    private queue: any[] = [];
    private mql: MediaQueryList;
    private reconcileTimer: ReturnType<typeof setTimeout> | null = null;
    private orientTimer: ReturnType<typeof setTimeout> | null = null;
    private rebuildPending = false;
    private mobileFrame: HTMLIFrameElement | null = null;

    constructor() {
      super();
      this.mql = window.matchMedia('(min-width: 900px)');
      
      // Bind methods to preserve `this` context for event listeners
      this.onMessage = this.onMessage.bind(this);
      this.onMqlChange = this.onMqlChange.bind(this);
      this.onOrientation = this.onOrientation.bind(this);
    }

    connectedCallback() {
      const uid = this.dataset.uid || '';
      const title = this.dataset.title || 'Trailer';
      this.mobileFrame = this.querySelector('.ht-mobile .ht-frame') as HTMLIFrameElement;
      const mount = this.querySelector('.ht-mount');
      const poster = this.querySelector('.ht-poster');
      const soundBtn = this.querySelector('.ht-sound');
      const posterImg = this.querySelector('.ht-poster-img');

      if (posterImg) {
        posterImg.addEventListener('error', () => {
          const fb = (posterImg as HTMLElement).dataset.fallback;
          if (fb) (posterImg as HTMLImageElement).src = fb || "";
        }, { once: true });
      }

      window.addEventListener('message', this.onMessage);
      this.mql.addEventListener('change', this.onMqlChange);
      window.addEventListener('orientationchange', this.onOrientation);

      if (poster) {
        poster.addEventListener('click', () => {
          this.mountDesktop(mount, uid, title);
          this.command('playVideo');
          this.command('unMute');
          this.command('setVolume', [100]);
          this.setMuted(false, soundBtn);
          this.hidePoster(poster);
        });
      }
      if (soundBtn) {
        soundBtn.addEventListener('click', () => {
          if (this.muted) {
            this.command('unMute');
            this.command('setVolume', [100]);
            this.command('playVideo');
            this.setMuted(false, soundBtn);
          } else {
            this.command('mute');
            this.setMuted(true, soundBtn);
          }
        });
      }

      this.reconcile(false, mount, uid, title);
    }

    disconnectedCallback() {
      window.removeEventListener('message', this.onMessage);
      window.removeEventListener('orientationchange', this.onOrientation);
      this.mql.removeEventListener('change', this.onMqlChange);
      if (this.reconcileTimer) clearTimeout(this.reconcileTimer);
      if (this.orientTimer) clearTimeout(this.orientTimer);
      this.unmountDesktop();
    }

    private post(payload: any) {
      if (this.desktopFrame && this.desktopFrame.contentWindow) {
        this.desktopFrame.contentWindow.postMessage(JSON.stringify(payload), 'https://www.youtube.com');
      }
    }

    private command(func: string, args: any[] = []) {
      const payload = { event: 'command', func, args };
      if (this.ready) this.post(payload);
      else this.queue.push(payload);
    }

    private setMuted(m: boolean, soundBtn: Element | null) {
      this.muted = m;
      if (!soundBtn) return;
      soundBtn.classList.toggle('is-muted', m);
      soundBtn.classList.toggle('is-unmuted', !m);
      soundBtn.setAttribute('aria-pressed', String(!m));
      soundBtn.setAttribute('aria-label', m ? 'Unmute trailer' : 'Mute trailer');
    }

    private hidePoster(poster: Element | null) {
      if (this.posterHidden || !poster) return;
      this.posterHidden = true;
      poster.classList.add('is-hidden');
    }

    private onMessage(e: MessageEvent) {
      if (!this.desktopFrame || !this.desktopFrame.contentWindow || e.source !== this.desktopFrame.contentWindow) return;
      let data;
      try {
        data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
      } catch (err) {
        console.warn('[HeroTrailer] Failed to parse message data:', err);
        return;
      }
      if (!data) return;
      if ((data.event === 'onReady' || data.event === 'initialDelivery') && !this.ready) {
        this.ready = true;
        this.queue.splice(0).forEach((p: any) => this.post(p));
      }
      const state = data.info && typeof data.info.playerState === 'number'
          ? data.info.playerState
          : data.event === 'onStateChange' && typeof data.info === 'number'
            ? data.info
            : undefined;
      
      const poster = this.querySelector('.ht-poster');
      if (state === 1) this.hidePoster(poster);
      
      if (data.event === 'infoDelivery' && data.info && typeof data.info.muted === 'boolean') {
        if (data.info.muted !== this.muted) {
          const soundBtn = this.querySelector('.ht-sound');
          this.setMuted(data.info.muted, soundBtn);
        }
      }
    }

    private nudge(el: HTMLElement) {
      el.style.transform = 'translateZ(0)';
      void el.offsetHeight; // force reflow
      requestAnimationFrame(() => {
        el.style.transform = '';
      });
    }

    private exitFullscreen() {
      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      } else if ((document as any).webkitFullscreenElement && (document as any).webkitExitFullscreen) {
        (document as any).webkitExitFullscreen();
      }
    }

    private mountDesktop(mount: Element | null, uid: string, title: string) {
      if (this.desktopFrame || !mount) return;
      this.ready = false;
      this.posterHidden = false;
      this.muted = true;
      this.queue.length = 0;
      
      const poster = this.querySelector('.ht-poster');
      const soundBtn = this.querySelector('.ht-sound');
      
      if (poster) poster.classList.remove('is-hidden');
      this.setMuted(true, soundBtn);
      
      this.desktopFrame = document.createElement('iframe');
      this.desktopFrame.className = 'ht-frame';
      this.desktopFrame.id = 'ht-frame-' + uid;
      this.desktopFrame.title = title;
      this.desktopFrame.setAttribute('frameborder', '0');
      this.desktopFrame.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
      this.desktopFrame.setAttribute('allowfullscreen', '');
      this.desktopFrame.addEventListener('load', () => this.post({ event: 'listening', id: this.desktopFrame?.id, channel: 'widget' }));
      this.desktopFrame.src = (mount as HTMLElement).dataset.src || 'about:blank';
      mount.appendChild(this.desktopFrame);
      this.nudge(this.desktopFrame);
    }

    private unmountDesktop() {
      if (!this.desktopFrame) return;
      this.desktopFrame.remove();
      this.desktopFrame = null;
      this.ready = false;
      this.queue.length = 0;
    }

    private showMobile() {
      if (this.mobileFrame && !this.mobileFrame.src && this.mobileFrame.dataset.src) {
        this.mobileFrame.src = this.mobileFrame.dataset.src;
      }
    }

    private hideMobile() {
      if (this.mobileFrame && this.mobileFrame.src) this.mobileFrame.removeAttribute('src');
    }

    private rebuildMobile(title: string) {
      if (!this.mobileFrame || !this.mobileFrame.parentNode) return;
      this.exitFullscreen();
      const dataSrc = this.mobileFrame.dataset.src;
      const fresh = document.createElement('iframe');
      fresh.className = 'ht-frame';
      fresh.title = title;
      fresh.setAttribute('frameborder', '0');
      fresh.setAttribute('loading', 'lazy');
      fresh.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
      fresh.setAttribute('allowfullscreen', '');
      if (dataSrc) fresh.dataset.src = dataSrc;
      this.mobileFrame.parentNode.replaceChild(fresh, this.mobileFrame);
      this.mobileFrame = fresh;
      if (dataSrc) this.mobileFrame.src = dataSrc;
      this.nudge(this.mobileFrame);
    }

    private reconcile(rebuild: boolean, mount: Element | null, uid: string, title: string) {
      if (this.mql.matches) {
        this.hideMobile();
        if (rebuild) this.unmountDesktop();
        this.mountDesktop(mount, uid, title);
      } else {
        this.unmountDesktop();
        if (rebuild) this.rebuildMobile(title);
        else this.showMobile();
      }
    }

    private scheduleReconcile(rebuild: boolean) {
      if (rebuild) this.rebuildPending = true;
      if (this.reconcileTimer) clearTimeout(this.reconcileTimer);
      this.reconcileTimer = setTimeout(() => {
        this.reconcileTimer = null;
        const doRebuild = this.rebuildPending;
        this.rebuildPending = false;
        
        const uid = this.dataset.uid || '';
        const title = this.dataset.title || 'Trailer';
        const mount = this.querySelector('.ht-mount');
        this.reconcile(doRebuild, mount, uid, title);
      }, 80);
    }

    private onMqlChange() {
      this.scheduleReconcile(true);
    }

    private onOrientation() {
      const vv = window.visualViewport;
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        if (vv) vv.removeEventListener('resize', finish);
        this.scheduleReconcile(true);
      };
      if (vv) vv.addEventListener('resize', finish);
      this.orientTimer = setTimeout(finish, 400);
    }
  }

  customElements.define('hero-trailer', HeroTrailer);
</script>
