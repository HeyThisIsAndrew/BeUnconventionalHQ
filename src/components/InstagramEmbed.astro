---
/**
 * A client-side Web Component that upgrades <instagram-embed> tags emitted by
 * the HTML sanitizer into a standard-width, cinematic social media card matching
 * the site's editorial layout.
 *
 * SPLIT LAYOUT:
 * - Left half: Vertical 9:16 video preview with interactive play overlay.
 * - Right half: Sourced social media branding (Instagram gradient mark),
 *   metadata, inline play action, and direct "Watch on Instagram" exit door.
 *
 * In player mode, the card mounts a clean, responsive Instagram embed iframe
 * with dedicated escape and return controls.
 */
---
<script>
  import { SOCIAL_ICONS } from '../data/icons.js';

  class InstagramEmbed extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';

      const instagramId = this.getAttribute('instagram-id');
      if (!instagramId) return;

      const thumbnailUrl = this.getAttribute('thumbnail-url');
      const rawTitle = this.getAttribute('title');
      const authorName = this.getAttribute('author-name');
      const displayTitle = rawTitle && rawTitle.toLowerCase() !== 'instagram'
        ? rawTitle
        : 'Featured Instagram Reel';
      const handle = authorName ? `@${authorName}` : 'Instagram';

      this.renderFacade(instagramId, thumbnailUrl, displayTitle, handle);
    }

    renderFacade(instagramId: string, thumbnailUrl: string | null, displayTitle: string, handle: string) {
      this.classList.remove('is-player');

      const imageMarkup = thumbnailUrl
        ? `<img
             class="ig-preview-img"
             src="${thumbnailUrl}"
             alt="${displayTitle.replace(/"/g, '&quot;')}"
             loading="lazy"
             decoding="async"
           />`
        : `<div class="ig-placeholder-fallback">
             <span class="ig-fallback-icon" aria-hidden="true">${SOCIAL_ICONS.Instagram}</span>
             <span class="ig-fallback-label">Instagram Reel</span>
           </div>`;

      this.innerHTML = `
        <div class="ig-embed-card">
          <div class="ig-preview-pane" role="button" tabindex="0" aria-label="Play ${displayTitle.replace(/"/g, '&quot;')}">
            ${imageMarkup}
            <div class="ig-preview-overlay">
              <span class="ig-preview-badge">
                <span class="ig-badge-svg" aria-hidden="true">${SOCIAL_ICONS.Instagram}</span>
                <span>Reel</span>
              </span>
              <div class="ig-play-circle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>
          <div class="ig-brand-pane">
            <div class="ig-brand-header">
              <div class="ig-platform-logo" aria-hidden="true">
                ${SOCIAL_ICONS.Instagram}
              </div>
              <div class="ig-brand-meta">
                <span class="ig-brand-type">Instagram Reel</span>
                <span class="ig-brand-handle">${handle}</span>
              </div>
            </div>
            <div class="ig-brand-body">
              <h3 class="ig-brand-title">${displayTitle}</h3>
              <p class="ig-brand-desc">Watch the original video on Instagram or launch the player inline.</p>
            </div>
            <div class="ig-brand-actions">
              <button class="ig-btn-play" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                <span>Play in Article</span>
              </button>
              <a class="ig-btn-external" href="https://www.instagram.com/p/${encodeURIComponent(instagramId)}/" target="_blank" rel="noopener noreferrer">
                <span>Watch on Instagram</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            </div>
          </div>
        </div>
      `;

      const start = (e: Event) => {
        e.preventDefault();
        this.play(instagramId, thumbnailUrl, displayTitle, handle);
      };

      const previewPane = this.querySelector('.ig-preview-pane');
      const playBtn = this.querySelector('.ig-btn-play');

      previewPane?.addEventListener('click', start);
      previewPane?.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') start(e);
      });
      playBtn?.addEventListener('click', start);
    }

    play(instagramId: string, thumbnailUrl: string | null, displayTitle: string, handle: string) {
      this.classList.add('is-player');

      this.innerHTML = `
        <div class="ig-player-card">
          <div class="ig-player-topbar">
            <div class="ig-topbar-left">
              <span class="ig-topbar-mark" aria-hidden="true">${SOCIAL_ICONS.Instagram}</span>
              <span class="ig-topbar-title">${displayTitle}</span>
            </div>
            <div class="ig-topbar-actions">
              <a class="ig-topbar-watch" href="https://www.instagram.com/p/${encodeURIComponent(instagramId)}/" target="_blank" rel="noopener noreferrer">
                <span>Watch on Instagram</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
              <button class="ig-btn-close-player" type="button" aria-label="Return to preview">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
          </div>
          <div class="ig-frame-stage">
            <iframe
              class="ig-embed-frame"
              title="Instagram player"
              src="https://www.instagram.com/p/${encodeURIComponent(instagramId)}/embed/"
              allowtransparency="true"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              allowfullscreen
              scrolling="no"
            ></iframe>
          </div>
        </div>
      `;

      const closeBtn = this.querySelector('.ig-btn-close-player');
      closeBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        this.renderFacade(instagramId, thumbnailUrl, displayTitle, handle);
      });
    }
  }

  if (!customElements.get('instagram-embed')) {
    customElements.define('instagram-embed', InstagramEmbed);
  }
</script>

<style is:global>
  /*
    INSTAGRAM EMBED: STANDARD-WIDTH CINEMATIC SPLIT CARD

    Spans standard image width (100% of reading column).
    - Left half: 9:16 vertical video preview.
    - Right half: Social platform branding, title, and action hub.
    - Zero horizontal overflow on mobile; clean 2.5rem vertical rhythm.
  */
  instagram-embed {
    display: block;
    width: 100%;
    margin: 2.5rem 0;
    position: relative;
    box-sizing: border-box;
  }

  /* ── FACADE CARD ── */
  instagram-embed .ig-embed-card {
    display: flex;
    flex-direction: row;
    background: var(--color-surface, #111111);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    overflow: hidden;
    min-height: 380px;
    max-height: 420px;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.9), 0 2px 6px -2px rgba(0, 0, 0, 0.8);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  instagram-embed .ig-embed-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }

  /* ── LEFT: VERTICAL PREVIEW ── */
  instagram-embed .ig-preview-pane {
    position: relative;
    width: 236px;
    flex-shrink: 0;
    background: #000;
    cursor: pointer;
    overflow: hidden;
  }

  instagram-embed .ig-preview-pane:focus-visible {
    outline: 2px solid var(--color-accent, #cc0000);
    outline-offset: -2px;
  }

  instagram-embed .ig-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    instagram-embed .ig-preview-pane:hover .ig-preview-img {
      transform: scale(1.04);
    }
  }

  instagram-embed .ig-preview-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.8) 0%,
      rgba(9, 9, 11, 0.1) 40%,
      rgba(9, 9, 11, 0.4) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  instagram-embed .ig-preview-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
  }

  instagram-embed .ig-badge-svg {
    display: inline-flex;
    width: 12px;
    height: 12px;
  }

  instagram-embed .ig-play-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
  }

  instagram-embed .ig-play-circle svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    instagram-embed .ig-preview-pane:hover .ig-play-circle {
      transform: scale(1.1);
      border-color: var(--color-accent, #cc0000);
      background: rgba(204, 0, 0, 0.85);
      box-shadow: 0 0 25px rgba(204, 0, 0, 0.5);
    }
  }

  /* ── RIGHT: BRAND & HUB PANE ── */
  instagram-embed .ig-brand-pane {
    flex: 1;
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: radial-gradient(ellipse at top right, rgba(225, 48, 108, 0.08) 0%, transparent 65%), var(--color-surface, #111111);
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  instagram-embed .ig-brand-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  instagram-embed .ig-platform-logo {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(220, 39, 67, 0.3);
  }

  instagram-embed .ig-platform-logo svg {
    width: 22px;
    height: 22px;
  }

  instagram-embed .ig-brand-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  instagram-embed .ig-brand-type {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-white-muted, #888);
  }

  instagram-embed .ig-brand-handle {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-white, #f0f0f0);
  }

  instagram-embed .ig-brand-body {
    margin: 1.25rem 0;
  }

  instagram-embed .ig-brand-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-white, #f0f0f0);
    margin: 0 0 0.5rem 0;
  }

  instagram-embed .ig-brand-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-white-muted, #888);
    margin: 0;
  }

  instagram-embed .ig-brand-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  instagram-embed .ig-btn-play {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-accent, #cc0000);
    border: 1px solid var(--color-accent, #cc0000);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.7rem 1.4rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  instagram-embed .ig-btn-play:hover {
    background-color: #e00000;
    box-shadow: 0 0 20px rgba(204, 0, 0, 0.4);
    transform: translateY(-1px);
  }

  .article-body instagram-embed .ig-btn-external,
  instagram-embed .ig-btn-external {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-white, #f0f0f0);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.7rem 1.25rem;
    border-radius: 4px;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .article-body instagram-embed .ig-btn-external:hover,
  instagram-embed .ig-btn-external:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  /* ── PLAYER CARD MODE ── */
  instagram-embed .ig-player-card {
    background: var(--color-surface, #111111);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.9);
  }

  instagram-embed .ig-player-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background: rgba(0, 0, 0, 0.5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  instagram-embed .ig-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  instagram-embed .ig-topbar-mark {
    display: inline-flex;
    width: 16px;
    height: 16px;
    color: var(--color-accent-text, #ef4444);
  }

  instagram-embed .ig-topbar-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-white, #f0f0f0);
  }

  instagram-embed .ig-topbar-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .article-body instagram-embed .ig-topbar-watch,
  instagram-embed .ig-topbar-watch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-white-muted, #888);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-body instagram-embed .ig-topbar-watch:hover,
  instagram-embed .ig-topbar-watch:hover {
    color: #fff;
  }

  instagram-embed .ig-btn-close-player {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-white-muted, #888);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  instagram-embed .ig-btn-close-player:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  instagram-embed .ig-frame-stage {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 0;
    background: #000;
  }

  instagram-embed .ig-embed-frame {
    width: 100%;
    max-width: 480px;
    min-height: 520px;
    height: 540px;
    border: 0;
    background: transparent;
  }

  /* ── FALLBACK ── */
  instagram-embed .ig-placeholder-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: radial-gradient(circle at 30% 30%, #222, #0d0d0d);
    color: var(--color-white-muted, #aaa);
  }

  instagram-embed .ig-fallback-icon {
    width: 48px;
    height: 48px;
    opacity: 0.7;
  }

  instagram-embed .ig-fallback-label {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ── MOBILE RESPONSIVE ── */
  @media (max-width: 640px) {
    instagram-embed .ig-embed-card {
      flex-direction: column;
      max-height: none;
      min-height: auto;
    }

    instagram-embed .ig-preview-pane {
      width: 100%;
      height: 280px;
    }

    instagram-embed .ig-brand-pane {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 1.5rem 1.25rem;
    }

    instagram-embed .ig-brand-title {
      font-size: 1.15rem;
    }

    instagram-embed .ig-frame-stage {
      padding: 0;
    }

    instagram-embed .ig-embed-frame {
      min-height: 480px;
      height: 500px;
    }
  }
</style>
