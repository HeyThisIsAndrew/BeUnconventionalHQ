---
// src/components/CommandPalette.astro
---

<dialog id="command-palette" class="cmd-palette" aria-label="Search content" transition:persist="command-palette">
  <div class="cmd-palette-content">
    <div class="cmd-palette-header">
      <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      {/*
        A COMPLETE COMBOBOX, OR NONE.

        The results carried role="listbox" and role="option" and the input got
        `aria-activedescendant`, but the input itself had no role. A partial
        pattern is worse than no pattern: options with no combobox to belong
        to, and an activedescendant pointing out of nowhere. `aria-expanded` is
        kept in step in JS on open and close.
      */}
      {/*
        PHONE KEYBOARD HINTS (`enterkeyhint`, `autocapitalize`, `autocorrect`
        below). All three change what the on-screen keyboard does, and none of
        them apply on desktop.

        `enterkeyhint` labels the return key "Search" instead of "Go".
        `autocapitalize` stops the first letter of every query becoming a
        capital. `autocorrect` stops iOS rewriting the words this site is
        mostly made of: title casing and proper nouns like MCU, Sanderson or
        Gundam are exactly what autocorrect treats as mistakes.

        `type` stays "text", not "search": Safari decorates a search input with
        its own clear button and inner shadow, which fights the panel.

        This comment sits OUT here rather than among the attributes below: a
        JSX comment block inside an element's attribute list is a parse error
        that `astro build` does not report. `npx astro check` does. The two
        catch different things, so run both.
      */}
      <input
        type="text"
        id="cmd-palette-input"
        role="combobox"
        aria-label="Search videos, articles, events and hubs"
        aria-controls="cmd-palette-results"
        aria-expanded="false"
        aria-autocomplete="list"
        placeholder="Search videos, articles, events..."
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        autocapitalize="off"
        autocorrect="off"
      />
      {/*
        THE DISMISS CONTROL HAS TO WORK ON A DEVICE WITH NO ESC KEY.

        It was a ~30x20px chip reading "ESC". On desktop that is a good hint.
        On a phone it names a key that does not exist, at well under a 44px
        target, and it is the only visible way out: the backdrop is mostly
        covered by the panel itself, so "tap outside" is not the escape hatch
        it is on desktop.

        So: the key name on desktop, a 44x44 close glyph on touch. The
        accessible name stays the same in both, and stays a superset of the
        visible "ESC" for WCAG 2.5.3 (Label in Name).
      */}
      <button class="close-btn" aria-label="Close search (Esc)">
        <span class="close-btn-key" aria-hidden="true">ESC</span>
        <span class="close-btn-glyph" aria-hidden="true">&#215;</span>
      </button>
    </div>
    <div class="cmd-palette-results" id="cmd-palette-results" role="listbox">
      <div class="cmd-palette-empty" id="cmd-palette-empty">No results found.</div>
    </div>
  </div>
</dialog>

<script>
  let indexLoaded = false;
  let searchData: any[] = [];
  let fuse: any = null;
  let activeIndex = -1;

  async function loadIndex() {
    if (indexLoaded) return;
    try {
      const [fuseModule, res] = await Promise.all([
        import('fuse.js'),
        fetch('/api/search-index.json')
      ]);
      const Fuse = fuseModule.default;
      searchData = await res.json();
      
      fuse = new Fuse(searchData, {
        keys: [
          { name: 'title', weight: 2 },
          { name: 'tags', weight: 1 },
          { name: 'type', weight: 0.5 }
        ],
        threshold: 0.4,
        ignoreLocation: true,
      });
      indexLoaded = true;
    } catch (e) {
      console.error('Failed to load search index:', e);
    }
  }

  function initCommandPalette() {
    const dialog = document.getElementById('command-palette') as HTMLDialogElement;
    const input = document.getElementById('cmd-palette-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('cmd-palette-results');
    const emptyState = document.getElementById('cmd-palette-empty');
    const closeBtn = dialog?.querySelector('.close-btn');
    
    if (!dialog || !input || !resultsContainer || !emptyState) return;
    if (dialog.dataset.init === 'true') return;
    dialog.dataset.init = 'true';

    const renderResults = (results: any[], isDefaultView = false) => {
      // Clear previous
      Array.from(resultsContainer.children).forEach(child => {
        if (child !== emptyState) child.remove();
      });

      if (results.length === 0) {
        emptyState.style.display = 'block';
        return;
      }
      
      emptyState.style.display = 'none';
      
      if (isDefaultView) {
        const eyebrow = document.createElement('div');
        eyebrow.className = 'cmd-palette-eyebrow';
        eyebrow.textContent = 'RECENT TRANSMISSIONS';
        resultsContainer.appendChild(eyebrow);
      }

      results.slice(0, 10).forEach((result, idx) => {
        const item = result.item;
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'cmd-result-item';
        a.setAttribute('role', 'option');
        a.setAttribute('id', `cmd-result-${idx}`);
        /*
          A `role="option"` with no `aria-selected` is an incomplete option.
          `aria-activedescendant` tells a screen reader WHICH row is current,
          but the reader announces the selected STATE from this attribute, so
          without it the row is read out with no indication it is the one
          Enter will open. Every row carries it; `updateActiveState()` flips
          the current one to true.
        */
        a.setAttribute('aria-selected', 'false');
        // Lets the mix be asserted without parsing the badge's display text.
        a.setAttribute('data-type', item.type);
        
        // If it's a video, use the global handler
        if (item.type === 'video') {
          a.setAttribute('data-action', 'open-video');
          const videoId = item.url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&]+)/)?.[1] || item.id;
          a.setAttribute('data-video-id', videoId);
        }

        /*
          THE LEADING BOX IS ALWAYS RENDERED, EVEN WITH NOTHING TO PUT IN IT.

          The row is a flex line: [96x54 image][text column]. Section pages
          carry no image at all, so the image was skipped, the text column
          became the first child, and the badge and title slid left into the
          thumbnail's lane. In a list of ten rows the one page entry was the
          only text not aligned with the rest, which reads as broken rather
          than as different.

          So the box is unconditional and holds a glyph when there is no
          image. Same size, same border, same background: the column line
          holds all the way down, and an entry with no artwork looks
          deliberate instead of missing.
        */
        if (item.image) {
          const img = document.createElement('img');
          img.src = item.image;
          /*
            A hub's image is its LOGO, and a logo must never be cropped. The
            thumbnail rule (`object-fit: cover` on a 16:9 box) chopped the top
            and bottom off the Warner Bros shield and the DC disc, which is not
            something to do to somebody else's brand mark. Tagged here so the
            stylesheet can treat the two cases differently.
          */
          img.className = item.type === 'hub' ? 'cmd-result-image is-mark' : 'cmd-result-image';
          img.alt = '';
          img.loading = 'lazy';
          a.appendChild(img);
        } else {
          const placeholder = document.createElement('div');
          placeholder.className = 'cmd-result-image is-placeholder';
          /*
            Decorative: the badge beside it already says PAGE, and the title
            says which one. Announcing a glyph here would just be noise.
          */
          placeholder.setAttribute('aria-hidden', 'true');
          placeholder.innerHTML =
            '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" ' +
            'stroke="currentColor" stroke-width="1.5" stroke-linecap="round" ' +
            'stroke-linejoin="round">' +
            '<rect x="3" y="3" width="18" height="18"></rect>' +
            '<line x1="3" y1="9" x2="21" y2="9"></line>' +
            '<line x1="9" y1="21" x2="9" y2="9"></line>' +
            '</svg>';
          a.appendChild(placeholder);
        }

        const info = document.createElement('div');
        info.className = 'cmd-result-info';

        const typeLabel = document.createElement('span');
        typeLabel.className = 'cmd-result-badge';
        typeLabel.textContent = item.type.toUpperCase();

        const title = document.createElement('span');
        title.className = 'cmd-result-title';
        title.textContent = item.title;

        info.appendChild(typeLabel);
        info.appendChild(title);

        a.appendChild(info);
        resultsContainer.appendChild(a);
      });
    };

    /*
      THE DEFAULT VIEW IS A CURATED MIX, NOT THE TOP OF A DATE SORT.

      It used to be `searchData.slice(0, 10)`, and the index is sorted newest
      first. Hubs and section pages were stamped with the BUILD TIME, so all 18
      hubs sorted above every real article and video and the palette opened on
      nothing but hubs. That is fixed at the source (they carry no date now),
      but "the ten newest things" is still the wrong opening move for a search
      box: it shows one kind of thing whenever one kind of thing was published
      last.

      An empty query is somebody who has not told us what they want yet. So
      show them the SHAPE of the site — a few of each kind, newest first within
      each — rather than a slice of one bucket.
    */
    const DEFAULT_MIX: Array<[string, number]> = [
      ['article', 3],
      ['video', 3],
      ['hub', 2],
      ['event', 1],
      ['page', 1],
    ];

    const defaultResults = () => {
      const out: any[] = [];
      for (const [type, count] of DEFAULT_MIX) {
        out.push(...searchData.filter((d) => d.type === type).slice(0, count));
      }
      /* If a bucket is short (no events yet, say), backfill from whatever is
         left so the panel never opens looking half-empty. */
      if (out.length < 10) {
        for (const d of searchData) {
          if (out.length >= 10) break;
          if (!out.includes(d)) out.push(d);
        }
      }
      return out.map((item) => ({ item }));
    };

    const performSearch = () => {
      if (!fuse) return;
      const query = input.value.trim();
      if (!query) {
        renderResults(defaultResults(), true);
      } else {
        renderResults(fuse.search(query));
      }
      activeIndex = -1;
      updateActiveState();
    };

    const updateActiveState = () => {
      const items = Array.from(resultsContainer.querySelectorAll('.cmd-result-item'));
      items.forEach((item, idx) => {
        if (idx === activeIndex) {
          item.classList.add('active');
          item.setAttribute('aria-selected', 'true');
          item.scrollIntoView({ block: 'nearest' });
          input.setAttribute('aria-activedescendant', `cmd-result-${idx}`);
        } else {
          item.classList.remove('active');
          item.setAttribute('aria-selected', 'false');
        }
      });
    };

    // Open/Close logic
    /*
      WHERE FOCUS GOES WHEN THE PALETTE CLOSES.

      A <dialog> is supposed to hand focus back to whatever opened it, and in
      practice here it did not: opening from the header's search button and
      pressing Escape left `document.activeElement` on <body>. For a keyboard
      user that is not a cosmetic detail. Focus on <body> means the next Tab
      restarts from the top of the document, so closing a search they decided
      against costs them their place on the page. Remember the opener and put
      focus back on it.
    */
    let lastFocused: HTMLElement | null = null;

    const openPalette = (opener?: HTMLElement | null) => {
      if (dialog.open) return;
      /*
        The opener is passed in rather than read off `document.activeElement`,
        because a tap does not reliably focus a <button>: iOS Safari leaves
        activeElement on <body>, so reading it there restored focus to nothing
        for exactly the case that needed it. Cmd+K passes nothing and falls
        back to activeElement, which is correct: that path should return the
        user to whatever they were on.
      */
      lastFocused = opener ?? (document.activeElement as HTMLElement | null);
      dialog.showModal();
      if (window.__hqScrollLock) {
        window.__hqScrollLock.lock();
      } else {
        document.body.style.overflow = 'hidden';
      }
      input.value = '';
      input.setAttribute('aria-expanded', 'true');
      loadIndex().then(() => performSearch());
    };

    /*
      TEARDOWN HANGS OFF THE DIALOG'S OWN `close` EVENT, NOT OFF closePalette().

      A <dialog> opened with showModal() closes on Escape BY ITSELF, without
      running any of our code. The teardown used to live inside closePalette(),
      which Escape only reaches when focus happens to be in the input. Move
      focus anywhere else first — one Tab lands on the ESC button — and Escape
      closed the dialog while leaving `modal-open` on <html> and the page
      unscrollable, with a reload as the only way out. Reproduced:

        focus = close-btn, Escape -> open:false, body overflow:"hidden"

      `close` fires for every path: Escape, dialog.close(), form submission.
      Putting the unlock here makes it impossible to close this without
      unlocking, which is the property that was missing.
    */
    dialog.addEventListener('close', () => {
      if (window.__hqScrollLock) {
        window.__hqScrollLock.unlock();
      } else {
        document.body.style.overflow = '';
      }
      input.value = '';
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      /*
        Only if it is still in the document and still focusable: a result click
        navigates away, and on a view transition the old button is gone.
      */
      if (lastFocused && lastFocused.isConnected && lastFocused !== document.body) {
        lastFocused.focus({ preventScroll: true });
      }
      lastFocused = null;
    });

    const closePalette = () => {
      /* The `close` listener above does the teardown. */
      if (dialog.open) dialog.close();
    };

    // Listeners
    closeBtn?.addEventListener('click', closePalette);
    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog) closePalette();
      if (target.closest('.cmd-result-item')) closePalette();
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      // Cmd+K / Ctrl+K
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        dialog.open ? closePalette() : openPalette();
      }
    });

    // Ensure it always closes on View Transition navigation
    document.addEventListener('astro:before-swap', () => {
      if (dialog.open) closePalette();
    });
    
    // Mobile search affordance trigger (any button with data-action="open-search")
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('[data-action="open-search"]') as HTMLElement | null;
      if (trigger) {
        e.preventDefault();
        openPalette(trigger);
      }
    });

    input.addEventListener('input', () => performSearch());
    
    input.addEventListener('keydown', (e) => {
      const items = Array.from(resultsContainer.querySelectorAll('.cmd-result-item')) as HTMLElement[];
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        updateActiveState();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = activeIndex - 1 < 0 ? items.length - 1 : activeIndex - 1;
        updateActiveState();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && activeIndex < items.length) {
          items[activeIndex].click();
          closePalette();
        } else if (items.length > 0) {
          items[0].click();
          closePalette();
        }
      } else if (e.key === 'Escape') {
        closePalette();
      }
    });
  }

  document.addEventListener('astro:page-load', initCommandPalette);
  initCommandPalette();
</script>

<style is:global>
  .cmd-palette {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 600px;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    overflow: visible;
  }
  .cmd-palette::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .cmd-palette[open] .cmd-palette-content {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
  .cmd-palette-content {
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0;
    box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255,255,255,0.02);
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    opacity: 0;
    transform: scale(0.98) translateY(-10px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /*
    THIS BLOCK MUST STAY BELOW THE BASE `.cmd-palette-content` RULE.

    Both selectors are a single class, so they have identical specificity and
    SOURCE ORDER decides. When this sat above the base rule, the base
    `max-height: 80vh` won and the `60dvh` below never applied at all: the
    panel still measured 682px in an 852px viewport. The fix was written and
    silently did nothing. Do not move this block up.
  */
  @media (max-width: 640px) {
    .cmd-palette {
      top: 5%;
      transform: translate(-50%, 0);
      width: 95%;
    }
    /*
      `dvh`, NOT `vh`, AND SMALLER.

      At `70vh` the panel was 682px tall in an 852px viewport, ending at 767px.
      A typical iOS keyboard takes ~336px, leaving 516px usable — so 251px of
      the results sat behind the keyboard, unreachable while typing, which is
      the whole time this thing is open.

      `dvh` is the DYNAMIC viewport height: it shrinks when the keyboard comes
      up, which is exactly the case here.

      This deliberately differs from the mobile hero, which uses `lvh` and
      where `dvh` is explicitly rejected (see scripts/viewport-units.test.mjs
      and hero.css). That rule is about an element sized to the SCROLL
      viewport, where `dvh` re-resolving as the address bar retracts makes the
      hero resize mid-scroll. Nothing scrolls behind a modal — the page is
      locked — so the objection does not transfer, and the property that makes
      `dvh` wrong there is the one that makes it right here.
    */
    .cmd-palette-content {
      max-height: 60dvh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmd-palette-content {
      transition: none;
    }
  }
  .cmd-palette-header {
    display: flex;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .search-icon {
    color: #888;
    margin-right: 1rem;
    width: 20px;
    height: 20px;
  }
  #cmd-palette-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.25rem;
    outline: none;
    font-family: inherit;
    font-weight: 300;
  }
  #cmd-palette-input::placeholder {
    /*
      Was `#555`: 2.66:1 on the panel, which fails WCAG AA for text and is
      darker than anything else on the site. A placeholder is text, and this
      one is the first thing anyone reads in here. `--color-white-muted` is
      the site's established floor for subordinate copy at 5.58:1, and still
      sits well below the #fff of what you type.
    */
    color: var(--color-white-muted);
  }
  .close-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255,255,255,0.05);
    color: #aaa;
    font-size: 0.65rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0;
    cursor: pointer;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }
  .close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .close-btn-glyph {
    display: none;
  }
  @media (max-width: 640px) {
    .close-btn {
      width: 44px;
      height: 44px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .close-btn-key {
      display: none;
    }
    .close-btn-glyph {
      display: block;
      font-size: 1.35rem;
      line-height: 1;
      font-weight: 400;
      letter-spacing: 0;
    }
  }
  .cmd-palette-results {
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cmd-palette-eyebrow {
    font-family: var(--font-display, 'Syne Variable', sans-serif);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #888;
    text-transform: uppercase;
    padding: 0.5rem 0.5rem 0.75rem 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    margin-bottom: 0.5rem;
  }
  .cmd-result-item {
    display: flex;
    align-items: center;
    padding: 0.5rem;
    border-radius: 0;
    text-decoration: none;
    color: #fff;
    cursor: pointer;
    transition: all 0.15s ease;
    gap: 1.25rem;
    border: 1px solid transparent;
  }
  .cmd-result-item:hover, .cmd-result-item.active {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255,255,255,0.05);
  }
  .cmd-result-item.active {
    background: rgba(204, 0, 0, 0.08);
    border-color: rgba(204, 0, 0, 0.2);
  }
  .cmd-result-image {
    width: 96px;
    height: 54px;
    object-fit: cover;
    flex-shrink: 0;
    background: #111;
    border: 1px solid rgba(255,255,255,0.1);
  }
  /*
    BRAND MARKS ARE CONTAINED, NEVER COVERED.

    `cover` fills the box and crops whatever does not fit. That is right for a
    video still, where the edges are incidental. It is wrong for a logo: the
    Warner Bros shield and the DC disc were both losing their top and bottom,
    and a cropped logo is the kind of thing the brand's own people notice.

    `contain` fits the whole mark inside the box and letterboxes the remainder.
    Slight padding so a wordmark that runs edge to edge in its own file does
    not touch the border.
  */
  /*
    Squared like everything else, and the glyph sits at the muted token so it
    reads as a quiet placeholder rather than as content.
  */
  .cmd-result-image.is-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white-muted);
  }
  .cmd-result-image.is-mark {
    object-fit: contain;
    padding: 6px;
    background: #0a0a0a;
  }
  .cmd-result-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    overflow: hidden;
  }
  .cmd-result-badge {
    font-family: var(--font-display, 'Syne Variable', sans-serif);
    font-size: 0.55rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #aaa;
    border-radius: 0;
    font-weight: 700;
    letter-spacing: 1.5px;
    align-self: flex-start;
    text-transform: uppercase;
  }
  .cmd-result-item[data-action="open-video"] .cmd-result-badge {
    border-color: rgba(204, 0, 0, 0.4);
    /* The site's readable red is a token. #ff4444 was a near-miss of it. */
    color: var(--color-accent-text);
  }
  .cmd-result-title {
    font-family: var(--font-display, 'Syne Variable', sans-serif);
    font-weight: 600;
    font-size: 1.05rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }
  .cmd-palette-empty {
    padding: 3rem 2rem;
    text-align: center;
    /*
      Was `#666`: 3.45:1, under AA. This is the "no results" message, read at
      the exact moment somebody's search has failed them.
    */
    color: var(--color-white-muted);
    font-family: var(--font-display, 'Syne Variable', sans-serif);
    font-size: 1.1rem;
    display: none;
    letter-spacing: 0.02em;
  }
</style>
