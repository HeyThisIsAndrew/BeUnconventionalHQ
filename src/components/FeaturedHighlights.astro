---
import ContentCard from './ContentCard.astro';
import { getVideosUnified } from '../lib/videos-source';
import { getPublishedArticles, articleHref } from '../lib/articles';
import { getCardImageSources } from '../lib/card-images';

const allVideos = await getVideosUnified();
const allArticles = getPublishedArticles();

const FLAGSHIP_VIDEOS = [
  'yLYtMt0h3uA', // Mortal Kombat 2 Review
  'fPQ_8fCuE50', // Spider-Man: Brand New Day
  '4rTMi6E5nrc'  // Wolverine
];

const videos = FLAGSHIP_VIDEOS.map(id => allVideos.find(v => v.youtubeId === id)).filter(Boolean);

// Pick the first published article
let article = allArticles.length > 0 ? allArticles[0] : null;

if (article) {
  // Override the Substack link with the local Intel page link
  article = { ...article, link: articleHref(article) };
}

// Mix them into a single highlighted list and sort by date descending
const highlightedItems = [...videos, article].filter(Boolean).sort((a: any, b: any) => {
  const dateA = new Date(a.publishedAt || a.isoDate || a.date).getTime();
  const dateB = new Date(b.publishedAt || b.isoDate || b.date).getTime();
  return dateB - dateA;
});
---

<div class="featured-highlights animate-on-scroll">
  <div class="fh-layout">
    <!-- Left Side: 50% width, single large focused tile -->
    <div class="fh-left">
      {highlightedItems.map((item, index) => (
        <div class={`fh-hero-card ${index === 0 ? 'active' : ''}`} data-index={index}>
          <ContentCard item={item} index={index} variant="hero" />
        </div>
      ))}
    </div>
    
    <!-- Right Side: 50% width, vertical list -->
    <div class="fh-right">
      {highlightedItems.map((item: any, index: number) => {
        if (!item) return null;
        const title = item.title;
        const badge = item.category || (item.type === 'video' || item.contentType === 'video' ? 'Video' : 'Article');
        
        // Use the existing utility to get the best thumbnail
        const rawImage = item.image ?? item.thumbnail;
        const { src, srcset } = getCardImageSources(rawImage);

        // State matching
        const isActive = index === 0;

        const isVideo = item.type === 'video' || item.contentType === 'video';
        return (
          <button type="button" class={`fh-row ${isActive ? 'is-active' : ''} is-${isVideo ? 'video' : 'article'}`} data-index={index} aria-pressed={isActive ? 'true' : 'false'}>
            <div class="fh-row-progress"></div>
            <div class="fh-row-thumb">
              {/*
                `sizes` is not optional here. With `w` descriptors and no
                `sizes`, the spec's default source size is 100vw — so for a
                thumbnail the CSS pins at 140px the browser was computing a
                need of a full viewport width and picking `maxresdefault`
                (1280w) every time on desktop. That is ~9x the pixels the box
                can show, and it is also the rendition YouTube does not always
                generate, so the widest-possible pick was also the likeliest
                to 404. `.fh-row-thumb` is 140px at every breakpoint (no media
                query touches it), so the value is exact rather than an
                estimate — the shared CARD_IMAGE_SIZES does not apply, that
                one describes the card grid.

                Recovery when a rendition is missing anyway is owned by the
                global fail-safe in Layout.astro, NOT by an `onerror` here —
                an inline handler cannot see YouTube's HTTP 200 placeholder
                response, and it races the capture-phase listener.
              */}
              <img src={src} srcset={srcset} sizes={srcset ? '140px' : undefined} alt={title} loading="lazy" decoding="async" />
            </div>
            <div class="fh-row-info">
              <span class="fh-row-badge">{badge}</span>
              <h4 class="fh-row-title">{title}</h4>
            </div>
          </button>
        );
      })}
    </div>
  </div>
</div>

<style>
  .featured-highlights {
    width: 100%;
    margin-top: 1rem;
  }
  
  .fh-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* 55/45 Split on Desktop & Landscape Tablet */
  @media (min-width: 768px) {
    .fh-layout {
      grid-template-columns: 1.2fr 1fr;
      align-items: stretch; /* Forces equal height columns */
    }
  }

  .fh-left {
    display: grid; /* Stack cards via grid */
    min-width: 0; /* Prevents grid blowout */
  }

  /* Stack all cards perfectly on top of each other for a true cross-fade */
  .fh-hero-card {
    grid-area: 1 / 1;
    /*
      The `min-width: 0` on .fh-left above is NOT enough on its own — this is
      the grid ITEM, and a grid item's default `min-width: auto` floors it at
      its own min-content width. ContentCard's hero variant sets
      `white-space: nowrap` on `.content-card-dynamic-tags`, so that floor is
      an entire unbreakable tag line ("WARNER BROS | REVIEW"), which measured
      478px inside a 390px phone viewport and pushed the card — and the
      headline and excerpt with it — off the right edge.

      Zeroing it lets the card shrink to its track, which is also what finally
      lets the `overflow: hidden` + `text-overflow: ellipsis` already declared
      on that tag row actually do its job instead of being overruled from
      above.
    */
    min-width: 0;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
    display: flex;
    flex-direction: column;
  }

  .fh-hero-card.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
    pointer-events: auto;
  }

  .fh-row-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 4px;
    background: var(--color-accent, #cc0000);
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    z-index: 10;
    box-shadow: 0 2px 15px rgba(204, 0, 0, 0.8);
    /* Transition applied dynamically via JS to handle pause/resume/reset */
  }

  /* Ensure the existing ContentCard fills its new 50% container nicely */
  .fh-left :global(.video-card-home) {
    flex: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .fh-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0; /* Prevents grid blowout */
  }

  .fh-row {
    flex: 1; /* Stretch rows to evenly fill height */
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: left;
    cursor: pointer;
    color: var(--color-white, #ffffff);
    transition: all 0.4s ease;
  }

  /*
    ─── DIM THE ARTWORK, NOT THE TEXT ──────────────────────────────────────

    The inactive state used to be `opacity: 0.6` + `grayscale(40%)` on the
    whole row. Both compose onto every descendant, so the badge was being
    rendered at 60% over a near-black background AND desaturated toward grey
    — Lighthouse measured the result as a contrast failure, and no red is
    recoverable through that: even a near-white red only reaches ~4.0:1 once
    it has been through 0.6 opacity, against a 4.5:1 requirement for text
    this size.

    Since a child cannot opt out of an ancestor's opacity or filter, the
    dimming has to move DOWN rather than be overridden. It lands on the
    thumbnail, which is the dominant visual and carries the inactive read on
    its own, while the text dims by colour instead — a value that can be
    picked to stay above threshold.
  */
  .fh-row-thumb {
    opacity: 0.6;
    filter: grayscale(40%);
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .fh-row:hover .fh-row-thumb {
    opacity: 0.8;
    filter: grayscale(0%);
  }

  .fh-row.is-active .fh-row-thumb {
    opacity: 1;
    filter: grayscale(0%);
  }

  .fh-row::before {
    content: '';
    position: absolute;
    left: -1px; /* Align over the border */
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent, #cc0000);
    box-shadow: 0 0 10px var(--color-accent, #cc0000);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .fh-row:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .fh-row.is-active {
    background: radial-gradient(circle at left, rgba(204, 0, 0, 0.15) 0%, rgba(255, 255, 255, 0.02) 100%);
    border-color: rgba(204, 0, 0, 0.2);
  }

  .fh-row.is-active::before {
    opacity: 1;
  }

  .fh-row-thumb {
    width: 140px;
    height: auto;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
    overflow: hidden;
    background: #111;
  }

  .fh-row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fh-row-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0; /* Prevents flexbox text blowout */
  }

  .fh-row-badge {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    /*
      NOT `--color-accent` (#cc0000). At 10.4px this is "normal" text and
      needs 4.5:1; brand red on this near-black row measures about 3.2:1 and
      fails on its own, before any dimming. This is the same hue lifted in
      luminance until it clears the bar (~6:1 measured), which reads as the
      brand red at badge size while actually being legible. The 3px active
      rail and the card chrome still use the true accent — large blocks of
      colour are held to 3:1, which #cc0000 does meet.
    */
    color: #ff5252;
  }

  .fh-row-title {
    margin: 0;
    font-family: var(--font-display, 'Syne', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /*
      Carries the rest of the inactive read that the row's `opacity` used to
      provide, but as a COLOUR so it stays measurable: white at 72% over this
      background is ~10:1, comfortably above the 4.5:1 floor, where the old
      0.6 row opacity was applying the same visual idea in a way that also
      dragged the badge under it.
    */
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.4s ease;
  }

  .fh-row:hover .fh-row-title,
  .fh-row.is-active .fh-row-title {
    color: var(--color-white, #ffffff);
  }
</style>

<script>
  function loadYouTubeAPI() {
    return new Promise((resolve) => {
      const win = window as any;
      if (win.YT && win.YT.Player) {
        resolve(win.YT);
        return;
      }
      if (win.onYouTubeIframeAPIReady) {
        const oldCallback = win.onYouTubeIframeAPIReady;
        win.onYouTubeIframeAPIReady = () => {
          oldCallback();
          resolve(win.YT);
        };
        return;
      }
      win.onYouTubeIframeAPIReady = () => {
        resolve(win.YT);
      };
      const tag = document.createElement('script');
      tag.src = "https://www.youtube.com/iframe_api";
      tag.onerror = () => {
        console.warn('YouTube Iframe API blocked. Falling back to static carousel.');
        resolve(null);
      };
      const firstScriptTag = document.getElementsByTagName('script')[0];
      if (firstScriptTag && firstScriptTag.parentNode) {
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
      } else {
        document.head.appendChild(tag);
      }
    });
  }

  function initFeaturedHighlights() {
    const section = document.querySelector('.featured-highlights') as HTMLElement;
    if (!section) return;

    /*
      ONCE PER SECTION ELEMENT.

      This is bound to BOTH `DOMContentLoaded` and `astro:page-load`, and on
      a first page load Astro fires the second one after the first — so
      without this guard the whole thing was built twice over the same DOM:
      two sets of click listeners on every row, and two independent autoplay
      state machines with their own `activePlayer` and their own timers.

      That is not merely wasteful. The timers advance the carousel at double
      speed, and `destroyActivePlayer()` in one closure cannot see the other
      closure's player, so switching slides orphans a live iframe that keeps
      playing underneath. It also made a single click run the activation
      handler twice, which is visible in the call log as unMute/playVideo
      pairs.

      The flag lives on the ELEMENT, not in a module variable, which is what
      keeps client-side navigation working: `astro:page-load` after a swap
      hands us a brand new section node with no flag, so it initialises
      exactly once again.
    */
    if (section.dataset.fhInit === '1') return;
    section.dataset.fhInit = '1';

    const rows = Array.from(section.querySelectorAll('.fh-row'));
    const heroCards = section.querySelectorAll('.fh-hero-card');
    if (rows.length === 0) return;

    let currentIndex = 0;
    let autoPlayTimeout: ReturnType<typeof setTimeout> | null = null;
    let isPaused = false;
    let activePlayer: any = null;
    let activeMediaContainer: HTMLElement | null = null;
    let slideStartTime = 0;
    let accumulatedTime = 0;
    const duration = 8000;

    function getDurationForIndex(index: number) {
      const row = rows[index];
      return row.classList.contains('is-video') ? 15000 : duration;
    }

    function destroyActivePlayer() {
      if (activePlayer && typeof activePlayer.destroy === 'function') {
        activePlayer.destroy();
      }
      activePlayer = null;
      activeMediaContainer = null;
      section.querySelectorAll('.yt-player-target').forEach(el => el.remove());
      section.querySelectorAll('.is-playing-inline').forEach(media => media.classList.remove('is-playing-inline'));
      /* Activation belongs to one player instance. Leaving it set would give
         the NEXT slide's iframe the pointer while it is still a muted
         preview, which is the bug this pair of classes exists to prevent. */
      section.querySelectorAll('.is-user-activated').forEach(media => media.classList.remove('is-user-activated'));
      section.querySelectorAll('.video-watermark-logo').forEach((logo: any) => logo.style.opacity = '0');
    }

    function activateIndex(index: number) {
      if (index < 0 || index >= rows.length) return;
      accumulatedTime = 0;
      slideStartTime = Date.now();
      
      const row = rows[index];
      const targetId = row.getAttribute('data-index');

      destroyActivePlayer();

      rows.forEach(r => {
        r.classList.remove('is-active');
        r.setAttribute('aria-pressed', 'false');
        const progress = r.querySelector('.fh-row-progress') as HTMLElement;
        if (progress) {
          progress.style.opacity = '1';
          progress.style.transition = 'none';
          progress.style.transform = 'scaleX(0)';
        }
      });

      row.classList.add('is-active');
      row.setAttribute('aria-pressed', 'true');

      heroCards.forEach(card => {
        if (card.getAttribute('data-index') === targetId) {
          card.classList.add('active');
          const isVideo = row.classList.contains('is-video');
          const videoBtn = card.querySelector('[data-action="inline-video"]');
          const win = window as any;
          if (isVideo && videoBtn && win.YT && win.YT.Player) {
            const videoId = videoBtn.getAttribute('data-video-id');
            const mediaContainer = card.querySelector('.content-card-media');
            if (videoId && mediaContainer) {
              activeMediaContainer = mediaContainer as HTMLElement;
              const targetDiv = document.createElement('div');
              targetDiv.className = 'yt-player-target';
              targetDiv.style.position = 'absolute';
              targetDiv.style.top = '0';
              targetDiv.style.left = '0';
              targetDiv.style.width = '100%';
              targetDiv.style.height = '100%';
              targetDiv.style.pointerEvents = 'none';
              targetDiv.style.zIndex = '0'; // Above image, behind play button and gradient
              targetDiv.style.opacity = '0';
              targetDiv.style.transition = 'opacity 1s ease';
              mediaContainer.appendChild(targetDiv);
              
              activePlayer = new win.YT.Player(targetDiv, {
                videoId: videoId,
                playerVars: {
                  autoplay: 1,
                  controls: 0,
                  mute: 1,
                  modestbranding: 1,
                  loop: 1,
                  playlist: videoId,
                  playsinline: 1,
                  cc_load_policy: 0, // Disable captions
                  iv_load_policy: 3, // Disable annotations
                  rel: 0,
                  disablekb: 1
                },
                events: {
                  onReady: (e: any) => {
                    e.target.playVideo();
                  },
                  onStateChange: (e: any) => {
                    // When video actually starts playing, wait 1.5s for YouTube UI to fade out, then fade video in
                    if (e.data === win.YT.PlayerState.PLAYING) {
                      setTimeout(() => {
                        // Check if the player is still active (hasn't been destroyed by slide switch)
                        const iframe = mediaContainer.querySelector('iframe');
                        if (iframe) {
                          iframe.style.opacity = '1';
                        }
                        const logo = mediaContainer.querySelector('.video-watermark-logo') as HTMLElement;
                        if (logo) {
                          logo.style.opacity = '0.8';
                        }
                        mediaContainer.classList.add('is-playing-inline');
                      }, 1500);
                    } else if (e.data === win.YT.PlayerState.PAUSED || e.data === win.YT.PlayerState.ENDED) {
                      // Hide the iframe immediately to hide YouTube's messy paused UI (More videos, title bar, etc.)
                      const iframe = mediaContainer.querySelector('iframe');
                      if (iframe) {
                        iframe.style.opacity = '0';
                        iframe.style.pointerEvents = 'none';
                      }
                      
                      const logo = mediaContainer.querySelector('.video-watermark-logo') as HTMLElement;
                      if (logo) logo.style.opacity = '0';

                      mediaContainer.classList.remove('is-playing-inline');
                      /* Back to poster + play icon, so the next click is ours
                         again rather than YouTube's. */
                      mediaContainer.classList.remove('is-user-activated');

                      // If the user was actively watching and the video just ended, move to the next tile
                      if (e.data === win.YT.PlayerState.ENDED && isPaused) {
                        isPaused = false;
                        nextSlide();
                      }
                    }
                  }
                }
              });
            }
          }
        } else {
          card.classList.remove('active');
        }
      });
      
      currentIndex = index;
    }

    function nextSlide() {
      const videoModal = document.getElementById('video-modal');
      if (videoModal && videoModal.classList.contains('active')) {
        accumulatedTime = 0;
        startAutoPlay();
        return;
      }
      if (isPaused) return;

      const nextIndex = (currentIndex + 1) % rows.length;
      activateIndex(nextIndex);
      startAutoPlay();
    }

    function startAutoPlay() {
      if (isPaused) return;
      if (autoPlayTimeout) return;

      const duration = getDurationForIndex(currentIndex);
      const remaining = Math.max(0, duration - accumulatedTime);
      slideStartTime = Date.now();
      
      const row = rows[currentIndex];
      const progress = row?.querySelector('.fh-row-progress') as HTMLElement;
      
      if (progress) {
        progress.style.transition = 'none';
        progress.style.transform = `scaleX(${accumulatedTime / duration})`;
        
        void progress.offsetWidth; // Force reflow
        
        progress.style.transition = `transform ${remaining}ms linear`;
        progress.style.transform = 'scaleX(1)';
      }

      autoPlayTimeout = setTimeout(() => {
        autoPlayTimeout = null;
        nextSlide();
      }, remaining);
    }

    function stopAutoPlay() {
      if (autoPlayTimeout) {
        clearTimeout(autoPlayTimeout);
        autoPlayTimeout = null;
        accumulatedTime += Date.now() - slideStartTime;
      }
      const row = rows[currentIndex];
      if (row) {
        const progress = row.querySelector('.fh-row-progress') as HTMLElement;
        if (progress) {
          const duration = getDurationForIndex(currentIndex);
          progress.style.transition = 'none';
          progress.style.transform = `scaleX(${Math.min(accumulatedTime / duration, 1)})`;
        }
      }
    }

    let isHovering = false;
    const fhRight = section.querySelector('.fh-right');
    if (fhRight) {
      fhRight.addEventListener('mouseenter', () => {
        isHovering = true;
        stopAutoPlay();
      });
      fhRight.addEventListener('mouseleave', () => {
        isHovering = false;
        if (!isPaused) {
          startAutoPlay();
        }
      });
    }

    rows.forEach((row, index) => {
      row.addEventListener('click', () => {
        isPaused = false;
        stopAutoPlay();
        activateIndex(index);
        if (!isHovering) {
          startAutoPlay();
        }
      });
    });

    const inlineVideoButtons = section.querySelectorAll('[data-action="inline-video"]');
    inlineVideoButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        // If the user clicked the secondary outbound link, let it navigate instead of playing inline
        if ((e.target as Element).closest('a.watch-now-btn')) {
          // Pause the video so it doesn't keep playing in the background tab
          if (activePlayer && typeof activePlayer.pauseVideo === 'function') {
            activePlayer.pauseVideo();
          }
          return;
        }

        e.preventDefault();
        e.stopPropagation();

        const mediaContainer = button.querySelector('.content-card-media') || button.closest('.content-card')?.querySelector('.content-card-media');
        if (!mediaContainer) return;

        if (activePlayer && typeof activePlayer.unMute === 'function') {
          activePlayer.unMute();
          activePlayer.setVolume(100);
          activePlayer.playVideo();

          /*
            Hand the pointer to YouTube only NOW. Until this click the iframe
            is inert by CSS, which is what let this handler receive the click
            at all — while it was interactive during the preview, the click
            went to YouTube's player and simply paused it.
          */
          mediaContainer.classList.add('is-user-activated');

          const iframe = mediaContainer.querySelector('iframe');
          if (iframe) {
            iframe.style.transition = 'none'; // Snap instantly on manual play
            iframe.style.opacity = '1';
          }
          
          const logo = mediaContainer.querySelector('.video-watermark-logo') as HTMLElement;
          if (logo) logo.style.opacity = '0.8';
          
          mediaContainer.classList.add('is-playing-inline');

          isPaused = true;
          stopAutoPlay();
          section.removeEventListener('mouseleave', startAutoPlay);
          
          const row = rows[currentIndex];
          if (row) {
             const progress = row.querySelector('.fh-row-progress') as HTMLElement;
             if (progress) progress.style.opacity = '0';
          }
        }
      });
    });

    /*
      ─── TELL THE PLAYER WHEN ITS BOX CHANGES SHAPE ────────────────────────

      The iframe is stretched to the container by CSS (`width/height: 100%`),
      so OUR geometry is always right — measured at 390px and 844px wide, the
      iframe rect matches the media box exactly. What CSS cannot do is reach
      inside a cross-origin iframe: YouTube lays its video out once, against
      the size the iframe had when the player was constructed, and it does not
      re-measure just because the element was restretched.

      Rotate the phone and the box changes shape underneath a player that is
      still composing for the old one — which is the black band down the left
      of the video, with the picture shoved to the right. Nothing in the DOM
      looks wrong at that point, because nothing in the DOM IS wrong.

      `setSize()` is the API's way of saying "re-measure": it rewrites the
      iframe's width/height attributes and posts the change into the player so
      it re-lays out. Our stylesheet still owns the visual size, so this only
      ever corrects the internal composition.

      Batched into a rAF because a rotation fires a burst of resizes and each
      call posts a message across the frame boundary.
    */
    if ('ResizeObserver' in window) {
      let resizeFrame = 0;
      const resizeObserver = new ResizeObserver(() => {
        if (resizeFrame) return;
        resizeFrame = requestAnimationFrame(() => {
          resizeFrame = 0;
          if (!activePlayer || typeof activePlayer.setSize !== 'function' || !activeMediaContainer) return;
          const { width, height } = activeMediaContainer.getBoundingClientRect();
          if (width > 0 && height > 0) activePlayer.setSize(width, height);
        });
      });
      section.querySelectorAll('.content-card-media').forEach((box) => resizeObserver.observe(box));
    }

    // IntersectionObserver to pause video and autoplay when out of view
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) {
            // Scrolled out of view: pause the video and stop autoplay
            if (activePlayer && typeof activePlayer.pauseVideo === 'function') {
              activePlayer.pauseVideo();
            }
            if (!isPaused) {
               stopAutoPlay();
            }
          } else {
            // Scrolled into view: resume video and autoplay
            if (activePlayer && typeof activePlayer.playVideo === 'function') {
              activePlayer.playVideo();
              
              // If the user was manually watching the video (isPaused is true), restore the UI instantly
              if (isPaused) {
                const row = rows[currentIndex];
                const mediaContainer = row?.querySelector('.content-card-media');
                if (mediaContainer) {
                  mediaContainer.classList.add('is-playing-inline');
                  const iframe = mediaContainer.querySelector('iframe');
                  if (iframe) {
                    iframe.style.pointerEvents = 'auto';
                    iframe.style.transition = 'none';
                    iframe.style.opacity = '1';
                  }
                  const logo = mediaContainer.querySelector('.video-watermark-logo') as HTMLElement;
                  if (logo) logo.style.opacity = '0.8';
                }
              }
            }
            if (!isPaused) {
              startAutoPlay();
            }
          }
        });
      }, { threshold: 0.1 }); // Trigger when less than 10% is visible
      
      observer.observe(section);
    }

    // (Hover logic is now defined above)

    loadYouTubeAPI().then(() => {
      activateIndex(currentIndex);
      startAutoPlay();
    });

    document.addEventListener('astro:before-swap', () => {
      stopAutoPlay();
      destroyActivePlayer();
    }, { once: true });
  }

  document.addEventListener('DOMContentLoaded', initFeaturedHighlights);
  document.addEventListener('astro:page-load', initFeaturedHighlights);
</script>
