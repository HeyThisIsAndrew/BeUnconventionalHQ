---
/**
 * CategoryOverlay — the mobile "Categories" trigger and the anchored
 * dropdown menu it opens.
 *
 * ─── WHY THIS EXISTS ──────────────────────────────────────────────────────
 * Below 768px the four inline category buttons are collapsed behind one
 * "Categories" button. Sunsetting the old full-screen overlay and its
 * scroll-lock / z-index hacks, tapping the button now drops down an overlapping
 * menu directly underneath the trigger (leaving the page scrollable and
 * never shifting content down).
 *
 * ─── HOW IT WORKS ─────────────────────────────────────────────────────────
 * Both `#open-categories-btn` and `#category-dropdown-menu` live inside
 * `.mobile-category-row`. Opening toggles `.is-open` and `inert` /
 * `aria-hidden`, dismisses any other open dropdown (`hq:close-nav-menu`,
 * `hq:close-contents`), and closes on trigger re-tap, outside tap, `Escape`,
 * category link click, or route swap.
 *
 * ─── HOW TO USE IT ────────────────────────────────────────────────────────
 *     <CategoryOverlay items={[
 *       { label: 'FILM', href: '#film', slug: 'film', active: false },
 *       ...
 *     ]} />
 *
 * `href` is whatever that surface uses: the Feed passes a `#hash` (it filters
 * client-side), /intel passes a real route. The component doesn't care.
 *
 * ─── HOW TO RESTYLE IT ────────────────────────────────────────────────────
 * `.mobile-category-row`, `.category-dropdown-panel`, `.category-trigger-chevron`
 * in styles/modules/filters.css (and styles/modules/landscape.css).
 */
import { LABELS } from '../data/content.js';

interface CategoryItem {
  /** Button text, already cased how it should display. */
  label: string;
  /** Where it goes — a hash for the Feed, a route for /intel. */
  href: string;
  /** Lowercase identifier; the Feed's filter script reads this. */
  slug: string;
  /** Whether this category is the current one. */
  active?: boolean;
}

interface Props {
  items: CategoryItem[];
  /** Text on the closed button. The Feed's script rewrites this to
   *  "Categories | Film" when a filter is applied. */
  buttonLabel?: string;
}

const { items, buttonLabel = LABELS.categories } = Astro.props;
---

{/* The closed state + anchored overlapping dropdown inside one relative
    container, mobile only (CSS hides `.mobile-category-row` above 768px). */}
<div class="mobile-category-row">
  <button
    id="open-categories-btn"
    type="button"
    class="quadrant-btn full-width-btn"
    aria-expanded="false"
    aria-controls="category-dropdown-menu"
  >
    <span class="category-trigger-label">{buttonLabel}</span>
    <svg
      class="category-trigger-chevron"
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3 5l4 4 4-4"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="square"
      ></path>
    </svg>
  </button>

  <nav
    id="category-dropdown-menu"
    class="category-dropdown-panel"
    aria-label="Categories"
    aria-hidden="true"
    inert
  >
    <div class="filter-grid">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={['quadrant-btn', 'cat-btn', { active: item.active }]}
            data-category={item.slug}
            aria-current={item.active ? 'true' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</div>

<script>
  /*
    Open/close for the mobile category dropdown.

    ─── THIS COMPONENT IS THE SOLE OWNER OF THIS BEHAVIOUR (#189) ───────────
    Event delegation on document (Issue #71) so the UI feels alive before the
    cold load has finished. Renamed `__hqCategoryOverlayBound` rather than a
    generic shared latch so no other component competes for it.
  */
  if (!(window as any).__hqCategoryOverlayBound) {
    (window as any).__hqCategoryOverlayBound = true;

    function close(panel: HTMLElement, openBtn: HTMLElement | null, restoreFocus = false) {
      if (!panel.classList.contains('is-open')) return;
      panel.classList.remove('is-open');
      panel.closest('.mobile-category-row')?.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      panel.setAttribute('inert', '');
      if (openBtn) {
        openBtn.setAttribute('aria-expanded', 'false');
        if (restoreFocus) {
          openBtn.focus({ preventScroll: true });
        }
      }
    }

    function open(panel: HTMLElement, openBtn: HTMLElement | null) {
      /* Dismiss any competing dropdown before opening this one. */
      window.dispatchEvent(new CustomEvent('hq:close-nav-menu'));
      window.dispatchEvent(new CustomEvent('hq:close-contents'));

      panel.classList.add('is-open');
      panel.closest('.mobile-category-row')?.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      panel.removeAttribute('inert');
      if (openBtn) {
        openBtn.setAttribute('aria-expanded', 'true');
      }

      /* Force pending style recalc so `visibility: visible` lands before
         focus moves into the dropdown. */
      void panel.offsetHeight;
      const focusTarget = panel.querySelector('.cat-btn.active') ?? panel.querySelector('.cat-btn');
      if (focusTarget instanceof HTMLElement) {
        focusTarget.focus({ preventScroll: true });
      }
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const openBtnEl = target.closest('#open-categories-btn');
      const catLink = target.closest('#category-dropdown-menu a.cat-btn');

      const panel = document.getElementById('category-dropdown-menu');
      const openBtn = document.getElementById('open-categories-btn');

      if (openBtnEl && panel) {
        event.preventDefault();
        if (panel.classList.contains('is-open')) close(panel, openBtn, false);
        else open(panel, openBtn);
      } else if (catLink && panel) {
        close(panel, openBtn, false);
      } else if (panel && panel.classList.contains('is-open') && !target.closest('.mobile-category-row')) {
        close(panel, openBtn, false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const panel = document.getElementById('category-dropdown-menu');
        const openBtn = document.getElementById('open-categories-btn');
        if (panel && panel.classList.contains('is-open')) {
          close(panel, openBtn, true);
        }
      }
    });

    window.addEventListener('hq:close-categories', () => {
      const panel = document.getElementById('category-dropdown-menu');
      const openBtn = document.getElementById('open-categories-btn');
      if (panel) close(panel, openBtn, false);
    });

    const mobileQuery = window.matchMedia('(max-width: 768px)');
    window.addEventListener('resize', () => {
      if (!mobileQuery.matches) {
        const panel = document.getElementById('category-dropdown-menu');
        const openBtn = document.getElementById('open-categories-btn');
        if (panel) close(panel, openBtn, false);
      }
    });
  }

  /*
    Category links stay plain anchors handled by <ClientRouter /> (never
    `preventDefault()` + `navigate()`), so modifier-clicks still open new tabs.
    Ensure any open dropdown closes cleanly before ClientRouter swaps the DOM;
    registered outside the guard so leak protection never races.
  */
  document.addEventListener('astro:before-swap', () => {
    const panel = document.getElementById('category-dropdown-menu');
    const openBtn = document.getElementById('open-categories-btn');
    if (panel && panel.classList.contains('is-open')) {
      panel.classList.remove('is-open');
      panel.closest('.mobile-category-row')?.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      panel.setAttribute('inert', '');
      openBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  /*
    Reflect the current category on the closed button: "Categories | Film".
    Guarded on a known desktop row EXISTING — `.desktop-category-row` or
    `.intel-filter-nav` — and writes into `.category-trigger-label` so the
    trailing chevron SVG is preserved.
  */
  document.addEventListener('astro:page-load', () => {
    const openBtn = document.getElementById('open-categories-btn');
    const desktopRow = document.querySelector('.desktop-category-row, .intel-filter-nav');
    if (!openBtn || !desktopRow) return;

    const labelEl = openBtn.querySelector('.category-trigger-label') ?? openBtn;
    const activeCat = desktopRow.querySelector('.cat-btn.active');
    if (activeCat) {
      labelEl.textContent = `Categories | ${activeCat.textContent?.trim()}`;
      openBtn.classList.add('active');
    } else {
      labelEl.textContent = 'Categories';
      openBtn.classList.remove('active');
    }
  });
</script>
