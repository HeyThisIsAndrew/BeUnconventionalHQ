---
/**
 * A client-side Web Component that upgrades <youtube-embed> tags emitted by
 * the HTML sanitizer into a native video tile matching the site's ContentCard
 * style. Clicking it triggers the global video modal.
 */
---
<script>
  class YouTubeEmbed extends HTMLElement {
    constructor() {
      super();
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';

      const videoId = this.getAttribute('video-id');
      if (!videoId) return;

      // Make the host element behave like a button to trigger the global modal
      this.setAttribute('data-action', 'open-video');
      this.setAttribute('data-video-id', videoId);
      this.setAttribute('role', 'button');
      this.setAttribute('tabindex', '0');
      this.setAttribute('aria-label', 'Play Video');
      this.setAttribute('data-play-hover', 'true');

      // Create the visual facade matching ContentCard media styles
      this.innerHTML = `
        <div class="content-card-media" style="width:100%;height:100%;">
          <img 
            class="content-card-img"
            src="https://wsrv.nl/?url=i.ytimg.com/vi/${videoId}/maxresdefault.jpg&w=900&output=webp&q=85" 
            alt="YouTube Video" 
            loading="lazy" 
          />
          <div class="youtube-tile-overlay">
            <div class="play-button-wrapper" aria-hidden="true">
              <div class="cinematic-play-button">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      `;
    }
  }

  if (!customElements.get('youtube-embed')) {
    customElements.define('youtube-embed', YouTubeEmbed);
  }
</script>

<style is:global>
  /*
    TWO BOXES, ON PURPOSE — same split as .ig-carousel-tile / .ig-tile-frame
    in CinematicGallery.astro, and for the same bug.

    The host element is the hover target and STAYS STILL. `.content-card-media`
    is the visual: border, background, clipping and the lift.

    Both used to be this one element, and hovering near its edge flickered
    violently: :hover lifted it 6px, moving it out from under the cursor,
    dropping :hover, putting it back — a loop at frame rate. Because `cursor`,
    `border-color` and `box-shadow` all live on the hovered element, the
    cursor, the outline and the red glow all strobed together. The thin bright
    edge came from the same place: a scaling image clipped by a box that was
    itself mid-transform, so the clip and the content disagreed by a subpixel
    each frame.

    Keep the transform OFF the host. Anything that moves belongs on the media.
  */
  youtube-embed {
    display: block;
    width: 100%;
    margin: 3rem 0;
    aspect-ratio: 16 / 9;
    position: relative;
    cursor: pointer;
  }

  youtube-embed .content-card-media {
    position: absolute;
    inset: 0;
    background-color: var(--color-surface, #111);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Gated to real pointers: on iOS a tap leaves :hover stuck on the tapped
     element, which would leave an embed permanently lit after being played. */
  @media (hover: hover) and (pointer: fine) {
    youtube-embed:hover .content-card-media {
      transform: translateY(-6px);
      border-color: var(--color-accent, #cc0000);
      box-shadow: 0 10px 30px rgba(204, 0, 0, 0.15);
    }

    youtube-embed:hover .content-card-img {
      transform: scale(1.05);
    }
  }

  /* The host is role="button" tabindex="0" but had no focus indicator at all
     — same defect class as issue #91. */
  youtube-embed:focus-visible {
    outline: 2px solid var(--color-accent, #cc0000);
    outline-offset: 3px;
  }

  youtube-embed .content-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .youtube-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.8) 0%,
      rgba(9, 9, 11, 0.2) 50%,
      transparent 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: background 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    youtube-embed:hover .youtube-tile-overlay {
      background: linear-gradient(
        to top,
        rgba(9, 9, 11, 0.9) 0%,
        rgba(9, 9, 11, 0.4) 50%,
        transparent 100%
      );
    }
  }
</style>
