---
/**
 * ArticleThumb — an article's cover image, with a branded fallback.
 *
 * ─── WHY THIS EXISTS ──────────────────────────────────────────────────────
 * Every post is expected to have a cover image, but Substack does not
 * guarantee one. Rather than shipping an empty grey box (or worse, a broken
 * image icon), a post without a cover gets the site logo over the article
 * title — so it still reads as intentional, branded content.
 *
 * This is a temporary treatment. The proper fix is running article images
 * through Astro's image pipeline at sync time (logged as a follow-up in
 * scripts/epic-001-article-syndication.md); until then this keeps the grid
 * looking deliberate.
 *
 * ─── HOW TO USE IT ────────────────────────────────────────────────────────
 *     <ArticleThumb image={a.image} title={a.title} />          // rail size
 *     <ArticleThumb image={a.image} title={a.title} size="feature" id="x" />
 *
 * ─── HOW TO RESTYLE IT ────────────────────────────────────────────────────
 * `.article-thumb-fallback` and friends in src/styles/modules/intel.css.
 */
import { Image } from 'astro:assets';
import { getCardImageSources } from '../lib/card-images.js';
/*
  The PRE-CROPPED mark (src/assets/logo-mark.webp), not logo.webp.

  logo.webp is a 2000x2000 square in which the artwork occupies only ~42% of
  the height — the rest is transparent padding. Rendering it into a 44px-wide
  fallback box therefore spent most of those pixels on nothing and left the
  wordmark itself around 18px tall: the "incredibly low, blurry resolution"
  this fallback was reported for. logo-mark.webp is the same artwork trimmed
  to its real content box, so the box size IS the mark size.
*/
import logoImage from '../assets/logo-mark.webp';

interface Props {
  /** Cover image URL. Empty/missing triggers the branded fallback. */
  image?: string;
  /** Article title — shown in the fallback, and used for the alt text. */
  title: string;
  /** `rail` is the small thumbnail; `feature` is the large centre image. */
  size?: 'rail' | 'feature';
  /** DOM id for the <img>, so the magazine script can swap its src. */
  id?: string;
  /**
   * When true the image is decorative (a nearby heading already names the
   * article), so alt is empty and screen readers skip it.
   */
  decorative?: boolean;
}

const { image, title, size = 'rail', id, decorative = false } = Astro.props;

const isFeature = size === 'feature';
/*
  ─── EVERY THUMBNAIL IS A RENDITION, NEVER THE ORIGINAL ─────────────────────

  This rendered `src={image}` — whatever URL the article record carried. For a
  Substack post that is frequently the raw S3 original: one on /intel measured
  3840x2160 and 1.2 MB, rendered into a 640x360 box.

  Found when /intel was added to the Lighthouse gate. Its feature image was the
  LCP element at 9.1 seconds, scoring 1 out of 100, and this component renders
  that feature AND every rail and card thumbnail beside it — so the same waste
  repeated down the page and across /feed.

  getCardImageSources() is what the rest of the site already uses: it rewrites
  a Substack CDN url with width transforms, and routes anything else through a
  resizing proxy, returning a srcset either way. `sizes` tells the browser
  which rendition to take, since the feature and the small thumbs differ by
  roughly a factor of four.
*/
const sources = getCardImageSources(image);

/* Feature renders ~720px wide on desktop and ~92vw on a phone; the small
   thumbs are 640-wide boxes that display far smaller in the rail. */
const SIZES = isFeature ? '(max-width: 900px) 92vw, 720px' : '(max-width: 900px) 45vw, 320px';

---

{
  image ? (
    /*
      width/height are set on the feature so the browser reserves the right
      space before the image loads — that is what prevents the page jumping
      (cumulative layout shift) as covers stream in.
    */
    <img
      id={id}
      src={sources.src || image}
      srcset={sources.srcset || undefined}
      sizes={sources.srcset ? SIZES : undefined}
      alt={decorative ? '' : `Cover image for ${title}`}
      width={isFeature ? 1456 : 640}
      height={isFeature ? 816 : 360}
      loading={isFeature ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    /*
      Branded fallback. aria-hidden on the logo because the title text beside
      it already carries the meaning, and the surrounding link is labelled by
      the article headline.
    */
    <div
      id={id}
      class:list={['article-thumb-fallback', { 'is-feature': isFeature }]}
      data-fallback="true"
    >
      {/*
        Emitted at 2x the size it is displayed at, and at the artwork's own
        2.17:1 ratio rather than a square.

        The old values asked Astro for a 160x160 (or 72x72) square and CSS then
        drew it at 96px / 44px wide. Between the distorted aspect ratio and the
        downscale, the wordmark was rendered from a handful of real pixels.
        Doubling the intrinsic size is what makes it crisp on the 2x and 3x
        displays every phone has — the file is a few KB either way.
      */}
      <Image
        src={logoImage}
        alt=""
        width={isFeature ? 440 : 240}
        height={isFeature ? 202 : 110}
        class="article-thumb-fallback-logo"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
      <span class="article-thumb-fallback-title">{title}</span>
    </div>
  )
}
