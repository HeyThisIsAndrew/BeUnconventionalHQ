---
/**
 * The full-bleed key-art strip above a tentpole row.
 *
 * ─── WHY THIS IS ABOVE THE ROW AND NOT BEHIND IT ────────────────────────────
 * Behind was the obvious place, and it was measured before it was built: at a
 * 1920px viewport the row's cards cover 86% of the viewport width across the
 * rail's 285px, leaving only the ~100px heading band and the feathered 32/38px
 * margins ever unobstructed. A banner there is art commissioned to be hidden.
 *
 * Above, it is a mini-hero for the shelf: seen in full, and it gives the row
 * the thing a streaming service's tentpole shelf actually has, which is the
 * title's own artwork rather than its name set in the site's typeface.
 *
 * ─── THE BANNER IS ARTWORK. THE ROW STILL OWNS ITS HEADING ──────────────────
 * This shipped once with the logo bottom-LEFT, standing in for the row's whole
 * lockup: the eyebrow, the publisher badge, the divider and the title all moved
 * up onto the artwork. The reasoning was that a studio logo already carries its
 * publisher's mark, so drawing DC again beside it was repetition.
 *
 * The owner's call, seeing it on the real art, is that it reads worse: the
 * tentpole row then had a different heading treatment from every other row on
 * the page, and the artwork was carrying text that belongs with the rail.
 *
 * So the banner is now just the art with the title's logo on the RIGHT, and the
 * row head below it renders the same eyebrow / badge / title lockup it does
 * everywhere else. The duplication is accepted deliberately: consistency across
 * the shelves is worth more here than one fewer appearance of the mark.
 */
import { Image } from 'astro:assets';

interface Props {
  /** Key art, imported from src/assets/rows. Null renders nothing at all. */
  art: ImageMetadata | null;
  /** The title's own logo. Null renders the art alone. */
  logo?: ImageMetadata | null;
  /** Alt text for the logo, and nothing else: the visible heading is the row's. */
  title: string;
  /** `R, G, B` — the row's accent, for the wash under the lockup. Null where a
      row has no accent of its own; the CSS default covers it. */
  accentRgb?: string | null;
}

const { art, logo = null, title, accentRgb = null } = Astro.props;
---

{art && (
  <div class="feed-row-banner" style={accentRgb ? `--banner-rgb: ${accentRgb};` : undefined}>
    {/*
      `sizes="100vw"` because the strip is full-bleed at every width. The widths
      ladder tops out at 2560, which is 1x on the widest desktop this site sees
      and 2x at 1280 — past that the art is behind a scrim and a gradient, and
      the bytes buy nothing.
    */}
    <Image
      src={art}
      alt=""
      class="feed-row-banner-art"
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />

    <div class="feed-row-banner-scrim" aria-hidden="true"></div>

    {logo && (
      <div class="feed-row-banner-lockup">
        {/* No heading element here. The row head below carries the real <h2>,
            so a second one would announce the same row twice. */}
        <Image
          src={logo}
          alt={title}
          class="feed-row-banner-logo"
          widths={[400, 800, 1200]}
          sizes="(max-width: 899px) 60vw, 460px"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
  </div>
)}

<style>
  /*
    FULL-BLEED, the same way the rails are: pull out to the viewport edges by
    half the difference between the container and the viewport. `100vw` would
    include the scrollbar's width and overflow by ~15px on Windows, which is the
    horizontal scrollbar this page has been through twice.
  */
  .feed-row-banner {
    position: relative;
    margin-inline: calc(50% - 50vw);
    width: 100vw;
    max-width: 100vw;
    /*
      A FLUID HEIGHT, NOT AN ASPECT RATIO PER BREAKPOINT.

      The art is supplied 16:9 and this strip is much wider than that at every
      size, so it is always a centred crop. Driving the height directly means
      one rule instead of three breakpoints of aspect-ratio arithmetic, and it
      is what makes the safe-zone advice to the artist a single sentence: keep
      the subject in the middle band, the top and bottom go.

      Capped at 380px so the shelf stays a shelf. Uncapped, 22vw is 563px on a
      2560 display, which is a second hero halfway down the feed.
    */
    height: clamp(200px, 22vw, 380px);
    overflow: hidden;
    /* The row below owns the space between them. */
    margin-bottom: 0;
  }

  .feed-row-banner-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* This is real artwork, not a plate: no blur, no brightness lift. */
  }

  /*
    Two scrims, and both are doing a specific job.

    The vertical one seats the bottom edge on the page ground so the strip and
    the row below it read as one block rather than a picture with a shelf under
    it. It has to reach alpha 1 and hold: at 0.95 a band of the art shows at the
    seam, which is the same failure CLAUDE.md records on the hub backdrops.

    The horizontal one is legibility for the mark, and it carries the row's
    accent rather than plain black so the strip agrees with the wash below it.
    It runs to the RIGHT, following the mark: it used to darken the left, which
    is where the lockup was before the row took its heading back.
  */
  .feed-row-banner-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top,
        rgba(10, 10, 10, 1) 0%,
        rgba(10, 10, 10, 0.72) 14%,
        rgba(10, 10, 10, 0.28) 34%,
        transparent 62%),
      linear-gradient(to left,
        rgba(6, 18, 14, 0.78) 0%,
        rgba(6, 18, 14, 0.42) 26%,
        rgba(6, 18, 14, 0.10) 48%,
        transparent 68%),
      radial-gradient(70% 90% at 86% 72%,
        rgba(var(--banner-rgb, 16, 185, 129), 0.20) 0%,
        transparent 72%);
  }

  /*
    Right-hand end, bottom-aligned. Bottom rather than centred because the art's
    right side is where the standing figure and the sun are: a mark across the
    middle of it sits on the subject, and down here it sits on the water.

    The gutter matches the page container's, so the mark lines up with the end of
    the rail below rather than with the raw viewport edge.
  */
  .feed-row-banner-lockup {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(0.85rem, 2vw, 1.6rem);
    padding-inline: clamp(1rem, 4vw, 3rem);
    display: flex;
    justify-content: flex-end;
  }

  /*
    Sized off the viewport so the mark holds its weight on a phone, capped so a
    wide wordmark cannot run into the middle of the strip. HARD RULE 6: no
    drop-shadow on an <img> — the scrim above is what separates it from the art.
  */
  .feed-row-banner-logo {
    height: clamp(52px, 7.5vw, 124px);
    width: auto;
    max-width: min(78%, 460px);
    object-fit: contain;
    object-position: right bottom;
  }

  @media (max-width: 560px) {
    /* The art is 16:9 and this is a 2:1-ish crop on a phone, so the centre band
       is all that survives. Pulling the mark in keeps it off the edge. */
    .feed-row-banner-lockup {
      padding-inline: 1.25rem;
    }
  }
</style>
