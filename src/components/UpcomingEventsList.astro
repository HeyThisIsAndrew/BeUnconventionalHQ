---
import { formatLocation } from '../lib/events';
import EventStatusIndicator from './EventStatusIndicator.astro';

const { events = [] } = Astro.props;
---

<ul class="uel-list" role="list">
  {events.map((event: any) => {
    const slug = event?.slug?.current ?? '';
    const locationLabel = formatLocation(event?.location);
    
    let month = '';
    let day = '';
    if (event?.startDate) {
      // Use UTC to prevent off-by-one errors from local timezone
      const d = new Date(event.startDate + 'T00:00:00Z');
      if (!isNaN(d.getTime())) {
        month = d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
        day = d.toLocaleDateString('en-US', { day: 'numeric', timeZone: 'UTC' });
      }
    }

    return (
      <li class="uel-item">
        <a href={`/events/${slug}`} class="uel-link">
          <div class="uel-date-badge">
            <span class="uel-badge-month">{month}</span>
            <span class="uel-badge-day">{day}</span>
          </div>

          <div class="uel-body">
            <h3 class="uel-title">{event.title}</h3>
            {locationLabel && <span class="uel-location-pill">{locationLabel}</span>}
          </div>

          <span class="uel-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .uel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .uel-link {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 80px; 
    padding: 1.2rem 1.5rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: #fff;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .uel-link:hover,
  .uel-link:focus-visible {
    background: rgba(255, 255, 255, 0.03);
    border-color: var(--color-accent, #cc0000);
    box-shadow: 0 8px 40px rgba(204, 0, 0, 0.15);
    transform: translateY(-4px);
    outline: none;
  }

  .uel-date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 60px;
    flex-shrink: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    padding-right: 1.5rem;
  }

  .uel-badge-month {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent-text, #ef4444);
    margin-bottom: 0.1rem;
  }

  .uel-badge-day {
    font-family: var(--font-display, 'Syne Variable', sans-serif);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: #fff;
  }

  .uel-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .uel-title {
    font-family: var(--font-display, 'Syne Variable', sans-serif);
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    transition: color 0.3s ease;
  }

  .uel-link:hover .uel-title {
    color: #fff;
  }

  .uel-location-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
    background: rgba(255,255,255,0.05);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }

  .uel-arrow {
    flex-shrink: 0;
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.3);
    transition: color 0.3s ease, transform 0.3s ease;
  }
  
  .uel-link:hover .uel-arrow,
  .uel-link:focus-visible .uel-arrow {
    transform: translateX(4px);
    color: var(--color-accent-text, #ef4444);
  }

  @media (max-width: 560px) {
    .uel-link {
      gap: 1rem;
      padding: 1rem;
    }
    .uel-date-badge {
      padding-right: 1rem;
      min-width: 50px;
    }
    .uel-title {
      font-size: 1.1rem;
    }
    .uel-badge-day {
      font-size: 1.6rem;
    }
    .uel-arrow {
      display: none;
    }
  }
</style>
