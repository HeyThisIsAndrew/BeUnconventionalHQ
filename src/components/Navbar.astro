---
import { site } from '../data/site.js';
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.webp';

const currentPath = Astro.url.pathname;
/* Navigation comes from site.nav (src/data/site.js) so the navbar and the
   footer cannot disagree about what sections exist. Add a section there once
   and it appears in both, plus the mobile menu. */
const navItems = site.nav;

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const isActive = (href: string) =>
  currentPath === `${base}/${href}` || currentPath === `${base}/${href}/` || currentPath.startsWith(`${base}/${href}/`);
---

<header id="navbar" transition:persist="global-nav" style="transition: none;">
  <div class="container nav-inner">
    <div class="nav-brand-group">
      <a href="/" class="nav-logo">
        <Image src={logoImage} alt="Be Unconventional HQ" width={150} height={150} widths={[65, 130, 150]} sizes="(max-width: 768px) 65px, 150px" loading="eager" />
      </a>
      <a
        href="/"
        class="nav-identity-wrapper"
        id="nav-identity"
        tabindex="-1"
        style="transform: translateY(-10px) scale(0.95); opacity: 0; pointer-events: none; transition: opacity 0.4s ease, transform 0.4s ease; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-left: 1rem; text-decoration: none; cursor: pointer;"
      >
        <div class="nav-identity-stack">
          <span class="nav-word-be">BE</span>
          <span class="nav-word-unconventional">UNCONVENTIONAL</span>
          <span class="nav-word-hq">HQ</span>
        </div>
      </a>
    </div>
    <button class="nav-toggle" aria-label="Toggle Menu" aria-expanded="false">
      <span class="line line-1"></span><span class="line line-2"></span><span
        class="line line-3"></span>
    </button>
    <nav class="nav-container">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li class="nav-item">
              <a
                href={`/${item.href}`}
                class:list={[{ active: isActive(item.href) }]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <script is:inline>
  (function () {
    let scrollHandler = null;
    let observer = null;
    let currentVisibility = null;

    function initNavObserver() {
      const identity = document.getElementById('nav-identity');
      const navbar = document.getElementById('navbar');
      if (!identity || !navbar) return;

      // Instant Jump to Top for ALL home links on the homepage to avoid SPA navigation flicker
      const homeLinks = document.querySelectorAll('a[href="/"]');
      homeLinks.forEach(link => {
        if (!link.dataset.clickBound) {
          link.addEventListener('click', (e) => {
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;

            if (navbar.classList.contains('menu-open')) {
              navbar.classList.remove('menu-open');
              const toggle = document.querySelector('.nav-toggle');
              if (toggle) toggle.setAttribute('aria-expanded', 'false');
              if (window.__hqScrollLock && window.__hqScrollLock.isLocked()) {
                window.__hqScrollLock.release();
              }
            }

            document.dispatchEvent(new CustomEvent('hq:lift-splash'));

            // The base path is determined dynamically or falls back to '/'
            const basePath = navbar.dataset.basePath || '/';
            if (window.location.pathname === basePath || window.location.pathname === '/') {
              e.preventDefault();
              if (document.documentElement.classList.contains('splash-lifting')) return;
              
              /* Jump, don't animate — via the scroll-lock bridge, because an
                 is:inline script cannot import. The forced style recalc inside
                 jumpTo() is what makes the `auto` override actually apply; see
                 src/lib/scroll-to.ts. It restores the global smooth scroll
                 synchronously, so iPad scroll inertia is untouched. */
              window.__hqScrollLock.jumpTo(0);
            }
          });
          link.dataset.clickBound = 'true';
        }
      });

      // Cleanup old observer and scroll handler to prevent memory leaks
      if (observer) {
        observer.disconnect();
        observer = null;
      }
      if (scrollHandler) {
        window.removeEventListener('scroll', scrollHandler);
        scrollHandler = null;
      }

      // 3. Visibility Logic
      // We use a basic scroll threshold so the navbar remains solid until the utmost part of the screen.
      function updateVisibility(isVisible) {
        if (isVisible === currentVisibility) return;
        currentVisibility = isVisible;

        if (isVisible) {
          identity.style.opacity = '1';
          identity.style.transform = 'translateY(0) scale(1)';
          identity.style.pointerEvents = 'auto';
          identity.removeAttribute('tabindex');
          navbar.classList.add('scrolled');
        } else {
          identity.style.opacity = '0';
          identity.style.transform = 'translateY(-10px) scale(0.95)';
          identity.style.pointerEvents = 'none';
          identity.setAttribute('tabindex', '-1');
          navbar.classList.remove('scrolled');
        }

        // Restore transitions after state is instantly applied
        if (window.__hqNavFrame1) cancelAnimationFrame(window.__hqNavFrame1);
        if (window.__hqNavFrame2) cancelAnimationFrame(window.__hqNavFrame2);

        window.__hqNavFrame1 = requestAnimationFrame(() => {
          window.__hqNavFrame2 = requestAnimationFrame(() => {
            navbar.style.transition = '';
            identity.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          });
        });
      }

      scrollHandler = () => {
        if (window.__hqScrollLock && window.__hqScrollLock.isLocked()) return;
        const scroll = window.scrollY || document.documentElement.scrollTop;
        updateVisibility(scroll > 100);
      };
      
      window.addEventListener('scroll', scrollHandler, { passive: true });
      // INSTANTLY check state on load so it doesn't get stuck visible!
      scrollHandler();

      // Clear the initial transition block after the first frame so CSS transitions take over
      if (window.__hqNavFrame1) cancelAnimationFrame(window.__hqNavFrame1);
      if (window.__hqNavFrame2) cancelAnimationFrame(window.__hqNavFrame2);
      
      window.__hqNavFrame1 = requestAnimationFrame(() => {
        window.__hqNavFrame2 = requestAnimationFrame(() => {
          if (navbar.style.transition === 'none' || navbar.style.transition === 'none 0s ease 0s') {
            navbar.style.transition = '';
          }
        });
      });
    }

    function updateActiveNavLinks() {
      const currentPath = window.location.pathname.replace(/\/$/, '');
      const navLinks = document.querySelectorAll('.nav-list .nav-item a');

      navLinks.forEach((link) => {
        const rawHref = link.getAttribute('href');
        if (rawHref && rawHref.startsWith('#')) {
          link.classList.remove('active');
          return;
        }

        const linkPath = new URL(link.href).pathname.replace(/\/$/, '');
        if (currentPath === linkPath || currentPath.startsWith(linkPath + '/')) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }


    if (!window.navbarObserverSetup) {
      document.addEventListener('astro:page-load', initNavObserver);
      document.addEventListener('astro:page-load', updateActiveNavLinks);
      window.navbarObserverSetup = true;
    }

    function initMobileMenu() {
      const navbar = document.getElementById('navbar');
      const toggle = document.querySelector('.nav-toggle');

      if (navbar && toggle) {
        if (!toggle.dataset.mobileClickBound) {
          toggle.addEventListener('click', () => {
            const isOpened = navbar.classList.contains('menu-open');
            if (isOpened) {
              if (!window.__hqScrollLock.isLocked()) {
                navbar.classList.remove('menu-open');
                toggle.setAttribute('aria-expanded', 'false');
                return;
              }

              navbar.classList.remove('menu-open');
              toggle.setAttribute('aria-expanded', 'false');
              window.__hqScrollLock.unlock();
            } else {
              window.__hqScrollLock.lock();
              navbar.classList.add('menu-open');
              toggle.setAttribute('aria-expanded', 'true');
            }
        });
        toggle.dataset.mobileClickBound = 'true';
      }

      const navLinks = navbar.querySelectorAll('.nav-list a');
        navLinks.forEach((link) => {
          if (!link.dataset.mobileClickBound) {
            link.addEventListener('click', () => {
              if (navbar.classList.contains('menu-open')) {
                navbar.classList.remove('menu-open');
                toggle.setAttribute('aria-expanded', 'false');
                
                if (window.__hqScrollLock && window.__hqScrollLock.isLocked()) {
                  if (link.getAttribute('href') === '/') {
                    window.__hqScrollLock.release();
                  } else {
                    window.__hqScrollLock.unlock();
                  }
                }
              }
          });
          link.dataset.mobileClickBound = 'true';
        }
        });
    }

    } // Ends initMobileMenu

    // The navbar uses transition:persist, so Astro preserves it (and any
    // .menu-open class) across client-side navigations.
    function resetMenuState() {
      const navbar = document.getElementById('navbar');
      if (navbar && navbar.classList.contains('menu-open')) {
        navbar.classList.remove('menu-open');
        navbar
          .querySelector('.nav-toggle')
          ?.setAttribute('aria-expanded', 'false');
          
        if (window.__hqScrollLock && window.__hqScrollLock.isLocked()) {
          window.__hqScrollLock.release();
        }
      }
    }

    function purgeNavbarState() {
      const navbar = document.getElementById('navbar');
      const identity = document.getElementById('nav-identity');
      
      if (window.__hqNavFrame1) cancelAnimationFrame(window.__hqNavFrame1);
      if (window.__hqNavFrame2) cancelAnimationFrame(window.__hqNavFrame2);

      if (navbar) {
        navbar.style.transition = 'none';
        
        if (navbar.classList.contains('menu-open') && window.__hqScrollLock && window.__hqScrollLock.isLocked()) {
          window.__hqScrollLock.release();
        }
        
        navbar.classList.remove('scrolled', 'menu-open');
        
        const toggle = document.querySelector('.nav-toggle');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      }

      if (identity) {
        identity.style.transition = 'none';
        identity.style.opacity = '0';
        identity.style.transform = 'translateY(-10px) scale(0.95)';
        identity.style.pointerEvents = 'none';
        identity.setAttribute('tabindex', '-1');
      }
      
      // CRITICAL: Reset the closure variable so the scroll listener doesn't ignore the next update!
      currentVisibility = null;
    }

    if (!window.navbarMobileMenuSetup) {
      document.addEventListener('astro:page-load', initMobileMenu);
      document.addEventListener('astro:page-load', resetMenuState);
      
      // The crucial fix for the persistence and flicker bugs
      document.addEventListener('astro:before-swap', purgeNavbarState);

      /* Escape closes the menu, matching the category overlay, the video
         modal and the calendar. Without it the mobile menu was the only
         full-screen overlay on the site a keyboard user could open but not
         dismiss with the key every other one accepts. Bound on document,
         once, alongside the other global listeners. */
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const navbar = document.getElementById('navbar');
        if (!navbar || !navbar.classList.contains('menu-open')) return;
        navbar.classList.remove('menu-open');
        const toggle = document.querySelector('.nav-toggle');
        if (toggle) {
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
        if (window.__hqScrollLock && window.__hqScrollLock.isLocked()) {
          window.__hqScrollLock.unlock();
        }
      });

      window.navbarMobileMenuSetup = true;
    }
  })();
  </script>
</header>
