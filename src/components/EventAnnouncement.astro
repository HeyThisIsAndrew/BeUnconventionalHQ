---
import Layout from '../layouts/Layout.astro';
import HeroTrailer from './HeroTrailer.astro';
import InstagramFeed from './InstagramFeed.astro';
import SubscribeCTA from './SubscribeCTA.astro';
import EventStatusIndicator from './EventStatusIndicator.astro';
import ContentCard from './ContentCard.astro';
import MiniCalendarSidebar from './MiniCalendarSidebar.astro';
import { getHubTopicKeywords } from '../lib/instagram-topic';
import { parseVideoId } from '../lib/platforms/youtube';
import { formatEventDateRange, formatLocation } from '../lib/events';
import { urlFor } from '../lib/local-content';

const { event, unifiedContent } = Astro.props;
const brandColor = event.brandColor || 'var(--color-accent, #cc0000)';

const HERO_WIDTHS = [800, 1200, 2400];
const heroAt =  (w: number) => event.heroImage ? urlFor(event.heroImage).width(w).auto('format').url() : '';
const heroMobileUrl = heroAt(800);
const heroSrcset = event.heroImage ? HERO_WIDTHS.map( (w: number) => `${heroAt(w)} ${w}w`).join(', ') : '';
const heroSizes = '100vw';
const heroUrl = heroAt(2400);
const fallbackGradient = `linear-gradient(135deg, ${brandColor} 0%, #111 100%)`;

const trailerUrl = event.trailerUrl;
const trailerId = parseVideoId(trailerUrl);
---

<Layout
  title={event.title}
  description={`Coverage of ${event.title}`}
  preloadImage={heroMobileUrl || undefined}
  preloadImageSrcset={heroSrcset || undefined}
  preloadImageSizes={event.heroImage ? heroSizes : undefined}
>
  <main class="event-dashboard" style={`--brand-color: ${brandColor};`}>
    
    {/* Purely Cinematic Banner Hero */}
    <section class="event-hero">
      <div class="event-hero-bg-wrapper" style={!heroUrl ? `background: ${fallbackGradient};` : ''}>
        {heroUrl && (
          <img
            src={heroMobileUrl}
            srcset={heroSrcset}
            sizes={heroSizes}
            alt=""
            class="event-hero-bg-animated"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>
      {/* 40vh instead of 70vh since content is moved out */}
      <div class="event-hero-overlay" style="min-height: 40vh;"></div>
    </section>

    <div class="container-page content-container pt-12 pb-24">
      {/* Mobile Right Column (Stacks ABOVE left column on mobile) */}
      <div class="flex flex-col-reverse lg:flex-row gap-12 lg:gap-16">
        
        {/* LEFT COLUMN (70%) */}
        <div class="flex-1 min-w-0 flex flex-col gap-10">
          
          <header class="event-header">
            {event.logo && <h1 class="sr-only">{event.title}</h1>}
            {event.logo ? (
              <img
                src={urlFor(event.logo).height(240).url()}
                alt={`${event.title} logo`}
                class="hero-logo mb-6"
                height="240"
              />
            ) : (
              <h1 class="hero-title">{event.title}</h1>
            )}
            <p class="hero-meta text-gray-300">
              <span class="event-dates">{formatEventDateRange(event.startDate, event.endDate)}</span>
              {formatLocation(event.location) && (
                <span class="event-location">
                  <span class="mx-2 text-gray-500">•</span>
                  {formatLocation(event.location)}
                </span>
              )}
            </p>
          </header>

          {/* Quick Navigation Index */}
          <nav aria-label="Quick Navigation" class="flex flex-wrap gap-4 text-sm uppercase tracking-wider font-bold">
            <a href="#event-description" class="text-white hover:text-[#ef4444] border-b-2 border-transparent hover:border-[#ef4444] transition-colors py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">Event Description</a>
            {unifiedContent.length > 0 && (
              <a href="#event-coverage" class="text-white hover:text-[#ef4444] border-b-2 border-transparent hover:border-[#ef4444] transition-colors py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">Coverage</a>
            )}
            {trailerId && (
              <a href="#event-trailer" class="text-white hover:text-[#ef4444] border-b-2 border-transparent hover:border-[#ef4444] transition-colors py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">Trailer</a>
            )}
          </nav>

          {event.description && (
            <div id="event-description" class="scroll-mt-32">
              <h2 class="text-2xl font-display font-bold uppercase tracking-wide text-white border-b border-gray-800 pb-3 mb-6">About the Event</h2>
              <div class="article-body">
                <p>{event.description}</p>
              </div>
            </div>
          )}

          {trailerId && (
            <div id="event-trailer" class="scroll-mt-32">
              <div class="hero-trailer aspect-video w-full h-auto max-w-4xl bg-black rounded-lg overflow-hidden border border-gray-800">
                <HeroTrailer trailerId={trailerId} title={event.title} />
              </div>
            </div>
          )}

          {/* Event Content Row */}
          <div id="event-coverage" class="scroll-mt-32">
            <h2 class="text-2xl font-display font-bold uppercase tracking-wide text-white border-b border-gray-800 pb-3 mb-6">Coverage</h2>
            {unifiedContent.length > 0 ? (
              <div class="card-grid">
                {unifiedContent.map((item: any, index: number) => (
                  <ContentCard item={item} index={index} />
                ))}
              </div>
            ) : (
              <p class="text-gray-500 italic">Coverage is coming soon.</p>
            )}
          </div>
          
        </div>

        {/* RIGHT COLUMN (30%) - Utility Rail */}
        <aside class="w-full lg:w-[320px] xl:w-[380px] flex-shrink-0">
          <div class="sticky top-32 flex flex-col gap-8">
            
            {/* Event Info Module */}
            <div class="sidebar-module bg-[#0a0a0a] border border-gray-800 p-8 rounded-xl shadow-2xl">
              <div class="hero-status mb-6"><EventStatusIndicator event={event} /></div>
              <div class="text-gray-300 text-sm mb-6 space-y-2">
                <p><strong>Date:</strong> {formatEventDateRange(event.startDate, event.endDate)}</p>
                {formatLocation(event.location) && <p><strong>Location:</strong> {formatLocation(event.location)}</p>}
              </div>
              {(event.officialWebsite || event.signUpLink) && (
                <a href={event.officialWebsite || event.signUpLink} target="_blank" rel="noopener noreferrer" class="hero-rsvp-btn w-full text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">
                  Sign Up / Tickets<span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </div>

            {/* Coverage Inquiry Module */}
            <div class="sidebar-module coverage-inquiry bg-[#cc0000]/10 border border-[#cc0000]/30 p-8 rounded-xl">
              <h3 class="font-display font-bold text-xl uppercase tracking-wide text-white mb-4">Coverage Inquiry</h3>
              <p class="text-gray-300 text-sm mb-6 leading-relaxed">
                BE Unconventional HQ provides premium editorial coverage for events, including live photography, video interviews, and written features.
              </p>
              <a href="mailto:press@beunconventionalhq.com?subject=Press%20Inquiry" class="text-red-400 text-sm font-bold uppercase tracking-wider hover:text-white transition-colors border-b border-red-400 pb-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">
                Request Press Kit &rarr;
              </a>
            </div>
            
            {/* Calendar Widget */}
            <div class="sidebar-module w-full">
              <MiniCalendarSidebar events={Astro.props.allEvents?.filter((e: any) => e.startDate >= new Date().toISOString().split('T')[0]) || []} />
            </div>
            
          </div>
        </aside>

      </div>
    </div>
    
    <InstagramFeed topicKeywords={getHubTopicKeywords(event)} />
    <SubscribeCTA />

  </main>
</Layout>

<style>
  .event-hero {
    position: relative;
    background-color: #111;
  }
  .event-hero-bg-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .event-hero-bg-animated {
    position: absolute;
    inset: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
    transform: translateZ(0);
    animation: cinematic-hero-zoom 30s ease-in-out infinite alternate;
  }
  @keyframes cinematic-hero-zoom {
    from { transform: scale(1.08) translateZ(0); }
    to { transform: scale(1) translateZ(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-hero-bg-animated { animation: none; }
  }
  
  .event-hero-overlay {
    position: relative;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.97) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.35) 100%
    );
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .hero-logo {
    max-height: clamp(84px, 46px + 12vw, 180px);
    max-width: min(100%, 420px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .hero-title {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: clamp(1.9rem, calc(1.1rem + 3vw), 3.75rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    overflow-wrap: break-word;
    word-break: break-word;
    margin: 0 0 1rem 0;
  }

  .hero-meta {
    font-size: clamp(0.9rem, 0.8rem + 0.6vw, 1.25rem);
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .event-dates, .event-location {
    display: inline-block;
  }

  .hero-rsvp-btn {
    display: inline-block;
    background: transparent;
    color: white;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.75rem 2rem;
    border: 1px solid var(--color-accent, #cc0000);
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .hero-rsvp-btn:hover, .hero-rsvp-btn:focus-visible {
    background: var(--color-accent, #cc0000);
    color: white;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
