---
import Layout from '../layouts/Layout.astro';
import HeroTrailer from './HeroTrailer.astro';
import InstagramFeed from './InstagramFeed.astro';
import SubscribeCTA from './SubscribeCTA.astro';
import EventStatusIndicator from './EventStatusIndicator.astro';
import ContentCard from './ContentCard.astro';
import MiniCalendarSidebar from './MiniCalendarSidebar.astro';
import { getHubTopicKeywords } from '../lib/instagram-topic';
import { parseVideoId } from '../lib/platforms/youtube';
import { formatEventDateRange, formatLocation } from '../lib/events';
import { urlFor } from '../lib/local-content';

const { event, unifiedContent } = Astro.props;

const brandColor = event.brandColor || 'var(--color-accent, #cc0000)';

const HERO_WIDTHS = [800, 1200, 2400];
const heroAt = (w: number) => event.heroImage ? urlFor(event.heroImage).width(w).auto('format').url() : '';
const heroMobileUrl = heroAt(800);
const heroSrcset = event.heroImage ? HERO_WIDTHS.map((w) => `${heroAt(w)} ${w}w`).join(', ') : '';
const heroSizes = '100vw';
const heroUrl = heroAt(2400);
const fallbackGradient = `linear-gradient(135deg, ${brandColor} 0%, #111 100%)`;

const trailerUrl = event.trailerUrl;
const trailerId = parseVideoId(trailerUrl);
---

<Layout
  title={event.title}
  description={`Coverage of ${event.title}`}
  preloadImage={heroMobileUrl || undefined}
  preloadImageSrcset={heroSrcset || undefined}
  preloadImageSizes={event.heroImage ? heroSizes : undefined}
>
  <main class="event-dashboard" style={`--brand-color: ${brandColor};`}>
    
    <section class="event-hero">
      <div class="event-hero-bg-wrapper" style={!heroUrl ? `background: ${fallbackGradient};` : ''}>
        {heroUrl && (
          <img
            src={heroMobileUrl}
            srcset={heroSrcset}
            sizes={heroSizes}
            alt=""
            class="event-hero-bg-animated"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>
      <div class="event-hero-overlay flex flex-col justify-end">
        <div class="container container-page !px-6 lg:!px-20 xl:!px-24">
          <div class="event-hero-content hero-copy animate-on-scroll">
            <h1 class="sr-only">{event.title}</h1>
            {event.logo ? (
              <img
                src={urlFor(event.logo).height(240).url()}
                alt={`${event.title} logo`}
                class="hero-logo w-full h-auto max-w-xs md:max-w-sm mb-4"
                height="240"
              />
            ) : (
              <h1 class="hero-title">{event.title}</h1>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="container-page content-container pt-12 pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] xl:grid-cols-[1fr_360px] gap-12 xl:gap-20">
        
        {/* Left Column (70%) */}
        <div class="event-main-col flex flex-col gap-12">
          
          {/* Mobile-only RSVP (Stacks above content on mobile) */}
          <div class="lg:hidden w-full sticky-utility-mobile">
            <div class="flex flex-col gap-4">
              <div class="hero-status"><EventStatusIndicator event={event} /></div>
              {(event.officialWebsite || event.signUpLink) && (
                <a href={event.officialWebsite || event.signUpLink} target="_blank" rel="noopener noreferrer" class="hero-rsvp-btn w-full text-center">
                  Official event information
                </a>
              )}
            </div>
          </div>

          <div class="event-about">
            {/* Quick Navigation Index */}
            <div class="flex gap-4 mb-8 text-sm uppercase tracking-wider font-bold">
              <a href="#event-description" class="text-white hover:text-[#ef4444] border-b-2 border-transparent hover:border-[#ef4444] transition-colors pb-1">Event Description</a>
              {(event.officialWebsite || event.signUpLink) && (
                <a href={event.officialWebsite || event.signUpLink} target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#ef4444] border-b-2 border-transparent hover:border-[#ef4444] transition-colors pb-1">Sign Up</a>
              )}
            </div>
            <h2 class="text-3xl font-bold font-display uppercase tracking-tight mb-4" id="event-description">About the Event</h2>
            <p class="hero-meta text-sm md:text-base mb-6 text-gray-300">
              <span class="event-dates">{formatEventDateRange(event.startDate, event.endDate)}</span>
              {formatLocation(event.location) && (
                <span class="event-location">
                  <span class="mx-2 text-gray-500">•</span>
                  {formatLocation(event.location)}
                </span>
              )}
            </p>
            {event.description && (
              <div class="prose prose-invert max-w-none text-gray-300">
                <p>{event.description}</p>
              </div>
            )}
          </div>

          {trailerId && (
            <div class="hero-trailer aspect-video w-full h-auto bg-black rounded-lg overflow-hidden border border-gray-800">
              <HeroTrailer trailerId={trailerId} title={event.title} />
            </div>
          )}

          <div class="event-content" id="event-content">
            <div class="flex items-center justify-between mb-8 border-b border-gray-800 pb-4">
              <h2 class="text-3xl font-bold font-display uppercase tracking-tight">Initial Coverage</h2>
            </div>
            
            {unifiedContent.length > 0 ? (
              <div class="card-grid">
                {unifiedContent.map((item: any, index: number) => (
                  <ContentCard item={item} index={index} />
                ))}
              </div>
            ) : (
              <div class="empty-state bg-[#111] border border-gray-800 rounded-lg p-12 text-center">
                <p class="text-gray-400 font-display text-lg uppercase tracking-wider">{event.title} coverage is coming soon.</p>
              </div>
            )}
          </div>
        </div>

        {/* Right Column (30%) */}
        <aside class="event-sidebar hidden lg:block">
          <div class="sticky top-32 flex flex-col gap-8">
            <div class="sidebar-module bg-[#0a0a0a] border border-gray-800 p-8 rounded-xl shadow-2xl">
              <div class="hero-status mb-6"><EventStatusIndicator event={event} /></div>
              <div class="text-gray-300 text-sm mb-6 space-y-2">
                <p><strong>Date:</strong> {formatEventDateRange(event.startDate, event.endDate)}</p>
                {formatLocation(event.location) && <p><strong>Location:</strong> {formatLocation(event.location)}</p>}
              </div>
              {(event.officialWebsite || event.signUpLink) && (
                <a href={event.officialWebsite || event.signUpLink} target="_blank" rel="noopener noreferrer" class="hero-rsvp-btn w-full text-center">
                  Sign Up / Tickets
                </a>
              )}
            </div>

            <div class="sidebar-module coverage-inquiry bg-[#cc0000]/10 border border-[#cc0000]/30 p-8 rounded-xl">
              <h3 class="font-display font-bold text-xl uppercase tracking-wide text-white mb-4">Coverage Inquiry</h3>
              <p class="text-gray-300 text-sm mb-6 leading-relaxed">
                BE Unconventional HQ provides premium editorial coverage for events, including live photography, video interviews, and written features.
              </p>
              <a href="/contact?subject=Press+Inquiry" class="text-[#ef4444] text-sm font-bold uppercase tracking-wider hover:text-white transition-colors border-b border-[#ef4444] pb-1">
                Request Press Kit &rarr;
              </a>
            </div>
            
            <div class="sidebar-module w-full">
              <MiniCalendarSidebar events={Astro.props.allEvents?.filter((e: any) => e.startDate >= new Date().toISOString().split('T')[0]) || []} />
            </div>
          </div>
        </aside>

      </div>
    </div>
    
    <InstagramFeed topicKeywords={getHubTopicKeywords(event)} />
    <SubscribeCTA />

  </main>
</Layout>

<style>
  .event-hero {
    position: relative;
    background-color: #111;
  }
  .event-hero-bg-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .event-hero-bg-animated {
    position: absolute;
    inset: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
    transform: translateZ(0);
    animation: cinematic-hero-zoom 30s ease-in-out infinite alternate;
  }
  @keyframes cinematic-hero-zoom {
    from { transform: scale(1.08) translateZ(0); }
    to { transform: scale(1) translateZ(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-hero-bg-animated { animation: none; }
  }
  .event-hero-overlay {
    position: relative;
    z-index: 1;
    min-height: 50vh;
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 1) 0%,
      rgba(0, 0, 0, 0.4) 100%
    );
    padding-top: clamp(6rem, 4.5rem + 6vw, 8.5rem);
    padding-bottom: 3rem;
  }

  .hero-logo {
    max-height: 180px;
    object-fit: contain;
  }
  .hero-title {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
    margin: 0;
  }
  
  .hero-rsvp-btn {
    display: inline-block;
    background: transparent;
    color: white;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-accent, #cc0000);
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .hero-rsvp-btn:hover {
    background: var(--color-accent, #cc0000);
    color: white;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }
</style>
