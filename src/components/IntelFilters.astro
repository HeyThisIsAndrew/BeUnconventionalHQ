---
import CategoryOverlay from './CategoryOverlay.astro';
import { CATEGORIES } from '../data/constants.js';
import { ARTICLE_SECTION } from '../data/sections.js';
import { topicPath } from '../lib/articles';

interface Props {
  active: string | null;
}

const { active } = Astro.props;
const filterCategories = CATEGORIES.filter((category) => category !== 'General');

/* The same categories, shaped for the shared mobile overlay. */
const overlayItems = filterCategories.map((category) => ({
  label: category.toUpperCase(),
  href: active === category ? ARTICLE_SECTION.path : topicPath(category),
  slug: category.toLowerCase(),
  active: active === category,
}));
---

{/* Mobile: one "Categories" button + full-screen menu */}
<CategoryOverlay items={overlayItems} />

<div class="intel-filter-nav" role="navigation" aria-label={`${ARTICLE_SECTION.name} categories`}>
  <div class="uniform-filter-grid">
    {
      filterCategories.map((category) => {
        const isActive = active === category;
        const href = isActive ? ARTICLE_SECTION.path : topicPath(category);

        return (
          <a
            href={href}
            class:list={['quadrant-btn', 'cat-btn', 'intel-compact-btn', { active: isActive }]}
            data-category={category.toLowerCase()}
            aria-current={isActive ? 'true' : undefined}
          >
            {category.toUpperCase()}
          </a>
        );
      })
    }
  </div>
</div>

<style>
  .intel-filter-nav {
    width: 100%;
    margin-bottom: 2.5rem;
    padding: 1rem 0;
    position: sticky;
    top: 80px; /* Sits just below the global navbar */
    z-index: 50;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* 
    Forces exactly equal widths for all buttons.
  */
  .uniform-filter-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.75rem;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  /* 
    Inherits all colors, hovers, and fonts from .quadrant-btn and .cat-btn
    (which guarantees square edges and exact matching), but overrides the 
    massive size to be sleeker.
  */
  .intel-compact-btn {
    flex: 1; /* Every button takes exactly the same fraction of the row */
    padding: 0.85rem 0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  /* Below 768px the inline row is replaced by <CategoryOverlay /> */
  @media (max-width: 768px) {
    .intel-filter-nav {
      display: none;
    }
  }
</style>
