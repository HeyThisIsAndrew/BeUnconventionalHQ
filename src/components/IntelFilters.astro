---
/**
 * Category filter bar for the article section.
 *
 * Uses the Feed's actual `.quadrant-btn` / `.cat-btn` control (promoted to
 * styles/modules/filters.css) rather than a lookalike, so hover, focus and
 * active states are identical to the Feed by construction.
 *
 * Server-rendered links to real routes, mirroring how the Feed does category
 * filtering (a static route per category). No hydration: every state is a
 * crawlable URL and keyboard-operable for free.
 *
 * Categories live under `/intel/topic/<category>` rather than
 * `/intel/<category>` so they can never be mistaken for an article slug.
 */
import { ARTICLE_SECTION } from '../data/sections.js';
import { getArticleCategories, topicPath } from '../lib/articles';

interface Props {
  /** Currently active category, or null on the "All" index. */
  active: string | null;
}

const { active } = Astro.props;
const categories = getArticleCategories();
---

<div class="intel-filter-nav" role="navigation" aria-label={`${ARTICLE_SECTION.name} categories`}>
  <div class="filter-grid intel-filter-grid">
    <a
      href={ARTICLE_SECTION.path}
      class:list={['quadrant-btn', 'cat-btn', { active: active === null }]}
      aria-current={active === null ? 'true' : undefined}
    >
      ALL
    </a>
    {
      categories.map((category) => (
        <a
          href={topicPath(category)}
          class:list={['quadrant-btn', 'cat-btn', { active: active === category }]}
          aria-current={active === category ? 'true' : undefined}
        >
          {category.toUpperCase()}
        </a>
      ))
    }
  </div>
</div>

<style>
  .intel-filter-nav {
    width: 100%;
    margin-bottom: 3.5rem;
  }

  /* Even columns so the bar reads as one control strip, matching the Feed's
     quadrant grid rather than a row of pills. */
  .intel-filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
  }

  @media (max-width: 768px) {
    .intel-filter-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .intel-filter-nav {
      margin-bottom: 2.5rem;
    }
  }
</style>
