---
import { SECTIONS } from '../data/content.js';
import { ARTICLE_SECTION } from '../data/sections.js';
import { getArticleItems } from '../lib/feed-items';
import PageTitle from './PageTitle.astro';
import ContentCard from './ContentCard.astro';
const allArticles = getArticleItems();
// Four, so the row divides evenly into 2x2 on mobile landscape.
const latestArticles = allArticles.slice(0, 4);
---

<section class="latest-section">
  <div class="section-header animate-on-scroll">
    <PageTitle {...SECTIONS.latestArticles} />
  </div>

  <div class="latest-grid">
    {
      latestArticles.map((article, index) => (
        <ContentCard item={article} index={index} />
      ))
    }
  </div>

  {/* Routes to /intel — this row is the article section's shopfront, so the
      link goes to the article section, not the mixed Feed. */}
  <div class="latest-view-all animate-on-scroll">
    <a href={ARTICLE_SECTION.path} class="view-all-link">
      All {ARTICLE_SECTION.name} &rarr;
    </a>
  </div>
</section>
