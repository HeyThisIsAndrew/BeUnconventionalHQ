---
import ContentCard from './ContentCard.astro';
import FeedRowBanner from './FeedRowBanner.astro';
import EmptyState from './EmptyState.astro';
import { LABELS, MESSAGES } from '../data/content.js';
import { getFeaturedBrandsLocal, getEventsLocal, urlFor } from '../lib/local-content';
import { resolveEntity, hexToRgbTriple } from '../lib/entity-resolver';
import { getHubMatchTags, matchVideosByTags } from '../lib/hub-coverage';
import CommercialRotator from './CommercialRotator.astro';
import FloatingPageNav from './FloatingPageNav.astro';

export interface Props {
  page: any;
  allItems: any[];
}

/*
  `page` is still accepted so the three /feed routes keep one call shape with
  FeedLayout, which reads it for rel=prev/next. This component no longer uses
  it: the flat grid that consumed `page.data` is gone, and the rows render from
  `allItems` — the whole feed, not a page of it.
*/
const { allItems = [] } = Astro.props;
const safeAllItems = Array.isArray(allItems) ? allItems : [];

/*
  ─── THE ROWS ARE BUILT FROM `hubs`, NOT `franchises` ───────────────────────

  The brief specified `item.franchises?.includes('dc')`. That field exists on
  the type and on all 215 synced documents, and it is EMPTY on every one of
  them — `franchises: doc.franchises ?? []` in src/lib/videos.ts is defaulting,
  not carrying data, because nothing populates it yet. A row built on it renders
  zero cards, and it does so silently: an empty row looks like "no coverage",
  not like a wiring bug.

  `hubs` is the populated taxonomy, and its values are full slugs — `dc-comics`
  and `marvel-comics`, NOT `dc` and `marvel`. Counted from src/data/videos.json:
  dc-comics 29, warner-bros 29, hbo-max 26, marvel-comics 21, prime-video 9,
  netflix 6.

  Lanterns is the one match the brief got exactly right: `youtubeTags` carries a
  lowercase `lanterns` on 26 documents, so `.includes('lanterns')` finds them
  without any normalising. It is still compared case-insensitively below, since
  youtubeTags is raw YouTube data and a future upload saying "Lanterns" would
  otherwise drop out of its own row.

  Adding a row is a line in this array. Rows that match nothing are dropped
  before render, so an empty one can never ship.
*/
const hubBrands = getFeaturedBrandsLocal();
const hubEvents = getEventsLocal();

/*
  ─── A HUB ROW HOLDS EVERYTHING ABOUT THAT HUB, NOT JUST THE VIDEOS ────────

  This was `Array.isArray(item.hubs) && item.hubs.includes(slug)` and nothing
  else, which quietly made every franchise and streamer row video-only.

  `hubs` is written by the YouTube sync and exists only on video records.
  Articles come from Substack and carry `tags`, so no article could ever
  satisfy that test — the DC row dropped both DC articles, Netflix dropped
  both Netflix articles, and so on, with no error and no empty row to notice.
  A row like "DC" is a TOPIC. Media type is the concern of exactly three rows,
  all of them in The Latest.

  ─── WHY THE KEYWORDS ARE NOT LISTED HERE ─────────────────────────────────

  The obvious repair is a per-row array of fallback words in this file. It
  would work today and rot immediately: CLAUDE.md states that there is ONE tag
  list per hub, `youtubeSyncKeywords` (labelled "Tags" in the CMS), and that it
  is the list feeding both the sync and the site's own matching. A second copy
  in a component is the exact drift that note exists to prevent, and it would
  be invisible to the editor who maintains the first.

  So step 3 reads the hub's own vocabulary through `getHubMatchTags()` and
  compares with the site's `compactTag` normalisation, the same path
  /featured/<slug> and /events/<slug> use for their coverage.

  Verified against the store: dc-comics, marvel-comics, hbo-max, netflix and
  prime-video each pick up 2 articles this way. Note an item can satisfy
  SEVERAL hubs — the Lanterns article is both DC and HBO Max — which is right,
  and which `resolveEntity()` could not express on its own since it returns one
  best hub per item.
*/
const slugOfDoc = (doc: any) =>
  typeof doc?.slug === 'string' ? doc.slug : doc?.slug?.current ?? null;

const allHubDocs = [...hubBrands, ...hubEvents];

/*
  ─── A TOPIC IS NOT A HUB ──────────────────────────────────────────────────

  Film, TV and Games are the site's Tier-1 topics, and they are stored in two
  different places depending on where the item came from: the YouTube sync
  writes `topics: ['film']` on a video, and a Substack article carries
  `category: 'Film'`. An item only ever has one of them.

  `games` and `gaming` are the same topic under two names — CLAUDE.md records
  the rename, and both spellings are still in the store (videos say `gaming`,
  articles say `Games`), so the alias is read here rather than left to whoever
  writes the next row definition.
*/
const TOPIC_ALIASES: Record<string, string[]> = {
  film: ['film', 'movies'],
  tv: ['tv', 'television'],
  games: ['games', 'gaming'],
  events: ['events', 'event'],
};

const hasTopic = (item: any, topic: string) => {
  const wanted = TOPIC_ALIASES[topic] ?? [topic];
  const topics = Array.isArray(item?.topics) ? item.topics.map((t: any) => String(t).toLowerCase()) : [];
  if (topics.some((t: string) => wanted.includes(t))) return true;
  const category = String(item?.category ?? '').toLowerCase();
  return wanted.includes(category);
};

const matchesHub = (item: any, slug: string) => {
  /* 1. The sync's explicit taxonomy — videos. */
  if (Array.isArray(item?.hubs) && item.hubs.includes(slug)) return true;

  /* 2. An editor naming the hub outright. */
  if (item?.relatedBrandSlug === slug) return true;

  /* 3. The hub's own tag vocabulary — articles, and any video whose tags name
     the hub without the sync having written it into `hubs`. */
  const hub = allHubDocs.find((doc) => slugOfDoc(doc) === slug);
  if (!hub) return false;
  return matchVideosByTags([item], getHubMatchTags(hub)).length > 0;
};

/*
  ─── A TAG MATCH HAS TO READ BOTH TAG FIELDS ───────────────────────────────

  Videos carry `youtubeTags` (raw YouTube tags) and articles carry `tags`
  (Substack post tags). They are different fields because they come from
  different syncs, and an item only ever has one of them.

  Reading `youtubeTags` alone made every tag-matched row video-only without
  looking like it: the Lanterns row showed five videos and silently dropped the
  two Lanterns articles, which are tagged "Lanterns" in `tags`. Nothing was
  broken on screen, the row was just quietly incomplete.

  Compared lower-case because the two sources disagree on case for the same
  tag: YouTube has "lanterns", Substack has "Lanterns".
*/
const hasTag = (item: any, tag: string) => {
  const wanted = tag.toLowerCase();
  const pools = [item?.youtubeTags, item?.tags];
  return pools.some(
    (pool) => Array.isArray(pool) && pool.some((t: any) => String(t).toLowerCase() === wanted),
  );
};

interface RowDef {
  id: string;
  title: string;
  variant?: 'prestige';
  /*
    Overrides the hub's own `brandColor` for this row's ambient wash. Only the
    tentpole shelf uses it: Lanterns is a show, not a hub, so there is no
    document to read a colour from.
  */
  accentColor?: string;
  /*
    Basenames under src/assets/rows, WITHOUT an extension.

    Resolved through import.meta.glob below rather than as a `/public` path, so
    the art goes through Astro's image pipeline (hashed, format-converted, a
    real srcset) and a file that is not there yet simply resolves to null. A
    public path would have shipped a broken <img> until somebody noticed.
  */
  bannerArt?: string;
  bannerLogo?: string;
  match: (item: any) => boolean;
}

interface SectionDef {
  id: string;
  title: string;
  /*
    Where this section's "explore" link goes, as a hash on /featured.

    The hash is the hub's `hubCategory` KEY, not the label shown on either page:
    the accordion sections on /featured carry `data-category="universes"` while
    the heading above them reads "Franchises". Linking to the label would look
    right and open nothing. Counted in the store: streaming 6, studios 5,
    universes 4, gaming 3.
  */
  explore?: { href: string; label: string };
  rows: RowDef[];
}

/*
  ─── THE TENTPOLE ROW SITS OUTSIDE THE SECTIONS ────────────────────────────

  Lanterns is a single title, not a franchise or a streamer, so it belongs to
  none of the three sections below. It keeps its prestige treatment and leads
  the page. Delete this one line to remove it; nothing else refers to it.
*/
const PRESTIGE_ROW: RowDef = {
  id: 'lanterns',
  title: 'Lanterns',
  variant: 'prestige',
  /* The show's signature emerald. Named here because no hub document carries
     it — `lanterns` is not a slug in the store. */
  accentColor: '#10B981',
  /*
    Drop the files in as src/assets/rows/lanterns-key-art.(jpg|png|webp) and
    lanterns-logo.png and the banner appears. Until then the shelf renders
    exactly as it did before, with its text lockup.
  */
  bannerArt: 'lanterns-key-art',
  bannerLogo: 'lanterns-logo',
  match: (i) => hasTag(i, 'lanterns'),
};

/*
  ─── ROW ARTWORK, RESOLVED AT BUILD TIME ───────────────────────────────────

  `eager` because there are at most a handful of these and the row needs the
  metadata (width/height) synchronously to render without layout shift. The glob
  is keyed by full path, so the lookup strips everything but the basename.

  A missing file is not an error here, by design: the banner is optional
  decoration on one row, and a build that fails because an editor has not
  uploaded artwork yet would be a worse trade than a shelf that renders plain.
*/
const ROW_ART = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/rows/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const rowArt = (name?: string): ImageMetadata | null => {
  if (!name) return null;
  const hit = Object.entries(ROW_ART).find(
    ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === name,
  );
  return hit ? hit[1].default : null;
};

/*
  ─── SECTIONS AND THEIR ROWS ───────────────────────────────────────────────

  Adding a row is a line in a `rows` array; adding a section is an entry here.
  Empty rows are dropped, and a section whose rows are all empty is dropped
  with them, so nothing can ship as a bare heading over nothing.

  ─── WHAT THESE FILTERS ACTUALLY MATCH, MEASURED ───────────────────────────
  Counted against src/data/videos.json at the time of writing, over the 28
  documents that are published AND of effective type `video` (shorts, live and
  retired docs never reach the feed):

    dc-comics 5 · hbo-max 5 · marvel-comics 4 · netflix 3 · prime-video 2

  STAR WARS MATCHES NOTHING, and that is a data fact rather than a wiring bug.
  There is no `star-wars` value in any document's `hubs`, and no document
  carries the exact tag "star wars". The only Star Wars strings in the store
  are compound tags — "Star Wars Andor", "Disney Plus Star Wars", "Star Wars
  review" — and every one of them is on a short or an unpublished document, so
  even a substring match would find nothing the feed can render. The row is
  specified here so it appears the moment a tagged video is published; until
  then it drops out rather than rendering an empty rail.

  `marvel` is kept alongside `marvel-comics` for the same forward-looking
  reason. Only `marvel-comics` exists in the store today.
*/
const SECTION_DEFS: SectionDef[] = [
  {
    id: 'latest',
    title: 'The Latest',
    rows: [
      { id: 'all-content', title: 'All Content', match: () => true },
      { id: 'all-videos', title: 'All Videos', match: (i) => i?.type === 'video' },
      { id: 'all-articles', title: 'All Articles', match: (i) => i?.type === 'article' },
    ],
  },
  {
    id: 'franchises',
    title: 'Franchises',
    explore: { href: '/featured#universes', label: 'EXPLORE FRANCHISES' },
    rows: [
      { id: 'dc-comics', title: 'DC', match: (i) => matchesHub(i, 'dc-comics') },
      { id: 'marvel-comics', title: 'Marvel', match: (i) => matchesHub(i, 'marvel-comics') || matchesHub(i, 'marvel') },
      { id: 'star-wars', title: 'Star Wars', match: (i) => matchesHub(i, 'star-wars') },
    ],
  },
  /*
    ─── THE TOPIC SECTIONS EXIST SO THE HOMEPAGE CAN LINK INTO THEM ──────────

    The homepage's "What We Cover" tiles are Film, TV, Games and Events, and
    they deep-link to /feed#film, #tv and #games. Those anchors need something
    to land on, so each topic is a section with that id.

    Games carries the platform hubs as well as its topic row: PlayStation,
    Nintendo and Xbox are how gaming content is actually branded, and an empty
    one drops out rather than shipping a bare heading — which today is most of
    them, since the store holds one PlayStation video and nothing for the other
    two.
  */
  {
    id: 'film',
    title: 'Film',
    rows: [{ id: 'topic-film', title: 'Film', match: (i) => hasTopic(i, 'film') }],
  },
  {
    id: 'tv',
    title: 'TV',
    rows: [{ id: 'topic-tv', title: 'TV', match: (i) => hasTopic(i, 'tv') }],
  },
  {
    id: 'games',
    title: 'Games',
    rows: [
      { id: 'topic-games', title: 'All Games', match: (i) => hasTopic(i, 'games') },
      { id: 'playstation', title: 'PlayStation', match: (i) => matchesHub(i, 'playstation') },
      { id: 'nintendo', title: 'Nintendo', match: (i) => matchesHub(i, 'nintendo') },
      { id: 'xbox', title: 'Xbox', match: (i) => matchesHub(i, 'xbox') },
    ],
  },
  {
    id: 'streaming',
    title: 'Streaming',
    explore: { href: '/featured#streaming', label: 'EXPLORE STREAMERS' },
    rows: [
      { id: 'hbo-max', title: 'HBO Max', match: (i) => matchesHub(i, 'hbo-max') },
      { id: 'netflix', title: 'Netflix', match: (i) => matchesHub(i, 'netflix') },
      { id: 'prime-video', title: 'Prime Video', match: (i) => matchesHub(i, 'prime-video') },
    ],
  },
];

/*
  ─── A ROW'S EXPLORE LINK IS DERIVED, NOT TYPED ────────────────────────────

  Every brand row's id IS its hub slug (`dc-comics`, `hbo-max`, …), so the
  destination is a lookup rather than a table of hardcoded hrefs that would
  drift the first time a slug changed. A row whose id matches no hub — the three
  global ones — simply gets no link.

  Events are checked too, so a row keyed to a convention would link to
  /events/<slug> rather than 404 at /featured/<slug>.
*/
const hubHref = (id: string): string | null => {
  const slugOf = (doc: any) =>
    typeof doc?.slug === 'string' ? doc.slug : doc?.slug?.current ?? null;
  if (hubBrands.some((b) => slugOf(b) === id)) return `/featured/${id}`;
  if (hubEvents.some((e) => slugOf(e) === id)) return `/events/${id}`;
  return null;
};

/*
  ─── EVERY BRANDED ROW IS LIT IN ITS OWN COLOUR ────────────────────────────

  The accent is READ FROM THE HUB, not listed here: `brandColor` already exists
  on each featuredBrand (DC #0476F2, Marvel #E23636, Netflix #E50914, Prime
  Video #00A8E1, HBO Max #002BE7, Star Wars #FFE81F), so the shelf lighting is
  editor-controlled from the CMS like everything else about a hub.

  WHITE IS SKIPPED. Four brands store #FFFFFF (Sony Pictures, Universal, A24,
  Apple TV+), and a white wash over a near-black page is not an accent, it is a
  grey fog across the row with no hue to read as branding. Those rows stay
  unlit, which is the honest result for a brand whose colour is white.

  The three global rows resolve to no hub at all and so stay clean by
  construction — nothing to special-case.
*/
const buildRow = (row: RowDef) => {
  const brandDoc = allHubDocs.find((doc) => slugOfDoc(doc) === row.id);

  /*
    ─── THE BOOKENDS ─────────────────────────────────────────────────────────

    A branded row is anchored by two static tiles: its mark at the head, and an
    "Explore <hub>" off-ramp at the tail. Both are resolved here rather than in
    the markup so a row that has no hub — the three global ones — gets neither,
    with nothing to special-case at render.

    The mark is asked for at height 320 like every other logo on the site
    (HubCard, the event heroes), and `auto('format')` keeps it off the critical
    path as a PNG.
  */
  /*
    The hub's key art, small and blurred-into-the-dark behind the Explore tile.
    Same source the /featured deck uses to represent a hub, so the off-ramp
    LOOKS like where it goes. 640 because it sits behind a dim scrim at tile
    size — the detail is spent before it reaches the eye (the same reasoning as
    the hero backdrop plate).
  */
  const bookendHero = (() => {
    if (!brandDoc?.heroImage) return null;
    try {
      return urlFor(brandDoc.heroImage).width(640).auto('format').url();
    } catch {
      return null;
    }
  })();

  const markRef = brandDoc ? brandDoc.heroLogo || brandDoc.logo : null;
  const bookendLogo = (() => {
    if (!markRef) return null;
    try {
      return urlFor(markRef).height(320).auto('format').url();
    } catch {
      /* A broken ref must not take the row down — the row just loses its mark. */
      return null;
    }
  })();
  const raw = brandDoc?.brandColor;
  const hubHex = typeof raw === 'string' ? raw : raw?.hex ?? null;

  const candidate = row.accentColor ?? hubHex;
  const accentColor =
    candidate && candidate.toLowerCase() !== '#ffffff' ? candidate : null;

  return {
    ...row,
    items: safeAllItems.filter(row.match),
    accentColor,
    accentRgb: accentColor ? hexToRgbTriple(accentColor) : null,
    bookendLogo,
    bookendHero,
    bookendTitle: brandDoc?.title ?? row.title,
    explore: (() => {
      const href = hubHref(row.id);
      return href ? { href, label: `EXPLORE ${row.title.toUpperCase()} HUB` } : null;
    })(),
  };
};

/*
  ─── NO TWO ADJACENT TILES MAY SHARE ARTWORK ───────────────────────────────

  The channel reuses one thumbnail across a run of episode reviews, so a
  chronological Lanterns row put four visually identical green-ring tiles side
  by side and read as a rendering fault rather than as four different episodes.

  This REORDERS rather than drops: an item whose artwork repeats the previous
  tile is held back and re-offered after the next distinct one, so nothing
  leaves the row and the sequence stays as close to newest-first as the
  artwork allows. Dropping duplicates would have hidden real episodes.

  Falls back to plain order when every remaining item shares one image, which
  is the only case where the constraint cannot be satisfied at all.
*/
function spreadByArtwork(items: any[]): any[] {
  const art = (item: any) => item?.thumbnail || item?.image || '';
  const queue = [...items];
  const out: any[] = [];

  while (queue.length > 0) {
    const lastArt = out.length > 0 ? art(out[out.length - 1]) : null;
    const nextIndex = queue.findIndex((item) => art(item) !== lastArt);
    out.push(...queue.splice(nextIndex === -1 ? 0 : nextIndex, 1));
  }

  return out;
}

const prestigeRow = (() => {
  const built = buildRow(PRESTIGE_ROW);
  if (built.items.length === 0) return null;
  return { ...built, items: spreadByArtwork(built.items) };
})();

/*
  ─── THE GLOBAL ROWS DE-DUPLICATE, AND ONLY THEY DO ────────────────────────

  "All Content", "All Videos" and "All Articles" are three different rows on
  /feed, where allItems holds both kinds. They are NOT three different rows on
  the type-filtered routes, which pass an already-narrowed list:

    /feed/videos   -> All Content and All Videos are the same 28 items
    /feed/articles -> All Content and All Articles are the same 12 items

  Those are three views of one list, so rendering two identical rails under two
  headings reads as a bug and doubles the cards the page ships.

  ─── WHY THIS IS SCOPED TO THE `latest` SECTION ───────────────────────────
  The first version of this compared every row against every earlier row on the
  page, and it silently ate the DC and HBO Max rows. Both hold exactly the five
  Lanterns videos — the show is a DC property airing on HBO Max — so by
  set-identity they matched the tentpole row and were dropped. Franchises
  rendered as Marvel alone and Streaming lost its largest row, which looked
  like a filter bug and was really this.

  Set identity is not the same thing as editorial identity. "DC" is a distinct
  browse path from "Lanterns" even in the week when they happen to contain the
  same five items, and it stops matching the moment any other DC video
  publishes. Only rows that are BY CONSTRUCTION views of the same list — the
  global three — may collapse into each other, so the comparison never leaves
  the section that defines them.

  First occurrence wins, so the result is deterministic rather than dependent
  on which row happens to be longer.
*/
const GLOBAL_SECTION_ID = 'latest';

const sameItems = (a: any[], b: any[]) => a.length === b.length && a.every((item, i) => item === b[i]);

const feedSections = SECTION_DEFS
  .map((section) => {
    const kept: any[][] = [];
    const rows = section.rows
      .map(buildRow)
      .filter((row) => row.items.length > 0)
      .filter((row) => {
        if (section.id !== GLOBAL_SECTION_ID) return true;
        if (kept.some((seen) => sameItems(seen, row.items))) return false;
        kept.push(row.items);
        return true;
      });
    return { ...section, rows };
  })
  .filter((section) => section.rows.length > 0);

const hasRows = Boolean(prestigeRow) || feedSections.length > 0;

/*
  ─── THE TENTPOLE SHELF NAMES ITS OWN HUB ──────────────────────────────────

  The badge, the Explore link and the second half of the eyebrow are all
  resolved from the row's own items rather than typed in as "DC". The shelf is
  driven by one line in PRESTIGE_ROW, so hardcoding DC here would mean pointing
  it at another show later and shipping a row that still said DC.

  The hub is taken from the first item that resolves to one, which for Lanterns
  is DC (see resolveEntity: among hbo-max / dc-comics / warner-bros, the item's
  own display tag decides). If nothing resolves, the badge, the divider and the
  link are all omitted and the shelf degrades to its title alone.
*/
const prestigeHub = prestigeRow
  ? prestigeRow.items.reduce<ReturnType<typeof resolveEntity>>(
      (found, item) => found ?? resolveEntity(item, { brands: hubBrands, events: hubEvents, urlFor }),
      null,
    )
  : null;

/* "MAX ORIGINAL SERIES" is not ours to assert — the distributor is whatever the
   item's hubs say. The eyebrow names the hub we actually resolved, and falls
   back to a neutral line when we resolved none. */
const prestigeEyebrow = prestigeHub
  ? `FEATURED SERIES \u2022 ${prestigeHub.title.toUpperCase()}`
  : 'FEATURED SERIES';

/*
  The banner is all-or-nothing. With key art the strip renders and takes the
  eyebrow and the title with it; without, the shelf keeps the text lockup it has
  always had. There is deliberately no half state where a logo floats over the
  page with no art behind it.
*/
const prestigeBannerArt = prestigeRow ? rowArt(PRESTIGE_ROW.bannerArt) : null;
const prestigeBannerLogo = prestigeBannerArt ? rowArt(PRESTIGE_ROW.bannerLogo) : null;

const navItems = feedSections.map(s => ({ id: s.id, text: s.title, level: 2 }));
---

<style>
  /* ─── NETFLIX ROWS ──────────────────────────────────────────────────────── */

  /* There is one view now. The rules that swapped this wrapper between the rows
     and a hidden results grid went with the grid itself — there is no
     `is-filtered` state left to enter, and nothing to hide. */

  /* ─── OVERARCHING SECTIONS ──────────────────────────────────────────── */

  /*
    The rows now sit directly under the hero: the filter row that used to
    separate them is gone from /feed (FeedLayout's `showFilters`). That row
    carried `margin: 4rem 0 3rem`, and it took the gap with it, so the first
    row had nothing holding it off the bottom of the hero. This is the standard
    editorial spacing, owned by the thing that actually needs it rather than
    inherited from a neighbour that might be removed again.
  */
  #feed-rows {
    padding-top: 3rem; 
  }
  
  /*
    ─── WHY THE SEAM MOVED WITH THE WINDOW ───────────────────────────────────

    This pulled the rows up over the hero with `margin-top: -6vh`, and the hero
    below it used to carry a mask fading its bottom edge out. The mask was
    removed; the overlap was not, only reduced. What was left is a hard-edged
    hero with the rows still sliding under it by an amount nobody can predict.

    `vh` is a fraction of the window's HEIGHT. The hero's height is set by its
    CONTENT: how many lines the headline wraps to, how tall the stage is. Those
    two numbers have nothing to do with each other, so the overlap was a
    different fraction of the hero at every window size. Measured on this page:

      1440 x 900    hero 654px   overlap  54px    8.3% of the hero
      1440 x 1800   hero 654px   overlap 108px   16.5% of the hero
      3840 x 2160   hero 632px   overlap 130px   20.5% of the hero

    The first two are the SAME page at the same width. Only the window's height
    changed, and the overlap doubled. At 4K it is worse than either: the hero is
    actually shorter there, while the overlap is largest, so the two move in
    opposite directions.

    That is the whole of "it's different at different window sizes", and no
    amount of retuning the number fixes it — any `vh` value has the same
    problem. So the overlap is gone. The hero ends where it ends and the banner
    begins, which is identical at every size because neither measurement
    depends on the other.
  */
  :global(.has-spotlight-hero) #feed-rows {
    position: relative;
    z-index: 1; /* Sits under the hero's z-index: 10 */
    margin-top: 0;
  }

  /*
    A full-bleed banner directly under a full-bleed hero reads as one cinematic
    block, so there is no gap between them to pay for. Without a banner the
    first row is type on the page ground and still needs its air.
  */
  :global(.has-spotlight-hero) #feed-rows[data-hero-banner] {
    padding-top: 0;
  }

  @media (max-width: 768px) {
    #feed-rows {
      padding-top: 2rem;
    }
    :global(.has-spotlight-hero) #feed-rows {
      margin-top: 0;
    }
  }

  /* The rotator brings its own internal padding, so this only owns the gap
     between it and the shelves either side of it. */
  .feed-rotator-break {
    margin-block: 1rem 2.5rem;
  }

  .feed-section {
    margin-bottom: 3.5rem;
  }

  /*
    The section heading outranks its rows visually as well as semantically, so
    the two levels are never mistaken for each other: larger, brighter, and
    underscored by a hairline that runs the width of the content column.
  */
  .feed-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 0.6rem;
    margin-bottom: 0.35rem;
  }

  .feed-row-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  /*
    ONE EXPLORE LINK, USED AT THREE DEPTHS — the tentpole shelf, a section
    heading and a row heading. `.prestige-hub-link` keeps its emerald tint on
    the lit shelf; everything else reads in the neutral one. Same metrics, same
    glyph, same hover, so the three never drift apart.
  */
  .feed-hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.62);
    transition: color 0.25s ease;
  }

  .feed-hub-link:hover,
  .feed-hub-link:focus-visible {
    color: var(--color-white, #f0f0f0);
  }

  .feed-hub-link:focus-visible {
    outline: 2px solid var(--color-accent-text, #ef4444);
    outline-offset: 3px;
  }

  /* The link drops under its heading rather than squeezing it on a phone. */
  @media (max-width: 640px) {
    .feed-section-head {
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .feed-hub-link {
      font-size: 0.56rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feed-hub-link {
      transition: none;
    }
  }

  .feed-section-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
    margin: 0;
  }

  .feed-section-rows {
    padding-top: 1.35rem;
  }

  /* Inside a section the rows sit closer together than a standalone row does:
     they are one group, and the section's own bottom margin provides the
     separation from the next group. */
  .feed-section-rows .feed-row {
    margin-bottom: 2rem;
  }

  .feed-section-rows .feed-row:last-child {
    margin-bottom: 0;
  }

  .feed-section-rows .feed-row-title {
    font-size: clamp(0.85rem, 1.25vw, 1rem);
    color: rgba(255, 255, 255, 0.82);
  }

  .feed-row {
    margin-bottom: 2.75rem;
  }

  .feed-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .feed-row-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
    margin: 0;
  }

  /*
    THE RAIL.

    `overflow-x: auto` with mandatory snapping, and the scrollbar hidden on all
    three engines — WebKit needs a pseudo-element, Firefox needs
    `scrollbar-width`, old Edge needs `-ms-overflow-style`. Hiding it is only
    safe because the chevrons exist on desktop and touch scrolls natively.

    `overscroll-behavior-x: contain` stops a rail that has hit its end from
    handing the gesture to the browser, which on iOS is the back-swipe: without
    it, flicking the last card sideways navigates away from the feed.
  */
  /*
    ─── THE RAIL RUNS EDGE TO EDGE, THE HEADINGS DO NOT ───────────────────────

    `.container-page` gives this page a 25.6px gutter and a 1536px max-width.
    The section and row headings want both. The rail wants neither: a card
    should scroll past the edge of the screen, not stop short of it inside an
    invisible box.

    `margin-inline: calc(50% - 50vw)` is the break-out. `50%` is half the
    element's own containing block and `50vw` is half the viewport, so the
    negative margin is exactly the distance from the container's edge to the
    viewport's on each side — it works at any width, including above the
    container's max-width where the gap is much larger than the gutter.

    `padding-inline` then puts that distance straight back as PADDING rather
    than margin, which is the whole trick: the scrollable area now spans the
    viewport, but the first card still starts on the same vertical line as the
    heading above it, and the last one can scroll fully off the right edge.

    KNOWN AND ACCEPTED: `vw` includes the scrollbar, 15px here, so the rail
    overshoots the layout viewport by 7.5px a side. `body` is `overflow-x:
    clip` (verified: the document's horizontal overflow is 0), so this is
    clipped rather than scrollable, and it costs about a tenth of the feather
    width below. Correcting it would mean publishing the scrollbar width from
    JS and making a layout rule depend on a script having run.
  */
  .feed-row-rail {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    list-style: none;
    margin-block: 0;
    margin-inline: calc(50% - 50vw);
    /*
      ─── ROOM FOR THE HOVER LIFT ──────────────────────────────────────────

      A scroll container cannot clip one axis and show the other: `overflow-x:
      auto` forces `overflow-y` to clip too, whatever it is set to. The slate
      lifts 4px and casts a 28px shadow on hover, and both were being cut off
      flush at the rail's edges.

      Padding, not margin: it is inside the scrollport, so the lifted card has
      somewhere to go.
    */
    padding-block: 0.75rem 1.5rem;
    padding-inline: calc(50vw - 50%);

    /*
      ─── SNAPPING IGNORES `padding`, SO THE GUTTER HAS TO BE DECLARED TWICE ──

      `scroll-snap-align: start` aligns a card to the SNAPPORT, and the
      snapport starts at the scroll container's padding-box edge unless
      `scroll-padding` says otherwise. So the snap engine treated the gutter
      above as empty space to be scrolled away: the rail loaded at
      `scrollLeft: 32` on a phone, putting the first card flush against the
      screen edge, 32px to the left of the heading it is supposed to line up
      with. It looked like the padding had not applied at all. It had; the
      scroll position was hiding it.

      It CANNOT be fixed in this rule, which is why it is set from the script
      below instead. `scroll-padding`'s percentages resolve against the
      scrollport — this element's own, now full-bleed, padding box — while
      `padding`'s resolve against the containing block. The identical
      expression therefore means two different things on the two properties:
      `calc(50vw - 50%)` computes to 32px as padding here and to exactly 0 as
      scroll-padding, which is the value that was doing nothing. `sync()` copies
      the resolved padding across, so the two can never disagree, and it
      already re-runs on resize.
    */

    /*
      ─── THE FEATHER IS SCROLL-AWARE, NOT ALWAYS ON ──────────────────────────

      A flat `linear-gradient(to right, transparent 0%, black 5%, black 95%,
      transparent 100%)` fades BOTH edges permanently, and the first card sits
      at the left edge — so the card a reader looks at first is always half
      faded, before anything has scrolled anywhere. The effect is meant to say
      "this continues past the edge"; on a rail resting at position 0 nothing
      continues past the left edge, and saying so is a lie the eye reads as a
      rendering fault.

      So each side's feather is a variable, and `sync()` in the script below
      turns it on only for a side that genuinely has content beyond it. Both
      default to 0, which makes the gradient fully opaque — that is also the
      correct no-JS state, since without script there is no scroll position to
      reason about and a permanently faded card would be the only visible
      result.
    */
    --feed-fade: clamp(28px, 5vw, 96px);
    --fade-start: 0px;
    --fade-end: 0px;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade-start),
      #000 calc(100% - var(--fade-end)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade-start),
      #000 calc(100% - var(--fade-end)),
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .feed-row-rail::-webkit-scrollbar { display: none; }

  /*
    `min(85vw, 320px)` is the brief's number and it is the right one: 320px caps
    the card on desktop, and 85vw keeps a phone showing a sliver of the NEXT
    card, which is the only affordance saying the rail scrolls at all.

    `flex: 0 0 auto` matters as much as the width — without it flex would shrink
    every card to fit the row and nothing would overflow, so nothing would
    scroll.
  */
  .feed-row-item {
    flex: 0 0 auto;
    width: min(85vw, 320px);
    scroll-snap-align: center;
    display: flex;
  }

  /*
    ─── THE FIRST AND LAST CARD OPT OUT OF CENTRE SNAPPING ───────────────────

    The brief asks for `snap-center`, and it is the right feel mid-rail. At the
    two ends it is not: a rail cannot scroll past 0 or past its maximum, so a
    first card that wants to be centred can never reach its own snap position.
    With `snap-type: mandatory` the browser resolves that by jumping to the
    nearest position it CAN satisfy, which skips the first card — it becomes
    unreachable, half off the left edge, and the same happens to the last card
    at the other end.

    `snap-align: start` on the first and `end` on the last are the positions
    those two can actually occupy. Everything between them still centres.
  */
  /* ─── BOOKENDS ────────────────────────────────────────────────────────────
     Deliberately quieter than a content tile: they are the ends of the shelf,
     not things to look at. No artwork, no fill — the row's own accent wash
     shows through, which is what ties the mark to the rail it heads.

     They inherit `.feed-row-item`'s width and snap, so nothing here touches
     either. Sizing them separately is how a rail blows out on mobile. */
  /*
    ─── THE OFF-RAMP IS BRANDED, AND HAS NO BOX ──────────────────────────────

    It shipped as a bordered panel with an arrow in it, which read as an empty
    card at the end of every row. The Instagram rail's terminal tile is the
    reference: no border, no panel, just the mark and the words sitting on the
    page.

    What it gains here is the hub's OWN key art behind it, dimmed almost to
    black — the same image /featured uses to represent that hub, so the tile
    looks like the place it sends you rather than like a generic arrow. Set as
    `--bookend-art` from the markup; a hub with no key art simply gets the flat
    gradient and still reads.
  */
  .feed-bookend-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    min-height: 160px;
    padding: 1.25rem;
    border: none;
    /* No radius and no border: there is no edge to round. The art layer below
       feathers out to transparent on all four sides, so anything drawn on this
       box would be the hard edge the mask exists to remove.

       NO overflow:hidden either — a clipping ancestor is what hard rule 3
       forbids anywhere near an iframe. */
    background: none;
    text-align: center;
    isolation: isolate;
  }

  /* The art, and the scrim that keeps the label legible over it. Two layers on
     one pseudo-element so the tile needs no extra markup. */
  .feed-bookend--cta .feed-bookend-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to bottom, rgba(10, 10, 10, 0.82), rgba(10, 10, 10, 0.94)),
      var(--bookend-art, none);
    background-size: cover, cover;
    background-position: center, center;
    opacity: 0.9;
    transition: opacity 0.35s ease;

    /*
      ─── NO EDGES. IT DISSOLVES INTO THE PAGE ───────────────────────────────

      The radius is gone and a mask took its place. A 4px radius still draws a
      rectangle: the art and its scrim ended on a hard line, so the tile read as
      a box parked at the end of the rail rather than as the rail running out.

      TWO linear masks INTERSECTED, not one radial. A radial on a tile this much
      taller than it is wide pinches the middle of the long sides and leaves the
      label sitting in a visibly dimmer patch. Intersecting a horizontal and a
      vertical ramp fades all four edges evenly and leaves the centre at full
      strength, which is where the mark and the words are.

      Where `mask-composite` is not understood the two masks add instead of
      intersecting, which still softens the corners and never produces a hard
      edge. The fallback is a weaker version of the same thing, not a different
      result.
    */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 20%, #000 80%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 17%, #000 83%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0%, #000 20%, #000 80%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 17%, #000 83%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /*
    ─── BORDERLESS BRAND LOGO BOOKEND ─────────────────────────────────────────
  */
  .feed-bookend--logo-only .feed-bookend-inner {
    background: transparent !important;
    border: none;
    padding: 0;
    gap: 1.5rem;
    min-height: auto;
  }

  .feed-bookend--logo-only .feed-bookend-inner::before {
    display: none; /* remove the scrim and background */
  }

  .feed-bookend-logo {
    max-width: 160px;
    height: auto;
    object-fit: contain;
    opacity: 0.9;
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .feed-bookend-link:hover .feed-bookend-logo,
  .feed-bookend-link:focus-visible .feed-bookend-logo {
    opacity: 1;
    transform: scale(1.05);
  }

  .feed-bookend-link:hover::before,
  .feed-bookend-link:focus-visible::before {
    opacity: 1;
  }

  /*
    ─── THE ROW MARK ────────────────────────────────────────────────────────

    Big enough to read at a glance, which the 96px-in-a-tile version was not —
    HBO Max's wordmark in particular was illegible at that size. Capped in
    HEIGHT rather than width because these marks are wildly different shapes: a
    height cap makes a round DC roundel and a long `prime video` wordmark carry
    the same visual weight, where a width cap would make the roundel tiny.
  */
  .feed-row-title--mark {
    display: flex;
    align-items: center;
    margin: 0;
    line-height: 0;
  }

  /*
    ─── SIZED FOR A LETTERBOXED WORDMARK, NOT FOR THE FILE ───────────────────

    Most of these assets are SQUARE canvases with the mark floating inside
    them: HBO Max, Netflix and Prime Video all measure 1:1, so a 46px box gave
    roughly 15px of actual wordmark and "hbo max" was unreadable. Marvel's is a
    true 2.2:1 lockup and was fine at the same height, which is what made the
    problem look like a Max-only bug.

    The cap is raised until the letterboxed ones read, which makes the genuinely
    wide marks a little larger than strictly necessary — the right trade, since
    an oversized wordmark still reads and an undersized one does not. Cropping
    the padding out of the source assets would be the real fix, and is an
    editorial job rather than a CSS one.
  */
  .feed-row-mark {
    height: clamp(44px, 5vw, 72px);
    width: auto;
    max-width: 260px;
    object-fit: contain;
    opacity: 0.95;
  }

  /* Matches the Instagram rail's terminal card: icon over a two-line label,
     uppercase from `text-transform` rather than baked into the markup so the
     two ends of a rail cannot drift in case. */
  .feed-bookend-link {
    color: var(--color-white-muted, #888);
    font-family: var(--font-display, sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.35;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.35s ease, border-color 0.35s ease, background 0.35s ease;
  }

  .feed-bookend-icon {
    stroke: currentColor;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .feed-bookend-link:hover,
  .feed-bookend-link:focus-visible {
    color: var(--color-white, #f0f0f0);
  }

  .feed-bookend-link:hover .feed-bookend-icon,
  .feed-bookend-link:focus-visible .feed-bookend-icon {
    transform: translateX(4px);
  }

  .feed-bookend-link:focus-visible {
    outline: 2px solid var(--color-accent-text, #ef4444);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .feed-bookend-link,
    .feed-bookend-icon,
    .feed-bookend--cta .feed-bookend-inner::before {
      transition: none;
    }

    .feed-bookend-link:hover .feed-bookend-icon {
      transform: none;
    }
  }

  /*
    The sticky mark and its scrim are gone with the tile they pinned. A row's
    branding lives in its heading now (.feed-row-mark), where it needs neither
    a pin nor a gradient to hide the cards passing under it.
  */

  /*
    ─── THE CENTRED TILE, AND THE ONE YOU PICKED ─────────────────────────────

    WHITE says "this is the one you are looking at". RED says "this is the one
    you chose, and it is now in the hero". Two different facts, so two colours,
    and the selected state wins where both are true.

    Drawn with `outline` rather than `border` deliberately: a border would add
    to the tile's box and shift every neighbour by 2px the moment the ring
    appeared, which on a snapping rail nudges the scroll position. An outline
    is painted outside the box and costs no layout, and `outline-offset: -2px`
    tucks it just inside the artwork's own edge so it reads as a rim rather
    than a halo.

    Phones only — desktop shows four tiles at once, so there is no single
    "current" one to mark.
  */
  /*
    `:global()` on the card, and it is not optional.

    Astro scopes these styles by stamping a `data-astro-cid-*` attribute on the
    elements in THIS component's template. `.feed-row-item` is one of them;
    `.content-card` is not — it is rendered by ContentCard.astro and carries
    that component's attribute instead. Without :global() the compiled selector
    asks for a card bearing FeedGrid's scope, which no card has, and the rules
    silently match nothing.

    Caught by measuring: with the classes correctly applied, `outlineColor` read
    back the inherited #f0f0f0 rather than either ring colour, which is what an
    element with `outline-style: none` reports.
  */
  @media (max-width: 899px) {
    .feed-row-item.is-centered :global(.content-card) {
      outline: none;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.3), 0 0 12px rgba(255, 255, 255, 0.1);
    }

    .feed-row-item.is-selected :global(.content-card) {
      outline: none;
      box-shadow: 0 0 0 1px var(--color-accent-text, #ef4444), 0 0 16px rgba(var(--brand-rgb, 239, 68, 68), 0.3);
    }

    .feed-row-item :global(.content-card) {
      transition: box-shadow 0.25s ease;
    }
  }

  @media (max-width: 899px) and (prefers-reduced-motion: reduce) {
    .feed-row-item :global(.content-card) {
      transition: none;
    }
  }

  .feed-row-item:first-child {
    scroll-snap-align: start;
  }

  .feed-row-item:last-child {
    scroll-snap-align: end;
  }

  .feed-row-item > * { width: 100%; }

  .feed-row-nav {
    display: none;
    gap: 0.4rem;
  }

  .feed-row-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.4);
    color: var(--color-white, #f0f0f0);
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, opacity 0.25s ease;
  }

  .feed-row-chevron:hover {
    border-color: rgba(var(--brand-rgb, 204, 0, 0), 0.85);
    background: rgba(0, 0, 0, 0.6);
  }

  /* Set by the rail's scroll handler: nothing further to scroll that way. */
  .feed-row-chevron[data-disabled='true'] {
    opacity: 0.25;
    pointer-events: none;
  }

  /* Mouse territory only. A coarse pointer scrolls the rail with a thumb. */
  @media (hover: hover) and (pointer: fine) {
    .feed-row-nav { display: flex; }
  }

  /*
    THE PRESTIGE ROW. A dark emerald wash, which is Lanterns' own colour, bled
    out past the page gutter so the row reads as a band rather than a boxed
    panel. No `overflow: hidden` anywhere in here: these rows carry cards that
    open a YouTube iframe, and hard rule 3 makes any clipping ancestor of one a
    black box on iOS Safari.
  */
  /* The banner is the top of this row, and it meets the hero directly. */
  #feed-rows[data-hero-banner] .feed-row--prestige {
    padding-top: 0;
  }

  .feed-row--prestige {
    position: relative;
    /* 1.5rem is the shelf's own air. It was raised to 3rem to push the banner
       clear of an overlap that no longer exists, and the banner zeroes it
       outright below. */
    padding: 1.5rem 0 1.25rem;
    margin-bottom: 3.25rem;
  }

  /* Already full-bleed by the same reasoning as the rail above, and unchanged:
     this is the band BEHIND the row, so it uses inset rather than margin. */
  /*
    A radial bloom anchored behind the lockup, not a flat linear wash. The light
    now has a source — it falls off from the badge outward — which is what makes
    the shelf read as lit rather than tinted.
  */
  /*
    ─── THE SHELF WASH, LIT AND FEATHERED ────────────────────────────────────

    What stood here had two visible faults.

    HARD TOP AND BOTTOM EDGES. `inset: 0 -50vw` clamped the wash to exactly the
    row's box, and the colours it started with were opaque dark greens —
    `rgba(6, 46, 34, 0.8)` and `rgba(8, 30, 24, 0.55)` — beginning at y=0. An
    opaque band that starts abruptly against a near-black page draws a line,
    and that line ran across the screen just above the eyebrow.

    IT RAN OUT TO THE RIGHT. A 600px bloom and a linear wash ending at 70% left
    the fourth card onward, and the Explore link, sitting in plain black.

    The repair is light rather than paint: low-alpha brand colour over the
    page's own background, spread wide, with a vertical mask taking both edges
    to zero so there is no boundary to see. Nothing here is opaque.

    The mask is on the PSEUDO-ELEMENT, deliberately. Feathering the row itself
    would mean a clipping ancestor, and these shelves carry cards that open a
    YouTube iframe — hard rule 3.
  */
  .feed-row--accented {
    position: relative;
  }

  .feed-row--accented::before {
    content: '';
    position: absolute;
    /* Bleeds past the row on all four sides so the mask has somewhere to fade
       INTO, rather than fading exactly where the content stops. */
    inset: -2.5rem -50vw -3rem;
    background:
      radial-gradient(
        ellipse 1300px 480px at 20% 35%,
        rgba(var(--row-accent-rgb, 204, 0, 0), 0.22) 0%,
        rgba(var(--row-accent-rgb, 204, 0, 0), 0.09) 45%,
        rgba(var(--row-accent-rgb, 204, 0, 0), 0.02) 75%,
