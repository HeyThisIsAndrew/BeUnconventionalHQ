---
import ContentCard from './ContentCard.astro';
import CardGrid from './CardGrid.astro';
import EmptyState from './EmptyState.astro';
import { LABELS, MESSAGES } from '../data/content.js';

export interface Props {
  page: any;
  allItems: any[];
}

const { page = { data: [] }, allItems = [] } = Astro.props;
const currentItems = Array.isArray(page?.data) ? page.data : [];
const safeAllItems = Array.isArray(allItems) ? allItems : [];

/*
  ─── THE ROWS ARE BUILT FROM `hubs`, NOT `franchises` ───────────────────────

  The brief specified `item.franchises?.includes('dc')`. That field exists on
  the type and on all 215 synced documents, and it is EMPTY on every one of
  them — `franchises: doc.franchises ?? []` in src/lib/videos.ts is defaulting,
  not carrying data, because nothing populates it yet. A row built on it renders
  zero cards, and it does so silently: an empty row looks like "no coverage",
  not like a wiring bug.

  `hubs` is the populated taxonomy, and its values are full slugs — `dc-comics`
  and `marvel-comics`, NOT `dc` and `marvel`. Counted from src/data/videos.json:
  dc-comics 29, warner-bros 29, hbo-max 26, marvel-comics 21, prime-video 9,
  netflix 6.

  Lanterns is the one match the brief got exactly right: `youtubeTags` carries a
  lowercase `lanterns` on 26 documents, so `.includes('lanterns')` finds them
  without any normalising. It is still compared case-insensitively below, since
  youtubeTags is raw YouTube data and a future upload saying "Lanterns" would
  otherwise drop out of its own row.

  Adding a row is a line in this array. Rows that match nothing are dropped
  before render, so an empty one can never ship.
*/
const hasHub = (item: any, slug: string) =>
  Array.isArray(item?.hubs) && item.hubs.includes(slug);

const hasTag = (item: any, tag: string) =>
  Array.isArray(item?.youtubeTags) &&
  item.youtubeTags.some((t: any) => String(t).toLowerCase() === tag);

const ROW_DEFS: { id: string; title: string; variant?: 'prestige'; match: (i: any) => boolean }[] = [
  { id: 'lanterns', title: 'Lanterns', variant: 'prestige', match: (i) => hasTag(i, 'lanterns') },
  { id: 'dc-comics', title: 'DC', match: (i) => hasHub(i, 'dc-comics') },
  { id: 'marvel-comics', title: 'Marvel', match: (i) => hasHub(i, 'marvel-comics') },
  { id: 'hbo-max', title: 'HBO Max', match: (i) => hasHub(i, 'hbo-max') },
  { id: 'netflix', title: 'Netflix', match: (i) => hasHub(i, 'netflix') },
  { id: 'prime-video', title: 'Prime Video', match: (i) => hasHub(i, 'prime-video') },
];

const feedRows = ROW_DEFS
  .map((row) => ({ ...row, items: safeAllItems.filter(row.match) }))
  .filter((row) => row.items.length > 0);
---

<script is:inline>
  if (typeof window !== 'undefined' && (window.location.hash || window.location.search.includes('category='))) {
    document.documentElement.classList.add('js-feed-filtering');
  }
</script>
<style>
  html.js-feed-filtering body #feed-grid-wrapper {
    opacity: 0;
  }

  /* ─── NETFLIX ROWS ──────────────────────────────────────────────────────── */

  /* The wrapper swaps between the two views. Both defaults are stated here so
     the correct one shows before any script runs: rows are the browse view, so
     with JS off or slow you get rows, not a grid AND rows.

     ─── THE GRID ONLY STANDS DOWN IF ROWS EXIST TO REPLACE IT ──────────────
     `data-has-rows` is the guard, and it is load-bearing rather than tidy.
     Every row matches on `hubs` or `youtubeTags`, which are YouTube taxonomy.
     Articles sync from Substack and carry neither, so /feed/articles builds
     ZERO rows. Without this attribute the rule below hid that page's grid too
     and the route rendered twelve cards at display:none: a completely blank
     page. Caught by counting VISIBLE cards, not by reading the markup, which
     was present and correct throughout. */
  #feed-grid-wrapper.is-filtered #feed-rows { display: none; }
  #feed-grid-wrapper[data-has-rows]:not(.is-filtered) #feed-grid { display: none; }

  .feed-row {
    margin-bottom: 2.75rem;
  }

  .feed-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .feed-row-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
    margin: 0;
  }

  /*
    THE RAIL.

    `overflow-x: auto` with mandatory snapping, and the scrollbar hidden on all
    three engines — WebKit needs a pseudo-element, Firefox needs
    `scrollbar-width`, old Edge needs `-ms-overflow-style`. Hiding it is only
    safe because the chevrons exist on desktop and touch scrolls natively.

    `overscroll-behavior-x: contain` stops a rail that has hit its end from
    handing the gesture to the browser, which on iOS is the back-swipe: without
    it, flicking the last card sideways navigates away from the feed.
  */
  .feed-row-rail {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
  }

  .feed-row-rail::-webkit-scrollbar { display: none; }

  /*
    `min(85vw, 320px)` is the brief's number and it is the right one: 320px caps
    the card on desktop, and 85vw keeps a phone showing a sliver of the NEXT
    card, which is the only affordance saying the rail scrolls at all.

    `flex: 0 0 auto` matters as much as the width — without it flex would shrink
    every card to fit the row and nothing would overflow, so nothing would
    scroll.
  */
  .feed-row-item {
    flex: 0 0 auto;
    width: min(85vw, 320px);
    scroll-snap-align: start;
    display: flex;
  }

  .feed-row-item > * { width: 100%; }

  .feed-row-nav {
    display: none;
    gap: 0.4rem;
  }

  .feed-row-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.4);
    color: var(--color-white, #f0f0f0);
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, opacity 0.25s ease;
  }

  .feed-row-chevron:hover {
    border-color: rgba(var(--brand-rgb, 204, 0, 0), 0.85);
    background: rgba(0, 0, 0, 0.6);
  }

  /* Set by the rail's scroll handler: nothing further to scroll that way. */
  .feed-row-chevron[data-disabled='true'] {
    opacity: 0.25;
    pointer-events: none;
  }

  /* Mouse territory only. A coarse pointer scrolls the rail with a thumb. */
  @media (hover: hover) and (pointer: fine) {
    .feed-row-nav { display: flex; }
  }

  /*
    THE PRESTIGE ROW. A dark emerald wash, which is Lanterns' own colour, bled
    out past the page gutter so the row reads as a band rather than a boxed
    panel. No `overflow: hidden` anywhere in here: these rows carry cards that
    open a YouTube iframe, and hard rule 3 makes any clipping ancestor of one a
    black box on iOS Safari.
  */
  .feed-row--prestige {
    position: relative;
    padding: 1.5rem 0 1.25rem;
    margin-bottom: 3.25rem;
  }

  .feed-row--prestige::before {
    content: '';
    position: absolute;
    inset: 0 -50vw;
    background: linear-gradient(
      100deg,
      rgba(6, 46, 34, 0.85) 0%,
      rgba(8, 30, 24, 0.6) 42%,
      rgba(10, 10, 10, 0) 78%
    );
    pointer-events: none;
    z-index: -1;
  }

  .feed-row--prestige .feed-row-title {
    color: #d7f7e6;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .feed-row-rail { scroll-behavior: auto; }
    .feed-row-chevron { transition: none; }
  }
</style>
<div id="feed-grid-wrapper" data-has-rows={feedRows.length > 0 ? "true" : undefined} style="width: 100%; clear: both; transition: opacity 0.2s ease;">
  {/*
    ─── TWO VIEWS, ONE WRAPPER ───────────────────────────────────────────────

    UNFILTERED  -> #feed-rows  (horizontal rows, grouped by hub)
    FILTERED    -> #feed-grid  (the flat grid the hash filter already builds)

    They are mutually exclusive and the swap is a single class on this wrapper,
    set by applyFilters() below. Doing it this way is deliberate: the filtering
    code already owns #feed-grid entirely — it caches the grid's original HTML,
    rebuilds it from the <template>, and pages it with Load More. Rebuilding
    that machinery to page six independent horizontal rows would have been a
    rewrite of the one part of this component that currently works.

    So the rows are the browse view and the grid is the results view, which is
    also the right split for a reader: you scan rows when you have not decided
    what you want, and you want a plain list the moment you have.
  */}

  {feedRows.length > 0 && (
    <div id="feed-rows">
      {feedRows.map((row) => (
        <section class:list={['feed-row', { 'feed-row--prestige': row.variant === 'prestige' }]} data-row={row.id}>
          <div class="feed-row-head">
            <h2 class="feed-row-title">{row.title}</h2>
            {/*
              The chevrons are mouse affordances only. A touch device scrolls
              the rail directly and a keyboard reaches every card through it,
              so they are aria-hidden and removed from the tab order rather
              than duplicated as focusable controls that go nowhere new.
            */}
            <div class="feed-row-nav" aria-hidden="true">
              <button type="button" class="feed-row-chevron" data-dir="-1" tabindex="-1">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </button>
              <button type="button" class="feed-row-chevron" data-dir="1" tabindex="-1">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </button>
            </div>
          </div>

          <ul class="feed-row-rail" data-rail>
            {row.items.map((item: any, index: number) => (
              <li class="feed-row-item">
                <ContentCard item={item} index={index} context="feed" />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}

{currentItems.length > 0 ? (
  <CardGrid id="feed-grid">
    {
      currentItems.map((item: any, index: number) => (
        <ContentCard item={item} index={index} context="feed" />
      ))
    }
  </CardGrid>
) : (
  <CardGrid id="feed-grid">
    <EmptyState message={MESSAGES.noContent} actionLabel={LABELS.viewAllContent} actionHref="/feed" />
  </CardGrid>
)}
</div>

<template id="full-dataset-cards">
  {safeAllItems.map((item: any, index: number) => (
    <ContentCard item={item} index={index} context="feed" />
  ))}
</template>

<template id="feed-empty-state">
  <EmptyState message={MESSAGES.noFilterMatch} actionLabel={LABELS.clearFilters} actionClass="clear-filters-btn" />
</template>

{/*
  ─── NO NUMBERED PAGINATION ON THE FEED ────────────────────────────────────

  <Pagination /> used to render here. It is gone from THIS component only; the
  component itself still serves /intel, /category/*, /events, the events archive
  and event coverage, so it is not deleted.

  Two reasons it had to go rather than be hidden. The rows are the browse view
  and they carry every item already, so a "page 2" of a feed you can scroll
  sideways is a second, contradictory way through the same content. And the
  numbered links were full URL navigations, which is what put the view
  transition — and with it the navbar — through a swap on every click.

  Load More stays, because the FILTERED view still needs it: picking a category
  can match far more than one screenful, and that view is a flat grid.
*/}
{currentItems.length > 0 && (
  <div class="mt-auto w-full" style="padding-top: 3.5rem;">
    <div id="load-more-container" style="display: none;" class="text-center w-full">
      <button id="load-more-btn" class="cta-button-primary mx-auto relative z-10">
        {LABELS.loadMore}
      </button>
    </div>
  </div>
)}



<script>
  function initFeedClientFiltering() {
    // Memory leak fix: Cleanup old hashchange listener before early returns on new pages
    if ((window as any)._feedHashChangeListener) {
      window.removeEventListener('hashchange', (window as any)._feedHashChangeListener);
    }

    const isFeedPage = window.location.pathname.startsWith('/feed') || window.location.pathname.startsWith('/category');
    if (!isFeedPage) return;

    // URL Normalization: Consume ?category= and translate strictly to a Hash
    const params = new URLSearchParams(window.location.search);
    const queryCategory = params.get('category');
    if (queryCategory) {
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.delete('category');
      newUrl.hash = queryCategory;
      /* Preserve ClientRouter's state for this entry — passing null makes a
         later Back change the URL without swapping the page. See stripHash()
         in Hero.astro. */
      window.history.replaceState(
        window.history.state,
        '',
        newUrl.toString().replace(newUrl.origin, ''),
      );
    }

    const feedGrid = document.getElementById('feed-grid');
    const gridWrapper = document.getElementById('feed-grid-wrapper');
    const template = document.getElementById('full-dataset-cards') as HTMLTemplateElement;
    const loadMoreContainer = document.getElementById('load-more-container');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const categoryBtns = document.querySelectorAll('.cat-btn');
    const typeBtns = document.querySelectorAll('.type-btn');
    const openCategoriesBtn = document.getElementById('open-categories-btn');

    if (!feedGrid || !template) return;

    // Save initial static HTML if not saved yet so we can restore it on clear filter
    if (!feedGrid.dataset.originalHtml) {
      feedGrid.dataset.originalHtml = feedGrid.innerHTML;
    }

    let currentMatches: HTMLElement[] = [];
    let currentlyDisplayedCount = 0;
    let hasFiltered = false;
    const PAGE_SIZE = 12;

    /**
     * Append the next page of matching cards.
     *
     * @param moveFocus Move keyboard focus to the first newly added card.
     *   TRUE only when the reader pressed "Load More" — see the note at the
     *   focus call below for why this must not happen on an automatic render.
     */
    function renderMoreItems(moveFocus = false) {
      const fragment = document.createDocumentFragment();
      const nextBatch = currentMatches.slice(currentlyDisplayedCount, currentlyDisplayedCount + PAGE_SIZE);
      const newlyAddedNodes: HTMLElement[] = [];
      
      nextBatch.forEach((originalNode, index) => {
        const node = originalNode.cloneNode(true) as HTMLElement;
        node.style.display = 'flex'; 
        // Force the reveal animation state so the observer isn't needed
        node.setAttribute('data-state', 'in');
        node.style.opacity = '1';
        node.style.transform = 'none';
        
        // Re-calculate animation delays based on index in current batch
        node.style.transitionDelay = (index * 100) + 'ms';
        node.setAttribute('data-delay', (index * 100).toString());
        
        // Clear the delay after the entrance animation finishes
        setTimeout(() => {
          if (node) node.style.transitionDelay = '';
        }, (index * 100) + 600);
        
        fragment.appendChild(node);
        newlyAddedNodes.push(node);
      });

      feedGrid?.appendChild(fragment);
      currentlyDisplayedCount += nextBatch.length;

      if (loadMoreContainer) {
        if (currentlyDisplayedCount < currentMatches.length) {
          loadMoreContainer.style.display = 'block';
        } else {
          loadMoreContainer.style.display = 'none';
        }
      }

      /*
        Accessibility: after "Load More", move focus to the first new card so
        a keyboard or screen-reader user lands on the content they just asked
        for instead of being left on a button that may have disappeared.

        ─── WHY THIS IS GUARDED ────────────────────────────────────────────
        It used to run on EVERY render, including the automatic one that fires
        on page load when the URL carries a category hash. Nobody had asked for
        focus to move, but the browser still treats a programmatic focus that
        soon after load as keyboard-driven, so `:focus-visible` matched and the
        card painted the global 3px white focus ring (styles/modules/a11y.css).

        That is the "rogue white border box on the top tile" seen on
        /feed/articles#film. It only appeared under the Articles toggle because
        article cards ARE `<a>` elements, so `matches('a, button')` found one to
        focus; video cards are `<div>` wrappers that open the modal, nothing
        focusable was found, and no ring was drawn. Same code, different markup
        — which is exactly why it looked like a state bug.

        `preventScroll` because a filtered render can place that card anywhere;
        focusing it would otherwise scroll the reader away from the filter row
        they just used.
      */
      if (moveFocus && newlyAddedNodes.length > 0) {
        const firstNewCard = newlyAddedNodes[0];
        const focusable = firstNewCard.matches('a, button')
          ? firstNewCard
          : firstNewCard.querySelector('a, button');
        if (focusable) (focusable as HTMLElement).focus({ preventScroll: true });
      }
    }

    function applyFilters() {
      const hash = window.location.hash.replace('#', '').toLowerCase();

      // Maintain hash on Type filter buttons
      typeBtns.forEach(btn => {
        if (!btn.hasAttribute('data-base-href')) {
          btn.setAttribute('data-base-href', btn.getAttribute('href') || '');
        }
        const baseHref = btn.getAttribute('data-base-href');
        const search = window.location.search;
        if (hash) {
          btn.setAttribute('href', `${baseHref}${search}#${hash}`);
        } else {
          btn.setAttribute('href', `${baseHref || ''}${search}`);
        }
      });

      // Update Category Buttons Active State
      categoryBtns.forEach((btn) => {
        const btnCategory = btn.getAttribute('data-category');
        if (hash && btnCategory === hash) {
          btn.classList.add('active');
          btn.setAttribute('aria-current', 'true');
        } else {
          btn.classList.remove('active');
          btn.removeAttribute('aria-current');
        }
      });

      // Update Mobile button state
      if (openCategoriesBtn) {
        if (hash) {
          const activeBtn = Array.from(categoryBtns).find(btn => btn.getAttribute('data-category') === hash);
          if (activeBtn) {
            openCategoriesBtn.textContent = `Categories | ${activeBtn.textContent?.trim()}`;
            openCategoriesBtn.classList.add('active');
          }
        } else {
          openCategoriesBtn.textContent = 'Categories';
          openCategoriesBtn.classList.remove('active');
        }
      }

      if (!hash) {
        // If we haven't filtered yet, the DOM is perfectly intact from Astro.
        if (!hasFiltered) return;

        // Reset State
        if (feedGrid) {
          feedGrid.innerHTML = feedGrid.dataset.originalHtml || '';
          // Ensure restored cards become visible since the original observer is gone
          const restoredCards = feedGrid.querySelectorAll('.reveal');
          restoredCards.forEach((node: any, index: number) => {
            node.setAttribute('data-state', 'in');
            node.style.opacity = '1';
            node.style.transform = 'none';
            node.style.transitionDelay = (index * 50) + 'ms';
            
            setTimeout(() => {
              if (node) node.style.transitionDelay = '';
            }, (index * 50) + 600);
          });

          // Accessibility: Move focus to the restored grid wrapper after "Clear Filters"
          const wrapper = document.getElementById('feed-grid-wrapper');
          if (wrapper) {
            wrapper.tabIndex = -1;
            wrapper.focus({ preventScroll: true });
            wrapper.style.outline = 'none'; // Prevent visual outline on programmatic focus
          }
        }
        /* Back to the browse view: rows in, results grid out. */
        gridWrapper?.classList.remove('is-filtered');
        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
        return;
      }

      hasFiltered = true;

      /* A filter is on: the flat results grid replaces the rows. */
      gridWrapper?.classList.add('is-filtered');

      // Filter elements from the full dataset template
      const allCards = template.content.querySelectorAll('.content-card');
      currentMatches = [];
      currentlyDisplayedCount = 0;

      allCards.forEach(card => {
        const categoriesAttr = card.getAttribute('data-categories') || '';
        const categories = categoriesAttr.split(',');
        if (categories.includes(hash)) {
          currentMatches.push(card as HTMLElement);
        }
      });

      // Clear current grid
      if (feedGrid) {
        feedGrid.innerHTML = '';
        if (currentMatches.length === 0) {
          const emptyTemplate = document.getElementById('feed-empty-state') as HTMLTemplateElement;
          if (emptyTemplate) {
            const clone = emptyTemplate.content.cloneNode(true);
            const clearBtn = (clone as DocumentFragment).querySelector('.clear-filters-btn');
            
            if (clearBtn) {
              clearBtn.addEventListener('click', () => {
                // Explicitly wipe the hash
                history.pushState(null, '', window.location.pathname);
                
                // Explicitly loop through all QuadrantFilter buttons and strip the .active class
                categoryBtns.forEach(btn => {
                  btn.classList.remove('active');
                  btn.removeAttribute('aria-current');
                });
                
                // Trigger the filter reset
                applyFilters();
              });
            }
            
            feedGrid.appendChild(clone);
          }
          if (loadMoreContainer) loadMoreContainer.style.display = 'none';
        } else {
          renderMoreItems();
        }
      }
    }

    if (loadMoreBtn && !loadMoreBtn.dataset.bound) {
      /* Wrapped, NOT passed directly: addEventListener would hand the
         MouseEvent to the first parameter, and any event object is truthy —
         so `renderMoreItems` would think every automatic render was a click. */
      loadMoreBtn.addEventListener('click', () => renderMoreItems(true));
      loadMoreBtn.dataset.bound = 'true';
    }

    // Attach click listeners to category buttons for smooth hash updates without scrolling
    categoryBtns.forEach((btn) => {
      if (!(btn as any).dataset.feedBound) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const category = btn.getAttribute('data-category');
          
          if (!category) return;
          
          // Explicitly strip active class from ALL siblings (UI Exclusivity enforcement)
          categoryBtns.forEach(sibling => {
            if (sibling !== btn) {
              sibling.classList.remove('active');
              sibling.removeAttribute('aria-current');
            }
          });

          const currentHash = window.location.hash.replace('#', '').toLowerCase();
          
          if (currentHash === category) {
            history.pushState(null, '', window.location.pathname + window.location.search); // Toggle off
          } else {
            history.pushState(null, '', `${window.location.pathname}${window.location.search}#${category}`); // Toggle on
          }
          applyFilters();
        });
        (btn as any).dataset.feedBound = 'true';
      }
    });

    (window as any)._feedHashChangeListener = applyFilters;
    window.addEventListener('hashchange', applyFilters);
    
    // Initial execution on load
    applyFilters();
    document.documentElement.classList.remove('js-feed-filtering');
  }

  /*
    THE ROW CHEVRONS.

    Bound per rail, and re-bound on every `astro:page-load` because ClientRouter
    swaps the document without reloading this module. Nothing is stored on
    `window` here (unlike the delegated handlers below) because these listeners
    live on elements that are themselves replaced by the swap, so they go with
    the nodes they were attached to.

    `scrollBy` gets 90% of the rail's visible width rather than a fixed pixel
    count, so one press advances by roughly one screenful of cards at any
    breakpoint, and the snap points do the final alignment.
  */
  function initFeedRows() {
    document.querySelectorAll<HTMLElement>('.feed-row').forEach((row) => {
      const rail = row.querySelector<HTMLElement>('[data-rail]');
      if (!rail) return;

      const chevrons = Array.from(row.querySelectorAll<HTMLButtonElement>('.feed-row-chevron'));

      /* A rail that fits its content has nothing to scroll, so both chevrons
         are disabled rather than left live and inert-feeling. 1px of slack
         absorbs sub-pixel layout rounding, which otherwise leaves the right
         chevron permanently enabled on an exactly-fitting row. */
      const sync = () => {
        const max = rail.scrollWidth - rail.clientWidth;
        chevrons.forEach((btn) => {
          const dir = Number(btn.dataset.dir);
          const atEnd = dir < 0 ? rail.scrollLeft <= 1 : rail.scrollLeft >= max - 1;
          btn.setAttribute('data-disabled', String(max <= 1 || atEnd));
        });
      };

      chevrons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = Number(btn.dataset.dir) || 1;
          rail.scrollBy({ left: dir * rail.clientWidth * 0.9, behavior: 'smooth' });
        });
      });

      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  }

  document.addEventListener('astro:page-load', () => {
    initFeedClientFiltering();
    initFeedRows();
    
    // Lifecycle-protected Spotlight Swap Event Delegation
    if ((window as any)._spotlightSwapListener) {
      document.removeEventListener('click', (window as any)._spotlightSwapListener);
    }

    /*
      ─── CARRY ASTRO'S STYLE SCOPE ONTO ANYTHING BUILT AT RUNTIME ──────────

      FeedSpotlightHero's <style> is SCOPED. Astro compiles every selector in
      it to `.hero-meta-tag[data-astro-cid-7clh4sw7]` and stamps that attribute
      on each element in the template AT BUILD TIME.

      An element created here has no such attribute, so not one of those rules
      matches it. The hero did not "lose its CSS" on swap — the new nodes were
      never in scope to begin with: chips rendered as bare text with 0 padding
      and no border, and "Read article" lost its rectangle entirely. Confirmed
      by reading the attribute list before and after a swap.

      Copying it from a node that still has one keeps the hash out of this file
      (it changes whenever the component's styles change, and a hardcoded copy
      would rot silently). Applied to descendants too, since the glyph and the
      label are styled by scoped rules of their own.
    */
    const carryScope = (source: Element | null, target: Element) => {
      if (!source) return;
      for (const name of source.getAttributeNames()) {
        if (!name.startsWith('data-astro-cid-')) continue;
        const value = source.getAttribute(name) ?? '';
        target.setAttribute(name, value);
        target.querySelectorAll('*').forEach((child) => child.setAttribute(name, value));
      }
    };

    const swapHandler = (e: MouseEvent) => {
      const card = (e.target as Element).closest('[data-action^="spotlight-"]') as HTMLElement;
      if (!card) return;

      e.preventDefault();
      
      const action = card.getAttribute('data-action');
      const isVideo = action === 'spotlight-video';
      
      const heroBg = document.getElementById('hero-bg') as HTMLImageElement | HTMLDivElement;
      const heroTitle = document.getElementById('hero-title');
      const heroDesc = document.getElementById('hero-description');
      const heroBrandLogo = document.getElementById('hero-brand-logo') as HTMLImageElement;
      const heroIframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
      const heroImage = document.getElementById('hero-image') as HTMLImageElement;
      const heroImageFront = document.getElementById('hero-image-front') as HTMLImageElement;

      if (!heroTitle) return; // Not on a page with the Spotlight Hero

      const title = card.getAttribute('data-title') || '';
      const preview = card.getAttribute('data-preview') || '';
      const image = card.getAttribute('data-image') || '';
      const videoId = card.getAttribute('data-video-id');
      let parsedBrand: { logo?: string, hero?: string, slug?: string, color?: string } = {};
      try {
        const brandStr = card.getAttribute('data-brand');
        if (brandStr) {
          parsedBrand = JSON.parse(brandStr);
        }
      } catch(e) {}
      
      const brandLogo = parsedBrand.logo || '';
      const brandHero = parsedBrand.hero || '';
      /*
        `data-href` FIRST. A feed card is a <div role="button"> — ContentCard
        drops the anchor in this context precisely so the card can swap the
        hero instead of navigating — so `card.querySelector('a')` was null on
        every card and this fell through to '#' every time. The "Read article"
        CTA has been a link to nowhere for as long as it has existed; it only
        looked fine because clicking it reloaded the same page.

        The anchor lookup is kept as the fallback for any caller that does
        render one inside the card.
      */
      const link = card.getAttribute('data-href')
        || card.querySelector('a')?.getAttribute('href')
        || '#';

      const performDOMUpdate = () => {
        // Update Text Content
        heroTitle.textContent = title;

      /*
        THE EYEBROW TAKES THE CARD'S OWN TAGS.

        It used to overwrite a single chip with the word VIDEO or ARTICLE,
        which is why the hero said less about an item than the card that
        promoted it. `data-tags` is the string ContentCard already rendered
        ("DC | REVIEW"), so the two cannot disagree.

        Chips are rebuilt rather than edited: an item can have one tag or
        three, so there is no fixed set of spans to keep in step. textContent
        per chip, never innerHTML on the tag text — these strings come from
        feed data.
      */
      const heroMetaRow = document.getElementById('hero-meta-tags');
      const kind = isVideo ? 'VIDEO' : 'ARTICLE';
      const cardTags = (card.getAttribute('data-tags') || '')
        .split('|')
        .map((t) => t.trim())
        .filter(Boolean);
      if (heroMetaRow) {
        heroMetaRow.textContent = '';
        let isFirst = true;
        for (const tag of (cardTags.length > 0 ? cardTags : [kind])) {
          const chip = document.createElement('span');
          chip.className = `hero-meta-tag${isFirst ? ' hero-meta-tag--type' : ''}`;
          chip.textContent = tag;
          carryScope(heroMetaRow, chip);
          heroMetaRow.appendChild(chip);
          isFirst = false;
        }
      }
      if (heroDesc) {
        heroDesc.textContent = preview;
        if (isVideo) {
          heroDesc.classList.remove('line-clamp-3');
          heroDesc.classList.add('line-clamp-2');
        } else {
          heroDesc.classList.remove('line-clamp-2');
          heroDesc.classList.add('line-clamp-3');
        }
      }

      const youtubeBtn = document.querySelector('.feed-hero-youtube-btn') as HTMLElement;
      if (youtubeBtn) {
        youtubeBtn.style.display = isVideo ? 'inline-flex' : 'none';
      }

      const brandColor = parsedBrand.color || '#CC0000';
      function hexToRgbTriple(hex: string) {
        if (!hex) return '204, 0, 0';
        const clean = hex.replace('#', '');
        if (clean.length !== 6) return '204, 0, 0';
        const r = parseInt(clean.substring(0, 2), 16);
        const g = parseInt(clean.substring(2, 4), 16);
        const b = parseInt(clean.substring(4, 6), 16);
        return `${r}, ${g}, ${b}`;
      }
      
      const heroSection = heroTitle.closest('.event-hero') as HTMLElement;
      if (heroSection) {
        heroSection.style.setProperty('--brand-color', brandColor);
        heroSection.style.setProperty('--brand-rgb', hexToRgbTriple(brandColor));
      }

      // Update Brand Logo
      if (heroBrandLogo) {
        const fallbackLogo = heroBrandLogo.getAttribute('data-fallback-logo') || '';
        heroBrandLogo.src = brandLogo || fallbackLogo;
        heroBrandLogo.classList.remove('hidden');
      }

      /*
        No CTA to rebuild. The copy column's Play/Read button was removed (see
        the note in FeedSpotlightHero): the stage pane below carries the action
        for whatever item is loaded, so there is only one control to keep in
        step with a swap instead of two.
      */

      // Reset iframe state
      if (heroIframe) {
        heroIframe.src = 'about:blank';
        heroIframe.style.opacity = '0';
        heroIframe.style.pointerEvents = 'none';
        heroIframe.removeAttribute('data-pending-video');
        const hubStage = document.querySelector('.hub-stage');
        if (hubStage) hubStage.classList.remove('is-playing');
      }

      const backgroundSrc = brandHero || image;
      if (heroImage && image) { heroImage.src = image; heroImage.style.opacity = '1'; }
      if (heroImageFront && image) { heroImageFront.src = image; heroImageFront.style.opacity = '1'; }

      /*
        THE STAGE PANE FOLLOWS THE SWAP.

        The pane is what the stage shows before anything plays — still, kind,
        title, Play. Left un-updated it would keep naming the PREVIOUS item
        over the new item's artwork, which is worse than showing nothing:
        the two halves of the hero would contradict each other.

        `is-item` goes back on because the previous item may have been played,
        and play() takes it off (see the play handler below).
      */
      const stageItemStill = document.getElementById('hero-stage-item-still') as HTMLImageElement | null;
      const stageItemKind = document.getElementById('hero-stage-item-kind');
      const stageItemTitle = document.getElementById('hero-stage-item-title');
      const stageItemAction = document.getElementById('hero-stage-item-action');
      if (stageItemStill && image) stageItemStill.src = image;
      if (stageItemKind) stageItemKind.textContent = kind;
      if (stageItemTitle) stageItemTitle.textContent = title;
      /*
        THE PANE'S CONTROL CHANGES ELEMENT, NOT JUST ITS LABEL.

        Relabelling it "Read" leaves a <button data-action="play-trailer">
        behind the word: the play handler finds no pending video on an article
        and returns, so the control reads as a dead button. An article needs a
        real <a href>, so the element is rebuilt rather than retitled. Built
        with the DOM API and `textContent`, so a title carrying an apostrophe
        or an angle bracket cannot break out of the markup.
      */
      if (stageItemAction) {
        const nextAction = document.createElement(isVideo ? 'button' : 'a');
        nextAction.id = 'hero-stage-item-action';
        nextAction.className = 'hub-stage-item-action';
        nextAction.textContent = isVideo ? 'Play' : 'Read';
        if (isVideo) {
          (nextAction as HTMLButtonElement).type = 'button';
          nextAction.setAttribute('data-action', 'play-trailer');
        } else {
          (nextAction as HTMLAnchorElement).href = link;
        }
        carryScope(stageItemAction, nextAction);
        stageItemAction.replaceWith(nextAction);
      }
      const stageEl = document.querySelector('.hub-stage');
      if (stageEl) stageEl.classList.add('is-item');
      
      const heroGridContainer = document.querySelector('.hero-grid-container');
      if (isVideo && videoId) {
        // Step 1: Prep the video state but do not play yet!
        if (heroGridContainer) heroGridContainer.classList.add('has-trailer');
        
        if (heroIframe) {
          heroIframe.setAttribute('data-pending-video', videoId);
        }
              } else {
        // Article Mode
        // if (heroGridContainer) heroGridContainer.classList.remove('has-trailer');
                      }


      // Update background image
      if (heroBg && heroBg.tagName === 'IMG' && backgroundSrc) {
        (heroBg as HTMLImageElement).src = backgroundSrc;
        (heroBg as HTMLImageElement).srcset = '';
      } else if (heroBg && heroBg.tagName === 'DIV' && backgroundSrc) {
        (heroBg as HTMLDivElement).style.backgroundImage = `url('${backgroundSrc}')`;
      }
      };

      /*
        ─── THIS SWAP NO LONGER SUPPRESSES THE PAGE'S VIEW TRANSITIONS ────────

        What stood here stripped `data-astro-transition-scope` off EVERY element
        in the document and set `documentElement.style.viewTransitionName =
        'none'` for the duration of the swap, restoring both afterwards.

        That is what made the navbar blink. The navbar is a persistent,
        transition-scoped element; pulling its scope attribute out from under it
        and blanking the root transition name takes it out of the old snapshot
        and puts it back into the new one, so it disappears and re-enters on a
        swap that never involved it. The fix is not to restore it faster, it is
        not to touch it: nothing outside this wrapper is any of this handler's
        business.

        The crossfade is KEPT. Naming the wrapper is not suppression — it scopes
        the animation to the element actually changing, which is what the global
        blanking was a blunt substitute for. Everything else on the page,
        navbar included, is simply left alone.
      */
      const feedGridWrapper = document.getElementById('feed-grid-wrapper');
      const isMobile = window.innerWidth < 768;

      if (!isMobile && (document as any).startViewTransition) {
        if (feedGridWrapper) feedGridWrapper.style.viewTransitionName = 'feed-grid-manual';

        const transition = (document as any).startViewTransition(() => {
          performDOMUpdate();
        });

        transition.finished.finally(() => {
          if (feedGridWrapper) feedGridWrapper.style.viewTransitionName = '';
        });
      } else {
        performDOMUpdate();
      }

      // Smooth scroll to top so the user sees the hero
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    (window as any)._spotlightSwapListener = swapHandler;
    document.addEventListener('click', swapHandler);

    // Step 2: The Play Action
    if ((window as any)._spotlightPlayListener) {
      document.removeEventListener('click', (window as any)._spotlightPlayListener);
    }

        const playHandler = (e: MouseEvent) => {
      const target = e.target as HTMLElement;

      /*
        The stage pane's own control is the only thing that starts this hero.
        Still delegated from the document rather than bound to the element: the
        pane's action is REPLACED on every swap (button for a video, anchor for
        an article), so a listener bound directly to it would be thrown away
        with the node it was attached to.
      */
      const isHeroCta = target.closest('#hero-stage-item-action');
      if (!isHeroCta) return;

      const isCtaVideo = isHeroCta.tagName.toLowerCase() === 'button';

      const heroIframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
      
      if (!heroIframe) return;
      
      const videoId = heroIframe.getAttribute('data-pending-video');
      
      if (isCtaVideo && videoId) {
        e.preventDefault();
        heroIframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&enablejsapi=1`;
        /* The iframe starts transparent so its about:blank document cannot
           flash above the stage still. Making only its parent visible leaves
           that transparent iframe over the dimmed art, which looks like the
           video never appeared. */
        heroIframe.style.opacity = '1';
        heroIframe.style.pointerEvents = 'auto';
        
        const hubStage = document.querySelector('.hub-stage');
        if (hubStage) {
            /*
              `is-item` HAS TO COME OFF. It takes .hub-stage-video to opacity 0,
              so leaving it on starts the video behind an invisible frame — the
              audio plays and the picture never arrives. /featured hit exactly
              this and removes the class at the same point.
            */
            hubStage.classList.remove('is-item');
            hubStage.classList.add('is-playing');
        } else {
            heroIframe.style.opacity = '1'; // Fallback
        }
      }
    };
    
    (window as any)._spotlightPlayListener = playHandler;
    document.addEventListener('click', playHandler);
  });
</script>
