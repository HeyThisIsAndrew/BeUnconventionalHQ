---
import Layout from '../layouts/Layout.astro';
import HeroTrailer from './HeroTrailer.astro';
import InstagramFeed from './InstagramFeed.astro';
import SubscribeCTA from './SubscribeCTA.astro';
import EventStatusIndicator from './EventStatusIndicator.astro';
import ContentCard from './ContentCard.astro';
import MiniCalendarSidebar from './MiniCalendarSidebar.astro';
import { getHubTopicKeywords } from '../lib/instagram-topic';
import { parseVideoId } from '../lib/platforms/youtube';
import { formatEventDateRange, formatLocation } from '../lib/events';
import { urlFor } from '../lib/local-content';

const { event, unifiedContent } = Astro.props;

const brandColor = (typeof event.brandColor === 'string' ? event.brandColor : event.brandColor?.hex) || '#CC0000';

function hexToRgbTriple(hex: string): string {
  const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
  if (!m) return '204, 0, 0';
  const int = parseInt(m[1], 16);
  return `${(int >> 16) & 255}, ${(int >> 8) & 255}, ${int & 255}`;
}
const brandRgb = hexToRgbTriple(brandColor);

const HERO_WIDTHS = [600, 900, 1200, 2400];
const heroAt = (w: number) => event.heroImage ? urlFor(event.heroImage).width(w).auto('format').url() : '';
const heroBackdropMobileUrl = heroAt(800);
const heroBackdropSrcset = event.heroImage ? HERO_WIDTHS.map((w) => `${heroAt(w)} ${w}w`).join(', ') : '';
const heroBackdropSizes = '100vw';
const heroBackdrop = event.heroImage;

const fallbackGradient = `linear-gradient(135deg, rgba(${brandRgb}, 0.28) 0%, #0a0a0a 62%, #111 100%)`;

const trailerUrl = event.trailerUrl;
const trailerId = parseVideoId(trailerUrl);

const stageGhostUrl = event.logo ? urlFor(event.logo).height(300).auto('format').url() : null;
---

<Layout
  title={event.title}
  description={`Coverage of ${event.title}`}
  preloadImage={heroBackdropMobileUrl || undefined}
  preloadImageSrcset={heroBackdropSrcset || undefined}
  preloadImageSizes={event.heroImage ? heroBackdropSizes : undefined}
>
  <main class="event-dashboard" style={`--brand-color: ${brandColor}; --brand-rgb: ${brandRgb};`} data-trailer={trailerId}>
    
    {/* 1. TOP HALF: Featured Hub Hero Layout (e.g. DC Page) */}
    <section class="event-hero">
      <div class="event-hero-bg-wrapper">
        {heroBackdrop ? (
          <img
            src={heroBackdropMobileUrl}
            srcset={heroBackdropSrcset}
            sizes={heroBackdropSizes}
            alt=""
            class="event-hero-bg-animated hero-backdrop-plate"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="event-hero-bg-animated" style={`background-image: ${fallbackGradient};`}></div>
        )}
      </div>

      {stageGhostUrl && (
        <div class="hub-stage-bg" aria-hidden="true">
          <div class="hub-stage-plate" style={`background-image: url('${stageGhostUrl}');`}></div>
        </div>
      )}
      <div class="hub-stage-wash" aria-hidden="true"></div>

      <div class="event-hero-overlay flex flex-col justify-center">
        <div
          class:list={[
            'container',
            'hero-grid-container',
            'lg:!px-20',
            'xl:!px-24',
            '2xl:!max-w-[1920px]',
            '2xl:!grid-cols-[1fr_1.2fr]',
            '3xl:!max-w-[2400px]',
            '3xl:!grid-cols-[1fr_1.4fr]',
            { 'has-trailer': !!trailerId, 'has-cta': !!event.signUpLink },
          ]}
        >
          <div class="event-hero-content hero-copy animate-on-scroll">
            <span class="hero-eyebrow">Event</span>

            <div class="hero-identity">
              {event.logo ? (
                <>
                  <h1 class="sr-only">{event.title}</h1>
                  <span class="hero-logo-wrap" aria-hidden="true">
                    <img src={urlFor(event.logo).height(320).auto('format').url()} alt="" class="hero-logo" />
                  </span>
                </>
              ) : (
                <h1 class="hero-title">{event.title}</h1>
              )}

              {event.description && (
                <div class="hero-description-wrapper mt-4">
                  <p class="hero-description-text" id="event-about-text">{event.description}</p>
                </div>
              )}

              <div class="mt-6 flex flex-col gap-2">
                <div class="hero-status"><EventStatusIndicator event={event} /></div>
                <p class="hero-meta text-gray-200">
                  <span class="event-dates">{formatEventDateRange(event.startDate, event.endDate)}</span>
                  {formatLocation(event.location) && (
                    <span class="event-location">
                      <span class="mx-2 text-gray-500">•</span>
                      {formatLocation(event.location)}
                    </span>
                  )}
                </p>
              </div>
            </div>
          </div>
          
          <div class="hub-stage">
            {trailerId ? (
              <div class="aspect-video w-full bg-black rounded-lg overflow-hidden shadow-2xl relative z-10 border border-white/10">
                <HeroTrailer trailerId={trailerId} title={event.title} />
              </div>
            ) : (
              event.logo && (
                <div class="aspect-video flex items-center justify-center p-8">
                  <img src={urlFor(event.logo).height(400).auto('format').url()} alt="" class="max-w-full max-h-full object-contain drop-shadow-2xl opacity-80 mix-blend-screen" />
                </div>
              )
            )}
          </div>
          
          {(event.officialWebsite || event.signUpLink) && (
            <div class="hero-info-cta">
              <a href={event.officialWebsite || event.signUpLink} target="_blank" rel="noopener noreferrer" class="hero-rsvp-btn focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">
                Sign Up / Tickets
              </a>
            </div>
          )}

        </div>
      </div>
    </section>

    {/* 2. BOTTOM HALF: Article Layout View */}
    <div class="container py-16">
      <div class="article-layout">
        
        {/* LEFT RAIL: Navigation */}
        <aside class="article-rail article-rail-left">
          <nav aria-label="Event Navigation">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 border-l-2 border-red-500 pl-3">On this page</h3>
            <ul class="flex flex-col gap-3 text-sm font-bold uppercase tracking-wider pl-3">
              <li><a href="#event-description" class="text-gray-400 hover:text-white transition-colors">About</a></li>
              {trailerId && <li><a href="#event-trailer" class="text-gray-400 hover:text-white transition-colors">Trailer</a></li>}
              {unifiedContent.length > 0 && <li><a href="#event-coverage" class="text-gray-400 hover:text-white transition-colors">Coverage</a></li>}
            </ul>
          </nav>
        </aside>

        {/* CENTER COLUMN: Event Content */}
        <article class="article-column">
          
          {/* Coverage Grid */}
          {unifiedContent.length > 0 && (
            <div id="event-coverage" class="mt-8 scroll-mt-32">
              
              <div class="flex items-center justify-between mb-8 border-b border-gray-800 pb-4">
                <h2 class="text-2xl font-bold font-display uppercase tracking-tight text-white">Coverage</h2>
                
                <div class="filter-controls animate-on-scroll">
                  <button class="filter-btn type-btn active" data-filter="all" aria-pressed="true">ALL</button>
                  <button class="filter-btn type-btn" data-filter="article" aria-pressed="false">ARTICLES</button>
                  <button class="filter-btn type-btn" data-filter="video" aria-pressed="false">VIDEOS</button>
                </div>
              </div>
              <div class="card-grid">
                {unifiedContent.map((item: any, index: number) => (
                  <ContentCard item={item} index={index} />
                ))}
              </div>
            </div>
          )}

        </article>

        {/* RIGHT RAIL: Widgets */}
        <aside class="article-rail article-rail-right">
          <div class="flex flex-col gap-10 sticky top-32">
            
            {/* Calendar */}
            <div class="calendar-widget">
              <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 border-b border-gray-800 pb-2">Upcoming Events</h3>
              <MiniCalendarSidebar events={Astro.props.allEvents?.filter((e: any) => e.startDate >= new Date().toISOString().split('T')[0]) || []} />
            </div>

            {/* Coverage Inquiry */}
            <div class="coverage-inquiry">
              <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 border-b border-gray-800 pb-2">Coverage Inquiry</h3>
              <p class="text-gray-400 text-sm mb-4 leading-relaxed">
                BE Unconventional HQ provides premium editorial coverage for events, including live photography, video interviews, and written features.
              </p>
              <a href="mailto:press@beunconventionalhq.com?subject=Press%20Inquiry" class="text-white text-xs font-bold uppercase tracking-wider hover:text-red-400 transition-colors border-b border-transparent hover:border-red-400 pb-1">
                Request Press Kit &rarr;
              </a>
            </div>

          </div>
        </aside>

      </div>
    </div>
    
    <InstagramFeed topicKeywords={getHubTopicKeywords(event)} />
    <SubscribeCTA />

  </main>

<script>
  function initEventFilters() {
    const filterBtns = Array.from(document.querySelectorAll('.filter-btn'));
    if (!filterBtns.length) return;

    filterBtns.forEach((btn) => { btn.setAttribute("data-bound", "true");
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        let activeFilter = 'all';
        if (btn.classList.contains('type-btn')) {
          activeFilter = btn.getAttribute('data-filter') || '';
        }

        const cards = document.querySelectorAll('.content-card');
        cards.forEach((card) => {
          const show = activeFilter === 'all' || card.getAttribute('data-type') === activeFilter;
          (card as HTMLElement).style.display = show ? 'block' : 'none';
        });
      });
    });
  }

  initEventFilters();
  document.addEventListener('astro:page-load', initEventFilters);
</script>
</Layout>

<style>
${featuredStyle}

  /* Specific Event Overrides */
  .hero-meta {
    font-size: clamp(0.85rem, 0.8rem + 0.4vw, 1.1rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .hero-rsvp-btn {
    display: inline-block;
    background: var(--color-accent, #cc0000);
    color: white;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: background 0.3s ease;
  }
  .hero-rsvp-btn:hover {
    background: #a00000;
  }

  /* Grid for Coverage Cards */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }
  
  /* Article Layout additions to ensure mobile stacks correctly */
  @media (max-width: 1200px) {
    .article-rail {
      display: block !important;
      position: static !important;
    }
    .article-layout {
      grid-template-areas: 
        "toc"
        "column"
        "support";
      grid-template-columns: 1fr;
    }
  }
</style>
