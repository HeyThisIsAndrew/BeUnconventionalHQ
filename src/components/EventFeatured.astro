---
import Layout from '../layouts/Layout.astro';
import HeroTrailer from './HeroTrailer.astro';
import InstagramFeed from './InstagramFeed.astro';
import SubscribeCTA from './SubscribeCTA.astro';
import EventStatusIndicator from './EventStatusIndicator.astro';
import ContentCard from './ContentCard.astro';
import MiniCalendarSidebar from './MiniCalendarSidebar.astro';
import { getHubTopicKeywords } from '../lib/instagram-topic';
import { parseVideoId } from '../lib/platforms/youtube';
import { formatEventDateRange, formatLocation } from '../lib/events';
import { urlFor } from '../lib/local-content';

const { event, unifiedContent } = Astro.props;

const HERO_WIDTHS = [800, 1200, 2400];
const heroAt = (w: number) => event.heroImage ? urlFor(event.heroImage).width(w).auto('format').url() : '';
const heroMobileUrl = heroAt(800);
const heroSrcset = event.heroImage ? HERO_WIDTHS.map((w) => `${heroAt(w)} ${w}w`).join(', ') : '';
const heroSizes = '100vw';

const trailerUrl = event.trailerUrl;
const trailerId = parseVideoId(trailerUrl);
---

<Layout
  title={event.title}
  description={`Coverage of ${event.title}`}
  preloadImage={heroMobileUrl || undefined}
  preloadImageSrcset={heroSrcset || undefined}
  preloadImageSizes={event.heroImage ? heroSizes : undefined}
>
  <main class="event-page-wrapper">
    
    {/* Minimal Hero Header (just the image as a 30vh banner) */}
    {event.heroImage && (
      <section class="event-banner">
        <img
          src={heroMobileUrl}
          srcset={heroSrcset}
          sizes={heroSizes}
          alt=""
          class="event-banner-img"
          loading="eager"
          fetchpriority="high"
        />
        <div class="event-banner-overlay"></div>
      </section>
    )}

    <div class="container-page py-12 lg:py-20">
      
      {/* 3-Column Article Layout */}
      <div class="event-article-layout">
        
        {/* LEFT RAIL: Navigation & Event Details */}
        <aside class="event-rail event-rail-left">
          <div class="sticky top-32 flex flex-col gap-12">
            
            <nav aria-label="Event Navigation" class="event-nav hidden lg:block">
              <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">On this page</h3>
              <ul class="flex flex-col gap-3 text-sm font-bold uppercase tracking-wider">
                <li><a href="#event-description" class="text-white hover:text-red-400 transition-colors">About</a></li>
                {trailerId && <li><a href="#event-trailer" class="text-white hover:text-red-400 transition-colors">Trailer</a></li>}
                {unifiedContent.length > 0 && <li><a href="#event-coverage" class="text-white hover:text-red-400 transition-colors">Coverage</a></li>}
              </ul>
            </nav>

            <div class="event-details-box bg-[#111] border border-gray-800 p-6 rounded-lg">
              <div class="hero-status mb-4"><EventStatusIndicator event={event} /></div>
              
              <div class="text-gray-300 text-sm mb-6 space-y-3">
                <div>
                  <span class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Date</span>
                  <span class="font-medium text-white">{formatEventDateRange(event.startDate, event.endDate)}</span>
                </div>
                {formatLocation(event.location) && (
                  <div>
                    <span class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Location</span>
                    <span class="font-medium text-white">{formatLocation(event.location)}</span>
                  </div>
                )}
              </div>
              
              {(event.officialWebsite || event.signUpLink) && (
                <div class="pt-4 border-t border-gray-800">
                  <a href={event.officialWebsite || event.signUpLink} target="_blank" rel="noopener noreferrer" class="hero-rsvp-btn w-full text-center">
                    Sign Up / Tickets
                  </a>
                </div>
              )}
            </div>

          </div>
        </aside>

        {/* CENTER COLUMN: Content */}
        <article class="event-column">
          
          <header class="mb-10 text-center lg:text-left">
            {event.logo && <h1 class="sr-only">{event.title}</h1>}
            {event.logo ? (
              <img
                src={urlFor(event.logo).height(240).url()}
                alt={`${event.title} logo`}
                class="hero-logo mx-auto lg:mx-0"
                height="240"
              />
            ) : (
              <h1 class="hero-title">{event.title}</h1>
            )}
          </header>

          {event.description && (
            <div id="event-description" class="article-body scroll-mt-32">
              <p>{event.description}</p>
            </div>
          )}

          {trailerId && (
            <div id="event-trailer" class="mt-12 scroll-mt-32">
              <div class="hero-trailer aspect-video w-full bg-black rounded-lg overflow-hidden border border-gray-800">
                <HeroTrailer trailerId={trailerId} title={event.title} />
              </div>
            </div>
          )}

          {unifiedContent.length > 0 && (
            <div id="event-coverage" class="mt-20 scroll-mt-32">
              <h2 class="text-3xl font-display font-bold uppercase tracking-wide text-white border-b border-gray-800 pb-3 mb-8">Coverage</h2>
              <div class="card-grid">
                {unifiedContent.map((item: any, index: number) => (
                  <ContentCard item={item} index={index} />
                ))}
              </div>
            </div>
          )}

        </article>

        {/* RIGHT RAIL: Widgets */}
        <aside class="event-rail event-rail-right">
          <div class="sticky top-32 flex flex-col gap-8">
            
            {/* Coverage Inquiry */}
            <div class="coverage-inquiry bg-[#cc0000]/10 border border-[#cc0000]/30 p-6 rounded-lg">
              <h3 class="font-display font-bold text-lg uppercase tracking-wide text-white mb-3">Coverage Inquiry</h3>
              <p class="text-gray-300 text-xs mb-4 leading-relaxed">
                BE Unconventional HQ provides premium editorial coverage for events, including live photography, video interviews, and written features.
              </p>
              <a href="mailto:press@beunconventionalhq.com?subject=Press%20Inquiry" class="text-red-400 text-xs font-bold uppercase tracking-wider hover:text-white transition-colors border-b border-red-400 pb-1">
                Request Press Kit &rarr;
              </a>
            </div>

            <div class="calendar-widget">
              <MiniCalendarSidebar events={Astro.props.allEvents?.filter((e: any) => e.startDate >= new Date().toISOString().split('T')[0]) || []} />
            </div>

          </div>
        </aside>

      </div>
    </div>
    
    <InstagramFeed topicKeywords={getHubTopicKeywords(event)} />
    <SubscribeCTA />

  </main>
</Layout>

<style>
  .event-banner {
    position: relative;
    height: 35vh;
    min-height: 250px;
    background: #111;
    overflow: hidden;
  }
  .event-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .event-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0.3) 100%);
  }

  /* 3-Column Article Layout */
  .event-article-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .event-article-layout {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr) 18rem;
      grid-template-areas: "left center right";
      gap: 3rem;
      align-items: start;
    }
    
    .event-rail-left { grid-area: left; }
    .event-column { grid-area: center; }
    .event-rail-right { grid-area: right; }
  }

  /* Reorder on mobile: Logo/Title -> Event Details -> Content -> Widgets */
  @media (max-width: 1023px) {
    .event-column { order: 1; }
    .event-rail-left { order: 2; }
    .event-rail-right { order: 3; }
    
    /* Pull the header out of the column visually so it sits at the very top */
    .event-column {
      display: flex;
      flex-direction: column;
    }
    .event-column > header {
      order: -1;
      margin-bottom: 2rem;
    }
  }

  /* Typography */
  .hero-logo {
    max-height: clamp(84px, 46px + 12vw, 160px);
    max-width: min(100%, 420px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .hero-title {
    font-family: var(--font-display, 'Inter', sans-serif);
    font-size: clamp(2rem, calc(1.5rem + 3vw), 3.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
  }

  .hero-rsvp-btn {
    display: inline-block;
    background: var(--color-accent, #cc0000);
    color: white;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: background 0.3s ease;
  }
  .hero-rsvp-btn:hover {
    background: #a00000;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }
</style>
