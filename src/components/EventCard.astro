---
import { parseEventDate } from '../lib/events';
import { parseVideoId } from '../lib/platforms/youtube';
import { buildImageSet } from '../lib/local-content';

const { event, index = 0 } = Astro.props;
const trailerId = parseVideoId(event.trailerUrl);

const hero = buildImageSet(event.heroImage, { widths: [320, 480, 640, 800], aspect: 16 / 9 });
const logo = buildImageSet(event.logo, { widths: [96, 160, 240] });

const imageSrc =
  logo?.src ?? hero?.src ?? (trailerId ? `https://img.youtube.com/vi/${trailerId}/hqdefault.jpg` : '/placeholder-event.jpg');
const imageSrcset = logo?.srcset ?? hero?.srcset ?? undefined;
---

<a
  href={`/events/${event.slug.current}`}
  class="content-card past-event-card group animate-on-scroll no-underline"
  style={`--index: ${index};`}
>
  <div class="past-event-media">
    <img
      src={imageSrc}
      srcset={imageSrcset}
      sizes="120px"
      alt={event.title}
      loading="lazy"
      decoding="async"
      class="past-event-img"
    />
  </div>

  <div class="past-event-body">
    <div class="past-event-meta">
      <span>Event</span>
      <span aria-hidden="true">&bull;</span>
      <span>{parseEventDate(event.startDate)?.year ?? 'Recent'}</span>
    </div>

    <h3 class="past-event-title">{event.title}</h3>

    <span class="watch-now-btn" style="margin-top: 0.6rem;">
      View Coverage <span class="content-card-arrow" aria-hidden="true">&rarr;</span>
      <span class="btn-underline"></span>
    </span>
  </div>
</a>

<style>
  .past-event-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: 0; /* Edge to edge */
    gap: 0;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0; /* Sharp corners on the card */
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .past-event-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 40px rgba(204, 0, 0, 0.15);
  }

  .past-event-card:hover .past-event-title {
    color: var(--color-white);
  }

  .past-event-card:hover .watch-now-btn {
    color: var(--color-accent-text);
  }

  .past-event-card:hover .btn-underline {
    width: 100%;
  }

  .past-event-media {
    flex: 0 0 130px; /* Maintains original row height */
    height: 130px;
    padding: 1rem; /* Shrinks the logo so it doesn't touch the edges */
    background: #0a0a0a; /* Dark background behind the logo */
    border-radius: 0; /* NO rounded edges */
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 560px) {
    .past-event-media {
      flex: 0 0 90px;
      height: 90px;
      padding: 0.5rem;
    }
    .past-event-title {
      font-size: 1.1rem;
    }
  }

  .past-event-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
  }

  .past-event-card:hover .past-event-img {
    transform: scale(1.05);
  }

  .past-event-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 1.5rem;
    flex: 1;
  }

  .past-event-meta {
    color: #a1a1aa;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .past-event-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.2;
    margin: 0 0 0.6rem 0;
  }
</style>
