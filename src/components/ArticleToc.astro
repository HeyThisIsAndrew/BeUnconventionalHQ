---
/**
 * ArticleToc — the sticky "Contents" rail on the left of an article.
 *
 * ─── WHAT IT DOES ─────────────────────────────────────────────────────────
 * Lists the article's H2/H3 headings as anchor links, and highlights whichever
 * section is currently on screen as you scroll.
 *
 * ─── WHERE THE ENTRIES COME FROM ──────────────────────────────────────────
 * buildToc() in src/lib/article-toc.ts, which reads the headings out of the
 * sanitized body and injects matching `id`s so these links have something to
 * jump to. If a heading has no id, it is because buildToc did not see it.
 *
 * ─── WHY IT DISAPPEARS ON SHORT ARTICLES ──────────────────────────────────
 * A contents list with two entries is noise. Below MIN_ENTRIES the rail is not
 * rendered at all.
 */
import type { TocEntry } from '../lib/article-toc';

interface Props {
  entries: TocEntry[];
  /**
   * Page landmarks to fall back on when the article has too few headings to
   * index — see the note on MIN_ENTRIES below. These are real anchors that
   * exist on the page, never invented section names.
   */
  landmarks?: TocEntry[];
}

const { entries, landmarks = [] } = Astro.props;

/**
 * Fewer headings than this and the heading list is not worth the space.
 *
 * Two, not three: a two-section article still gets a real rail.
 */
const MIN_ENTRIES = 2;

/*
  ─── WHAT HAPPENS WHEN AN ARTICLE HAS NO HEADINGS ──────────────────────────
  Some posts genuinely have none — "Mortal Kombat 2 Review" has zero <h*> tags
  in its Substack source, so there are no sections to index and no code can
  invent them. The rail used to disappear entirely in that case.

  The owner's call, made twice, is that an empty rail reads as broken. So a
  post that cannot be indexed by heading falls back to the page landmarks the
  caller passes in — the top of the article and the Suggested Reading block.

  Recorded honestly, because it was argued: these are navigation aids, not a
  table of contents, and they duplicate what the scrollbar and End key already
  do. They are only ever shown when there is no real alternative, and the
  heading list always wins when one exists. The durable fix is editorial —
  two section headings in the Substack post turn this back into a real index.
*/
const useLandmarks = entries.length < MIN_ENTRIES && landmarks.length >= 2;
const items = entries.length >= MIN_ENTRIES ? entries : useLandmarks ? landmarks : [];
const show = items.length >= MIN_ENTRIES;
/* Landmarks are not sections, so they are labelled as what they are. */
const heading = useLandmarks ? 'On This Page' : 'Contents';
---

{
  show && (
    <aside class="article-rail article-rail-left" aria-labelledby="article-toc-head">
      <nav class="article-toc">
        <p class="article-rail-head" id="article-toc-head">{heading}</p>
        <ul class="article-toc-list">
          {items.map((entry) => (
            <li class:list={['article-toc-item', { 'is-sub': entry.level >= 3 }]}>
              <a href={`#${entry.id}`} data-toc-link={entry.id}>{entry.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

<script>
  /*
    Highlight the section currently in view.

    IntersectionObserver rather than a scroll listener: the browser does the
    work off the main thread and only tells us when a heading crosses the
    threshold, so this costs nothing while scrolling.

    rootMargin pulls the detection line up to ~30% from the top of the
    viewport, so a heading counts as "current" once it reaches the upper third
    rather than only at the very top edge.
  */
  let currentObserver: IntersectionObserver | null = null;
  
  function initArticleToc() {
    if (currentObserver) {
      currentObserver.disconnect();
      currentObserver = null;
    }
    
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (links.length === 0) return;

    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));
    if (headings.length === 0) return;

    const setActive = (id: string) => {
      links.forEach((link) => {
        const isActive = link.dataset.tocLink === id;
        link.classList.toggle('active', isActive);
        if (isActive) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const activeHeadings = new Set<Element>();
    const observer = new IntersectionObserver(
      (records) => {
        records.forEach(r => {
          if (r.isIntersecting) activeHeadings.add(r.target);
          else activeHeadings.delete(r.target);
        });

        if (activeHeadings.size > 0) {
          // Prefer the topmost heading currently anywhere in the active zone
          const visible = Array.from(activeHeadings)
            .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)[0];
          if (visible.id) setActive(visible.id);
          return;
        }

        /*
          ─── NOTHING IN THE ZONE IS A POSITION, NOT A NON-EVENT ─────────────

          This used to do nothing at all when the set emptied, which left
          whatever was highlighted last still highlighted. Reported as: read to
          the end of an article, click the wordmark to jump to the top, and the
          contents rail still points at the final section.

          The set empties at BOTH ends of the article, and they are different
          answers:

            above the first heading  the masthead and hero fill the zone, so
                                     nothing is in it. The reader is at the
                                     start — highlight the FIRST entry.
            below the last heading   every heading has scrolled past the
                                     detection line. The reader is in the
                                     footer — keep the LAST entry.

          So the position is resolved from the headings themselves rather than
          assumed. `ZONE_TOP` is the same 80px the rootMargin below uses; the
          two must agree or the rail disagrees with its own detection line.

          Doing this only when the set is empty keeps the normal scrolling path
          untouched — that is still pure IntersectionObserver, no geometry read
          per frame.
        */
        const ZONE_TOP = 80;
        const passed = headings.filter((h) => h.getBoundingClientRect().top < ZONE_TOP);
        const fallback = passed.length > 0 ? passed[passed.length - 1] : headings[0];
        if (fallback?.id) setActive(fallback.id);
      },
      // Active zone: from 80px below the top of the viewport, down to 50% of the viewport.
      { rootMargin: '-80px 0px -50% 0px', threshold: 0 },
    );

    headings.forEach((heading) => observer.observe(heading));
    setActive(headings[0].id);
    
    currentObserver = observer;
  }

  document.addEventListener('astro:page-load', initArticleToc);
  
  document.addEventListener('astro:before-swap', () => {
    if (currentObserver) {
      currentObserver.disconnect();
      currentObserver = null;
    }
  });
</script>
