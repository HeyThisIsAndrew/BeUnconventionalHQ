---
// The cinematic "next up" hero for the Events Hub. Presents the single nearest
// upcoming event as an editorial statement piece — not a calendar row.
//
// Accessibility: the whole card is clickable via ONE stretched link (.fe-cta
// with an ::after that covers the card), so there is exactly one link and no
// nested-interactive markup. When a logo exists it becomes the visible
// identity and the <h2> is visually hidden (kept for screen readers + SEO);
// with no logo, the <h2> title shows.
import { formatEventDateRange, formatLocation } from '../lib/events';
import { buildImageSet } from '../lib/local-content';
import EventStatusIndicator from './EventStatusIndicator.astro';

const { event } = Astro.props;
const slug = event?.slug?.current ?? '';

/*
  ─── THE HERO IS AN <img>, NOT A CSS BACKGROUND ────────────────────────────
  It used to be `background-image: url(…)` on `.fe-bg`, requested at a fixed
  1600x900. Two problems, both visible in production:

  1. A CSS background is invisible to responsive image selection — every
     device downloaded the same file, and a 390px phone paid for a 1600px
     one. This is issue #59's diagnosis applied to the events hero.
  2. 1600x900 is larger than some of the source assets (the D23 hero is
     768x432), so the CDN was upsampling and the hero rendered soft. See
     buildImageSet() — the request is now capped at the asset's own size.

  As a real <img> it gets srcset/sizes, `fetchpriority="high"` (it is the LCP
  element on /events), and an intrinsic width/height so the box is reserved
  before the bytes arrive.
*/
const hero = buildImageSet(event?.heroImage, {
  widths: [640, 960, 1280, 1600, 1920],
  aspect: 16 / 9,
  quality: 60,
});

/*
  The logo is drawn at up to 130px tall (`.fe-logo`), so 320px of source
  covers a 2x display with margin. It was requested at height 200 — under 2x
  on the very phones most likely to see it.
*/
const logo = buildImageSet(event?.logo, { widths: [200, 320, 480, 760] });
const dateLabel = formatEventDateRange(event?.startDate, event?.endDate);
const locationLabel = formatLocation(event?.location);
const brandColor = event?.brandColor || 'var(--color-accent, #cc0000)';
---

<article class="fe-card animate-on-scroll" style={`--brand: ${brandColor};`}>
  {hero ? (
    <img
      class="fe-bg"
      src={hero.src}
      srcset={hero.srcset || undefined}
      sizes="100vw"
      width={hero.width || undefined}
      height={hero.height || undefined}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      decoding="async"
    />
  ) : (
    <div class="fe-bg" style={`background-image: linear-gradient(135deg, ${brandColor} 0%, #111 100%);`}></div>
  )}
  <div class="fe-overlay"></div>

  <div class="fe-content w-full">
    {/*
      ─── ONE VERTICAL LOCKUP, NOT THREE THINGS IN A ROW ───────────────────

      This used to be `flex flex-row items-center gap-4 md:flex-col
      md:items-start md:gap-0`, holding the logo, the countdown and the
      date/location side by side on a phone and stacked with NO gap from md
      up. Both halves were wrong, and both were reported:

      PORTRAIT. Three items sharing a 326px row left each of them a column
      barely 90px wide. The countdown's four cards could not sit in 90px, so
      they wrapped into a 2x2 block — the "bulky four-quadrant grid" — and
      the date, squeezed into what was left, broke to "SEP / 12- / 13, /
      202... / ANA... / CA" and ran off the right edge of the card.

      LANDSCAPE (md and up). `md:gap-0` meant the logo, the countdown and the
      date had literally zero space between them: the logo's baseline touched
      the countdown's top border, which touched the date.

      It is one column at every width now with a real `gap-4`, so the order
      reads logo -> countdown -> date -> location down the card. `items-start`
      keeps the lockup flush with the description and the CTA below it, which
      is the alignment the rest of the hero already uses.
    */}
    <div class="fe-lockup flex flex-col items-start gap-4 w-full mb-4">
      {/*
        ─── ONE STATUS BADGE, AT THE TOP, AT EVERY WIDTH ──────────────────

        This shipped TWICE — `hidden md:inline-block` beside the logo and
        `inline-block md:hidden` down in the meta group — because the lockup
        used to be a row on a phone and a column from md up, so the badge
        needed a different home in each. The lockup is one column at every
        width now, so the pair was two renders of one component kept in step
        by hand for a layout that no longer exists.

        Above the logo rather than beside it: it is an eyebrow, and the hero
        now reads status, then identity, then countdown, then date and city.
        That is the same descent the event page's metadata row uses.
      */}
      {(event.spotlightBadge !== 'none' && event.spotlightBadge !== 'countdown') && (
        <div class="fe-eyebrow"><EventStatusIndicator event={event} /></div>
      )}

      {/*
        ─── THE LOGO AND THE CLOCK SHARE A CENTRE ────────────────────────

        Both were direct children of a lockup with `items-start`, so both
        were flush left and their centres never agreed. Measured, with the
        countdown live:

          390px phone     logo 128 wide, countdown 206   logo 39px left of centre
          844 landscape   logo 160 wide, countdown 194   logo 17px left of centre
          1440 desktop    logo 231 wide, countdown 202   logo 15px right of centre

        Which one is wider flips with the breakpoint, because the logo is a
        fixed `w-32`/`w-40` on small screens and its own intrinsic width from
        md up. So this cannot be solved by centring one inside the other: it
        needs a box that is as wide as whichever is wider, with both centred
        in it.

        `width: fit-content` gives exactly that, and `align-items: center`
        centres both. The box itself is still a flush-left child of the
        lockup, so the eyebrow, the date and the city keep the left edge they
        share with the rest of the card. Nothing here centres the hero.
      */}
      <div class="fe-core">
      {/* Logo */}
      <div class="flex flex-row items-end gap-4 md:gap-10 w-32 sm:w-40 md:w-auto max-w-full">
        {logo ? (
          <>
            {/*
              Deliberately NOT fetchpriority="high". It used to be, which put
              two images on one screen both claiming top priority.

              `.fe-bg` above is the LCP element — the full-bleed 100vw hero.
              This logo draws at 160px on a phone and 380px on desktop.
              Marking both high meant they were fetched concurrently at equal
              priority, so on the gate's 1.6 Mbps link the logo took bandwidth
              directly from the element the LCP metric is measuring. Priority
              only means something when it is scarce.

              Still eager rather than lazy: it is above the fold, and
              loading="lazy" would push it past first paint.
            */}
            <img
              src={logo.src}
              srcset={logo.srcset || undefined}
              sizes="(min-width: 900px) 380px, 160px"
              width={logo.width || undefined}
              height={logo.height || undefined}
              alt={`${event.title} logo`}
              class="fe-logo w-full h-auto md:w-auto"
              decoding="async"
            />
            <h2 class="sr-only">{event.title}</h2>
          </>
        ) : (
          <h2 class="fe-title">{event.title}</h2>
        )}
      </div>

      {/*
        ─── THE COUNTDOWN IS ONE INLINE STRIP ────────────────────────────

        Four bordered cards became one plate holding "02d : 03h : 48m : 40s".
        `flex-nowrap` and `whitespace-nowrap` are the point of the exercise:
        the old version wrapped, and a clock that reflows into a square is
        not reading as a clock any more. At its widest ("999d : 23h : 59m :
        59s") it measures well inside the 326px a 390px phone gives the hero,
        so there is nothing left for it to wrap onto.

        The unit is a single letter visually and the whole word to a screen
        reader, so "02d" is announced as "02 days" without the layout paying
        for the word. `role="timer"` plus `aria-live="off"` says what this is
        without asking assistive tech to read it out once a second.
      */}
      {event.spotlightBadge === 'countdown' && (
        <div
          class="fe-countdown hidden items-center flex-nowrap gap-1.5 sm:gap-2"
          data-target-date={event.startDate}
          role="timer"
          aria-live="off"
          aria-label={`Countdown to ${event.title}`}
        >
          <span class="fe-count-unit">
            <span class="fe-count-num" data-days>00</span
            ><span class="fe-count-abbr" aria-hidden="true">d</span
            ><span class="sr-only"> days</span>
          </span>
          <span class="fe-count-sep" aria-hidden="true">:</span>
          <span class="fe-count-unit">
            <span class="fe-count-num" data-hours>00</span
            ><span class="fe-count-abbr" aria-hidden="true">h</span
            ><span class="sr-only"> hours</span>
          </span>
          <span class="fe-count-sep" aria-hidden="true">:</span>
          <span class="fe-count-unit">
            <span class="fe-count-num" data-mins>00</span
            ><span class="fe-count-abbr" aria-hidden="true">m</span
            ><span class="sr-only"> minutes</span>
          </span>
          <span class="fe-count-sep" aria-hidden="true">:</span>
          <span class="fe-count-unit">
            <span class="fe-count-num" data-secs>00</span
            ><span class="fe-count-abbr" aria-hidden="true">s</span
            ><span class="sr-only"> seconds</span>
          </span>
        </div>
      )}
      </div>

      {/*
        Date and location. They were `.fe-meta` at up to 1.1rem in plain white
        with no tracking of their own on landscape, which read as body copy
        that had lost its styling. They are metadata now and wear the site's
        metadata type at every width — the same 0.72rem/0.18em uppercase muted
        setting the hero eyebrow and the article tags use.

        `flex-wrap` with a gap rather than an inline bullet with margins: the
        separator is only drawn when the two sit on the same line, so a phone
        that breaks them onto two lines does not leave a dot hanging.
      */}
      <div class="flex flex-col items-start gap-2 min-w-0 w-full">
        <p class="fe-meta">
          <span class="fe-dates">{dateLabel}</span>
          {locationLabel && <span class="fe-location">{locationLabel}</span>}
        </p>
      </div>
    </div>

    {event.description && <p class="fe-desc">{event.description}</p>}

    <a href={`/events/${slug}`} class="fe-cta">
      Explore Coverage
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .fe-card {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    display: flex;
    background: #111;
    isolation: isolate;
    outline: 1px solid transparent;
    transition: box-shadow 0.3s ease, outline-color 0.3s ease;
  }
  .fe-card:hover,
  .fe-card:focus-within {
    outline-color: var(--brand, #cc0000);
    box-shadow: 0 0 25px var(--brand, rgba(204, 0, 0, 0.5));
  }
  @media (min-width: 900px) {
    .fe-card {
      min-height: 520px;
    }
  }

  .fe-bg {
    position: absolute;
    inset: 0;
    /* width/height attributes give the box its intrinsic size for CLS; these
       make the painted result fill the card regardless of the asset's own
       proportions, exactly as background-size: cover did. */
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
    /*
      Rests at scale(1) and zooms IN on hover. It used to rest at scale(1.05)
      and settle to 1, which meant the hero was magnified 5% for the entire
      life of the page on every touch device — where :hover never fires. On a
      source that is already smaller than its slot that is 5% of avoidable
      softness, permanently, for an animation nobody on a phone can trigger.
      Same amplitude, same effect on desktop, sharp at rest everywhere.
    */
    transform: scale(1);
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .fe-card:hover .fe-bg,
  .fe-card:focus-within .fe-bg {
    transform: scale(1.05);
  }
  .fe-card:hover .fe-logo,
  .fe-card:focus-within .fe-logo {
    transform: scale(1.1);
  }
  
  /*
    Strong bottom-weighted overlay for WCAG-legible copy over any hero art.

    NO backdrop-filter. It used to carry `blur(3px)` across the WHOLE card,
    which blurred the hero itself — the top of the frame, where no copy sits
    and nothing needed to be softened, took the same hit as the text area. On
    a source that is already smaller than its slot, that was the difference
    between "small image" and "broken image", and it is the other half of the
    low-resolution report alongside the CDN upscale. It is also a full-card
    GPU pass on every scroll frame on mobile.

    The gradient alone does the legibility job: it is what the contrast was
    measured against at the bottom, where the copy actually is, and the stops
    below are weighted a little heavier through the middle to make up for the
    blur's removal.
  */
  .fe-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.94) 0%,
      rgba(0, 0, 0, 0.82) 35%,
      rgba(0, 0, 0, 0.5) 70%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  .fe-content {
    position: relative;
    z-index: 2;
    margin-top: auto; /* anchor copy to the bottom of the hero */
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 720px;
  }
  @media (min-width: 900px) {
    .fe-content {
      padding: 3rem;
    }
  }

  /*
    ─── PORTRAIT: CLOSE THE DEAD ZONE ABOVE THE LOCKUP ────────────────────

    `.fe-content` is bottom-anchored (`margin-top: auto`), so every pixel of
    card height the copy does not use becomes empty space above it. The old
    countdown was a 2x2 block roughly 170px tall, which is what the 420px
    floor was sized around; the inline strip is ~40px, so on a phone that
    floor now buys nothing but a gap. 360px keeps the hero art readable as a
    scene and moves the whole lockup up by the difference.
  */
  @media (max-width: 640px) {
    .fe-card {
      min-height: 360px;
    }
    .fe-content {
      padding: 1.5rem;
    }
  }

  /*
    ─── LANDSCAPE PHONE: CENTRE IT INSTEAD OF HANGING IT OFF THE BOTTOM ───

    A phone held sideways is ~390px tall. Bottom-anchoring a lockup in a card
    that tall pins it against the lower edge with the whole upper half empty,
    which is the "positioning is off in landscape" report. `margin-block:
    auto` splits the leftover space above and below instead of putting all of
    it above, so the lockup sits centred in the frame it shares with the art.
  */
  @media (orientation: landscape) and (max-height: 520px) {
    .fe-card {
      min-height: 320px;
    }
    .fe-content {
      margin-block: auto;
      padding: 1.5rem 1.75rem;
    }
  }

  /*
    Sized by its widest child, never by the column, which is why this is
    `fit-content` and not `w-full`. Full width would centre the pair in the
    whole card and take the hero with it.

    The 1rem gap repeats `.fe-lockup`'s own `gap-4`, so nesting these two
    changes the spacing by nothing.
  */
  /*
    ─── THE CLOCK RESERVES ITS BOX BEFORE THE CLOCK EXISTS ─────────────────

    `.fe-countdown` ships with Tailwind's `hidden`, so until the first tick it
    is `display: none` and contributes nothing. That was harmless while it was
    a flush-left sibling. Inside `.fe-core` it decides the width, so revealing
    it moved the logo: measured at 390px, x=56 with scripting off and x=95
    with it on, a 39px jolt on the hero after first paint.

    So it takes its space immediately and merely cannot be seen. The digits
    ship as "00", which is the width every value below 100 days renders at,
    so the box it reserves is the box it ends up with.

    Keyed off `data-countdown-init`, which the script sets on the element the
    moment it adopts it. That makes this rule strictly the PRE-INIT state:
    the "event has started" path adds `hidden` after init, and there the strip
    really should collapse rather than leave a hole.
  */
  .fe-countdown:not([data-countdown-init]) {
    display: flex;
    visibility: hidden;
  }

  .fe-core {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: fit-content;
    max-width: 100%;
  }

  .fe-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .fe-logo {
    max-height: clamp(70px, 40px + 9vw, 130px);
    max-width: min(100%, 380px);
    width: auto;
    height: auto;
    object-fit: contain;
    transform-origin: left bottom;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .fe-title {
    font-family: var(--font-display, 'Syne Variable', sans-serif);
    font-size: clamp(1.8rem, 1.2rem + 3vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff;
    margin: 0;
    text-shadow: 0 6px 30px rgba(0, 0, 0, 0.6);
  }

  /*
    ─── DATE AND CITY ARE METADATA, AND NOW LOOK LIKE IT ──────────────────

    This was `clamp(0.9rem, …, 1.1rem)` in near-white with 0.1em tracking,
    and on a landscape phone it landed at ~1rem plain white directly under
    the countdown, which is why it read as unstyled body copy rather than as
    a caption. It is the site's metadata setting now, the same one the hero
    eyebrow and `.article-tag` use, at every viewport — so portrait and
    landscape stop disagreeing about what this line is.
  */
  .fe-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-white-muted, #888);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin: 0;
  }

  /* The lead fact of the pair, so it keeps the brighter of the two greys. */
  .fe-dates {
    color: rgba(255, 255, 255, 0.86);
  }

  /*
    THE SEPARATOR IS DRAWN BY THE LAYOUT, NOT TYPED INTO THE MARKUP.

    It used to be a literal <span>•</span> with `mx-2`, hidden below md. A
    pseudo-element on the second item disappears automatically when flex-wrap
    puts that item on its own line, so a narrow card never shows a dot
    dangling at the start of a line — and there is no breakpoint to keep in
    step with the wrap.
  */
  .fe-location::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: 0.75rem;
    vertical-align: middle;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  /*
    ─── THE COUNTDOWN STRIP ───────────────────────────────────────────────

    One plate, four numbers, three colons, no wrapping. The `hidden` class
    ships on the element and the script swaps it for `flex` on the first
    tick, so a countdown whose target has already passed never flashes
    "00:00:00:00" before removing itself.

    `font-variant-numeric: tabular-nums` on top of the mono face: the seconds
    change every tick, and without fixed-width digits the whole strip jitters
    left and right as 1s and 8s trade places.
  */
  .fe-countdown {
    padding: 0.5rem 0.85rem;
    background: rgba(0, 0, 0, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    white-space: nowrap;
    max-width: 100%;
  }

  .fe-count-unit {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }

  .fe-count-num {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* Deliberately small and muted: the digits are the information, the unit
     is only there so the digits mean something. */
  .fe-count-abbr {
    margin-left: 1px;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.55);
  }

  .fe-count-sep {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: clamp(0.9rem, 0.8rem + 0.4vw, 1.15rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.3);
  }

  .fe-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fe-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0.85rem 1.75rem;
    background: transparent;
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px solid var(--brand);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .fe-cta span {
    transition: transform 0.2s ease;
  }
  .fe-card:hover .fe-cta,
  .fe-cta:focus-visible {
    background: var(--brand);
    color: #fff;
  }
  .fe-card:hover .fe-cta span,
  .fe-cta:focus-visible span {
    transform: translateX(4px);
  }
  .fe-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* Stretched link: the CTA covers the whole card so the entire hero is one
     clickable target, while remaining the single link in the DOM. */
  .fe-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .fe-bg--fallback {
    background-image:
      radial-gradient(circle at 100% 0%, rgba(204, 0, 0, 0.15) 0%, transparent 50%),
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 100% 100%, 40px 40px, 40px 40px;
    background-color: #080808;
    width: 100%;
    height: 100%;
  }

</style>


<script>
  import { parseEventDateToLocal } from '../lib/events';

  /*
    ─── HARD RULE 1 APPLIES TO THE COUNTDOWN TOO ─────────────────────────

    This read `new Date(timer.getAttribute('data-target-date'))`, and the
    attribute is a bare calendar date: "2026-09-12". ECMAScript parses that
    as midnight UTC, so for every viewer west of Greenwich the countdown was
    aiming at 5pm on September 11th — it hit zero and removed itself the
    evening BEFORE the event, on the one page whose job is to say how long is
    left. parseEventDateToLocal builds the Date from its components, which is
    the whole reason src/lib/events.ts exists.
  */
  function initCountdowns() {
    const timers = document.querySelectorAll<HTMLElement>('.fe-countdown');
    timers.forEach((timer) => {
      if (timer.dataset.countdownInit === '1') return;
      timer.dataset.countdownInit = '1';

      const targetStr = timer.getAttribute('data-target-date');
      if (!targetStr) return;

      const target = parseEventDateToLocal(targetStr).getTime();
      if (Number.isNaN(target)) return;

      /* Declared before tick() so the first synchronous call can clear it —
         `const interval` after the call left it in the temporal dead zone,
         and an event that had already started threw on load. */
      let interval = 0;

      const setVal = (selector: string, val: number, pad = 2) => {
        const el = timer.querySelector(selector);
        if (el) el.textContent = val.toString().padStart(pad, '0');
      };

      const tick = () => {
        const distance = target - Date.now();

        if (distance < 0) {
          /*
            The event has started. Take the strip down rather than leaving
            four zeros on the hero — `hidden` is the class it ships with, so
            this is the same state it had before the first tick.
          */
          window.clearInterval(interval);
          timer.classList.add('hidden');
          timer.classList.remove('flex');
          return;
        }

        timer.classList.remove('hidden');
        timer.classList.add('flex');

        const days = Math.floor(distance / 86400000);
        const hours = Math.floor((distance % 86400000) / 3600000);
        const minutes = Math.floor((distance % 3600000) / 60000);
        const seconds = Math.floor((distance % 60000) / 1000);

        /* Days is unpadded past two digits so a year-out event reads "412d"
           rather than being clipped by a fixed two-character slot. */
        setVal('[data-days]', days);
        setVal('[data-hours]', hours);
        setVal('[data-mins]', minutes);
        setVal('[data-secs]', seconds);
      };

      /* Once immediately so the strip is correct on the first painted frame,
         then every second. */
      tick();
      if (!timer.classList.contains('hidden')) interval = window.setInterval(tick, 1000);
    });
  }

  document.addEventListener('astro:page-load', initCountdowns);
  // Also run on first load, in case astro:page-load has already fired.
  initCountdowns();
</script>
