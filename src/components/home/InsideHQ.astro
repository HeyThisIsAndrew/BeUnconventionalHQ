---
/**
 * Inside the HQ: who is behind the page, in the HQ's own words.
 *
 * The homepage never said who runs it until the Instagram grid near the
 * bottom, and a personality-led channel read like an anonymous publication.
 * This puts the founder, the principle and the motto on the page once,
 * between the coverage and the channel's own videos.
 *
 * EVERY LINE IS THE ABOUT PAGE'S (src/pages/about.astro), quoted or cut down,
 * never new claims. Change the wording there first, then here.
 *
 * The chalk frame and the motto's texture use the page's one #hq-chalk filter
 * (ChalkFilter.astro), on wrappers and text, never on the <img> (hard rule 6
 * forbids drop-shadow filters on images; nothing here filters the photo).
 */
import { Image } from 'astro:assets';
import HomeSectionHeader from './HomeSectionHeader.astro';
import headshot from '../../assets/andrew-headshot.webp';
---

<section class="home-section inside-hq" aria-labelledby="home-inside-title">
  <div class="home-container">
    <HomeSectionHeader
      icon="mic"
      id="home-inside-title"
      title="Inside the HQ"
      descriptor="Who's behind the coverage"
      href="/about"
      linkLabel="About the HQ"
    />

    <div class="ihq-grid">
      <figure class="ihq-portrait">
        <span class="ihq-frame" aria-hidden="true"></span>
        <Image
          src={headshot}
          alt="Andrew Baxter, founder and editor of BE Unconventional HQ"
          widths={[320, 480, 640]}
          sizes="(max-width: 767px) 60vw, 320px"
          loading="lazy"
          decoding="async"
          class="ihq-photo"
        />
        <figcaption class="ihq-caption">
          <a href="/author/andrew-baxter">Andrew Baxter</a>
          <span>Founder &amp; Editor</span>
        </figcaption>
      </figure>

      <div class="ihq-copy">
        <p class="ihq-principle">
          If we're talking cinema, our content should look like cinema.
        </p>
        <p class="ihq-body">
          No clickbait, no artificial outrage, just unfiltered honesty and
          expertise-driven industry analysis. More than a decade in games and
          technology, including time at Sony Interactive Entertainment, informs
          the coverage: a working knowledge of how these things are built,
          tested and shipped.
        </p>
        <p class="ihq-motto">
          <span>Be yourself.</span>
          <span>Be passionate.</span>
          <span class="ihq-motto-last">Be unconventional.</span>
        </p>
      </div>
    </div>
  </div>
</section>
