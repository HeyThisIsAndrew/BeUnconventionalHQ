---
/**
 * The homepage's ONE section header system:
 *   [chalk icon] + [section name] + [small-caps descriptor] + [1px hairline]
 *
 * One treatment for every section: a white name, a red icon. (There used to
 * be a `tone` prop that set only Intel's name in white; it made the headers
 * disagree with each other and is gone.)
 */
import ChalkIcon, { type ChalkIconName } from './ChalkIcon.astro';

interface Props {
  icon: ChalkIconName;
  title: string;
  descriptor?: string;
  /** Heading id, for the section's aria-labelledby. */
  id: string;
  /** Optional right-aligned "view all" link. */
  href?: string;
  linkLabel?: string;
}

const { icon, title, descriptor, id, href, linkLabel } = Astro.props;
---

<header class="hsh">
  <ChalkIcon name={icon} size={30} class="hsh-icon" />
  <h2 id={id} class="hsh-title">{title}</h2>
  {descriptor && <p class="hsh-descriptor">{descriptor}</p>}
  <span class="hsh-rule" aria-hidden="true"></span>
  {href && linkLabel && (
    <a class="hsh-link" href={href}>
      {linkLabel}
      <ChalkIcon name="arrow-right" size={14} />
    </a>
  )}
</header>
