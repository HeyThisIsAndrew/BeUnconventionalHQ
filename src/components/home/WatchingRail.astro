---
/**
 * Discovery: "The HQ Is Watching", the channel's long-form videos.
 *
 * ─── THE CARDS ARE THE FEED'S ─────────────────────────────────────────────
 * Each tile is ContentCard, the same component /feed's rails render (Andrew:
 * "must inherit the design of the feed page tiles"), so its hover-only play
 * icon, badges and type come with it and cannot drift from the feed. With
 * the default context a video card opens the site's shared #video-modal
 * through Layout's delegated handler: no new YouTube player (hard rule 11).
 *
 * ─── ENDLESS ON DESKTOP ───────────────────────────────────────────────────
 * From 768px up the rail loops: the script clones the whole set once before
 * and once after the real one and, whenever the scroll drifts into a clone
 * set, moves it back by exactly one set's width. The clones are identical at
 * that offset, so the jump is invisible and the arrows never run out.
 * Clones are hidden from assistive tech and the tab order (the real set is
 * the one to read), but NOT `inert`, which would also swallow the click that
 * opens the modal. Their ids and JSON-LD are stripped, so the page never
 * carries a duplicate of either. Phones keep a plain finite swipe.
 */
import ChalkIcon from './ChalkIcon.astro';

/* A rail card is a FIXED width, not the grid's share of the page, so the
   grid's CARD_IMAGE_SIZES (90vw on a phone, 47vw on a tablet) was wrong for
   it both ways. Measured: 304-318px up to 1536, 378 at 1920, 438 at 2560,
   498 at 3840. */
const RAIL_IMAGE_SIZES = '(min-width: 3400px) 500px, (min-width: 2560px) 440px, (min-width: 1920px) 380px, 320px';
import HomeSectionHeader from './HomeSectionHeader.astro';
import ContentCard from '../ContentCard.astro';

interface Props {
  /** Video records in the feed's shape (getVideoItems), newest first. */
  items: any[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="home-section watching" aria-labelledby="home-watching-title" data-watching>
    <div class="home-container">
      <HomeSectionHeader
        icon="watching"
        id="home-watching-title"
        title="The HQ Is Watching"
        descriptor="Fresh off the channel"
        href="/feed/videos"
        linkLabel="All videos"
      />

      <div class="rail">
        <button type="button" class="rail-arrow rail-arrow--prev" data-watching-prev aria-label="Previous videos" disabled>
          <ChalkIcon name="arrow-left" size={22} />
        </button>

        <ul class="rail-track" data-watching-track>
          {items.map((item, index) => (
            <li class="rail-item" data-watching-item>
              <ContentCard item={item} index={index} imageSizes={RAIL_IMAGE_SIZES} />
            </li>
          ))}
        </ul>

        <button type="button" class="rail-arrow rail-arrow--next" data-watching-next aria-label="Next videos">
          <ChalkIcon name="arrow-right" size={22} />
        </button>
      </div>
    </div>
  </section>
)}

<script>
  const DESKTOP = '(min-width: 768px)';
  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;
    const root = document.querySelector<HTMLElement>('[data-watching]');
    const maybeTrack = root?.querySelector<HTMLElement>('[data-watching-track]');
    const maybePrev = root?.querySelector<HTMLButtonElement>('[data-watching-prev]');
    const maybeNext = root?.querySelector<HTMLButtonElement>('[data-watching-next]');
    if (!maybeTrack || !maybePrev || !maybeNext) return;
    /* Re-bound as non-null consts: TS does not carry the guard above into
       the hoisted `function sync()` below. */
    const track: HTMLElement = maybeTrack;
    const prev: HTMLButtonElement = maybePrev;
    const next: HTMLButtonElement = maybeNext;

    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia(DESKTOP);
    const originals = Array.from(track.querySelectorAll<HTMLElement>('[data-watching-item]'));
    let looping = false;
    let settle = 0;

    const makeClone = (li: HTMLElement) => {
      const c = li.cloneNode(true) as HTMLElement;
      c.removeAttribute('data-watching-item');
      c.setAttribute('data-watching-clone', '');
      c.setAttribute('aria-hidden', 'true');
      c.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      c.querySelectorAll('script').forEach((el) => el.remove());
      c.querySelectorAll<HTMLElement>('a, button, [tabindex]').forEach((el) => el.setAttribute('tabindex', '-1'));
      return c;
    };

    /* One set's width, gaps included: the distance between the first real
       card and the first card of the trailing clone set. */
    const setWidth = () => {
      const tail = track.querySelectorAll<HTMLElement>('[data-watching-clone]')[originals.length];
      return tail ? tail.offsetLeft - originals[0].offsetLeft : 0;
    };

    /* Keep the scroll inside the middle (real) set. */
    const recentre = () => {
      if (!looping) return;
      const w = setWidth();
      if (!w) return;
      if (track.scrollLeft < w * 0.5) track.scrollLeft += w;
      else if (track.scrollLeft > w * 1.5) track.scrollLeft -= w;
    };

    const enableLoop = () => {
      if (looping || originals.length < 2) return;
      /* Only loop when there is actually more than a screen of cards. */
      if (track.scrollWidth <= track.clientWidth + 2) return;
      track.prepend(...originals.map(makeClone));
      track.append(...originals.map(makeClone));
      looping = true;
      const prevSnap = track.style.scrollSnapType;
      track.style.scrollSnapType = 'none';
      track.scrollLeft += originals[0].getBoundingClientRect().left - track.getBoundingClientRect().left;
      track.style.scrollSnapType = prevSnap;
      sync();
    };

    const disableLoop = () => {
      if (!looping) return;
      track.querySelectorAll('[data-watching-clone]').forEach((c) => c.remove());
      looping = false;
      track.scrollLeft = 0;
      sync();
    };

    function sync() {
      if (looping) {
        prev.disabled = false;
        next.disabled = false;
        return;
      }
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }

    const onScroll = () => {
      /* Recentre once the scroll has come to rest, never mid-gesture or
         mid-animation, where moving scrollLeft would cancel the motion.
         `scrollend` where supported; a short debounce everywhere else. */
      window.clearTimeout(settle);
      settle = window.setTimeout(recentre, 140);
      sync();
    };
    const onScrollEnd = () => {
      window.clearTimeout(settle);
      recentre();
    };

    const page = (dir: 1 | -1) => () => {
      recentre();
      track.scrollBy({ left: dir * track.clientWidth * 0.9, behavior: reduced() ? 'auto' : 'smooth' });
    };
    const onPrev = page(-1);
    const onNext = page(1);
    const onMedia = () => (desktop.matches ? enableLoop() : disableLoop());

    prev.addEventListener('click', onPrev);
    next.addEventListener('click', onNext);
    track.addEventListener('scroll', onScroll, { passive: true });
    track.addEventListener('scrollend', onScrollEnd);
    window.addEventListener('resize', sync);
    desktop.addEventListener('change', onMedia);

    /*
      Set up when the rail is near, not while the page loads. Both steps read
      layout (`scrollWidth`, `offsetLeft`), and this section is
      `content-visibility: auto` (home.css), so reading it at load forced a
      style and layout of the whole rail the browser was skipping: PageSpeed's
      "Forced reflow" line for this file. One viewport of lead time means the
      loop and the arrow states are ready before the reader arrives.
    */
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      onMedia();
      sync();
    };
    const gate =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              gate?.disconnect();
              start();
            },
            { rootMargin: '100% 0px' },
          )
        : null;
    if (gate) gate.observe(track);
    else start();

    cleanup = () => {
      gate?.disconnect();
      window.clearTimeout(settle);
      prev.removeEventListener('click', onPrev);
      next.removeEventListener('click', onNext);
      track.removeEventListener('scroll', onScroll);
      track.removeEventListener('scrollend', onScrollEnd);
      window.removeEventListener('resize', sync);
      desktop.removeEventListener('change', onMedia);
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
