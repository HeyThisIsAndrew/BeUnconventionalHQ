---
/**
 * Featured: one curated story world, currently set by FEATURED_WORLD in
 * src/data/homepage-feed.ts.
 *
 * The world's name as a title lockup, then the world's stories in
 * FeaturedHighlights: the production homepage's featured box (Andrew:
 * "inherit the design principles of the production version where the video
 * plays in the left column", "the preview should be within a box"). A
 * contained card on the left plays the selected video; picking a row on the
 * right replaces it. Reusing that component, not re-creating it, is the
 * point: it is one of the site's YouTube players (hard rule 11) and already
 * carries the "Watch on YouTube" escape link and the embed-pause contract
 * (hard rule 12), which a second implementation would have to re-earn.
 *
 * This section no longer paints a full-bleed backdrop behind the columns:
 * it read as uncontained, and as broken.
 */
import HomeSectionHeader from './HomeSectionHeader.astro';
import FeaturedHighlights from '../FeaturedHighlights.astro';
import type { FeaturedWorld } from '../../lib/homepage-feed';

interface Props {
  world: FeaturedWorld | null;
  /** The world's stories in the feed's record shape, videos first. */
  records: any[];
}

const { world, records } = Astro.props;
/* Longest word, in letters: the title's size is derived from it (home.css). */
const fwLen = world ? Math.max(4, ...world.title.split(/\s+/).map((w) => w.length)) : 8;
---

{world && records.length > 0 && (
  <section class="home-section featured-world" aria-labelledby="home-featured-title">
    <div class="home-container">
      <HomeSectionHeader
        icon="featured"
        id="home-featured-title"
        title="Featured"
        descriptor="The big picture"
      />

      <div class="fw-lockup">
        <p class="home-kicker fw-kicker">
          Coverage · {world.total} {world.total === 1 ? 'piece' : 'pieces'}
        </p>
        <p class="fw-title" aria-hidden="true" style={`--fw-len: ${fwLen}`}>{world.title}</p>
      </div>

      <FeaturedHighlights items={records} />
    </div>
  </section>
)}
