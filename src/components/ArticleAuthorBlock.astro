---
/**
 * ArticleAuthorBlock — the byline on an article page.
 *
 * ─── WHY IT IS MORE THAN A NAME ───────────────────────────────────────────
 * Google's quality guidance weighs Experience, Expertise, Authoritativeness
 * and Trust ("E-E-A-T"). A bare "by Andrew" signals none of those. A named
 * author with a role and a one-line credential does, and is also what press
 * accreditation boards look for when they check whether a site is a
 * publication or a personal blog.
 *
 * The same values feed the `author` node of the article's JSON-LD, so the
 * human-readable and machine-readable claims cannot disagree.
 *
 * ─── WHERE TO EDIT IT ─────────────────────────────────────────────────────
 * DEFAULT_BYLINE in src/data/sections.js. When a contributors system exists,
 * this component takes an `author` prop and the default becomes a fallback.
 */
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.webp';
import { DEFAULT_BYLINE } from '../data/sections.js';

interface Props {
  /** Reserved for a future contributors system. Defaults to the founder. */
  author?: { name: string; role: string; bio?: string };
}

const { author = DEFAULT_BYLINE } = Astro.props;
---

{/*
  No `rel="author"`. `rel` is only valid on <a>, <link> and <area> — Astro's
  typed HTML attributes reject it on a <div>, and Google retired the
  rel=author signal years ago. Authorship for this page is expressed properly
  in the Person node of the article's JSON-LD (src/pages/intel/[slug].astro),
  which is what actually gets read.
*/}
<div class="article-byline">
  {/* Placeholder portrait until a real headshot is uploaded — see the
      follow-up in scripts/epic-001-article-syndication.md. */}
  <Image
    src={logoImage}
    alt=""
    width={96}
    height={96}
    class="article-byline-avatar"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />
  <div class="article-byline-copy">
    <p class="article-byline-name">
      By <span class="author">{author.name}</span>
    </p>
    <p class="article-byline-role">{author.role}</p>
    {author.bio && <p class="article-byline-bio">{author.bio}</p>}
  </div>
</div>
