  /* Full-screen overlay styles moved to styles/modules/filters.css so
     <CategoryOverlay /> can be shared by the Feed and /intel. */

  :global(body.modal-open) {
    overflow: hidden !important;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { lockScroll, unlockScroll } from '../lib/scroll-lock';

  function initQuadrantFilter() {
