---
import { getVideosUnified } from '../lib/videos-source';
import { parseVideoId } from '../lib/platforms/youtube';
import { getDisplayTags } from '../lib/tags';
import { getFeaturedBrandsLocal, urlFor } from '../lib/local-content';
import logoImage from '../assets/logo-mark.webp';
import { site } from '../data/site.js';

interface Props {
  /**
   * The full feed supplies its own rail and player controller. Category feeds
   * render a static grid, so they opt into this lightweight player control.
   */
  interactive?: boolean;
}

const { interactive = false } = Astro.props;

const videos = await getVideosUnified();

/*
  TYPED LOOSE ON PURPOSE, IN ONE PLACE.

  `getVideosUnified()` is declared as returning UnifiedVideo, but this hero
  reads fields that belong to the raw feed item and are not on that type —
  url, videoId, image, snippet, brandLogo. Every one of those reads was its own
  ts(2339), which is how this file came to carry the project's only `astro
  check` errors against a 0/0/0 baseline.

  Widening once here, rather than casting at each read, keeps the count at zero
  without scattering `as any` through the markup — and leaves one obvious place
  to delete from when UnifiedVideo grows the fields for real.
*/
const latestVideo: Record<string, any> = videos[0] || {};
const trailerId = parseVideoId(latestVideo.url || latestVideo.link || latestVideo.videoId || '');

const isVideo = true;
const heroKind = isVideo ? 'VIDEO' : 'ARTICLE';
const heroTags = getDisplayTags(latestVideo);

const brands = getFeaturedBrandsLocal();
const primaryTag = heroTags[0];
const brand = brands.find((b) => 
  (latestVideo.relatedBrandSlug && b.slug?.current === latestVideo.relatedBrandSlug) ||
  (primaryTag && b.title?.toUpperCase() === primaryTag.toUpperCase())
);
const fallbackLogoSrc = logoImage.src;
const brandLogo = brand?.logo ? urlFor(brand.logo).url() : fallbackLogoSrc;
const brandHero = brand?.heroImage ? urlFor(brand.heroImage).url() : '';

const itemBg = latestVideo.thumbnail || latestVideo.image || '';
const heroBg = brandHero || itemBg;
const heroTitle = latestVideo.title || '';
const heroDescription = latestVideo.description || latestVideo.snippet || '';

function hexToRgbTriple(hex: string): string {
  if (!hex) return '204, 0, 0';
  const clean = hex.replace('#', '');
  if (clean.length !== 6) return '204, 0, 0';
  const r = parseInt(clean.substring(0, 2), 16);
  const g = parseInt(clean.substring(2, 4), 16);
  const b = parseInt(clean.substring(4, 6), 16);
  return `${r}, ${g}, ${b}`;
}

const brandHex = brand?.brandColor?.hex || '#CC0000';
const brandRgb = hexToRgbTriple(brandHex);
const fallbackGradient = `linear-gradient(135deg, rgba(${brandRgb}, 0.28) 0%, #0a0a0a 62%, #111 100%)`;


/*
  THE EYEBROW SHOWS THE ITEM'S OWN TAGS, NOT ITS FILE TYPE.

  It used to be a single hardcoded chip reading VIDEO or ARTICLE, which is the
  one thing about a hero item a visitor can already see: it is a still with a
  play button on it. The cards below say "DC | REVIEW" and the hero said
  "VIDEO", so the loudest item on the page carried the least information.

  `getDisplayTags()` is the SAME function the cards use (src/lib/tags.ts) —
  brand, then content type, then event, capped at three. Sharing it is the
  point: a tag that reads DC | REVIEW on a card cannot read something else in
  the hero, and the brand/type dictionaries stay in one file.

  The kind is the FALLBACK, not a prefix. An item that matches no brand and no
  type still needs something in the chip, and that is the only case where
  VIDEO/ARTICLE earns its place.
*/

const heroMetaTags = heroTags.length > 0 ? heroTags : [heroKind];
---

<section
  class="event-hero w-full max-w-full box-border"
  data-standalone-spotlight={interactive ? '' : undefined}
  style={`--brand-color: ${brandHex}; --brand-rgb: ${brandRgb};`}
>
  <div class="event-hero-bg-wrapper">
    {heroBg ? (
      <img
        id="hero-bg"
        src={heroBg}
        alt=""
        class="event-hero-bg-animated hero-backdrop-plate"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div id="hero-bg" class="event-hero-bg-animated" style={`background-image: ${fallbackGradient};`}></div>
    )}
  </div>

  <div class="hub-stage-wash" aria-hidden="true"></div>

  <div class="event-hero-overlay flex flex-col justify-center">
    <div
      class:list={[
        'container',
        'hero-grid-container',
        'w-full',
        'max-w-full',
        'box-border',
        'lg:!px-20',
        'xl:!px-24',
        '2xl:!max-w-[1920px]',
        '2xl:!grid-cols-[1fr_1.2fr]',
        '3xl:!max-w-[2400px]',
        '3xl:!grid-cols-[1fr_1.4fr]',
        { 'has-trailer': true },
      ]}
    >
      <div class="event-hero-content hero-copy">
        
        {/* `id` is on the CONTAINER, not on a chip: the number of chips
            changes with the item (one tag, two, three), so the swap handler in
            FeedGrid rewrites the row wholesale rather than trying to keep a
            fixed set of spans in step with it. */}
        <div class="hero-eyebrow" id="hero-meta-tags">
          {heroMetaTags.map((tag, index) => (
            <span class={`hero-meta-tag${index === 0 ? ' hero-meta-tag--type' : ''}`}>{tag}</span>
          ))}
        </div>

        <div class="hero-identity">
          <img 
            id="hero-brand-logo" 
            src={brandLogo || fallbackLogoSrc} 
            alt="Brand Logo" 
            class={`hero-logo`}
            data-fallback-logo={fallbackLogoSrc}
          />
          <h1 id="hero-title" class="hero-title leading-tight line-clamp-1">{heroTitle}</h1>
          <p id="hero-description" class="hero-tagline line-clamp-2">{heroDescription}</p>
          <a
            href={site.socials.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="feed-hero-youtube-btn"
          >
            <svg class="feed-hero-youtube-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z" fill="currentColor"></path>
            </svg>
            <span class="feed-hero-youtube-text">SUBSCRIBE</span>
          </a>
        </div>


        {/*
          ─── THERE IS NO PLAY BUTTON IN THIS COLUMN, DELIBERATELY ───────────

          There was one, and before that it was a full-width bar. It is gone
          rather than restyled: the stage pane on the right already carries the
          action for this exact item, over its own artwork, right next to its
          title. Two controls that start the same video, one of them beside a
          picture of what it starts and one of them not, is a choice the
          visitor should never have been asked to make.

          It also removed a whole class of bug rather than patching it. The
          button was rebuilt in JS on every tile swap, and a runtime-built node
          carries none of Astro's scoped-style attributes, so after a swap it
          lost its rectangle and its 13px glyph constraint and rendered as bare
          text under an oversized play triangle.

          If a second action ever belongs here, it goes back as a sibling of
          the identity block — not in the `cta` grid area, which stretches.
        */}
      </div>

      <div
        class="hero-trailer hub-stage is-item"
        data-trailer={trailerId || undefined}
      >
        <div class="hub-stage-mark hub-stage-mark--art">
           {/* Fallback image if no video */}
           <img
              id="hero-image"
              src={itemBg}
              class="hub-stage-art-fill"
              
           />
           <img
              id="hero-image-front"
              src={itemBg}
              class="hub-stage-art-img"
              
           />
           
           
        </div>

        <div class="hub-stage-video" style="z-index: 5;">
          <iframe
            id="hero-iframe"
            class="hub-stage-iframe transition-opacity duration-500"
            src="about:blank"
            data-pending-video={trailerId || undefined}
            title=""
            tabindex="-1"
            allow="autoplay; encrypted-media"
            style="opacity: 0; pointer-events: none;"
          ></iframe>
        </div>

        {/*
          ─── THE STAGE STATES WHAT IT IS ABOUT TO PLAY ──────────────────────

          The same pane /featured shows when a rail tile is picked: still,
          scrim, kind, title, Play. Here it is the stage's OPENING state rather
          than a selection, because the feed hero always has exactly one item
          loaded and the visitor has not chosen it — so the stage was a bare
          thumbnail that named nothing and offered nothing, and the only way to
          start it was the button in the other column.

          Every rule this needs (.hub-stage-item and friends, including the
          `is-playing` rule that takes the pane off the frame it just started)
          was already in this file's stylesheet, written for a pane that was
          never rendered. This is that markup arriving, not a new treatment.

          Sits ABOVE .hub-stage-video in both source order and stacking: the
          video div carries `z-index: 5` inline, so a pane that merely follows
          it would be behind it, and an opacity-0 element still swallows
          clicks. That is why the pane takes 6 and the video layer gives up
          pointer events while a pane is up.
        */}
        <div class="hub-stage-item active" id="hero-stage-item" style="z-index: 6;">
          {itemBg && <img id="hero-stage-item-still" src={itemBg} alt="" class="hub-stage-item-still" />}
          <span class="hub-stage-item-scrim"></span>
          <div class="hub-stage-item-copy">
            <span class="hub-stage-item-kind" id="hero-stage-item-kind">{heroKind}</span>
            <p class="hub-stage-item-title" id="hero-stage-item-title">{heroTitle}</p>
            {isVideo && trailerId ? (
              /* Same handler as the copy column's button — `data-action` is
                 what FeedGrid's play listener reads. It plays IN the stage; the
                 site-wide `open-video` action would pop the modal, and this
                 panel is already the player. */
              <button type="button" class="hub-stage-item-action" id="hero-stage-item-action" data-action="play-trailer">
                Play
              </button>
            ) : (
              <a href={latestVideo.url || latestVideo.link || '#'} class="hub-stage-item-action" id="hero-stage-item-action">
                Read
              </a>
            )}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

{
  interactive && (
    <script>
      /*
        FeedGrid owns this behavior on /feed, where selecting a card can also
        replace the hero item. Category pages use a static CardGrid instead,
        so their otherwise identical hero needs only the initial Play control.

        Keep the listener lifecycle-aware: ClientRouter preserves document
        listeners between navigations, and a category-page handler must not
        remain active after navigating back to a full feed.
      */
      function initStandaloneSpotlightPlayback() {
        const listenerKey = '__hqStandaloneSpotlightPlayListener';
        const previousHandler = (window as any)[listenerKey] as ((event: MouseEvent) => void) | undefined;
        if (previousHandler) document.removeEventListener('click', previousHandler);

        if (!document.querySelector('[data-standalone-spotlight]')) {
          delete (window as any)[listenerKey];
          return;
        }

        const playHandler = (event: MouseEvent) => {
          const target = event.target as Element | null;
          const control = target?.closest<HTMLButtonElement>('#hero-stage-item-action[data-action="play-trailer"]');
          if (!control) return;

          const stage = control.closest('.hub-stage');
          if (!stage) return;
          const iframe = stage.querySelector<HTMLIFrameElement>('#hero-iframe');
          const videoId = iframe?.dataset.pendingVideo;
          if (!iframe || !videoId) return;

          event.preventDefault();
          iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&enablejsapi=1`;
          iframe.style.opacity = '1';
          iframe.style.pointerEvents = 'auto';
          stage.classList.remove('is-item');
          stage.classList.add('is-playing');
        };

        (window as any)[listenerKey] = playHandler;
        document.addEventListener('click', playHandler);
      }

      document.addEventListener('astro:page-load', initStandaloneSpotlightPlayback);
    </script>
  )
}

<style>
  .event-dashboard {
    /* min-height removed to respect canonical footer spacing */
  }
  /* Page width wrapper now shared: `.container-page` in modules/layout.css */
  
  /* Hero */
  .event-hero {
    position: relative;
    background-color: #111;
    /* NO overflow:hidden here. On iOS Safari an overflow:hidden ancestor makes
       a descendant cross-origin (YouTube) iframe render as a black box. The bg
       below is inset:0 and its image clips to its own box, so it can't spill —
       the clip was never needed. */
  }
  /* Clipping/coverage layer: static, fills the hero, hides the sliver the
     animated child exposes at its edges while scaled. overflow:hidden is safe
     HERE (and only here) — it contains no iframe, so the iOS black-box bug
     cannot trigger. */
  .event-hero-bg-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .event-hero-bg-animated {
    position: absolute;
    inset: 0;
    /* Cover the whole hero (behind the copy AND the trailer). It re-crops when
       the description expands — an accepted trade for full coverage. */
    object-fit: cover;
    object-position: center 22%;
    width: 100%;
    height: 100%;
    /* translateZ(0) promotes this layer to its own compositor layer. Without
       it, the overlay's backdrop-filter blur stops the animated transform from
       repainting (issue #22 root cause) — keep it in the base AND in every
       keyframe so the promotion never lapses mid-animation. */
    transform: translateZ(0);
    /* Tuned after visual QA: the original 1.05/50s (~0.1%/s) sat below the
       perception floor and read as static. 1.08/30s is ambient but alive —
       don't retune blind; verify any change with the 2s/1.5x debug values
       (see d1db593). */
    animation: cinematic-hero-zoom 30s ease-in-out infinite alternate;
  }
  /* Scale never drops below 1, so the image always covers the wrapper — no
     exposed edges at any point in the cycle. */
  @keyframes cinematic-hero-zoom {
    from {
      transform: scale(1.08) translateZ(0);
    }
    to {
      transform: scale(1) translateZ(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-hero-bg-animated {
      animation: none;
    }
  }

  /*
    THE HERO PLATE.

    Blurred, and OVERSCANNED past its clipping wrapper. A CSS blur goes weak at
    its own element's edges — it mixes in the transparent pixels outside — so
    the outermost band of a blurred element is the least blurred part of it.
    Left flush with the box, that band is what shows behind the logo and the
    copy. `.event-hero-bg-wrapper` already clips, so pushing the plate past it
    puts the weak edge outside the clip where it is never seen.

    Blurred less than the deck's, and brightened rather than dimmed: on
    /featured this sits behind a poster and must not compete with it, whereas
    here it IS the scene with only a logo and a line of type in front. Trailer
    stills are dark to begin with, and blurring a dark image and then dimming it
    is how this hero was once a black rectangle.
  */
  .hero-backdrop-plate {
    inset: -12%;
    top: -12%;
    left: -12%;
    right: -12%;
    bottom: -12%;
    filter: blur(9px) saturate(1.15) brightness(1.16);
    -webkit-filter: blur(9px) saturate(1.15) brightness(1.16);
  }

  /*
    Shapes the plate the copy sits on. A single flat image behind white text is
    what made this hero read as a stock header — the copy had no ground of its
    own, so it floated. Darkest at the bottom left, where the mark and the line
    are, and clearing toward the trailer on the right.
  */
  .event-hero-bg-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /*
      TWO SCRIMS MULTIPLY. THESE ONES MULTIPLIED TO BLACK.

      A design review called this hero "mostly empty dark space next to the
      logo", and the backdrop gallery WAS behind it the whole time — it was
      just unreadable. Stacked alpha compounds: at the bottom-left corner these
      two came to 1 - (1-0.92)(1-0.88) = 0.99, and at the logo's own position
      about 0.85. A gallery under a 99% black wash is an expensive way to draw
      a black rectangle.

      The vertical one now only does what it has to — seat the bottom edge
      against the section below — and the horizontal one carries legibility for
      the copy, ending sooner and softer. At the logo the pair now comes to
      about 0.55, which is a lit scene with type on it rather than a void.
    */
    background:
      linear-gradient(to top, rgba(5,5,5,0.82) 0%, rgba(5,5,5,0.42) 18%, rgba(5,5,5,0.12) 38%, transparent 62%),
      linear-gradient(to right, rgba(5,5,5,0.62) 0%, rgba(5,5,5,0.34) 24%, rgba(5,5,5,0.10) 46%, transparent 68%);
  }
  /* In normal flow (not absolute) so the banner GROWS with its content instead
     of overflowing upward under the fixed navbar. padding-top clears the navbar
     so the logo is never clipped. */
  .event-hero-overlay {
    position: relative;
    z-index: 1;
    /*
      Was 70vh, which read as dominant: the hero took most of the screen with
      the coverage below it barely announcing itself. 62 is enough to establish
      the hub without burying what the page is actually for.

      `lvh`, not `vh`. On iOS `vh` is the LARGEST viewport, which the page also
      uses before the URL bar retracts — the unit this project already pins for
      exactly this reason (scripts/viewport-units.test.mjs).
    */
    /* Removed massive empty space */
    /* min-height: 62lvh; */
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.97) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.35) 100%
    );
    /* Subtle blur of the background image behind the overlay (content is a child,
       so it stays sharp) — softens the busy hero art for title legibility. */
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    padding-top: clamp(6rem, 4.5rem + 6vw, 8.5rem);
    padding-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  /*
    A PHONE HELD SIDEWAYS HAS NO ROOM FOR DESKTOP'S BREATHING SPACE.

    That padding-top is a `vw` clamp, so it grows with WIDTH: 123px at 844px
    across. On a page 390px tall that is a third of the screen spent on
    clearance above the header, and it was pushing the hero past the bottom on
    every iPhone below the Pro. The header still needs clearing; nothing else
    about the spacing does.
  */
  @media (orientation: landscape) and (max-height: 450px) {
    .event-hero-overlay {
      min-height: 0;
      padding-top: 5.25rem;
      padding-bottom: 1.25rem;
    }
  }

  /* Mobile: single column. Source order is copy → trailer → button, so the
     trailer sits above the Event Details button. */
  .hero-grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  /*
    NAMED .hero-info-cta, NOT .hero-cta — deliberately. See the matching note
    in events/[slug].astro: .hero-cta is already the homepage splash/reveal
    button's class (hero.css + splash.css), and this page's wrapper reusing
    that name let splash.css's pulsing-glow/flex rules bleed onto the
    unrelated "Event Details" CTA here — reported as a stray red outline
    around the button on every viewport.
  */
  .hero-info-cta {
    text-align: center;
  }

  /*
    THE SPLIT IS ABOUT SHAPE, NOT WIDTH.

    This was `min-width: 900px`, which reads as "desktop" and is wrong for the
    thing it decides. A phone held sideways is 874px on an iPhone 16/17 Pro and
    932px on the Max, so the same gesture on two phones in the same hand got
    two different layouts, and the smaller one stacked. Reported as landscape
    "still showing as a stack rather than having the video on the right".

    What actually decides whether copy and video fit side by side is whether
    the viewport is WIDER THAN IT IS TALL. So: any landscape viewport with room
    for two columns, plus anything genuinely wide, which keeps portrait tablets
    on it.

    820px is measured, not picked. The hero bottoms out around 394px on its own
    content whatever the width, and below 820 the devices are also SHORTER than
    that, so the split overflowed instead of fitting: an SE in landscape ran
    93px past the bottom of the screen. 820 clears every current iPhone held
    sideways (844, 852, 874, 896, 932, 956) and leaves the genuinely small ones
    (SE 667, 8 Plus 736, mini 780) stacked, which is the right layout for a
    screen that would otherwise get two 300px columns.

    `.hub-stage-bg` below inverts this EXACTLY. If you change one, change both:
    a split layout with the stacked backdrop puts a full-bleed plate behind a
    right-hand column that expects a feathered one.
  */
  @media (min-width: 900px), (orientation: landscape) and (min-width: 820px) {
    /* .has-trailer / .has-cta are applied at build time — no reliance on :has()
       (which older Firefox lacks). Single-row areas when there's no CTA so the
       copy isn't squeezed by an empty grid row. */
    .hero-grid-container.has-trailer {
      grid-template-columns: 1fr 1fr;
      /*
        The rail is its own row now rather than the tail of the copy column.
        That is what lets mobile order the page copy -> trailer -> rail (the
        rail follows the stage in the DOM) while desktop still shows it in the
        left column: grid-areas put it back. The stage spans both rows, so the
        rail lands level with its bottom without any margin arithmetic.
      */
      grid-template-areas:
        'copy trailer'
        'rail trailer';
      grid-template-rows: 1fr auto;
      align-items: center;
    }
    /*
      Only the COPY column stretches. Stretching the whole row squeezed the
      stage instead: it has an aspect-ratio, so constraining its height
      constrains its width too, and it collapsed from 600px to 290px on an iPad.
      Stretching one cell gives the copy the row's full height to work with and
      leaves the stage sizing itself.
    */
    /*
      ─── THE METADATA ROW DOES NOT MOVE ───────────────────────────────────

      It used to. This column was `align-self: end`, so it was only ever as
      tall as its own content and its BOTTOM edge was pinned to the bottom of
      the 1fr row. Two things then dragged the eyebrow around:

        1. THE LOGO'S HEIGHT. A tall mark made the column taller, and since
           the bottom was fixed, the extra height came off the top: the tags
           slid upward. Two events differing only in how their logo was
           cropped showed the tags at two different heights.
        2. WHETHER THERE WAS A CTA. `.has-cta` adds a grid row, which makes
           the 1fr row shorter, which moved the bottom edge the column was
           pinned to. So an event with no `signUpLink` (Oscars, Anime Expo,
           Summer Game Fest, SDCC 2027) put its tags somewhere else again.

      Now the column STRETCHES to the row and the eyebrow sits at its top,
      which is the top of the grid and does not depend on anything inside the
      column. `.hero-identity` takes `margin-top: auto` so the lockup stays
      bottom-anchored exactly where it was, and the 1.4rem under the eyebrow
      survives as the minimum gap rather than being eaten by an auto margin.
    */
    .hero-grid-container.has-trailer .hero-copy {
      align-self: stretch;
      /* Same reason as the rail's: a grid item defaults to a min-content
         floor, and this column holds one. */
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }
    .hero-grid-container.has-trailer .hero-copy > .hero-identity {
      margin-top: auto;
    }
    .hero-grid-container.has-trailer .hub-rail {
      grid-area: rail;
      align-self: end;
      margin-top: 0;
    }

    .hero-grid-container.has-trailer.has-cta {
      grid-template-areas:
        'copy trailer'
        'cta trailer'
        'rail trailer';
      grid-template-rows: 1fr auto auto;
    }
    .hero-grid-container.has-trailer .hero-copy {
      grid-area: copy;
    }
    .hero-grid-container.has-trailer .hero-trailer {
      grid-area: trailer;
    }
    /*
      Bigger, but only in the 50/50. A hub with no trailer stacks instead, and a
      760px stage there is 427px of mostly-empty box that pushed the hero from
      62% of the viewport to 106% on desktop. It earns the extra width only when
      it has a column of its own to fill.
    */
    .hero-grid-container.has-trailer .hero-trailer.hub-stage {
      max-width: 760px;
    }
    /*
      No `grid-area: cta` here any more. The button is inside .hero-copy, so
      placing it in a grid area would have pulled it back out of the column and
      stretched it across the row again — which is the bug this hero shipped
      with. The `cta` area itself is still declared in .has-trailer.has-cta
      above for callers that genuinely put a child there.
    */
  }

  .event-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 900px;
  }
  
  /* Placement only — the trailer's internals live in <HeroTrailer/>. */
  /* ══════════════════════════════════════════════════════════════════════
     THE HUB HERO'S RIGHT HALF — the deck page's stage, brought here.

     Lifted rather than rewritten: every value below already survived several
     rounds of review on /featured, and rebuilding it from memory is how the
     two pages drift apart again.

     The hero KEEPS ITS OWN HEIGHT. An earlier attempt made it 100lvh, which is
     ~1286px on an iPad Pro portrait with maybe 400px of content centred in it —
     a wall of nothing. Nothing here sets a viewport height.
     ══════════════════════════════════════════════════════════════════════ */

  /*
    The plate behind the right half. Overscans its clip, because a CSS blur goes
    WEAK at its own element's edges: it samples the transparent pixels outside
    and mixes them in, so the outermost band is the least blurred part of it.
    Pushed past the clip, what shows is the middle of the blur, which is even.

    The mask is the feathered middle — a smoothstep rather than a two-stop ramp,
    because a linear alpha ramp's two ENDS are discontinuities the eye reads as
    faint vertical bands.
  */
  .hub-stage-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: 28%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.04) 8%, rgba(0,0,0,0.14) 16%,
      rgba(0,0,0,0.32) 24%, rgba(0,0,0,0.55) 32%, rgba(0,0,0,0.76) 40%,
      rgba(0,0,0,0.90) 48%, rgba(0,0,0,0.98) 56%, rgba(0,0,0,1) 64%);
    mask-image: linear-gradient(to right,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.04) 8%, rgba(0,0,0,0.14) 16%,
      rgba(0,0,0,0.32) 24%, rgba(0,0,0,0.55) 32%, rgba(0,0,0,0.76) 40%,
      rgba(0,0,0,0.90) 48%, rgba(0,0,0,0.98) 56%, rgba(0,0,0,1) 64%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .hub-stage-plate {
    position: absolute;
    inset: -30%;
    background-size: contain;
    background-position: 58% 50%;
    background-repeat: no-repeat;
    filter: blur(26px) saturate(1.4) brightness(1.45);
    -webkit-filter: blur(26px) saturate(1.4) brightness(1.45);
    opacity: 0.5;
    /* STATIC. A 32s scale() on the CLIPPING wrapper was the light leak on the
       deck page: scaling a clipping box scales the clip, dragging the blur's
       weak edge out past the scrims. Nothing here moves. */
  }

  /*
    `contain` fits a mark inside the box and leaves its aspect alone. Key art
    is photographic and 16:9, so it covers instead, and sits back further: a
    full-frame image at the mark's brightness washed the copy column's side of
    the feather.
  */
  .hub-stage-plate--art {
    background-size: cover;
    background-position: center 30%;
    opacity: 0.38;
    filter: blur(30px) saturate(1.15) brightness(1.05);
    -webkit-filter: blur(30px) saturate(1.15) brightness(1.05);
  }

  /* Lit without needing a single asset, so a hub with no logo still reads. */
  .hub-stage-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(90% 80% at 76% 46%,
      rgba(var(--brand-rgb, 204,0,0), 0.20) 0%,
      rgba(var(--brand-rgb, 204,0,0), 0.09) 36%,
      rgba(var(--brand-rgb, 204,0,0), 0.02) 60%,
      transparent 78%);
  }

  /* The stage itself sits in the grid's `trailer` cell. */
  /*
    `.hero-trailer.hub-stage`, not `.hub-stage`. The stage carries BOTH classes
    and `.hero-trailer { max-width: 600px }` is declared later in this file, so
    a single-class rule here lost on source order and the stage stayed capped at
    600 however large the column got. Two classes wins on specificity instead of
    relying on where the rule happens to sit.
  */
  .hero-trailer.hub-stage {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    /* NO overflow: hidden — HARD RULE 3, the iframe lives in here. */
  }

  .hub-stage-mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* HARD RULE 6: the glow is on the WRAPPER, never on the <img>. */
    filter: drop-shadow(0 0 38px rgba(var(--brand-rgb, 204,0,0), 0.40))
            drop-shadow(0 16px 40px rgba(0,0,0,0.8));
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    opacity: 0.97;
  }

  /* A pane is up, so the frame underneath it must not take the click that was
     aimed at the pane's own Play button. `opacity: 0` hides a layer; it does
     not stand it down. */
  .hub-stage.is-item .hub-stage-video {
    pointer-events: none;
  }

  /* Recreated youtube button styling to match featured page */
  .feed-hero-youtube-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.15rem; /* Matches .hub-stage-replay */
    padding: 0.5rem 1.05rem 0.5rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.32);
    color: var(--color-white, #f0f0f0);
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .feed-hero-youtube-btn:hover,
  .feed-hero-youtube-btn:focus-visible {
    border-color: rgba(var(--brand-rgb, 204, 0, 0), 0.85);
    background: rgba(0, 0, 0, 0.5);
  }

  .feed-hero-youtube-glyph {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .feed-hero-youtube-btn:focus-visible {
    outline: 2px solid var(--color-accent-text, #ef4444);
    outline-offset: 3px;
  }

  .hub-stage-mark-img {
    width: 62%;
    max-height: 78%;
    height: auto;
    object-fit: contain;
  }

  /*
    ─── ART MODE ───────────────────────────────────────────────────────────

    The same layer, holding the key art instead of a mark.

    It CLIPS, and that is safe HERE and only here: `.hub-stage-mark` is a
    SIBLING of `.hub-stage-video`, never its ancestor, so hard rule 3 is not
    in play. The plate inside overscans past the clip because a CSS blur goes
    weak at its own edges — the outermost band is the least blurred part — and
    left flush, that near-sharp band is exactly the edge of the frame, where
    it would read as a sharp picture with a soft middle.

    `filter: none` because the base rule's drop-shadow glow is shaped for a
    mark with transparent surroundings. On a full-bleed rectangle it is just a
    shadow, and `box-shadow` draws the same thing without a filter's repaint
    cost. It is the video's own shadow, so idle and playing sit in one frame.
  */
  .hub-stage-mark--art {
    /*
      NO FILTER. The base rule's drop-shadow glow is shaped for a mark
      floating in transparency; on a full-bleed rectangle it is just a
      shadow, which `box-shadow` draws without a filter's repaint cost. That
      shadow is the video's own, so the idle frame and the playing one are
      the same object rather than two boxes that share a position.
    */
    filter: none;
    -webkit-filter: none;
    opacity: 1;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.85);
    /*
      Clips the blurred fill behind the art. Safe HERE and only here:
      `.hub-stage-mark` is a SIBLING of `.hub-stage-video`, never its
      ancestor, so hard rule 3 is not in play. The stage itself still never
      clips.
    */
    overflow: hidden;
  }

  /*
    ─── THE PLACEHOLDER IS THE PICTURE, AND ALL OF IT ──────────────────────

    It shipped blurred and overscanned, borrowing the treatment every other
    plate on this page uses. That was wrong twice: it was an effect applied to
    the event's art rather than the art, and the overscan zoomed it. Asked for
    plainly: "it should just be the full image that is used for the hero but
    in the location of the trailer at the trailer's size."

    Then it was `cover`, and that cut L.A. Comic Con's key art in half. The
    frame is 16/9 and 17 of the 19 events' art is exactly 16:9, so cover was
    an exact fit almost everywhere and the exceptions were the whole problem:
    L.A. Comic Con is 2.35:1 and SXSW is 2.70:1, and cover trimmed 24% and
    34% off their sides. Both have their NAME set across the full width of
    the artwork, so what cover removed was the first and last letters of the
    event's own title. Reported, correctly, as "cut off".

    So the front copy CONTAINS: the whole image, never cropped, whatever
    shape it is. `contain` alone would leave bars, which is why there are two
    copies — see the fill below. On the 17 events whose art is already 16:9,
    contain and cover are the same fit and the fill is never visible at all.
  */
  .hub-stage-art-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /*
    THE GUTTERS ARE FILLED, NOT LEFT EMPTY.

    Letterbox bars in the frame a trailer is about to play in read as a
    broken image, and a flat black bar reads as a rendering fault. A blurred,
    darkened copy of the same file behind the art is the standard answer, and
    it costs no extra request: identical src and srcset, so the browser
    paints one decode twice.

    It is DARKENED as well as blurred, deliberately. The gutter has to recede
    or it competes with the picture it is framing, and this page has a
    recorded failure in the other direction: the hero was once a black
    rectangle because a dark image was blurred and then dimmed. That applied
    to the thing carrying the scene. This is the margin around it.

    `scale(1.12)` on the IMAGE, never on the clipping box. A CSS blur samples
    the transparent pixels outside its element and goes weak at its own
    edges, so the fill is pushed past the clip where that band is never seen.
    Scaling the clip instead is what caused the light leak on the deck page.
  */
  .hub-stage-art-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.12);
    filter: blur(22px) saturate(1.1) brightness(0.62);
    -webkit-filter: blur(22px) saturate(1.1) brightness(0.62);
  }

  .hub-stage-wordmark {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.5rem, 3.6vw, 3rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: rgba(255,255,255,0.92);
    line-height: 1.15;
  }

  .hub-stage-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.02);
    transition: opacity 1.1s ease, transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 30px 70px rgba(0,0,0,0.85);
    /* NO overflow: hidden and no radius needing one. HARD RULE 3. */
  }

  .hub-stage-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    /* A frame whose document never loads paints WHITE by default, which is a
       white rectangle in the middle of a black page. */
    background: #050505;
  }

  /* Playing: video up, mark down but not out — it is the glow behind it. */
  .hub-stage.is-playing .hub-stage-video {
    opacity: 1;
    transform: scale(1);
  }
  .hub-stage.is-playing .hub-stage-mark {
    opacity: 0.28;
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-stage-mark,
    .hub-stage-video {
      transition: none;
    }
  }

  /*
    Below the 50/50 breakpoint the grid stacks, so the feathered plate has no
    right half to sit in. It becomes the full-bleed ground behind the stacked
    copy instead, which is what the deck page does at these sizes.

    This condition is the EXACT INVERSE of the split query above, and has to
    stay that way. It used to be a flat `max-width: 1023px`, which overlapped
    the split by a whole band: a 900-1023px portrait viewport got the two
    column layout AND the full-bleed plate, so the right-hand column sat on a
    backdrop built for a stacked page.
  */
  @media (max-width: 899px) and (orientation: portrait), (max-width: 819px) {
    .hub-stage-bg {
      left: 0;
      -webkit-mask-image: none;
      mask-image: none;
      opacity: 0.55;
    }
    .hub-stage-wash {
      background: radial-gradient(120% 70% at 50% 38%,
        rgba(var(--brand-rgb, 204,0,0), 0.16) 0%,
        rgba(var(--brand-rgb, 204,0,0), 0.05) 46%,
        transparent 74%);
    }
  }

  /*
    THE MARK IN THE COPY COLUMN.

    Sizing is left to the .hero-logo rule further down, which already scales
    with the viewport, caps its width so a wide mark cannot overflow the column,
    and carries a note about iOS. A second height here just fought it.

    HARD RULE 6: the glow is on the WRAPPER, never on the <img>. The rule below
    notes that a filter ON the image made it fail to render on iOS entirely.
  */
  .hero-logo-wrap {

    display: block;
    margin: 0.2rem 0 1.4rem;
    filter: drop-shadow(0 10px 26px rgba(0, 0, 0, 0.9));
  }

  /*
    MARK ABOVE THE LINE, TIGHT TOGETHER.

    Side by side was tried and rejected: it squeezed the description into a
    narrow column, which made it wrap enough to trip the "Read more" clamp on
    hubs with longer copy — an expand control nobody wants in a hero. Full
    width beneath the mark, the line always fits and the clamp never fires.

    The gap is deliberately small. The two belong to each other; the air
    between them was reading as two separate things.
  */
  .hero-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin-bottom: 1.2rem;
  }
  .hero-identity .hero-logo-wrap {
    margin: 0;
  }

  /*
    A HEADING THAT IS PURELY A CONTAINER. The <h1> around the mark must not
    bring a heading's own margin, size or weight with it — the alt text only
    ever paints if the image fails, and it should land where the mark would
    have, not as a browser-default 2em block that moves everything under it.
  */
  .hero-title-lockup {
    display: block;
    margin: 0;
    padding: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  /* ─── THE RAIL ──────────────────────────────────────────────────────── */
  .hub-rail {
    display: flex;
    gap: 10px;
    /*
      `min-width: 0` IS LOAD-BEARING.

      A grid `1fr` track is `minmax(auto, 1fr)`, so it cannot shrink below its
      content's min-content width. This rail is five 108px cards plus four 10px
      gaps = exactly 580px of min-content, which is precisely what the copy
      column measured while the stage next to it collapsed from 600px to 290px
      on an iPad. The rail was quietly setting the column widths.

      It already scrolls horizontally, so allowing it to shrink costs nothing —
      the same automatic-minimum trap that made the accordion rows size
      themselves off their sibling count on /featured.
    */
    min-width: 0;
    margin-top: 1.6rem;
    overflow-x: auto;
    /*
      PADDING ON ALL FOUR SIDES, AND EVERY SIDE IS LOAD-BEARING.

      `overflow-x: auto` computes `overflow-y` to `auto` as well, so this box
      clips vertically too — and the active card lifts AND scales 1.06. Without
      room, the selected tile was sliced: off the top always, and off the left
      or right when the selected card was the first or last one.

      The horizontal padding is what stops the end cards being cut. 1.06 on a
      108px card grows it ~3px each side, so 10px is comfortable margin.
    */
    padding: 10px;

    /*
      THE EDGE FEATHER ONLY EXISTS WHERE THERE IS MORE TO SCROLL TO.

      Both ramps default to 0%, so a rail that fits is not faded at all, and a
      rail scrolled hard left has no fade on its left. This is the same
      construct as the hub rail on /featured, and for the same reason: a fixed
      10%/90% ramp there dimmed the first and last item permanently, so two of
      five hubs looked disabled with nothing scrolled. Selecting an end card
      must never dim it.
    */
    -webkit-mask-image: linear-gradient(to right,
      transparent 0%, #000 var(--rail-fade-start, 0%),
      #000 calc(100% - var(--rail-fade-end, 0%)), transparent 100%);
    mask-image: linear-gradient(to right,
      transparent 0%, #000 var(--rail-fade-start, 0%),
      #000 calc(100% - var(--rail-fade-end, 0%)), transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hub-rail::-webkit-scrollbar { display: none; }

  .hub-rail-card {
    position: relative;
    flex: 0 0 auto;
    width: 108px;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #111;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }
  .hub-rail-card:hover,
  .hub-rail-card:focus-visible { opacity: 0.85; }
  /*
    Matches the deck rail on /featured: lift, brand border, brand glow — plus a
    caret above the selected tile so the link between the rail and the stage is
    stated rather than implied.
  */
  .hub-rail-card.active {
    opacity: 1;
    border-color: rgba(var(--brand-rgb, 204,0,0), 0.95);
    transform: scale(1.06);
    box-shadow: 0 5px 15px rgba(var(--brand-rgb, 204,0,0), 0.42);
  }
  .hub-rail-card.active::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -9px;
    width: 0;
    height: 0;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid rgba(var(--brand-rgb, 204,0,0), 0.95);
    pointer-events: none;
  }
  .hub-rail-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hub-rail-thumb--empty {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(150deg, rgba(var(--brand-rgb, 204,0,0), 0.30) 0%, #0b0b0d 70%);
  }
  .hub-rail-label {
    position: absolute;
    left: 5px;
    bottom: 4px;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    text-shadow: 0 1px 4px rgba(0,0,0,0.95);
  }

  /* ─── THE PANES THE RAIL SWITCHES TO ────────────────────────────────── */
  .hub-stage-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.7s ease;
    /* NO overflow: hidden — HARD RULE 3, the iframe is a sibling in here. */
  }
  .hub-stage-item.active {
    opacity: 1;
    visibility: visible;
  }
  .hub-stage-item-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hub-stage-item-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
      rgba(5,5,5,0.94) 0%, rgba(5,5,5,0.86) 14%, rgba(5,5,5,0.66) 30%,
      rgba(5,5,5,0.40) 46%, rgba(5,5,5,0.18) 62%, rgba(5,5,5,0.05) 78%,
      transparent 92%);
  }
  .hub-stage-item-copy {
    position: absolute;
    left: 1.4rem;
    right: 1.4rem;
    bottom: 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .hub-stage-item-kind {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(var(--brand-rgb, 204,0,0), 1);
  }
  .hub-stage-item-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(0.95rem, 1.5vw, 1.25rem);
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0,0,0,0.95);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hub-stage-item-action {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border: 1px solid rgba(255,255,255,0.3);
    background: transparent;
    color: rgba(255,255,255,0.94);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .hub-stage-item-action:hover,
  .hub-stage-item-action:focus-visible {
    border-color: rgba(var(--brand-rgb, 204,0,0), 0.95);
    background: rgba(var(--brand-rgb, 204,0,0), 0.16);
  }

  /* An item is showing: the mark and the trailer both stand down. */
  .hub-stage.is-item .hub-stage-mark { opacity: 0; }
  .hub-stage.is-item .hub-stage-video { opacity: 0; }

  /*
    PLAYING BEATS EVERYTHING ELSE ON THE STAGE.

    Without this the selected item's pane — its still, its title, its Play
    button — stayed at full opacity ON TOP of the frame it had just started.
    The video was loading and playing the whole time, behind an opaque image,
    which from the outside is indistinguishable from the button doing nothing.

    Reported as "I click it and it's not doing anything now", and my own check
    missed it because I pressed Play without first picking a rail card, so no
    pane was active to do the covering.
  */
  .hub-stage.is-playing .hub-stage-item {
    opacity: 0;
    visibility: hidden;
  }

  /*
    Top right, not bottom right: a video the visitor CHOSE runs with YouTube's
    own controls, and the bottom strip is theirs. The trailer has no controls
    at all, which is the case this exists for.
  */
  .hub-stage-sound {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 12;
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.75rem 0.38rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    /* Squared with the replay control. Leaving one of the two pills rounded
       would be the same inconsistency, just moved. */
    border-radius: 0;
    background: rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    cursor: pointer;
    opacity: 0.72;
    transition: opacity 0.25s ease, border-color 0.25s ease;
  }
  .hub-stage.is-playing:not(.is-chosen-video) .hub-stage-sound { display: inline-flex; }
  .hub-stage-sound:hover,
  .hub-stage-sound:focus-visible {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .hub-stage-sound-glyph {
    width: 16px;
    height: 16px;
    flex: none;
  }
  /* One glyph, two states. The slash shows while muted, the waves while not. */
  .hub-stage-sound[data-sound='off'] .hub-stage-sound-on,
  .hub-stage-sound[data-sound='on'] .hub-stage-sound-off {
    display: none;
  }
