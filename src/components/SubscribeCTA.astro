---
/**
 * SubscribeCTA — the "Don't miss a drop" band.
 *
 * ─── WHY THIS LOOKS THE WAY IT DOES ───────────────────────────────────────
 * This component used to be written twice: an `if compact / else default`
 * with two complete copies of the heading, the subtitle and both subscribe
 * buttons. The two branches differed only in a handful of inline styles, so
 * changing the wording or adding a third button meant editing it in two
 * places — and they had already started to drift.
 *
 * Now there is ONE piece of markup and the variant only switches a CSS class.
 * That is the general rule to follow in this codebase: if two blocks differ
 * only in styling, they should be one block with a class, never two blocks.
 *
 * ─── THE TWO VARIANTS ─────────────────────────────────────────────────────
 *   default   full-width band with page margins — used at the bottom of pages
 *   compact   tighter, smaller type — used inside narrower columns
 *
 * ─── WHERE THE WORDS COME FROM ────────────────────────────────────────────
 * Heading:  SECTIONS.subscribe   (src/data/content.js)
 * Subtitle: MESSAGES.subscribeSubtitle
 * Buttons:  LABELS.subscribeSubstack / LABELS.subscribeYouTube
 * Links:    site.socials          (src/data/site.js)
 *
 * To change any of that wording, edit those files — not this one.
 */
import PageTitle from './PageTitle.astro';
import { site } from '../data/site.js';
import { SECTIONS, LABELS, MESSAGES } from '../data/content.js';
import NewsletterForm from './NewsletterForm.astro';

export interface Props {
  /** Override the standard subtitle for a specific page. */
  subtitle?: string;
  /** `compact` tightens spacing for use inside a narrow column. */
  variant?: 'default' | 'compact';
}

const { subtitle = MESSAGES.subscribeSubtitle, variant = 'default' } = Astro.props;

/**
 * The two subscribe destinations. Adding a third (say Patreon) is one entry
 * here — the markup below loops, so nothing else needs touching.
 */
const subscribeLinks = [
  { label: LABELS.subscribeSubstack, href: site.socials.substack },
  { label: LABELS.subscribeYouTube, href: site.socials.youtube },
];

const isCompact = variant === 'compact';
---

<section
  class:list={['subscribe-cta', { 'is-compact': isCompact, container: !isCompact, reveal: isCompact }]}
  data-delay={isCompact ? '400' : undefined}
>
  <div class:list={['cta-band', { reveal: !isCompact }]}>
    <div class="subscribe-cta-copy">
      <div class="section-header subscribe-cta-header">
        <PageTitle {...SECTIONS.subscribe} scale="secondary" />
      </div>
      <p class="subscribe-cta-subtitle">{subtitle}</p>
    </div>

    {/* Primary action: capture the address on our own domain. The platform
        links below remain as secondary options — this adds a path, it does
        not remove the existing ones. */}
    <NewsletterForm />

    <div class="cta-buttons-wrapper">
      {
        subscribeLinks.map((link) => (
          <a class="cta-button-primary" href={link.href} target="_blank" rel="noopener">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Shared by both variants — this is what used to be typed inline twice. */
  .subscribe-cta {
    position: relative;
    z-index: 10;
    margin-bottom: 2rem;
  }

  .subscribe-cta .cta-band {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .subscribe-cta-copy {
    width: 100%;
    text-align: center;
  }

  .subscribe-cta-header {
    margin-bottom: 1rem;
  }

  .subscribe-cta-subtitle {
    color: var(--color-white-muted);
  }

  /* ── compact variant ────────────────────────────────────────────────────
     The ONLY differences from the default. Anything not listed here is
     shared, which is the point of the refactor. */
  .subscribe-cta.is-compact {
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .subscribe-cta.is-compact .subscribe-cta-subtitle {
    font-size: 0.9rem;
  }

  .subscribe-cta.is-compact .cta-buttons-wrapper {
    flex-wrap: wrap;
  }

  .subscribe-cta.is-compact .cta-button-primary {
    white-space: nowrap;
  }

  /* ── buttons ────────────────────────────────────────────────────────────
     Stacked on phones, side by side from 768px. */
  .cta-buttons-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
    width: 100%;
  }

  .cta-buttons-wrapper .cta-button-primary {
    width: 100%;
    text-align: center;
  }

  @media (min-width: 768px) {
    .cta-buttons-wrapper {
      flex-direction: row;
    }

    .cta-buttons-wrapper .cta-button-primary {
      flex: 1;
    }
  }
</style>
