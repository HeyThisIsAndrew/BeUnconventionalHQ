---
import PageTitle from './PageTitle.astro';
import ContentCard from './ContentCard.astro';
import { getVideosUnified } from '../lib/videos-source';

const allVideos = await getVideosUnified();

// Hardcode or filter the 3 strongest pieces for the portfolio strip
// e.g., Mortal Kombat 2 review, On-Location Coverage, Deep Analysis
const portfolioVideos = allVideos
  .filter(v => v.title.toLowerCase().includes('review') || v.title.toLowerCase().includes('mortal kombat'))
  .slice(0, 3);

// Fallback if not enough matching videos exist in the dataset
if (portfolioVideos.length < 3) {
  portfolioVideos.push(...allVideos.filter(v => !portfolioVideos.includes(v)).slice(0, 3 - portfolioVideos.length));
}
---

<section class="journalism-strip container" style="margin: 4rem auto 6rem; max-width: 1536px;">
  <div class="section-header animate-on-scroll">
    <PageTitle kicker="Editorial Depth" primary="Reviews &" secondary="Analysis" />
    <p class="journalism-desc" style="text-align: center; color: var(--color-white-muted); max-width: 600px; margin: 1rem auto 3rem;">
      Deep dives, on-location coverage, and critical analysis from a cinematic perspective.
    </p>
  </div>
  
  <div class="journalism-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: 2.5rem;">
    {portfolioVideos.map((video, index) => (
      <ContentCard item={video} index={index} />
    ))}
  </div>
</section>
