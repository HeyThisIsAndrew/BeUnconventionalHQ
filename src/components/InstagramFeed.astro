---
import { getFlattenedGallery } from '../lib/instagram.js';
import CinematicGallery from './CinematicGallery.astro';
import { SOCIAL_ICONS } from '../data/icons.js';
import { site } from '../data/site.js';

export interface Props {
  limit?: number;
  keyword?: string;
  minItems?: number;
}

const { limit = 10, keyword, minItems = 5 } = Astro.props;

// Get the gallery and limit the items if requested
const feed = getFlattenedGallery(keyword) || [];
const items = Array.isArray(feed) ? feed.slice(0, limit) : [];
// Ensure we only render if we have actual valid items (not undefined or missing urls)
const validItems = items.filter(item => item && item.displayUrl);
const shouldRender = validItems.length >= minItems;
---

{shouldRender && (
  <section class="instagram-feed-section container" aria-labelledby="instagram-feed-heading">
    <div class="instagram-feed-header">
      <h2 id="instagram-feed-heading" class="intel-break-title">Latest on Instagram</h2>
    </div>
    
    <CinematicGallery items={items} />

    <div class="latest-view-all animate-on-scroll">
      <a href={site.socials.instagram} target="_blank" rel="noopener noreferrer" class="view-all-link ig-view-all">
        FOLLOW ON <span class="ig-icon" set:html={SOCIAL_ICONS.Instagram}></span>
      </a>
    </div>
  </section>
)}

<style>
  .instagram-feed-section {
    margin: 0 auto 6rem; /* Top margin is 0 (spacing from previous section), bottom is exactly 6rem */
  }

  .instagram-feed-header {
    margin-bottom: 1rem;
  }

  .ig-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap; /* prevent breaking on mobile */
  }

  @media (max-width: 560px) {
    .instagram-feed-header h2 {
      font-size: clamp(0.75rem, 4vw, 1rem);
    }
  }

  .ig-icon {
    display: inline-flex;
    width: 14px;
    height: 14px;
    fill: currentColor;
    /* Center it slightly better with the text */
    transform: translateY(-1px);
  }
</style>
