---
import { getFlattenedGallery } from '../lib/instagram.js';
import CinematicGallery from './CinematicGallery.astro';
import { SOCIAL_ICONS } from '../data/icons.js';

export interface Props {
  limit?: number;
}

const { limit = 10 } = Astro.props;

// Get the gallery and limit the items if requested
const feed = getFlattenedGallery() || [];
const items = Array.isArray(feed) ? feed.slice(0, limit) : [];
---

{items.length > 0 && (
  <section class="instagram-feed-section container" aria-labelledby="instagram-feed-heading">
    <div class="instagram-feed-header">
      <h2 id="instagram-feed-heading" class="intel-break-title">Latest on Instagram</h2>
      <a href="https://www.instagram.com/beunconventional/" target="_blank" rel="noopener noreferrer" class="instagram-follow-btn">
        <span class="ig-icon" set:html={SOCIAL_ICONS.Instagram}></span>
        FOLLOW BE UNCONVENTIONAL HQ
      </a>
    </div>
    
    <CinematicGallery items={items} />
  </section>
)}

<style>
  .instagram-feed-section {
    margin: 4rem 0;
  }

  .instagram-feed-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .instagram-follow-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-white-muted, #a1a1aa);
    text-decoration: none;
    transition: color 0.2s ease, text-decoration 0.2s ease;
  }

  .ig-icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .instagram-follow-btn:hover {
    color: var(--color-accent, #cc0000);
    text-decoration: underline;
  }
</style>
