---
/**
 * Structural page section: a centred, width-capped `<section>` with optional
 * vertical padding.
 *
 * Spacing is passed as literal CSS values rather than a named scale. That is
 * deliberate — this component was extracted from pages whose spacing was
 * already inlined and slightly irregular, and inventing a scale here would
 * change rendered output. Introducing a spacing scale is a separate,
 * visual-review-gated change (see issue #50).
 *
 * `pt` / `pb` are only emitted when supplied, so a section that never declared
 * a `padding-top` does not gain `padding-top: 0`.
 */
interface Props {
  pt?: string;
  pb?: string;
  maxWidth?: string;
  container?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  pt,
  pb,
  /*
    THE TOKEN, NOT A NUMBER. This defaulted to a hard '1536px' and wrote it as
    an INLINE style, which outranks every stylesheet — including `.container`'s
    own `max-width: var(--page-max)`. So `--page-max` stepping up to 1920, 2240
    and 2600 on bigger screens did nothing on any page built from <Section>,
    and on a 3840px monitor every section stopped growing 1000px before the
    page around it did. That is the "tiles are now tiny" report: the tiles were
    not shrinking, they were the only thing that had stopped.

    `--page-max` is 1536px at its own base step (layout.css), so nothing below
    1920 moves by a pixel. A caller that wants a specific width still passes
    one.
  */
  maxWidth = 'var(--page-max, 1536px)',
  container = true,
  class: className = '',
  ...rest
} = Astro.props;

const style = [
  pt !== undefined ? `padding-top: ${pt}` : '',
  pb !== undefined ? `padding-bottom: ${pb}` : '',
  `max-width: ${maxWidth}`,
  'margin: 0 auto',
]
  .filter(Boolean)
  .join('; ');

const classes = [container ? 'container' : '', className].filter(Boolean).join(' ');
---

<section class={classes} style={`${style};`} {...rest}>
  <slot />
</section>
