---
import { getDisplayTags } from '../lib/tags';

import { parseVideoId } from '../lib/platforms/youtube';
import { getCardImageSources, CARD_IMAGE_SIZES } from '../lib/card-images';
import { LABELS } from '../data/content.js';
import { CATEGORY_TAG_ALIASES, categoryTagAliases } from '../data/constants.js';
import logoImage from '../assets/logo-mark.webp';
import { getImage } from 'astro:assets';

export interface Props {
  item: any;
  index: number;
  variant?: 'default' | 'hero';
}

const { item, index = 0, variant = 'default' } = Astro.props;

// Determine if this is the Largest Contentful Paint (LCP) element
const isLCP = variant === 'hero' && index === 0;

if (!item) return;

let excerpt = '';
let finalTags: string[] = [];

{
  // Use preview/excerpt for articles, or description for videos
  excerpt = item.preview || item.excerpt || item.description || '';

  finalTags = getDisplayTags(item);

  // Clean up any HTML tags if present (e.g., from article excerpts)
  if (typeof excerpt === 'string') {
    // Strip HTML tags and any leading/trailing hashtags clusters
    excerpt = excerpt.replace(/<[^>]*>?/gm, '').replace(/^(?:\s*#[\w-]+\s*)+/, '').replace(/(?:\s*#[\w-]+\s*)+$/, '').trim();
  }
}

const isVideo = item.contentType === 'video' || item.type === 'video';
const videoId = isVideo ? parseVideoId(item.link || '') : null;
const isPlayable = isVideo && !!videoId;

// Determine primary label for the badge
const baseTags = Array.isArray(item.tags) ? item.tags : (Array.isArray(item.youtubeTags) ? item.youtubeTags : []);
const itemTags = [...baseTags, item.category || ''];
const lowerTags = itemTags.map((t: string) => typeof t === 'string' ? t.toLowerCase() : '');

/*
  `data-categories` is what the Feed's #hash filter reads (see FeedGrid), and
  it is NOT the same list as the tags above.

  A card's tags are whatever Substack or YouTube supplied, so a games post says
  "gaming" and will keep saying it. Filtering on the renamed slug alone would
  have matched nothing. Expanding through the alias map means the card answers
  to every spelling of its own category, which also keeps any #gaming link
  already shared or bookmarked working after the rename.
*/
const filterKeys = new Set(lowerTags.filter(Boolean));
for (const slug of Object.keys(CATEGORY_TAG_ALIASES)) {
  const aliases = categoryTagAliases(slug);
  if (aliases.some((alias: string) => filterKeys.has(alias))) {
    aliases.forEach((alias: string) => filterKeys.add(alias));
  }
}
const filterAttr = [...filterKeys].join(',');

let primaryLabel = item.category || '';
if (!primaryLabel || primaryLabel.toLowerCase() === 'general') {
  if (lowerTags.includes('gaming') || lowerTags.includes('games')) primaryLabel = 'Games';
  else if (lowerTags.includes('film') || lowerTags.includes('movies')) primaryLabel = 'Film';
  else if (lowerTags.includes('tv') || lowerTags.includes('television')) primaryLabel = 'TV';
  else if (lowerTags.includes('event') || lowerTags.includes('events')) primaryLabel = 'Event';
  else primaryLabel = isVideo ? 'Video' : 'Article';
}

// Render anchor or div depending on type. We use 'video-card-home' for both
// so they share the exact hover effects from home-cards.css.
// Articles used to live only on Substack, so every non-video card opened in a
// new tab. Now that an article can resolve to a page on this site, decide from
// the href itself: absolute URLs leave the site and keep target/rel, relative
// ones are internal navigation and must not. Video behaviour is unchanged.
/*
  The cover to show, plus the renditions to offer for it — or empty strings if
  there genuinely isn't one, which is what makes the `cardImage ?` branch below
  pick the branded fallback panel instead of an <img>.

  Both the normalising and the sizing live in src/lib/card-images.ts, so they
  are covered by scripts/card-images.test.mjs rather than eyeballed. That
  matters more than it sounds: this started as two inline string replaces, and
  one of them was dead on real data — Substack widths were only ever REPLACED,
  and 6 of the 11 proxied URLs in articles.json carry no width at all, so those
  cards silently kept loading the full 2048x1152 upload.

  Still trimmed in there, and still for the original reason: several records
  carry `image: ''` or a string of spaces rather than omitting the field, and
  `''` is falsy while `' '` is not — an untrimmed whitespace value would reach
  <img src> and paint exactly the broken box the fallback exists to avoid.
*/
const { src: cardImage, srcset: cardImageSrcset } = getCardImageSources(
  item.image ?? item.thumbnail,
);

const cardHref = item.link || '#';
const isExternalLink = /^https?:\/\//i.test(cardHref);
const externalLinkProps = isExternalLink
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};

const CardWrapper = isPlayable ? 'div' : 'a';
const wrapperProps = isPlayable
  ? {
      class: `reveal video-card-home content-card w-full variant-${variant}`,
      'data-delay': index * 100,
      'data-type': 'video',
      'data-categories': filterAttr,
      'data-video-id': videoId,
      'data-action': variant === 'hero' ? 'inline-video' : 'open-video',
      role: 'button' as const,
      tabindex: 0,
      /*
        NO `aria-label` HERE — it is what broke `label-content-name-mismatch`.

        `role="button"` takes its name from its content, and WCAG 2.5.3
        (Label in Name) requires the accessible name to CONTAIN the visible
        text. An `aria-label` of "Play video: <title>" replaced a name built
        from the card's own words — the kicker, headline, tag row, excerpt
        and "Watch Now" — with a much shorter string that does not contain
        them, so speech input users saying what they can read ("watch now")
        could not address the control.

        Dropping it lets the name come from the content, which contains the
        visible text by construction. The "Play video" framing is kept as an
        sr-only span inside the card instead: it joins the accessible name
        without adding visible text for the name to have to contain.
      */
    }
  : {
      href: cardHref,
      ...externalLinkProps,
      class: `reveal video-card-home content-card w-full variant-${variant}`,
      'data-categories': filterAttr,
      'data-type': isVideo ? 'video' : 'article',
      'data-delay': index * 100
    };

/*
  THE WATERMARK MUST GO THROUGH getImage(), NOT `logoImage.src`.

  This shipped as `<img src={logoImage.src}>` and 404'd on every single video
  card in the production build. `@astrojs/cloudflare` turns on compile-time
  image optimization, so the build emits only the TRANSFORMED renditions
  (`logo-mark.<hash>_<variant>.webp`); the untransformed path that
  `logoImage.src` resolves to — `/assets/logo-mark.<hash>.webp` — is never
  written. It looks correct in dev, where the dev server serves the original
  on demand, and only breaks once built.

  That one 404 was the whole black-thumbnail bug, and it is worth spelling
  out why a decorative overlay could do that much damage: this <img> is a
  SIBLING of the cover inside `.content-card-media`, the fail-safe in
  Layout.astro marks the shared CONTAINER, and home-cards.css then hides
  every `> img` in it. So a broken watermark took the perfectly good
  thumbnail down with it, on every card, deterministically.

  Layout.astro already reaches for the same asset the right way (see
  `fallbackMark`). Requested at 72px because the mark renders at 24px tall in
  the standard card and 36px in the hero — 2x the widest of those, rather
  than the 414 KB original.
*/
const watermark = await getImage({
  src: logoImage,
  height: 72,
  format: 'webp',
  quality: 70,
});

/*
  VideoObject JSON-LD, per Google's video indexing guidelines.

  `Record<string, unknown>` rather than an inferred object literal: `duration`
  is appended conditionally below, and TypeScript will not let you add a key
  that the inferred shape does not have (ts(2339)).

  THE DESCRIPTION IS THE CLEANED EXCERPT, TRUNCATED - NOT `item.description`.
  A raw YouTube description on this channel runs 2-3 KB of chapter lists,
  affiliate links and hashtag blocks. Emitted verbatim on every card, that put
  18 KB of JSON-LD into the homepage's 351 KB of HTML, about 5% of the document,
  to say nothing a summary does not. `excerpt` is the same text already
  stripped of markup and hashtag clusters further up this file, so this reuses
  that work rather than cleaning the string a second time.
*/
const SCHEMA_DESCRIPTION_MAX = 300;
let videoSchemaJson: Record<string, unknown> | null = null;
if (isVideo && item.youtubeId) {
  const schemaDescription = excerpt.length > SCHEMA_DESCRIPTION_MAX
    ? `${excerpt.slice(0, SCHEMA_DESCRIPTION_MAX).trimEnd()}...`
    : excerpt;
  videoSchemaJson = {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": item.title,
    "description": schemaDescription,
    "thumbnailUrl": [item.thumbnailUrl || item.thumbnail || cardImage],
    "uploadDate": item.publishedAt || item.date,
    "contentUrl": `https://www.youtube.com/watch?v=${item.youtubeId}`,
    "embedUrl": `https://www.youtube.com/embed/${item.youtubeId}`,
    // schema.org types familyFriendly as Boolean, not the string "yes".
    "familyFriendly": true
  };
  // Convert duration to ISO 8601 duration format (e.g., PT120S)
  if (item.durationSeconds) {
    videoSchemaJson.duration = `PT${Math.round(item.durationSeconds)}S`;
  }
}
---

<CardWrapper {...wrapperProps} data-play-hover={isVideo ? 'true' : undefined}>
  {videoSchemaJson && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(videoSchemaJson).replace(/</g, '\\u003c')} />
  )}
  {/*
    Supplies the action verb the removed `aria-label` used to carry. It is
    part of the accessible name (name-from-content walks hidden-from-sight
    text) but not part of the visible text, which is exactly the asymmetry
    Label in Name needs: the name becomes "Play video: <everything visible>",
    which still contains every word a reader can see.
  */}
  {isPlayable && <span class="sr-only">Play video:</span>}
  {/*
    Every style here is a class, not an inline `style` attribute.

    That matters for more than tidiness: inline styles beat any class rule, so
    while the thumbnail and copy were inlined it was impossible to give this
    card a different layout at a different breakpoint without `!important`.
    Moving them to classes is what allows the compact mobile card below
    (.content-card at <=560px becomes a horizontal row).

    All of it lives in styles/modules/home-cards.css under `.content-card`.
  */}
  {/*
    ─── NO IMAGE MEANS NO <img> ───────────────────────────────────────────
    This used to render `<img src={item.image || item.thumbnail}>`
    unconditionally. When an item has neither — several do — that evaluates to
    an EMPTY STRING, and an empty `src` resolves to the current page URL: the
    browser fetches the HTML document, fails to decode it as an image, and
    paints a broken-image glyph with the alt text sprawling across the
    thumbnail. That is the "card rendering as a completely empty box".

    It also breaks hard rule 4 in CLAUDE.md ("never assign an empty src"),
    which was written about iframes but applies for exactly the same reason.

    So the image is only rendered when there is genuinely one to show;
    otherwise the card gets the same branded fallback panel the article
    thumbnails use, and reads as deliberate.
  */}
  <div class="content-card-media">
    {cardImage ? (
      <img
        class="content-card-img"
        src={cardImage}
        srcset={cardImageSrcset || undefined}
        sizes={cardImageSrcset ? CARD_IMAGE_SIZES : undefined}
        alt={item.title}
        loading={isLCP ? 'eager' : 'lazy'}
        fetchpriority={isLCP ? 'high' : 'auto'}
        decoding={isLCP ? 'sync' : 'async'}
      />
    ) : (
      <div class="article-thumb-fallback" data-fallback="true">
        <span class="article-thumb-fallback-title">{item.title}</span>
      </div>
    )}

    {/*
      The shadow belongs to the WRAPPER, not the <img> — hard rule 6
      ("no `filter: drop-shadow` on an <img>", for known iOS Safari rendering
      bugs). It matters more than usual here because this element is a
      compositing sibling of a cross-origin iframe, which is the exact
      neighbourhood of the WebKit bug the clip release above is fixing. The
      <img> keeps the class and the opacity, so the player script's
      `.video-watermark-logo` lookups are unchanged.
    */}
    {isVideo && (
      <span class="video-watermark" aria-hidden="true">
        <img 
          src={watermark.src} 
          width={watermark.attributes.width}
          height={watermark.attributes.height}
          alt="" 
          class="video-watermark-logo" 
          aria-hidden="true" 
        />
      </span>
    )}

    {isVideo && (
      <div class="play-button-wrapper" aria-hidden="true">
        <div class="cinematic-play-button">
          <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
    )}
  </div>

  <div class="content-card-body">
    <div class="content-card-title-wrapper">
      <h3 class="content-card-title">{item.title}</h3>
      {finalTags.length > 0 && (
        <div class="content-card-dynamic-tags">
          {finalTags.join(' | ')}
        </div>
      )}
    </div>

    {variant === 'hero' && excerpt && (
      <p class="content-card-excerpt">{excerpt}</p>
    )}
    
    <span class="watch-now-btn" style="margin-top: auto;">
      {isVideo ? LABELS.watchNow : LABELS.readNow}
      {isVideo ? (
        <svg class="youtube-icon" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
          <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
        </svg>
      ) : (
        <span class="content-card-arrow" aria-hidden="true">&rarr;</span>
      )}
      <span class="btn-underline" />
    </span>
  </div>
</CardWrapper>

<style>
  .content-card-excerpt {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    margin: 0.5rem 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Lock heights to prevent layout jumping when switching active items */
  :global(.content-card-excerpt) {
    color: #A3A3A3;
    height: 4.5em; /* Exactly 3 lines at 1.5 line-height */
  }

  .variant-hero :global(.content-card-media) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface-elevated, #1a1a1a);
  }

  .variant-hero :global(.content-card-media)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 30%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
    pointer-events: none;
    z-index: 1; /* Below play button (z-index 2), above iframe (z-index 0) */
  }
  
  /* Hide vignette when video plays */
  :global(.content-card-media.is-playing-inline)::after {
    opacity: 0 !important;
    transition: opacity 0.1s ease !important;
  }

  /* Inline video iframe styles - forced via !important to override YouTube JS */
  :global(.yt-player-target),
  .variant-hero :global(iframe) {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    transform: translateZ(0) !important;
    border: none !important;
    z-index: 0;
    background: transparent;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  /* Watermark Logo */
  .video-watermark {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    pointer-events: none;
  }

  .video-watermark-logo {
    display: block;
    width: auto;
    height: 24px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* Move to bottom left for Hero cards */
  :global(.variant-hero) .video-watermark {
    top: auto;
    bottom: 2rem;
    left: 2rem;
    right: auto;
  }

  :global(.variant-hero) .video-watermark-logo {
    height: 36px;
  }

  /* Only show watermark when video is actively playing inline */
  :global(.is-playing-inline) .video-watermark-logo {
    opacity: 0.8;
  }
  
  /* The cover gives way to the preview as soon as it is playing... */
  :global(.content-card-media.is-playing-inline) img.content-card-img,
  :global(.content-card-media.is-playing-inline) .article-thumb-fallback {
    opacity: 0 !important;
    pointer-events: none;
    transition: opacity 0.1s ease !important;
  }

  /*
    ...but THE PLAY ICON OUTLASTS IT, deliberately.

    It used to fade with the cover, which left a silent, muted video playing
    over a card with no affordance on it at all — nothing said "click for
    sound". Keeping it up through the preview is the whole point: it is the
    one control on screen while the iframe is inert, and it is what the
    reader clicks to unmute.

    It stands down only once they have actually activated the video, because
    from that moment YouTube's own controls are live underneath and two
    stacked play/pause buttons is exactly the overlap being fixed here.
  */
  :global(.content-card-media.is-user-activated) .play-button-wrapper {
    opacity: 0 !important;
    pointer-events: none;
    transition: opacity 0.1s ease !important;
  }

  :global(.content-card-body) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  :global(.content-card-title-wrapper) {
    font-size: 1.1rem;
    line-height: 1.4;
    min-height: 2.8em; /* Accommodate up to 2 lines */
    height: auto;
    overflow: visible;
    margin-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.3rem; /* ensures title pushes tags down safely */
  }

  :global(.content-card-title) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 1em;
    line-height: 1.4;
    height: auto;
    margin-bottom: 0;
  }

  :global(.content-card-dynamic-tags) {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    
    height: auto;
    min-height: 1.2rem;
    display: flex;
    align-items: center; /* Vertically center within the gap */
    
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

</style>
