---
import { parseVideoId } from '../lib/platforms/youtube';
import { LABELS } from '../data/content.js';

export interface Props {
  item: any;
  index: number;
}

const { item, index = 0 } = Astro.props;
const isVideo = item.contentType === 'video' || item.type === 'video';
const videoId = isVideo ? parseVideoId(item.link) : null;
const isPlayable = isVideo && !!videoId;

// Determine primary label for the badge
const baseTags = Array.isArray(item.tags) ? item.tags : [];
const itemTags = [...baseTags, item.category || 'General'];
const lowerTags = itemTags.map((t: string) => typeof t === 'string' ? t.toLowerCase() : '');
let primaryLabel = 'General';
if (isVideo) primaryLabel = 'Video';
else if (lowerTags.includes('tv')) primaryLabel = 'TV';
else if (lowerTags.includes('film')) primaryLabel = 'Film';
else if (lowerTags.includes('gaming')) primaryLabel = 'Gaming';
else if (lowerTags.includes('event') || lowerTags.includes('events')) primaryLabel = 'Event';
else primaryLabel = item.category || 'Article';

// Render anchor or div depending on type. We use 'video-card-home' for both
// so they share the exact hover effects from home-cards.css.
// Articles used to live only on Substack, so every non-video card opened in a
// new tab. Now that an article can resolve to a page on this site, decide from
// the href itself: absolute URLs leave the site and keep target/rel, relative
// ones are internal navigation and must not. Video behaviour is unchanged.
/*
  The cover to show, or an empty string if there genuinely isn't one.

  `.trim()` matters: several records carry `image: ''` (or a string of spaces)
  rather than omitting the field, and `''` is falsy but `' '` is not — without
  the trim a whitespace-only value would still be handed to <img src> and
  produce exactly the broken box this guards against.
*/
const rawImage = String(item.image ?? item.thumbnail ?? '').trim();
let cardImage = rawImage;

if (cardImage) {
  if (cardImage.includes('i.ytimg.com') && cardImage.includes('maxresdefault.jpg')) {
    // maxresdefault is 1280x720. hqdefault is 480x360, perfect for cards.
    cardImage = cardImage.replace('maxresdefault.jpg', 'hqdefault.jpg');
  } else if (cardImage.includes('substackcdn.com/image/fetch/')) {
    // Substack uses Cloudinary parameters in the URL. 
    // Replace w_1200 with w_600 and h_600 with h_338 to reduce payload by ~4x.
    cardImage = cardImage.replace(/w_\d+/, 'w_600').replace(/h_\d+/, 'h_338');
  }
}

const cardHref = item.link || '#';
const isExternalLink = /^https?:\/\//i.test(cardHref);
const externalLinkProps = isExternalLink
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};

const CardWrapper = isPlayable ? 'div' : 'a';
const wrapperProps = isPlayable
  ? {
      class: "reveal video-card-home content-card w-full",
      'data-delay': index * 100,
      'data-type': 'video',
      'data-categories': lowerTags.join(','),
      'data-video-id': videoId,
      'data-action': 'open-video',
      role: 'button' as const,
      tabindex: 0,
      'aria-label': `Play video: ${item.title}`
    }
  : {
      href: cardHref,
      ...externalLinkProps,
      class: `reveal video-card-home content-card w-full`,
      'data-categories': lowerTags.join(','),
      'data-type': isVideo ? 'video' : 'article',
      'data-delay': index * 100
    };
---

<CardWrapper {...wrapperProps}>
  {/*
    Every style here is a class, not an inline `style` attribute.

    That matters for more than tidiness: inline styles beat any class rule, so
    while the thumbnail and copy were inlined it was impossible to give this
    card a different layout at a different breakpoint without `!important`.
    Moving them to classes is what allows the compact mobile card below
    (.content-card at <=560px becomes a horizontal row).

    All of it lives in styles/modules/home-cards.css under `.content-card`.
  */}
  {/*
    ─── NO IMAGE MEANS NO <img> ───────────────────────────────────────────
    This used to render `<img src={item.image || item.thumbnail}>`
    unconditionally. When an item has neither — several do — that evaluates to
    an EMPTY STRING, and an empty `src` resolves to the current page URL: the
    browser fetches the HTML document, fails to decode it as an image, and
    paints a broken-image glyph with the alt text sprawling across the
    thumbnail. That is the "card rendering as a completely empty box".

    It also breaks hard rule 4 in CLAUDE.md ("never assign an empty src"),
    which was written about iframes but applies for exactly the same reason.

    So the image is only rendered when there is genuinely one to show;
    otherwise the card gets the same branded fallback panel the article
    thumbnails use, and reads as deliberate.
  */}
  <div class="content-card-media">
    {cardImage ? (
      <img
        class="content-card-img"
        src={cardImage}
        alt={item.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="article-thumb-fallback" data-fallback="true">
        <span class="article-thumb-fallback-title">{item.title}</span>
      </div>
    )}
  </div>

  <div class="content-card-body">
    <div class="content-card-meta">
      <span>{primaryLabel}</span>
      {item.date && (
        <>
          <span aria-hidden="true">&bull;</span>
          <span>{item.date}</span>
        </>
      )}
    </div>

    <h3 class="content-card-title">{item.title}</h3>

    <span class="watch-now-btn">
      {isVideo ? LABELS.watchNow : LABELS.readNow}{' '}
      <span class="content-card-arrow" aria-hidden="true">&rarr;</span>
      <span class="btn-underline" />
    </span>
  </div>
</CardWrapper>
