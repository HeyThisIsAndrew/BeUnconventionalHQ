---
/**
 * A client-side Web Component that upgrades <substack-gallery> tags emitted by
 * the HTML sanitizer into a swipeable carousel.
 * 
 * Included globally on article pages so any injected galleries are automatically
 * enhanced without needing React or complex state. Uses CSS-only scroll snapping
 * for performance.
 */
---
<script>
  class SubstackGallery extends HTMLElement {
    constructor() {
      super();
      
      // Upgrade only once per element
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      
      const images = Array.from(this.querySelectorAll('img'));
      if (images.length === 0) return;

      // Wrap images in a scroll container
      const container = document.createElement('div');
      container.className = 'substack-gallery-container';
      
      images.forEach(img => {
        const slide = document.createElement('div');
        slide.className = 'substack-gallery-slide';
        
        // Wrap in a button to trigger lightbox
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'substack-gallery-trigger';
        button.setAttribute('aria-label', 'View image full screen');
        
        // Click handler for lightbox
        button.addEventListener('click', (e) => {
          e.preventDefault();
          this.openLightbox(img.src, img.alt);
        });
        
        // Clone the image to avoid mutation issues during DOM move
        button.appendChild(img.cloneNode(true));
        slide.appendChild(button);
        container.appendChild(slide);
      });
      
      // Replace raw images with the interactive carousel container
      this.innerHTML = '';
      this.appendChild(container);
    }
    
    openLightbox(src: string, alt: string) {
      // Check if lightbox already exists, if so remove it
      let existing = document.getElementById('substack-lightbox');
      if (existing) existing.remove();
      
      const lightbox = document.createElement('div');
      lightbox.id = 'substack-lightbox';
      lightbox.className = 'substack-lightbox';
      
      const closeBtn = document.createElement('button');
      closeBtn.className = 'substack-lightbox-close';
      closeBtn.innerHTML = '&times;';
      closeBtn.setAttribute('aria-label', 'Close fullscreen');
      
      const img = document.createElement('img');
      img.src = src;
      img.alt = alt || '';
      img.className = 'substack-lightbox-img';
      
      lightbox.appendChild(closeBtn);
      lightbox.appendChild(img);
      
      // Close on click anywhere or escape key
      const closeHandler = () => {
        lightbox.classList.remove('active');
        setTimeout(() => lightbox.remove(), 300);
        document.removeEventListener('keydown', keyHandler);
        document.body.style.overflow = '';
      };
      
      const keyHandler = (e: KeyboardEvent) => {
        if (e.key === 'Escape') closeHandler();
      };
      
      lightbox.addEventListener('click', closeHandler);
      document.addEventListener('keydown', keyHandler);
      
      document.body.appendChild(lightbox);
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
      
      // Trigger animation
      requestAnimationFrame(() => {
        lightbox.classList.add('active');
      });
    }
  }

  if (!customElements.get('substack-gallery')) {
    customElements.define('substack-gallery', SubstackGallery);
  }
</script>

<style is:global>
  substack-gallery {
    display: block;
    margin: 2.5rem 0;
    width: 100%;
    position: relative;
    border-radius: 12px;
  }
  
  .substack-gallery-container {
    display: flex;
    align-items: center; /* Prevents slides from stretching to the same height */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    /* Removed padding-bottom to fix top/bottom padding imbalance */
    /* Custom scrollbar for webkit */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .substack-gallery-container::-webkit-scrollbar {
    height: 6px;
  }
  .substack-gallery-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .substack-gallery-container::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 20px;
  }

  .substack-gallery-slide {
    flex: 0 0 85%;
    scroll-snap-align: center;
    border-radius: 8px;
    overflow: hidden;
    /* Removed background color so there's no visible padding */
    display: block;
  }
  
  @media (min-width: 768px) {
    .substack-gallery-slide {
      flex: 0 0 75%;
    }
  }

  .substack-gallery-slide button.substack-gallery-trigger {
    display: block;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .substack-gallery-slide img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  
  .substack-gallery-slide button:hover img {
    transform: scale(1.02);
  }
  
  /* Lightbox Styles */
  .substack-lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(5px);
  }
  
  .substack-lightbox.active {
    opacity: 1;
    pointer-events: auto;
    cursor: zoom-out;
  }
  
  .substack-lightbox-img {
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.2, 1);
    border-radius: 4px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  
  .substack-lightbox.active .substack-lightbox-img {
    transform: scale(1);
  }
  
  .substack-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    color: white;
    font-size: 3rem;
    line-height: 1;
    font-weight: 300;
    cursor: pointer;
    z-index: 310;
    padding: 0.5rem;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  
  .substack-lightbox-close:hover {
    opacity: 1;
  }
</style>
