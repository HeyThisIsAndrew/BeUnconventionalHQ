---
/**
 * A client-side Web Component that upgrades <substack-gallery> tags emitted by
 * the HTML sanitizer into a swipeable carousel.
 * 
 * Included globally on article pages so any injected galleries are automatically
 * enhanced without needing React or complex state. Uses CSS-only scroll snapping
 * for performance.
 */
---
<script>
  import { lockScroll, unlockScroll } from '../lib/scroll-lock';

  class SubstackGallery extends HTMLElement {
    private _resizeObserver?: ResizeObserver;
    private _scrollTimeout?: ReturnType<typeof setTimeout>;

    constructor() {
      super();
      
      // Upgrade only once per element
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      
      const images = Array.from(this.querySelectorAll('img'));
      if (images.length === 0) return;

      const imageSources = images.map(img => ({ src: img.src, alt: img.alt }));

      // Wrap images in a scroll container
      const container = document.createElement('div');
      container.className = 'substack-gallery-container';
      
      // Create 5 identical groups for infinite scrolling
      for (let g = 0; g < 5; g++) {
        const group = document.createElement('div');
        group.className = 'substack-marquee-group';
        
        images.forEach((img, index) => {
          const slide = document.createElement('div');
          slide.className = 'substack-gallery-slide';
          
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'substack-gallery-trigger';
          button.setAttribute('aria-label', 'View image full screen');
          
          button.addEventListener('click', (e) => {
            e.preventDefault();
            this.openLightbox(index, imageSources, container);
          });
          
          // Only the first group steals the actual DOM nodes, others clone
          button.appendChild(g === 0 ? img : img.cloneNode(true));
          slide.appendChild(button);
          group.appendChild(slide);
        });
        
        container.appendChild(group);
      }
      
      this.innerHTML = '';
      this.appendChild(container);

      // Initialize infinite scroll teleportation
      setTimeout(() => {
        const groups = container.querySelectorAll('.substack-marquee-group');
        if (groups.length < 5) return;
        
        const groupWidth = (groups[1] as HTMLElement).offsetLeft - (groups[0] as HTMLElement).offsetLeft;
        // Start in the middle group (group 3, index 2)
        container.scrollLeft = groupWidth * 2;
        
        container.addEventListener('scroll', () => {
          container.style.pointerEvents = 'none';
          
          clearTimeout(this._scrollTimeout);
          this._scrollTimeout = setTimeout(() => {
            container.style.pointerEvents = '';
            const currentPosition = container.scrollLeft;
            const middlePosition = groupWidth * 2;
            const offset = currentPosition % groupWidth;
            
            // Snap if outside the middle zone
            if (currentPosition < groupWidth * 1 || currentPosition > groupWidth * 3) {
              container.scrollLeft = middlePosition + offset;
            }
          }, 150);
        }, { passive: true });
        
        // Re-measure on resize
        this._resizeObserver = new ResizeObserver(() => {
          // just force a re-snap by triggering a fake scroll
          container.dispatchEvent(new Event('scroll'));
        });
        this._resizeObserver.observe(container);
      }, 100);
    }
    
    disconnectedCallback() {
      if (this._resizeObserver) this._resizeObserver.disconnect();
      clearTimeout(this._scrollTimeout);
    }
    
    openLightbox(startIndex: number, imageSources: Array<{src: string, alt: string}>, container: HTMLElement) {
      // Check if lightbox already exists, if so remove it
      let existing = document.getElementById('substack-lightbox');
      if (existing) existing.remove();
      
      const lightbox = document.createElement('div');
      lightbox.id = 'substack-lightbox';
      lightbox.className = 'substack-lightbox';
      
      const closeBtn = document.createElement('button');
      closeBtn.className = 'substack-lightbox-close';
      closeBtn.innerHTML = '&times;';
      closeBtn.setAttribute('aria-label', 'Close fullscreen');
      
      let currentIndex = startIndex;
      const img = document.createElement('img');
      img.className = 'substack-lightbox-img';
      
      const updateImage = () => {
        img.src = imageSources[currentIndex].src;
        img.alt = imageSources[currentIndex].alt || '';
      };
      updateImage();
      
      lightbox.appendChild(closeBtn);
      lightbox.appendChild(img);

      const next = () => {
        currentIndex = (currentIndex + 1) % imageSources.length;
        updateImage();
      };

      const prev = () => {
        currentIndex = (currentIndex - 1 + imageSources.length) % imageSources.length;
        updateImage();
      };
      
      // Close on click outside image or escape key
      const closeHandler = (e?: Event) => {
        if (e && e.target === img) return; // Don't close if clicking the image itself
        lightbox.classList.remove('active');
        setTimeout(() => lightbox.remove(), 300);
        document.removeEventListener('keydown', keyHandler);
        unlockScroll();
        
        // SYNC STATE: Scroll the inline gallery to the last viewed image
        const groups = container.querySelectorAll('.substack-marquee-group');
        if (groups.length >= 3) {
          const middleGroup = groups[2] as HTMLElement;
          const targetSlide = middleGroup.children[currentIndex] as HTMLElement;
          if (targetSlide) {
            // Scroll to the exact position of the slide in the middle group
            container.scrollTo({
              left: targetSlide.offsetLeft - container.offsetLeft - 16, // match gap
              behavior: 'instant'
            });
          }
        }
      };
      
      const keyHandler = (e: KeyboardEvent) => {
        if (e.key === 'Escape') closeHandler();
        if (e.key === 'ArrowRight') next();
        if (e.key === 'ArrowLeft') prev();
      };
      
      lightbox.addEventListener('click', closeHandler);
      document.addEventListener('keydown', keyHandler);

      let touchStartX = 0;
      let touchEndX = 0;
      lightbox.addEventListener('touchstart', e => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });
      lightbox.addEventListener('touchend', e => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchEndX < touchStartX - 50) next();
        if (touchEndX > touchStartX + 50) prev();
      }, { passive: true });

      let wheelTimeout: ReturnType<typeof setTimeout> | null = null;
      lightbox.addEventListener('wheel', e => {
        e.preventDefault();
        if (wheelTimeout) return; // Debounce wheel
        
        if (e.deltaX > 20) {
          next();
          wheelTimeout = setTimeout(() => wheelTimeout = null, 300);
        } else if (e.deltaX < -20) {
          prev();
          wheelTimeout = setTimeout(() => wheelTimeout = null, 300);
        }
      }, { passive: false });
      
      document.body.appendChild(lightbox);
      lockScroll();
      
      // Trigger animation
      requestAnimationFrame(() => {
        lightbox.classList.add('active');
      });
    }
  }

  if (!customElements.get('substack-gallery')) {
    customElements.define('substack-gallery', SubstackGallery);
  }
</script>

<style is:global>
  substack-gallery {
    display: block;
    margin: 2.5rem 0;
    width: 100%;
    position: relative;
  }
  
  .substack-gallery-container {
    display: flex;
    align-items: center; /* Prevents slides from stretching to the same height */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    mask-image: linear-gradient(to right, transparent 0, black 16px, black calc(100% - 16px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 16px, black calc(100% - 16px), transparent 100%);
    /* Custom scrollbar for webkit */
    scrollbar-width: none; /* Hide scrollbar for infinite loop */
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    container-type: inline-size;
  }

  .substack-gallery-container::-webkit-scrollbar {
    display: none;
  }

  .substack-marquee-group {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .substack-gallery-slide {
    flex: 0 0 85cqw;
    scroll-snap-align: center;
    overflow: hidden;
    display: block;
  }
  
  @media (min-width: 768px) {
    .substack-gallery-slide {
      flex: 0 0 75cqw;
    }
  }

  .substack-gallery-slide button.substack-gallery-trigger {
    display: block;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .substack-gallery-slide img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  
  .substack-gallery-slide button:hover img {
    transform: scale(1.02);
  }
  
  /* Lightbox Styles */
  .substack-lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(5px);
  }
  
  .substack-lightbox.active {
    opacity: 1;
    pointer-events: auto;
    cursor: zoom-out;
  }
  
  .substack-lightbox-img {
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.2, 1);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  
  .substack-lightbox.active .substack-lightbox-img {
    transform: scale(1);
  }
  
  .substack-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    color: white;
    font-size: 3rem;
    line-height: 1;
    font-weight: 300;
    cursor: pointer;
    z-index: 310;
    padding: 0.5rem;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  
  .substack-lightbox-close:hover {
    opacity: 1;
  }
</style>
