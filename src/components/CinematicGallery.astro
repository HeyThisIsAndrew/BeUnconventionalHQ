---
import { getCardImageSources } from '../lib/card-images.js';

interface GalleryItem {
  id: string;
  mediaType: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
  displayUrl: string;
  videoUrl?: string;
  caption?: string;
  permalink?: string;
  likeCount?: number | string;
  commentCount?: number | string;
}

export interface Props {
  items: GalleryItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <infinite-marquee>
    <div class="ig-carousel-wrapper" style="mask-image: linear-gradient(to right, transparent 0, black 24px, black calc(100% - 24px), transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0, black 24px, black calc(100% - 24px), transparent 100%);">
      <div class="ig-carousel-track">
        {Array.from({ length: 5 }, (_, i) => i + 1).map((groupIndex) => (
          <div 
            class="ig-marquee-group" 
            aria-hidden={groupIndex > 2 ? "true" : undefined}
          >
          {items.map((item) => {
            if (!item || !item.displayUrl) return null;
            const sources = getCardImageSources(item.displayUrl);
            
            return (
              <a href={item.permalink} target="_blank" rel="noopener noreferrer" class="ig-carousel-tile" data-play-hover="true">
                <img 
                  src={sources.src} 
                  srcset={sources.srcset}
                  sizes="(max-width: 768px) 45vw, 240px"
                  alt={item.caption?.slice(0, 50) || 'Instagram Media'} 
                  loading="eager" 
                  decoding="async" 
                  class="ig-tile-img"
                />
                <div class="ig-tile-overlay">
                  {item.mediaType === 'VIDEO' && (
                    <div class="play-button-wrapper">
                      <div class="cinematic-play-button">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </div>
                    </div>
                  )}
                  <div class="ig-tile-content">
                    <div class="ig-accent-line"></div>
                    <p class="ig-text">{item.caption || "View post on Instagram"}</p>
                  </div>
                </div>
              </a>
            );
          })}
          </div>
        ))}
      </div>
    </div>
  </infinite-marquee>
)}

<script>
  class InfiniteMarquee extends HTMLElement {
    private _animationFrame?: number;
    private _resizeObserver?: ResizeObserver;
    private _isTouching: boolean = false;

    constructor() {
      super();
      
      const track = this.querySelector('.ig-carousel-track') as HTMLElement;
      if (!track) return;
      
      const groups = Array.from(track.querySelectorAll('.ig-marquee-group'));
      if (groups.length < 2) return;
      
      // Let images load before measuring
      setTimeout(() => {
        let groupWidth = (groups[1] as HTMLElement).offsetLeft - (groups[0] as HTMLElement).offsetLeft;
        const speed = 0.5; // pixels per frame
        let isPaused = false;
        
        this._resizeObserver = new ResizeObserver(() => {
          groupWidth = (groups[1] as HTMLElement).offsetLeft - (groups[0] as HTMLElement).offsetLeft;
        });
        this._resizeObserver.observe(track);
  
        // Start in the middle (group 3 of 5, index 2)
        let exactScrollLeft = groupWidth * 2;
        track.scrollLeft = exactScrollLeft;
  
        const updateScroll = () => {
          if (!isPaused && !this._isTouching) {
            exactScrollLeft += speed;
            
            // Endless loop wrapper logic for animation (non-momentum)
            if (exactScrollLeft >= groupWidth * 3) {
              exactScrollLeft -= groupWidth;
            } else if (exactScrollLeft <= groupWidth * 1) {
              exactScrollLeft += groupWidth;
            }
            
            track.scrollLeft = exactScrollLeft;
          } else {
            // Keep accumulator in sync with native scroll position
            exactScrollLeft = track.scrollLeft;
          }
          
          this._animationFrame = requestAnimationFrame(updateScroll);
        };
  
        this._animationFrame = requestAnimationFrame(updateScroll);
  
        // A single, unified scroll handler for all interaction types (touch, wheel, momentum)
        let scrollTimeout: ReturnType<typeof setTimeout>;
        
        // Pause auto-scrolling as soon as the user touches the carousel
        track.addEventListener('touchstart', () => {
          isPaused = true;
          this._isTouching = true;
        }, { passive: true });
        
        track.addEventListener('touchend', () => {
          // If no scroll happened (just a tap), we need to ensure it unpauses
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            this._isTouching = false;
            isPaused = false;
            track.classList.remove('is-scrolling');
          }, 150);
        }, { passive: true });

        track.addEventListener('scroll', () => {
          // Whenever the user natively scrolls, pause the JS auto-scroller
          isPaused = true;
          this._isTouching = true;
          
          // Disable pointer events on the TILES (via CSS), not the track itself, 
          // otherwise it instantly aborts the native swipe gesture on iOS!
          track.classList.add('is-scrolling');
          
          exactScrollLeft = track.scrollLeft;

          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            this._isTouching = false;
            isPaused = false;
            track.classList.remove('is-scrolling');
            
            // Once they completely stop scrolling (including momentum),
            // seamlessly snap the infinite loop back to the middle zone
            // to ensure we never hit the physical ends.
            const currentPosition = track.scrollLeft;
            const middlePosition = groupWidth * 2;
            const offset = currentPosition % groupWidth;
            
            // Only snap if we're actually near an edge to minimize DOM updates
            if (currentPosition < groupWidth * 1 || currentPosition > groupWidth * 3) {
              exactScrollLeft = middlePosition + offset;
              track.scrollTo({ left: exactScrollLeft, behavior: 'instant' });
            }
          }, 150); // 150ms after the last scroll event fires
        }, {passive: true});
        
      }, 100);
    }

    disconnectedCallback() {
      if (this._animationFrame) cancelAnimationFrame(this._animationFrame);
      if (this._resizeObserver) this._resizeObserver.disconnect();
    }
  }
    
    if (!customElements.get('infinite-marquee')) {
      customElements.define('infinite-marquee', InfiniteMarquee);
    }
  </script>

<style>
  /* 
    The wrapper fits standard layout, avoiding full-width bleed unless on small mobile.
    It contains the scrolling track.
  */
  .ig-carousel-wrapper {
    position: relative;
    width: 100%;
    /* Keep it in bounds on desktop */
    margin: 2rem 0;
    overflow: hidden; /* Hide the scrollbar visually for the wrapper */
  }

  /* 
    The track handles the horizontal scrolling natively now.
  */
  .ig-carousel-track {
    display: flex;
    gap: 1.25rem;
    padding: 1rem 0 2rem;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain; /* Prevents swipe navigation and bouncing */
    /* Cursor hinting that it can be dragged/swiped */
    cursor: grab;
  }

  .ig-carousel-track:active {
    cursor: grabbing;
  }
  
  .ig-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .ig-marquee-group {
    display: flex;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    /* No native snap on standard touch since we have JS momentum loop logic */
    /* .ig-carousel-track { scroll-snap-type: x mandatory; } */
  }

  /* 
    Tiles are strictly constrained to avoid internal scrolling.
    Fixed aspect ratio 4:5 (Standard Instagram Portrait).
  */
  .ig-carousel-tile {
    flex: 0 0 220px; /* Locked width */
    aspect-ratio: 4 / 5; /* Forces the height to wrap perfectly */
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    background: var(--color-surface, #111);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
    text-decoration: none;
    display: block;
  }

  @media (max-width: 560px) {
    /* Full bleed on small mobile without using 100vw to prevent horizontal scrollbars */
    .ig-carousel-wrapper {
      width: calc(100% + 2.5rem); /* layout padding is 1.25rem on each side at this size */
      margin-left: -1.25rem;
      margin-right: -1.25rem;
    }
    .ig-carousel-tile {
      flex: 0 0 160px; /* Even smaller on phones */
    }
  }

  .ig-carousel-tile:hover {
    transform: translateY(-8px);
    border-color: var(--color-accent);
    box-shadow: 0 12px 30px rgba(204, 0, 0, 0.2);
  }

  /* Prevent taps or hovers from sticking while the user is actively swiping */
  .ig-carousel-track.is-scrolling .ig-carousel-tile {
    pointer-events: none;
  }

  .ig-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Locks the image into the bounds perfectly */
    transition: transform 0.6s ease;
  }

  .ig-carousel-tile:hover .ig-tile-img {
    transform: scale(1.05);
  }

  /* 
    Cinematic Overlay matching the site's dark aesthetic 
  */
  .ig-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.95) 0%,
      rgba(9, 9, 11, 0.4) 40%,
      transparent 100%
    );
    opacity: 0.8;
    transition: background 0.3s ease, opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    pointer-events: none;
  }

  .ig-carousel-tile:hover .ig-tile-overlay {
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.98) 0%,
      rgba(9, 9, 11, 0.7) 50%,
      transparent 100%
    );
    opacity: 1;
  }



  .ig-tile-content {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transform: translateY(10px);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ig-carousel-tile:hover .ig-tile-content {
    transform: translateY(0);
    opacity: 1;
  }

  .ig-accent-line {
    height: 2px;
    width: 24px;
    background: rgba(220, 38, 38, 0.8);
    transition: width 0.5s ease-out;
  }

  .ig-carousel-tile:hover .ig-accent-line {
    width: 40px;
  }

  .ig-text {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.85rem;
    font-weight: 400; /* Ensure it is not bold */
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.4s ease, text-shadow 0.4s ease;
  }
  
  .ig-carousel-tile:hover .ig-text {
    color: #fff;
    text-shadow: 0 0 12px rgba(204, 0, 0, 0.4);
  }
</style>
