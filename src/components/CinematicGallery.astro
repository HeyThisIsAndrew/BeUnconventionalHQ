---
import { getCardImageSources } from '../lib/card-images.js';

interface GalleryItem {
  id: string;
  mediaType: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
  displayUrl: string;
  videoUrl?: string;
  caption?: string;
  permalink?: string;
  likeCount?: number | string;
  commentCount?: number | string;
}

export interface Props {
  items: GalleryItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <infinite-marquee>
    <div class="ig-carousel-wrapper">
      <div class="ig-carousel-track">
        {[1, 2, 3].map((groupIndex) => (
          <div 
            class="ig-marquee-group" 
            aria-hidden={groupIndex > 1 ? "true" : undefined}
          >
          {items.map((item) => {
            if (!item || !item.displayUrl) return null;
            const sources = getCardImageSources(item.displayUrl);
            
            return (
              <a href={item.permalink} target="_blank" rel="noopener noreferrer" class="ig-carousel-tile">
                <img 
                  src={sources.src} 
                  srcset={sources.srcset}
                  sizes="(max-width: 768px) 45vw, 240px"
                  alt={item.caption?.slice(0, 50) || 'Instagram Media'} 
                  loading="lazy" 
                  decoding="async" 
                  class="ig-tile-img"
                />
                <div class="ig-tile-overlay">
                  {item.mediaType === 'VIDEO' && (
                    <div class="ig-play-icon">
                      <svg viewBox="0 0 24 24" fill="currentColor" width="36" height="36">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>
                  )}
                  <div class="ig-tile-content">
                    <div class="ig-accent-line"></div>
                    <p class="ig-text">{item.caption || "View post on Instagram"}</p>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>
  </infinite-marquee>
)}

<script>
  class InfiniteMarquee extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector('.ig-carousel-track');
      if (!track) return;
      
      const groups = track.querySelectorAll('.ig-marquee-group');
      if (groups.length < 3) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return; // Let native scroll take over fully

      let isPaused = false;
      let speed = 0.5; // Very slow speed (approx 30px per sec, ~7.5s per item)

      // Use a robust way to calculate group width
      let groupWidth = (groups[1] as HTMLElement).offsetLeft - (groups[0] as HTMLElement).offsetLeft;
      
      const resizeObserver = new ResizeObserver(() => {
        groupWidth = (groups[1] as HTMLElement).offsetLeft - (groups[0] as HTMLElement).offsetLeft;
      });
      resizeObserver.observe(track);

      let exactScrollLeft = groupWidth;
      track.scrollLeft = exactScrollLeft;

      const updateScroll = () => {
        if (!isPaused) {
          exactScrollLeft += speed;
          track.scrollLeft = exactScrollLeft;
        } else {
          // Keep accumulator in sync with native scroll position if user dragged it
          exactScrollLeft = track.scrollLeft;
        }

        // Endless loop wrapper
        if (exactScrollLeft >= groupWidth * 2) {
          exactScrollLeft -= groupWidth;
          track.scrollLeft = exactScrollLeft;
        } else if (exactScrollLeft <= 0) {
          exactScrollLeft += groupWidth;
          track.scrollLeft = exactScrollLeft;
        }
        
        requestAnimationFrame(updateScroll);
      };

      requestAnimationFrame(updateScroll);

      // Pause interactions
      track.addEventListener('mouseenter', () => isPaused = true);
      track.addEventListener('mouseleave', () => isPaused = false);
      
      track.addEventListener('touchstart', () => { isPaused = true; }, {passive: true});
      track.addEventListener('touchend', () => {
        setTimeout(() => isPaused = false, 1000);
      }, {passive: true});
      
      let wheelTimeout: ReturnType<typeof setTimeout>;
      track.addEventListener('wheel', () => {
        isPaused = true;
        clearTimeout(wheelTimeout);
        wheelTimeout = setTimeout(() => isPaused = false, 1000);
      }, {passive: true});
      
      // Handle native boundaries during active manual scrolling
      track.addEventListener('scroll', () => {
        if (track.scrollLeft >= groupWidth * 2) {
          track.scrollLeft -= groupWidth;
          exactScrollLeft = track.scrollLeft;
        } else if (track.scrollLeft <= 0) {
          track.scrollLeft += groupWidth;
          exactScrollLeft = track.scrollLeft;
        }
      }, {passive: true});
    }
  }
  
  if (!customElements.get('infinite-marquee')) {
    customElements.define('infinite-marquee', InfiniteMarquee);
  }
</script>

<style>
  /* 
    The wrapper fits standard layout, avoiding full-width bleed unless on small mobile.
    It contains the scrolling track.
  */
  .ig-carousel-wrapper {
    position: relative;
    width: 100%;
    /* Keep it in bounds on desktop */
    margin: 2rem 0;
    overflow: hidden; /* Hide the scrollbar visually for the wrapper */
  }

  /* 
    The track handles the horizontal scrolling natively now.
  */
  .ig-carousel-track {
    display: flex;
    gap: 1.25rem;
    padding: 1rem 0 2rem;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* Cursor hinting that it can be dragged/swiped */
    cursor: grab;
  }

  .ig-carousel-track:active {
    cursor: grabbing;
  }
  
  .ig-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .ig-marquee-group {
    display: flex;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ig-carousel-track {
      scroll-snap-type: x mandatory;
    }
  }

  /* 
    Tiles are strictly constrained to avoid internal scrolling.
    Fixed aspect ratio 4:5 (Standard Instagram Portrait).
  */
  .ig-carousel-tile {
    flex: 0 0 220px; /* Locked width */
    aspect-ratio: 4 / 5; /* Forces the height to wrap perfectly */
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    background: var(--color-surface, #111);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease;
    text-decoration: none;
    display: block;
  }

  @media (max-width: 560px) {
    .ig-carousel-tile {
      flex: 0 0 160px; /* Even smaller on phones */
    }
  }

  .ig-carousel-tile:hover {
    transform: translateY(-8px);
    border-color: var(--color-accent);
    box-shadow: 0 12px 30px rgba(204, 0, 0, 0.2);
  }

  .ig-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Locks the image into the bounds perfectly */
    transition: transform 0.6s ease;
  }

  .ig-carousel-tile:hover .ig-tile-img {
    transform: scale(1.05);
  }

  /* 
    Cinematic Overlay matching the site's dark aesthetic 
  */
  .ig-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.95) 0%,
      rgba(9, 9, 11, 0.4) 40%,
      transparent 100%
    );
    opacity: 0.8;
    transition: background 0.3s ease, opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    pointer-events: none;
  }

  .ig-carousel-tile:hover .ig-tile-overlay {
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.98) 0%,
      rgba(9, 9, 11, 0.7) 50%,
      transparent 100%
    );
    opacity: 1;
  }

  .ig-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: rgba(255, 255, 255, 0.3); /* low visibility default */
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .ig-play-icon::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 42px; /* Smaller icon than content card */
    height: 30px;
    border-radius: 8px;
    background: var(--color-accent);
    opacity: 0;
    filter: blur(8px);
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  .ig-carousel-tile:hover .ig-play-icon {
    color: #ffffff; /* Icon turns white */
    transform: translate(-50%, -50%) scale(1.15);
  }

  .ig-carousel-tile:hover .ig-play-icon svg {
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }

  .ig-carousel-tile:hover .ig-play-icon::before {
    opacity: 0.6;
  }

  .ig-tile-content {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transform: translateY(10px);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ig-carousel-tile:hover .ig-tile-content {
    transform: translateY(0);
    opacity: 1;
  }

  .ig-accent-line {
    height: 2px;
    width: 24px;
    background: rgba(220, 38, 38, 0.8);
    transition: width 0.5s ease-out;
  }

  .ig-carousel-tile:hover .ig-accent-line {
    width: 40px;
  }

  .ig-text {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.85rem;
    font-weight: 400; /* Ensure it is not bold */
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.4s ease, text-shadow 0.4s ease;
  }
  
  .ig-carousel-tile:hover .ig-text {
    color: #fff;
    text-shadow: 0 0 12px rgba(204, 0, 0, 0.4);
  }
</style>
