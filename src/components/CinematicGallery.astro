---
import { getCardImageSources } from '../lib/card-images.js';

interface GalleryItem {
  id: string;
  mediaType: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
  displayUrl: string;
  videoUrl?: string;
  caption?: string;
  permalink?: string;
}

export interface Props {
  items: GalleryItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <div class="ig-carousel-wrapper">
    <div class="ig-carousel-track">
      {items.map((item) => {
        if (!item || !item.displayUrl) return null;
        
        const sources = getCardImageSources(item.displayUrl);
        const hasCaption = !!item.caption;
        
        return (
          <a href={item.permalink} target="_blank" rel="noopener noreferrer" class="ig-carousel-tile">
            <img 
              src={sources.src} 
              srcset={sources.srcset}
              sizes="(max-width: 768px) 45vw, 240px"
              alt={item.caption?.slice(0, 50) || 'Instagram Media'} 
              loading="lazy" 
              decoding="async" 
              class="ig-tile-img"
            />
            <div class="ig-tile-overlay">
              {item.mediaType === 'VIDEO' && (
                <div class="ig-play-icon">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="36" height="36">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              )}
              <div class="ig-tile-content">
                <div class="ig-accent-line"></div>
                <p class="ig-text">{item.caption || "View post on Instagram"}</p>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
)}

<style>
  /* 
    The wrapper fits standard layout, avoiding full-width bleed unless on small mobile.
    It contains the scrolling track.
  */
  .ig-carousel-wrapper {
    position: relative;
    width: 100%;
    /* Keep it in bounds on desktop */
    margin: 2rem 0;
    overflow: hidden; /* Hide the scrollbar visually for the wrapper */
  }

  /* 
    The track handles the horizontal scrolling.
  */
  .ig-carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1.25rem;
    padding: 1rem 0 2rem; /* padding bottom for hover lift */
    
    /* Center the track when items don't fill the wrapper */
    width: max-content;
    max-width: 100%;
    margin: 0 auto;

    /* Hide scrollbars */
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  
  .ig-carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* 
    Tiles are strictly constrained to avoid internal scrolling.
    Fixed aspect ratio 4:5 (Standard Instagram Portrait).
  */
  .ig-carousel-tile {
    flex: 0 0 220px; /* Locked width */
    aspect-ratio: 4 / 5; /* Forces the height to wrap perfectly */
    scroll-snap-align: start;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface, #111);
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.2, 1), box-shadow 0.4s ease;
    text-decoration: none;
    display: block;
  }

  @media (max-width: 560px) {
    .ig-carousel-tile {
      flex: 0 0 160px; /* Even smaller on phones */
    }
  }

  .ig-carousel-tile:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(204, 0, 0, 0.2);
  }

  .ig-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Locks the image into the bounds perfectly */
    transition: transform 0.6s ease;
  }

  .ig-carousel-tile:hover .ig-tile-img {
    transform: scale(1.05);
  }

  /* 
    Cinematic Overlay matching the site's dark aesthetic 
  */
  .ig-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.95) 0%,
      rgba(9, 9, 11, 0.4) 40%,
      transparent 100%
    );
    opacity: 0.8;
    transition: background 0.3s ease, opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    pointer-events: none;
  }

  .ig-carousel-tile:hover .ig-tile-overlay {
    background: linear-gradient(
      to top,
      rgba(9, 9, 11, 0.98) 0%,
      rgba(9, 9, 11, 0.7) 50%,
      transparent 100%
    );
    opacity: 1;
  }

  .ig-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .ig-carousel-tile:hover .ig-play-icon {
    color: var(--color-accent, #cc0000);
    transform: translate(-50%, -50%) scale(1.15);
  }

  .ig-tile-content {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transform: translateY(10px);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ig-carousel-tile:hover .ig-tile-content {
    transform: translateY(0);
    opacity: 1;
  }

  .ig-accent-line {
    height: 2px;
    width: 24px;
    background: rgba(220, 38, 38, 0.8);
    transition: width 0.5s ease-out;
  }

  .ig-carousel-tile:hover .ig-accent-line {
    width: 40px;
  }

  .ig-text {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-heading, "Syne", sans-serif);
    font-size: 0.85rem;
    font-weight: 400; /* Ensure it is not bold */
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.4s ease, text-shadow 0.4s ease;
  }
  
  .ig-carousel-tile:hover .ig-text {
    color: #fff;
    text-shadow: 0 0 12px rgba(204, 0, 0, 0.4);
  }
</style>
