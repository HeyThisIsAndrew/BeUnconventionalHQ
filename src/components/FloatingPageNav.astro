---
/**
 * FloatingPageNav — the article's contents, as a panel pinned to the left edge.
 *
 * ─── WHAT CHANGED, AND WHAT DELIBERATELY DID NOT ────────────────────────────
 * This replaces ArticleToc, which rendered the same list as a static block at
 * the top of the left rail. Two problems with that: the rail scrolled with the
 * page until its `position: sticky` caught, so the contents were somewhere
 * different depending on where you were, and the block held the top of a 14rem
 * column that had one other thing in it.
 *
 * Pinned to the viewport's left edge it is always in the same place, always the
 * same size, and it stops owning a column. The reading measure gets the width
 * back (see .article-layout in article.css).
 *
 * The ACTIVE-SECTION SCRIPT BELOW IS LIFTED UNCHANGED from that component. It
 * carries write-ups for five separate bugs — the teleport case where an
 * IntersectionObserver never fires because both states are "not intersecting",
 * the empty-set case that used to leave the last section highlighted after you
 * jumped to the top, the module-scoped teardown that replaced a `window` global,
 * the pending-timer clear before a ClientRouter swap, and the release that has
 * to run BEFORE the early returns. Rewriting it to match a new presentation
 * would have reintroduced them one at a time. Only the markup and CSS are new.
 *
 * ─── COLLAPSED IS TICKS, EXPANDED IS WORDS ──────────────────────────────────
 * At rest it is a column of short rules, one per section, with the current one
 * drawn long and in the accent. That is enough to say where you are in a piece
 * without putting a list of headings permanently over the artwork. Hovering or
 * tabbing into it opens the labels.
 *
 * The labels are CLIPPED, never `display: none`. A hidden label is out of the
 * accessibility tree, and then a screen reader is offered a nav of six unnamed
 * links. Width and opacity keep them announced at every state.
 */
import type { TocEntry } from '../lib/article-toc';

interface Props {
  entries: TocEntry[];
  /**
   * Page landmarks to fall back on when the article has too few headings to
   * index. Real anchors that exist on the page, never invented section names.
   */
  landmarks?: TocEntry[];
}

const { entries, landmarks = [] } = Astro.props;

/**
 * Fewer headings than this and the list is not worth the space.
 *
 * Two, not three: a two-section article still gets a real nav.
 */
const MIN_ENTRIES = 2;

/*
  ─── WHAT HAPPENS WHEN AN ARTICLE HAS NO HEADINGS ──────────────────────────
  Some posts genuinely have none — "Mortal Kombat 2 Review" has zero <h*> tags
  in its Substack source, so there are no sections to index and no code can
  invent them.

  The owner's call, made twice, is that an empty rail reads as broken. So a post
  that cannot be indexed by heading falls back to the page landmarks the caller
  passes in. Recorded honestly, because it was argued: these are navigation
  aids, not a table of contents. They are only ever shown when there is no real
  alternative, and the heading list always wins when one exists. The durable fix
  is editorial — two section headings in the Substack post turn this back into a
  real index.
*/
const useLandmarks = entries.length < MIN_ENTRIES && landmarks.length >= 2;
const items = entries.length >= MIN_ENTRIES ? entries : useLandmarks ? landmarks : [];
const show = items.length >= MIN_ENTRIES;
/* Landmarks are not sections, so they are labelled as what they are. */
const heading = useLandmarks ? 'On This Page' : 'Contents';
---

{
  show && (
    <nav class="floating-page-nav" aria-label={heading}>
      <p class="fpn-head" aria-hidden="true">{heading}</p>
      <ul class="fpn-list">
        {items.map((entry) => (
          <li class:list={['fpn-item', { 'is-sub': entry.level >= 3 }]}>
            <a href={`#${entry.id}`} data-toc-link={entry.id}>
              <span class="fpn-tick" aria-hidden="true"></span>
              <span class="fpn-label">{entry.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /*
    ─── PINNED TO THE VIEWPORT, NOT TO THE COLUMN ────────────────────────────

    `fixed` rather than `sticky`: sticky still belongs to a grid track and moves
    until it catches, which is the behaviour this replaced.

    z-index 40 puts it under the navbar (which sits above it) and over the
    article. It must not reach the PiP window's 90 — a contents list on top of a
    video is the same mistake in the other direction.
  */
  .floating-page-nav {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 70vh;
    padding: 1rem 1rem 1rem 0.9rem;
    border-radius: 0 10px 10px 0;
    border: 1px solid transparent;
    border-left: none;
    background: transparent;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    transition:
      background 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      padding 0.28s ease;
  }

  .floating-page-nav::-webkit-scrollbar {
    display: none;
  }

  .floating-page-nav:hover,
  .floating-page-nav:focus-within {
    background: rgba(12, 12, 12, 0.94);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.6);
    padding-right: 1.5rem;
  }

  /*
    The word "Contents" is decoration here: the <nav> already carries it as its
    accessible name, so announcing it twice would be the same label in a row.
    `aria-hidden` on the element, not `.sr-only`, for that reason.
  */
  .fpn-head {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-white-muted, #888);
    white-space: nowrap;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.28s ease, max-height 0.28s ease;
  }

  .floating-page-nav:hover .fpn-head,
  .floating-page-nav:focus-within .fpn-head {
    opacity: 1;
    max-height: 2rem;
  }

  .fpn-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .fpn-item.is-sub {
    padding-left: 0.75rem;
  }

  .fpn-list a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-white-muted, #888);
    transition: color 0.2s ease;
  }

  .fpn-list a:hover,
  .fpn-list a:focus-visible {
    color: var(--color-white, #f0f0f0);
  }

  .fpn-list a:focus-visible {
    outline: 2px solid var(--color-accent-text, #ef4444);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* The whole nav at rest: one short rule per section. */
  .fpn-tick {
    flex: 0 0 auto;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.28);
    transition: width 0.25s ease, background 0.25s ease;
  }

  .fpn-item.is-sub .fpn-tick {
    width: 9px;
  }

  .fpn-list a:hover .fpn-tick {
    background: rgba(255, 255, 255, 0.6);
  }

  /*
    `.active` is set by the script below, on the <a>. Drawn long and in the
    accent so the current section reads at a glance with the panel closed, which
    is the state it is in almost all the time.
  */
  .fpn-list a.active .fpn-tick {
    width: 26px;
    background: var(--color-accent-text, #ef4444);
  }

  .fpn-list a.active {
    color: var(--color-white, #f0f0f0);
  }

  /*
    CLIPPED, NOT HIDDEN. `display: none` would take these out of the
    accessibility tree and leave a screen reader a nav of unnamed links.
  */
  .fpn-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.4;
    transition: max-width 0.28s ease, opacity 0.22s ease;
  }

  .floating-page-nav:hover .fpn-label,
  .floating-page-nav:focus-within .fpn-label {
    max-width: 15rem;
    opacity: 1;
  }

  .fpn-item.is-sub .fpn-label {
    font-size: 0.72rem;
  }

  /*
    ─── IT ONLY EXISTS WHERE THERE IS ROOM BESIDE THE COLUMN ─────────────────

    1200px is the same breakpoint the left rail used. Below it the reading
    column IS the page, so a panel pinned to the left edge would sit on the
    words rather than beside them. The article still renders its own headings,
    and the scrollbar is the position indicator at that width.
  */
  @media (max-width: 1199px) {
    .floating-page-nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-page-nav,
    .fpn-head,
    .fpn-label,
    .fpn-tick,
    .fpn-list a {
      transition: none;
    }
  }
</style>

<script>
  /*
    Highlight the section currently in view.

    IntersectionObserver rather than a scroll listener: the browser does the
    work off the main thread and only tells us when a heading crosses the
    threshold, so this costs nothing while scrolling.

    rootMargin pulls the detection line up to ~30% from the top of the
    viewport, so a heading counts as "current" once it reaches the upper third
    rather than only at the very top edge.
  */
  let currentObserver: IntersectionObserver | null = null;
  let teardownScroll: (() => void) | null = null;
  
  /*
    Tear down BEFORE the early returns below, not only on swap. initFloatingPageNav
    returns early on a page with no TOC, and the same mistake in FeedGrid is
    already recorded there as "Memory leak fix: Cleanup old hashchange listener
    before early returns on new pages".
  */
  function releaseFloatingPageNav() {
    if (currentObserver) {
      currentObserver.disconnect();
      currentObserver = null;
    }
    if (teardownScroll) {
      teardownScroll();
      teardownScroll = null;
    }
  }

  function initFloatingPageNav() {
    releaseFloatingPageNav();
    
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (links.length === 0) return;

    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));
    if (headings.length === 0) return;

    const setActive = (id: string) => {
      links.forEach((link) => {
        const isActive = link.dataset.tocLink === id;
        link.classList.toggle('active', isActive);
        if (isActive) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const syncFallback = () => {
      const ZONE_TOP = 80;
      const passed = headings.filter((h) => h.getBoundingClientRect().top < ZONE_TOP);
      const fallback = passed.length > 0 ? passed[passed.length - 1] : headings[0];
      if (fallback?.id) setActive(fallback.id);
    };

    const activeHeadings = new Set<Element>();
    const observer = new IntersectionObserver(
      (records) => {
        records.forEach(r => {
          if (r.isIntersecting) activeHeadings.add(r.target);
          else activeHeadings.delete(r.target);
        });

        if (activeHeadings.size > 0) {
          // Prefer the topmost heading currently anywhere in the active zone
          const visible = Array.from(activeHeadings)
            .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)[0];
          if (visible.id) setActive(visible.id);
          return;
        }

        /*
          ─── NOTHING IN THE ZONE IS A POSITION, NOT A NON-EVENT ─────────────

          This used to do nothing at all when the set emptied, which left
          whatever was highlighted last still highlighted. Reported as: read to
          the end of an article, click the wordmark to jump to the top, and the
          contents rail still points at the final section.

          The set empties at BOTH ends of the article, and they are different
          answers:

            above the first heading  the masthead and hero fill the zone, so
                                     nothing is in it. The reader is at the
                                     start — highlight the FIRST entry.
            below the last heading   every heading has scrolled past the
                                     detection line. The reader is in the
                                     footer — keep the LAST entry.

          So the position is resolved from the headings themselves rather than
          assumed. `ZONE_TOP` in syncFallback() is the same 80px the rootMargin
          below uses; the two must agree or the rail disagrees with its own
          detection line.

          Doing this only when the set is empty keeps the normal scrolling path
          untouched — that is still pure IntersectionObserver, no geometry read
          per frame.
        */
        syncFallback();
      },
      // Active zone: from 80px below the top of the viewport, down to 50% of the viewport.
      { rootMargin: '-80px 0px -50% 0px', threshold: 0 },
    );

    headings.forEach((heading) => observer.observe(heading));
    setActive(headings[0].id);
    
    currentObserver = observer;

    /*
      ─── TELEPORTATION BUG PROTECTION ───────────────────────────────────────
      If the user jumps across the entire active zone instantly (e.g. clicking 
      "BE UNCONVENTIONAL HQ" to scroll to top, or dragging the scrollbar very 
      fast), the headings go from 'not intersecting' (below) to 'not intersecting' 
      (above) in a single frame. The IntersectionObserver never fires because 
      the boolean state didn't change! This debounced scroll listener catches 
      those teleports gracefully without polling layout geometry every frame.
    */
    let scrollTimeout: ReturnType<typeof setTimeout> | null = null;
    const onScroll = () => {
      if (activeHeadings.size > 0) return;
      if (scrollTimeout) clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(syncFallback, 50);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    /*
      MODULE SCOPE, NOT `window`. This was stored as
      `(window as any).__hqTocScrollHandler`, which works only while init and
      teardown alternate perfectly: a second init without a swap between
      overwrites the global and orphans the first listener, with no handle left
      to remove it. `currentObserver` right above is already module-scoped for
      exactly this reason, so the two now tear down the same way — and the cast
      that was needed to satisfy strict TS goes away with the global.

      The pending timer is cleared too. A scroll inside the last 50ms before a
      ClientRouter swap otherwise leaves a callback holding the OLD page's
      heading and link nodes until it fires.
    */
    teardownScroll = () => {
      window.removeEventListener('scroll', onScroll);
      if (scrollTimeout) clearTimeout(scrollTimeout);
      scrollTimeout = null;
    };
  }

  document.addEventListener('astro:page-load', initFloatingPageNav);
  
  document.addEventListener('astro:before-swap', releaseFloatingPageNav);
</script>
