---
import CtaPanel from './CtaPanel.astro';

export interface Props {
  kicker?: string;
  primary?: string;
  secondary?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
}

const {
  kicker = "Bookings",
  primary = "Want us at",
  secondary = "Your event?",
  description = "We provide cinematic coverage for premieres, conventions, and gaming events.",
  buttonText = "Get in Touch",
  /* The contact modal was removed — press/collaboration enquiries go to the
     collaborations page, which carries the mailto: the modal used to. */
  buttonLink = "/collaborations"
} = Astro.props;
---

{/* Sponsor/Booking CTA */}
<CtaPanel kicker={kicker} primary={primary} secondary={secondary} description={description}>
  <a href={buttonLink} class="cta-button-primary">{buttonText}</a>
</CtaPanel>

<style>
  /* This style is added to enforce the brand's cinematic hover glow,
     resolving an inconsistency on the new event pages. */
  .cta-button-primary:hover,
  .cta-button-primary:focus-visible {
    box-shadow: 0 0 25px rgba(204, 0, 0, 0.5);
  }
</style>
