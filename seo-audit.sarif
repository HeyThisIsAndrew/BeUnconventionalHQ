{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Astro SEO Audit",
          "informationUri": "https://github.com/namanlabc/astro-seo-audit",
          "semanticVersion": "0.3.3",
          "rules": [
            {
              "id": "description.length",
              "name": "Description length recommendation",
              "shortDescription": {
                "text": "Description is 31 characters; configured guidance is 70–160."
              },
              "help": {
                "text": "Review the summary for usefulness. This range is configurable guidance, not a search-engine rule."
              }
            },
            {
              "id": "title.length",
              "name": "Title length recommendation",
              "shortDescription": {
                "text": "Title is 114 characters; configured guidance is 30–60."
              },
              "help": {
                "text": "Review the title for clarity. Search engines do not enforce a fixed character limit, so treat this as editorial guidance."
              }
            },
            {
              "id": "images.alt-missing",
              "name": "Missing image alt attribute",
              "shortDescription": {
                "text": "9 images are missing an alt attribute."
              },
              "help": {
                "text": "Add useful alt text for meaningful images or alt=\"\" for decorative images. Empty alt attributes are intentionally not flagged."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "description.length",
          "level": "note",
          "message": {
            "text": "Description is 15 characters; configured guidance is 70–160."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "events/d23-2026/index.html"
                }
              },
              "logicalLocations": [
                {
                  "name": "/events/d23-2026/",
                  "kind": "route"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "description.length",
          "level": "note",
          "message": {
            "text": "Description is 31 characters; configured guidance is 70–160."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "events/sdcc-2026/index.html"
                }
              },
              "logicalLocations": [
                {
                  "name": "/events/sdcc-2026/",
                  "kind": "route"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "title.length",
          "level": "note",
          "message": {
            "text": "Title is 114 characters; configured guidance is 30–60."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "intel/how-resident-evil-makes-being-in/index.html"
                }
              },
              "logicalLocations": [
                {
                  "name": "/intel/how-resident-evil-makes-being-in/",
                  "kind": "route"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "images.alt-missing",
          "level": "warning",
          "message": {
            "text": "9 images are missing an alt attribute."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "intel/how-resident-evil-makes-being-in/index.html"
                }
              },
              "logicalLocations": [
                {
                  "name": "/intel/how-resident-evil-makes-being-in/",
                  "kind": "route"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
