# Cloudflare Pages reads this file and applies these HTTP response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Security headers applied to every route.

/*
  # Stop browsers from MIME-sniffing a response away from its declared type.
  X-Content-Type-Options: nosniff
  # Send origin only on cross-site navigations; full URL stays same-origin.
  Referrer-Policy: strict-origin-when-cross-origin
  # Prevent other sites from framing our pages (clickjacking protection).
  X-Frame-Options: SAMEORIGIN
  # Disable powerful browser features the site does not use.
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  # Force HTTPS for one year (site is HTTPS-only on Cloudflare Pages).
  Strict-Transport-Security: max-age=31536000
  # Restrict where content may load from. Allowlist matches the site's real
  # dependencies: Google Tag Manager/Analytics (scripts + beacons), the Meta /
  # TikTok / Clarity marketing pixels, YouTube embeds, and https image CDNs
  # (YouTube thumbs, Substack, Unsplash).
  # 'unsafe-inline' is required by GTM and the site's inline island scripts.
  # static.cloudflareinsights.com is Cloudflare Web Analytics, which the
  # platform injects into the response itself. It was being blocked by this
  # very policy on every page load, logging a CSP violation to the console and
  # costing a Lighthouse Best Practices point, while collecting nothing.
  #
  # Meta (connect.facebook.net), Clarity (*.clarity.ms) and TikTok
  # (analytics.tiktok.com) were added after all three were found refused in
  # production — Meta and Clarity outright by this directive, TikTok by CORS
  # inside the Partytown worker. See issue #63. Note the CSP was only HALF the
  # problem: a script fetched by a web worker also needs CORS headers the
  # pixel vendors do not send, so the Partytown resolveUrl in astro.config.mjs
  # routes them through /api/proxy. Both changes are required; either alone
  # leaves the pixels dead.
  #
  # img-src is already `'self' data: https:`, which covers every pixel beacon
  # (Meta's /tr, Clarity's collector) without naming hosts.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://challenges.cloudflare.com https://static.cloudflareinsights.com https://connect.facebook.net https://*.facebook.net https://analytics.tiktok.com https://*.tiktok.com https://*.tiktokcdn.com https://www.clarity.ms https://*.clarity.ms; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.googletagmanager.com https://challenges.cloudflare.com https://www.facebook.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://static.cloudflareinsights.com https://cloudflareinsights.com https://connect.facebook.net https://*.facebook.com https://analytics.tiktok.com https://*.tiktok.com https://www.clarity.ms https://*.clarity.ms https://c.clarity.ms

# The embedded Sanity Studio (/admin, injected by @sanity/astro's
# studioBasePath) is an internal tool: tell crawlers to keep it out of search
# results entirely. Header-based because the page markup is generated by the
# integration, so there's no template to put a <meta> tag in.
#
# KNOWN LIMITATION: the site-wide CSP above does not allow connections to
# *.sanity.io, so the hosted Studio at /admin cannot reach the Sanity API in
# production. If you want the hosted Studio to work (vs. running `npx sanity
# dev` locally), /admin needs its own CSP: detach the global one here with
# "! Content-Security-Policy" and set a Studio-friendly policy including
# connect-src https://*.sanity.io wss://*.sanity.io — then verify in the
# browser console, because Cloudflare JOINS duplicate headers (two CSPs
# enforce as their intersection, which would break it further).
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow

# Unhashed static files in public/. Everything Astro emits lands under
# /assets/* with a content hash and gets an immutable year from the Cloudflare
# adapter, but these keep stable filenames and so were being served with no
# cache policy at all - including banner.webp, which is the homepage LCP image
# and the single largest thing a repeat visitor was re-downloading. Lighthouse
# flags exactly this as "use efficient cache lifetimes".
#
# 30 days rather than a year precisely because the paths are NOT hashed: a
# replaced banner has to reach people in reasonable time. stale-while-revalidate
# serves the cached copy instantly and refreshes it in the background.
/banner.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/profile.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/og-image.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Force an actual download instead of Safari's inline PDF viewer. iOS
# Safari routinely ignores the HTML `download` attribute specifically for
# PDFs (a type it can render natively) and opens its built-in viewer page
# instead - the extra "why did pressing Download take me to another page"
# step this was reported for. Content-Disposition: attachment is a
# server-level signal browsers honor far more reliably than the client-
# side attribute, on Safari included.
/downloads/be-unconventional-hq-media-kit.pdf
  Content-Disposition: attachment; filename="Be-Unconventional-HQ-Media-Kit.pdf"
/downloads/be-unconventional-hq-press-kit.pdf
  Content-Disposition: attachment; filename="Be-Unconventional-HQ-Press-Kit.pdf"
/downloads/be-unconventional-hq-logo-pack.zip
  Content-Disposition: attachment; filename="Be-Unconventional-HQ-Logo-Pack.zip"
